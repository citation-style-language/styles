<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" page-range-format="expanded" initialize-with-hyphen="false" default-locale="en-US">
  <info>
    <title>Nephrology and Dialysis</title>
    <title-short>Nephrol Dial</title-short>
    <id>http://www.zotero.org/styles/nephrology-and-dialysis</id>
    <link href="http://www.zotero.org/styles/nephrology-and-dialysis" rel="self"/>
    <link href="http://www.zotero.org/styles/numeric" rel="template"/>
    <link href="https://journal.nephro.ru/jour/about/submissions#authorGuidelines" rel="documentation"/>
    <author>
      <name>Alexey Zulkarnaev</name>
      <email>7059899@gmail.com</email>
    </author>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <issn>1680-4422</issn>
    <eissn>2618-9801</eissn>
    <updated>2026-07-30T10:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="page-range-delimiter">-</term>
      <term name="presented at">presented at</term>
    </terms>
  </locale>
  <macro name="Author">
    <choose>
      <if type="chapter" match="any">
        <choose>
          <if match="any" variable="author">
            <names variable="author" suffix=" ">
              <name delimiter=", " font-style="italic" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="5" et-al-use-first="3"/>
            </names>
          </if>
          <else>
            <names variable="container-author" suffix=" ">
              <name delimiter=", " font-style="italic" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="5" et-al-use-first="3"/>
            </names>
          </else>
        </choose>
      </if>
      <else>
        <names variable="author" suffix=" ">
          <name delimiter=", " font-style="italic" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="5" et-al-use-first="3"/>
        </names>
      </else>
    </choose>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout delimiter="," prefix="[" suffix="]">
      <text variable="citation-number"/>
      <group prefix=", ">
        <label variable="locator" form="short" strip-periods="true"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="5" et-al-use-first="3" initialize-with="." name-as-sort-order="all" sort-separator=" " second-field-align="flush">
    <layout>
      <text variable="citation-number" suffix=". "/>
      <choose>
        <if type="article article-journal article-magazine" match="any">
          <text macro="Author" font-style="normal"/>
          <text variable="title" suffix=". "/>
          <text variable="container-title" suffix=". "/>
          <date date-parts="year" form="text" variable="issued" suffix=";"/>
          <text variable="volume"/>
          <text variable="issue" prefix="(" suffix=")"/>
          <text variable="page" prefix=":" suffix=". "/>
          <text variable="DOI" prefix="DOI: "/>
        </if>
        <else-if type="book" match="any">
          <text macro="Author"/>
          <text variable="title" suffix=". "/>
          <text variable="publisher" prefix="Publisher «" suffix="». "/>
          <date date-parts="year" form="text" variable="issued" suffix=". "/>
          <text variable="ISBN" prefix="ISBN: "/>
          <choose>
            <if match="any" variable="DOI">
              <text variable="DOI" prefix=". DOI: "/>
            </if>
          </choose>
        </else-if>
        <else-if type="chapter" match="any">
          <text macro="Author"/>
          <text variable="title" suffix=". "/>
          <text variable="container-title" prefix="in " suffix=". "/>
          <text variable="publisher" prefix="Publisher: «" suffix="». "/>
          <date date-parts="year" form="text" variable="issued" suffix=". "/>
          <text variable="page" prefix="P." suffix=". "/>
          <text variable="ISBN" prefix="ISBN: "/>
          <choose>
            <if match="any" variable="DOI">
              <text variable="DOI" prefix=". DOI: "/>
            </if>
          </choose>
        </else-if>
        <else-if type="webpage post-weblog post" match="any">
          <text variable="container-title" font-style="italic" suffix=" [Internet]. "/>
          <text variable="title" suffix=". "/>
          <text variable="URL" prefix="Available at: " suffix=". "/>
          <date form="text" variable="accessed" prefix="Accessed "/>
        </else-if>
        <else-if type="patent" match="any">
          <text macro="Author"/>
          <text variable="title" suffix=". "/>
          <choose>
            <if match="any" is-uncertain-date="issued">
              <date date-parts="year" form="text" variable="submitted" suffix=". "/>
            </if>
            <else>
              <date date-parts="year" form="text" variable="issued" suffix=". "/>
            </else>
          </choose>
          <text variable="publisher-place" suffix=". "/>
          <choose>
            <if match="any" variable="number">
              <text variable="number"/>
            </if>
            <else>
              <text variable="call-number"/>
            </else>
          </choose>
        </else-if>
        <else-if type="bill legislation legal_case" match="any">
          <text variable="title"/>
        </else-if>
        <else-if type="paper-conference" match="any">
          <text macro="Author"/>
          <text variable="title" suffix=". "/>
          <text variable="event-title" suffix=", "/>
          <date date-parts="year" form="text" variable="issued"/>
          <text value="; Abstract book. "/>
          <text variable="page" prefix="P." suffix=". "/>
          <text variable="event-place"/>
          <choose>
            <if match="any" variable="ISBN">
              <text variable="collection-title" prefix=". ISBN: "/>
            </if>
          </choose>
          <choose>
            <if match="any" variable="URL">
              <text variable="URL" prefix=". Available at: " suffix=". "/>
              <date form="text" variable="accessed" prefix="Accessed " suffix=" "/>
            </if>
          </choose>
        </else-if>
        <else-if type="thesis" match="any">
          <text macro="Author"/>
          <text variable="title" suffix=". "/>
          <date date-parts="year" form="text" variable="issued"/>
        </else-if>
        <else>
          <text value="OUT OF STYLE. CHECK DOCUMENT TYPE!" quotes="false"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>