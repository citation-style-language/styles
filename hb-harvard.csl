<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" default-locale="sv-SE">
  <info>
    <title>Högskolan i Borås - Harvard (svenska)</title>
    <title-short>HB Harvard sv</title-short>
    <id>http://www.zotero.org/styles/hb-harvard</id>
    <link href="http://www.zotero.org/styles/hb-harvard" rel="self"/>
    <link href="http://www.zotero.org/styles/university-of-gothenburg-apa-swedish-legislations" rel="template"/>
    <link href="https://github.com/HB-undervisning/citation-styles/blob/main/README.md" rel="documentation"/>
    <author>
      <name>Amanda Pettersson</name>
    </author>
    <category citation-format="author-date"/>
    <category field="humanities"/>
    <category field="law"/>
    <summary>Harvardstil på svenska enligt Högskolan i Borås Harvardguide.</summary>
    <updated>2026-10-08T13:11:00+02:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="sv">
    <terms>
      <term name="and">och</term>
      <term name="et-al">et al.</term>
      <term name="anonymous" form="short">anonym</term>
      <term name="no date">u.å.</term>
      <term name="page" form="short">
        <single>s.</single>
        <multiple>s.</multiple>
      </term>
      <term name="number-of-pages" form="short">
        <single>s.</single>
        <multiple>s.</multiple>
      </term>
      <term name="edition" form="short">uppl.</term>
      <term name="editor" form="short">
        <single>red.</single>
        <multiple>red.</multiple>
      </term>
    </terms>
  </locale>
  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date"/>
      </else>
    </choose>
  </macro>
  <macro name="author-bibliography">
    <choose>
      <if variable="author">
        <names variable="author">
          <name name-as-sort-order="all" sort-separator=", " initialize-with=". " and="symbol" delimiter=", " delimiter-precedes-last="never"/>
        </names>
      </if>
      <else-if variable="editor">
        <group delimiter=" ">
          <names variable="editor">
            <name name-as-sort-order="all" sort-separator=", " initialize-with=". " and="symbol" delimiter=", " delimiter-precedes-last="never"/>
          </names>
          <text value="(red.)"/>
        </group>
      </else-if>
      <else-if type="report webpage" variable="publisher" match="all">
        <text variable="publisher"/>
      </else-if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>
  <macro name="publisher">
    <choose>
      <if type="report webpage">
        <choose>
          <if variable="author">
            <text variable="publisher"/>
          </if>
        </choose>
      </if>
      <else>
        <text variable="publisher"/>
      </else>
    </choose>
  </macro>
  <macro name="author-citation">
    <names variable="author">
      <name form="short" and="symbol" delimiter=", " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="edition">
    <choose>
      <if variable="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="access">
    <choose>
      <if variable="URL">
        <text variable="URL"/>
        <choose>
          <if variable="accessed">
            <date variable="accessed" prefix=" [" suffix="]">
              <date-part name="year"/>
              <date-part name="month" form="numeric-leading-zeros" prefix="-"/>
              <date-part name="day" form="numeric-leading-zeros" prefix="-"/>
            </date>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="doi-or-access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi:"/>
      </if>
      <else>
        <text macro="access"/>
      </else>
    </choose>
  </macro>
  <macro name="pages">
    <choose>
      <if variable="page">
        <group delimiter=" ">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="material-type">
    <choose>
      <if variable="medium">
        <text variable="medium" prefix="[" suffix="]"/>
      </if>
      <else-if type="graphic">
        <text value="fotografi" prefix="[" suffix="]"/>
      </else-if>
      <else-if type="post post-weblog" match="any">
        <text variable="medium" prefix="[" suffix="]"/>
      </else-if>
      <else-if type="motion_picture">
        <text value="video" prefix="[" suffix="]"/>
      </else-if>
      <else-if type="broadcast">
        <text variable="genre" prefix="[" suffix="]"/>
      </else-if>
      <else-if type="speech">
        <text value="inspelad föreläsning" prefix="[" suffix="]"/>
      </else-if>
    </choose>
  </macro>
  <macro name="encyclopedia-reference">
    <group delimiter=". ">
      <group delimiter=" ">
        <names variable="author" font-style="italic">
          <name name-as-sort-order="all" sort-separator=", " initialize-with=". " and="symbol" delimiter=", " delimiter-precedes-last="never"/>
          <substitute>
            <text variable="publisher"/>
            <text variable="container-title"/>
            <text variable="title"/>
          </substitute>
        </names>
        <text macro="issued-year" prefix="(" suffix=")"/>
      </group>
      <text variable="title"/>
      <choose>
        <if variable="URL">
          <text macro="access"/>
        </if>
        <else-if variable="archive">
          <text variable="archive" prefix="Tillgänglig: "/>
        </else-if>
      </choose>
    </group>
  </macro>
  <macro name="legislation-id">
    <group delimiter=" ">
      <text variable="container-title"/>
      <text variable="volume"/>
    </group>
  </macro>
  <macro name="legislation-reference">
    <group delimiter=". ">
      <text macro="legislation-id"/>
      <text variable="title"/>
    </group>
  </macro>
  <macro name="standard-id">
    <choose>
      <if variable="number">
        <text variable="number"/>
      </if>
      <else>
        <text macro="author-citation"/>
      </else>
    </choose>
  </macro>
  <macro name="standard-reference">
    <group delimiter=". ">
      <text macro="standard-id"/>
      <text variable="title" font-style="italic"/>
      <names variable="author">
        <name and="symbol" delimiter=", " delimiter-precedes-last="never"/>
      </names>
    </group>
  </macro>
  <macro name="patent-applicant">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " and="symbol" delimiter=", " delimiter-precedes-last="never"/>
      <substitute>
        <text variable="publisher"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="patent-publication-date">
    <date variable="issued" form="numeric"/>
  </macro>
  <macro name="patent-reference">
    <group delimiter=". ">
      <group delimiter=" ">
        <text macro="patent-applicant"/>
        <text macro="issued-year" prefix="(" suffix=")"/>
      </group>
      <text variable="title" font-style="italic"/>
      <group delimiter=", ">
        <text variable="number"/>
        <text macro="patent-publication-date"/>
      </group>
      <text variable="URL"/>
    </group>
  </macro>
  <macro name="social-media-author">
    <names variable="author">
      <name and="symbol" delimiter-precedes-last="never" initialize-with=". " name-as-sort-order="all"/>
      <substitute>
        <text variable="container-title"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="social-media-reference">
    <group delimiter=". ">
      <group delimiter=" ">
        <group delimiter=" ">
          <text macro="social-media-author"/>
          <choose>
            <if variable="title-short">
              <text variable="title-short" prefix="(" suffix=")"/>
            </if>
          </choose>
        </group>
        <text macro="issued-year" prefix="(" suffix=")"/>
      </group>
      <group delimiter="">
        <text variable="title" suffix=" "/>
        <text variable="container-title" font-style="italic" suffix=" "/>
        <text variable="genre" prefix="[" suffix="]"/>
        <date variable="issued" prefix=", ">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="long"/>
        </date>
      </group>
      <text macro="access"/>
    </group>
  </macro>
  <macro name="video-author">
    <names variable="author">
      <name and="symbol" delimiter-precedes-last="never" initialize-with=". " name-as-sort-order="all"/>
      <substitute>
        <text variable="container-title"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="video-author-short">
    <names variable="author">
      <name form="short" and="symbol" delimiter-precedes-last="never" delimiter=", "/>
      <substitute>
        <text variable="container-title"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="video-reference">
    <group delimiter=". ">
      <group delimiter=" ">
        <text macro="video-author"/>
        <text macro="issued-year" prefix="(" suffix=")"/>
      </group>
      <group delimiter=" ">
        <text variable="title" font-style="italic"/>
        <text macro="material-type"/>
      </group>
      <text macro="access"/>
    </group>
  </macro>
  <!-- poddar, radioprogram, tvprogram-->
  <macro name="broadcast-title-short">
    <choose>
      <if variable="container-title">
        <text variable="container-title"/>
      </if>
      <else-if variable="title">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="publisher"/>
      </else>
    </choose>
  </macro>
  <macro name="broadcast-reference">
    <group delimiter=". ">
      <group delimiter=" ">
        <choose>
          <if variable="container-title">
            <text variable="container-title" font-style="italic"/>
          </if>
          <else>
            <text variable="title" font-style="italic"/>
          </else>
        </choose>
        <text macro="issued-year" prefix="(" suffix=")"/>
      </group>
      <group delimiter=" ">
        <text variable="title"/>
      </group>
      <choose>
        <if variable="publisher authority" match="any">
          <group delimiter="">
            <text variable="number" suffix=" "/>
            <text macro="material-type"/>
          </group>
          <group delimiter=", ">
            <text variable="publisher"/>
            <text variable="authority"/>
            <date variable="issued">
              <date-part name="day" suffix=" "/>
              <date-part name="month" form="long"/>
            </date>
          </group>
        </if>
        <else>
          <group delimiter="">
            <text variable="number" suffix=" "/>
            <text macro="material-type"/>
            <date variable="issued" prefix=", ">
              <date-part name="day" suffix=" "/>
              <date-part name="month" form="long"/>
            </date>
          </group>
        </else>
      </choose>
      <text macro="access"/>
    </group>
  </macro>
  <macro name="conference-extra">
    <text variable="note"/>
  </macro>
  <macro name="article-title">
    <choose>
      <if variable="author editor" match="any">
        <text variable="title"/>
      </if>
    </choose>
  </macro>
  <macro name="journal-location">
    <choose>
      <if variable="page">
        <text macro="pages"/>
      </if>
      <else-if variable="note">
        <text variable="note"/>
      </else-if>
    </choose>
  </macro>
  <macro name="bibliography-entry">
    <choose>
      <if type="patent">
        <text macro="patent-reference"/>
      </if>
      <else-if type="entry-encyclopedia">
        <text macro="encyclopedia-reference"/>
      </else-if>
      <else-if type="standard">
        <text macro="standard-reference"/>
      </else-if>
      <else-if type="legislation">
        <text macro="legislation-reference"/>
      </else-if>
      <else-if type="post-weblog" variable="genre">
        <text macro="social-media-reference"/>
      </else-if>
      <else-if type="post">
        <text macro="social-media-reference"/>
      </else-if>
      <else-if type="motion_picture" variable="URL" match="all">
        <text macro="video-reference"/>
      </else-if>
      <else-if type="broadcast">
        <text macro="broadcast-reference"/>
      </else-if>
      <else-if type="book">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="author-bibliography"/>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <text variable="title" font-style="italic"/>
          <group delimiter=", ">
            <text macro="edition"/>
            <text variable="publisher"/>
          </group>
          <text macro="doi-or-access"/>
        </group>
      </else-if>
      <else-if type="chapter">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="author-bibliography"/>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <text variable="title"/>
          <group delimiter=" ">
            <text value="I"/>
            <names variable="editor">
              <name initialize-with=". " name-as-sort-order="all" and="symbol" delimiter=", " delimiter-precedes-last="never"/>
            </names>
            <text value="(red.)"/>
            <text variable="container-title" font-style="italic"/>
          </group>
          <group delimiter=", ">
            <text variable="publisher"/>
            <text macro="pages"/>
          </group>
          <text macro="doi-or-access"/>
        </group>
      </else-if>
      <else-if type="article-journal article-magazine">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="author-bibliography"/>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <text macro="article-title"/>
          <group delimiter=", ">
            <text variable="container-title" font-style="italic"/>
            <group delimiter="">
              <text variable="volume"/>
              <text variable="issue" prefix="(" suffix=")"/>
            </group>
            <text macro="journal-location"/>
          </group>
          <text macro="doi-or-access"/>
        </group>
      </else-if>
      <else-if type="article-newspaper">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="author-bibliography"/>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <text variable="title"/>
          <group delimiter=", ">
            <text variable="container-title" font-style="italic"/>
            <date variable="issued">
              <date-part name="day" suffix=" "/>
              <date-part name="month" form="long"/>
            </date>
            <text macro="pages"/>
          </group>
          <text macro="access"/>
        </group>
      </else-if>
      <else-if type="paper-conference">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="author-bibliography"/>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <text variable="title"/>
          <group delimiter=". ">
            <group delimiter=" ">
              <text value="I"/>
              <text variable="container-title" font-style="italic"/>
            </group>
            <choose>
              <if variable="event-place note page" match="any">
                <group delimiter=", ">
                  <text variable="event-place"/>
                  <text macro="conference-extra"/>
                  <text macro="pages"/>
                </group>
              </if>
            </choose>
          </group>
          <text macro="doi-or-access"/>
        </group>
      </else-if>
      <else-if type="thesis">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="author-bibliography"/>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <group delimiter="">
            <text variable="title" font-style="italic"/>
          </group>
          <group delimiter=". ">
            <text variable="genre"/>
            <text variable="publisher"/>
            <text macro="access"/>
          </group>
        </group>
      </else-if>
      <else-if type="report">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="author-bibliography"/>
            <choose>
              <if variable="title-short">
                <text variable="title-short" prefix="(" suffix=")"/>
              </if>
            </choose>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <choose>
              <if variable="genre">
                <text variable="genre" prefix="[" suffix="]"/>
              </if>
            </choose>
            <choose>
              <if variable="event-date">
                <date variable="event-date" prefix=", ">
                  <date-part name="day"/>
                  <date-part name="month" form="long" prefix=" "/>
                </date>
              </if>
            </choose>
            <choose>
              <if variable="number">
                <group prefix="(" suffix=")">
                  <text value="Rapport "/>
                  <text variable="number"/>
                </group>
              </if>
            </choose>
            <text macro="material-type"/>
          </group>
          <text macro="publisher"/>
          <choose>
            <if variable="URL">
              <text macro="access"/>
            </if>
            <else-if variable="archive">
              <text variable="archive" prefix="Tillgänglig: "/>
            </else-if>
          </choose>
        </group>
      </else-if>
      <else-if type="webpage post-weblog">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="author-bibliography"/>
            <choose>
              <if variable="title-short">
                <text variable="title-short" prefix="(" suffix=")"/>
              </if>
            </choose>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <group delimiter=" ">
              <text variable="container-title" font-style="italic"/>
              <text macro="material-type"/>
            </group>
          </group>
          <text macro="publisher"/>
          <date variable="issued">
            <date-part name="day" suffix=" "/>
            <date-part name="month" form="long"/>
          </date>
          <text macro="access"/>
        </group>
      </else-if>
      <else-if type="motion_picture song speech">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="author-bibliography"/>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <text macro="material-type"/>
          </group>
          <group delimiter=", ">
            <text variable="container-title" font-style="italic"/>
            <text variable="publisher"/>
            <date variable="issued">
              <date-part name="day" suffix=" "/>
              <date-part name="month" form="long"/>
            </date>
          </group>
          <text macro="access"/>
        </group>
      </else-if>
      <else-if type="graphic">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="author-bibliography"/>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <text macro="material-type"/>
          </group>
          <text variable="publisher"/>
          <text macro="access"/>
        </group>
      </else-if>
      <else>
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="author-bibliography"/>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <text variable="title" font-style="italic"/>
          <text variable="container-title" font-style="italic"/>
          <text variable="publisher"/>
          <text macro="doi-or-access"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation and="symbol" et-al-min="6" et-al-use-first="1" et-al-subsequent-min="4" et-al-subsequent-use-first="1" disambiguate-add-names="true" disambiguate-add-givenname="true" disambiguate-add-year-suffix="true" givenname-disambiguation-rule="primary-name" collapse="year">
    <sort>
      <key macro="author-citation"/>
      <key macro="issued-year"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <choose>
        <if type="standard">
          <group delimiter=", ">
            <text macro="standard-id"/>
            <group delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </group>
        </if>
        <else-if type="legislation">
          <group delimiter=", ">
            <text macro="legislation-id"/>
            <group delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </group>
        </else-if>
        <else-if type="post post-weblog" match="any">
          <group delimiter=", ">
            <group delimiter=" ">
              <text macro="author-citation"/>
              <text macro="issued-year"/>
            </group>
            <group delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </group>
        </else-if>
        <else-if type="broadcast">
          <group delimiter=", ">
            <group delimiter=" ">
              <text macro="broadcast-title-short"/>
              <text macro="issued-year"/>
            </group>
            <group delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </group>
        </else-if>
        <else-if type="motion_picture" variable="URL" match="all">
          <group delimiter=", ">
            <group delimiter=" ">
              <text macro="video-author-short"/>
              <text macro="issued-year"/>
            </group>
            <group delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <group delimiter=" ">
              <choose>
                <if type="report webpage post post-weblog" variable="title-short" match="all">
                  <choose>
                    <if position="first">
                      <group delimiter=" ">
                        <text macro="author-citation"/>
                        <text variable="title-short" prefix="[" suffix="]"/>
                      </group>
                    </if>
                    <else>
                      <text variable="title-short"/>
                    </else>
                  </choose>
                </if>
                <else>
                  <text macro="author-citation"/>
                </else>
              </choose>
              <text macro="issued-year"/>
            </group>
            <group delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography hanging-indent="true" entry-spacing="1" line-spacing="1" et-al-min="11" et-al-use-first="1">
    <sort>
      <key macro="author-bibliography"/>
      <key macro="issued-year" sort="ascending"/>
      <key variable="title"/>
    </sort>
    <layout>
      <text macro="bibliography-entry"/>
      <choose>
        <if variable="DOI URL" match="none">
          <text value="."/>
        </if>
      </choose>
    </layout>
  </bibliography>
</style>
