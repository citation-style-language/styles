<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" page-range-format="expanded" default-locale="ar">
  <info>
    <title>Ibadica (العربية)</title>
    <title-short>Ibadica (author-date, Arabic)</title-short>
    <id>http://www.zotero.org/styles/ibadica</id>
    <link href="http://www.zotero.org/styles/ibadica" rel="self"/>
    <link href="http://www.zotero.org/styles/chicago-author-date" rel="template"/>
    <link href="https://github.com/Ibadica-fr/ibadica-csl" rel="documentation"/>
    <author>
      <name>Soufien Mestaoui</name>
    </author>
    <category citation-format="author-date"/>
    <category field="history"/>
    <category field="humanities"/>
    <category field="law"/>
    <category field="linguistics"/>
    <category field="literature"/>
    <category field="philosophy"/>
    <category field="theology"/>
    <summary>Arabic-only author-date style of the publisher Ibadica, modelled on the Chicago author-date structure and adapted to Arabic academic conventions: bold titles for works, guillemets for articles and chapters, Arabic punctuation, Hijri/Gregorian double dates (Hijri year in original-date), and the distinction between critical edition (تحقيق) and collective direction (إشراف).</summary>
    <updated>2026-11-25T14:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale>
    <date form="text">
      <date-part name="day" suffix=" "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
    <terms>
      <!-- Arabic guillemets -->
      <term name="open-quote">«</term>
      <term name="close-quote">»</term>
      <term name="open-inner-quote">"</term>
      <term name="close-inner-quote">"</term>
      <!-- Leading space intentional: citeproc-js (Zotero) then attaches "و" to the next name -->
      <term name="and"> و</term>
      <!-- General terms preferred by Ibadica -->
      <term name="accessed">تاريخ الاطلاع</term>
      <term name="available at">متاح على</term>
      <term name="forthcoming">قيد النشر</term>
      <term name="in press">قيد الطبع</term>
      <term name="letter">رسالة</term>
      <term name="online">على الإنترنت</term>
      <term name="original-work-published">صدر أصلًا</term>
      <term name="personal-communication">مراسلة شخصية</term>
      <term name="presented at">قُدِّمت في</term>
      <term name="review-of">مراجعة لكتاب</term>
      <term name="review-of" form="short">مراجعة لكتاب</term>
      <!-- Item types used as fallback descriptions -->
      <term name="paper-conference">ورقة</term>
      <term name="speech">محاضرة</term>
      <!-- Locators -->
      <term name="figure" form="short">شكل</term>
      <term name="folio" form="short">ق</term>
      <term name="issue" form="short">ع</term>
      <term name="line" form="short">سطر</term>
      <term name="note" form="short">هامش</term>
      <term name="opus" form="short">مصنف</term>
      <term name="part" form="short">جزء</term>
      <term name="sub-verbo" form="short">مادة</term>
      <term name="verse" form="short">بيت</term>
      <!-- Volume: "ج" (juzʾ) for books, "مج" (mujallad) for periodicals (symbol form) -->
      <term name="volume" form="short">
        <single>ج</single>
        <multiple>ج</multiple>
      </term>
      <term name="volume" form="symbol">
        <single>مج</single>
        <multiple>مج</multiple>
      </term>
      <term name="number-of-volumes" form="short">
        <single>ج</single>
        <multiple>ج</multiple>
      </term>
      <!-- Roles. "editor" is the critical editor (تحقيق); "editorial-director" is the
           director of a collective work (إشراف) -->
      <term name="editor" form="short">
        <single>تحقيق</single>
        <multiple>تحقيق</multiple>
      </term>
      <term name="editorial-director" form="short">
        <single>إشراف</single>
        <multiple>إشراف</multiple>
      </term>
      <term name="editorial-director" form="verb">إشراف</term>
      <term name="chair" form="verb">رئاسة</term>
      <term name="collection-editor" form="verb">إشراف</term>
      <term name="composer" form="verb">تلحين</term>
      <term name="container-author" form="verb">تأليف</term>
      <term name="director" form="verb">إخراج</term>
      <term name="guest" form="verb">بمشاركة</term>
      <term name="interviewer" form="verb">أجراها</term>
      <term name="narrator" form="verb">رواية</term>
      <term name="recipient" form="verb">إلى</term>
      <term name="reviewed-author" form="verb">تأليف</term>
      <term name="series-creator" form="verb">إعداد</term>
      <!-- Terms also present in the current official Arabic locale, kept because the
           older locale bundled with Zotero still has them in English -->
      <term name="page-range-delimiter">-</term>
      <term name="comma">،</term>
      <term name="semicolon">؛</term>
      <term name="advance-online-publication">نشر إلكتروني مسبق</term>
      <term name="no-place">دون مكان</term>
      <term name="no-place" form="short">د.م</term>
      <term name="no-publisher">دون ناشر</term>
      <term name="no-publisher" form="short">د.ن</term>
      <term name="special-issue">عدد خاص</term>
      <term name="working-paper">ورقة عمل</term>
      <term name="manuscript">مخطوط</term>
      <term name="patent">براءة اختراع</term>
      <term name="report">تقرير</term>
      <term name="thesis">أطروحة</term>
      <term name="act" form="short">فصل</term>
      <term name="appendix" form="short">ملحق</term>
      <term name="article-locator" form="short">مادة</term>
      <term name="canon" form="short">قانون</term>
      <term name="elocation" form="short">موضع</term>
      <term name="equation" form="short">معادلة</term>
      <term name="rule" form="short">قاعدة</term>
      <term name="scene" form="short">مشهد</term>
      <term name="supplement" form="short">ملحق</term>
      <term name="table" form="short">جدول</term>
      <term name="timestamp" form="short"/>
      <term name="title-locator" form="short">عنوان</term>
      <term name="number" form="short">رقم</term>
      <term name="version">إصدار</term>
      <term name="compiler" form="verb">إعداد</term>
      <term name="contributor" form="verb">بمشاركة</term>
      <term name="curator" form="verb">تنسيق</term>
      <term name="executive-producer" form="verb">إنتاج تنفيذي</term>
      <term name="host" form="verb">تقديم</term>
      <term name="organizer" form="verb">تنظيم</term>
      <term name="performer" form="verb">أداء</term>
      <term name="producer" form="verb">إنتاج</term>
      <term name="script-writer" form="verb">سيناريو</term>
    </terms>
  </locale>
  <!-- ========== Names ========== -->
  <macro name="editor-as-author">
    <!-- An editor without author is the director of a collective work, unless the
         item is a critical edition (Hijri original-date) or a part of a book -->
    <choose>
      <if type="chapter entry entry-dictionary entry-encyclopedia paper-conference" match="none">
        <choose>
          <if variable="original-date" match="none">
            <choose>
              <if variable="editor">
                <group delimiter=" ">
                  <names variable="editor">
                    <name and="text" delimiter="، " delimiter-precedes-last="never" name-as-sort-order="first" sort-separator="، "/>
                  </names>
                  <text term="editorial-director" form="short" prefix="(" suffix=")"/>
                </group>
              </if>
            </choose>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="editor-as-author-short">
    <choose>
      <if type="chapter entry entry-dictionary entry-encyclopedia paper-conference" match="none">
        <choose>
          <if variable="original-date" match="none">
            <names variable="editor">
              <name form="short" and="text" delimiter="، " delimiter-precedes-last="never"/>
            </names>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="author-bib">
    <names variable="author">
      <name and="text" delimiter="، " delimiter-precedes-last="never" name-as-sort-order="first" sort-separator="، "/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editorial-director"/>
        <text macro="editor-as-author"/>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter="، " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editorial-director"/>
        <text macro="editor-as-author-short"/>
        <text macro="title-short"/>
      </substitute>
    </names>
  </macro>
  <macro name="book-contributors">
    <group delimiter=". ">
      <names variable="editorial-director">
        <label form="verb" suffix=" "/>
        <name and="text" delimiter="، " delimiter-precedes-last="never"/>
      </names>
      <choose>
        <if variable="author original-date editorial-director" match="any">
          <names variable="editor translator">
            <label form="verb" suffix=" "/>
            <name and="text" delimiter="، " delimiter-precedes-last="never"/>
          </names>
        </if>
        <else>
          <names variable="translator">
            <label form="verb" suffix=" "/>
            <name and="text" delimiter="، " delimiter-precedes-last="never"/>
          </names>
        </else>
      </choose>
      <names variable="compiler">
        <label form="verb" suffix=" "/>
        <name and="text" delimiter="، " delimiter-precedes-last="never"/>
      </names>
      <names variable="illustrator">
        <label form="verb" suffix=" "/>
        <name and="text" delimiter="، " delimiter-precedes-last="never"/>
      </names>
      <choose>
        <if type="manuscript" match="none">
          <names variable="contributor">
            <label form="verb" suffix=" "/>
            <name and="text" delimiter="، " delimiter-precedes-last="never"/>
          </names>
        </if>
      </choose>
    </group>
  </macro>
  <macro name="container-editors">
    <!-- Editor of the containing book: critical editor when the book has its own
         author, a Hijri date or an explicit director; otherwise director -->
    <group delimiter="، ">
      <names variable="container-author">
        <label form="verb" suffix=" "/>
        <name and="text" delimiter="، " delimiter-precedes-last="never"/>
      </names>
      <names variable="editorial-director">
        <label form="verb" suffix=" "/>
        <name and="text" delimiter="، " delimiter-precedes-last="never"/>
      </names>
      <choose>
        <if variable="container-author original-date editorial-director" match="any">
          <names variable="editor">
            <label form="verb" suffix=" "/>
            <name and="text" delimiter="، " delimiter-precedes-last="never"/>
          </names>
        </if>
        <else>
          <group delimiter=" ">
            <text term="editorial-director" form="verb"/>
            <names variable="editor">
              <name and="text" delimiter="، " delimiter-precedes-last="never"/>
            </names>
          </group>
        </else>
      </choose>
      <names variable="translator">
        <label form="verb" suffix=" "/>
        <name and="text" delimiter="، " delimiter-precedes-last="never"/>
      </names>
    </group>
  </macro>
  <!-- ========== Dates ========== -->
  <macro name="date">
    <!-- Hijri year (original-date) / Gregorian year (issued) -->
    <group>
      <choose>
        <if variable="original-date issued" match="all">
          <group delimiter="/">
            <date variable="original-date">
              <date-part name="year" suffix="هـ" range-delimiter="-"/>
            </date>
            <date variable="issued">
              <date-part name="year" suffix="م" range-delimiter="-"/>
            </date>
          </group>
        </if>
        <else-if variable="original-date">
          <date variable="original-date">
            <date-part name="year" suffix="هـ" range-delimiter="-"/>
          </date>
        </else-if>
        <else-if is-uncertain-date="issued">
          <group delimiter=" ">
            <text term="circa" form="short"/>
            <date variable="issued">
              <date-part name="year" range-delimiter="-"/>
            </date>
          </group>
        </else-if>
        <else-if variable="issued">
          <date variable="issued">
            <date-part name="year" range-delimiter="-"/>
          </date>
        </else-if>
        <else-if variable="status">
          <text variable="status"/>
        </else-if>
        <else>
          <group delimiter="-">
            <text term="no date" form="short"/>
            <text variable="year-suffix"/>
          </group>
        </else>
      </choose>
      <choose>
        <if variable="issued original-date status" match="any">
          <text variable="year-suffix"/>
        </if>
      </choose>
    </group>
  </macro>
  <macro name="day-month">
    <date variable="issued">
      <date-part name="day" suffix=" "/>
      <date-part name="month"/>
    </date>
  </macro>
  <macro name="accessed">
    <choose>
      <if type="webpage post post-weblog" match="any">
        <group delimiter=": ">
          <text term="accessed"/>
          <date variable="accessed" form="text"/>
        </group>
      </if>
      <else-if variable="issued original-date" match="none">
        <group delimiter=": ">
          <text term="accessed"/>
          <date variable="accessed" form="text"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <!-- ========== Titles ========== -->
  <macro name="title">
    <choose>
      <if type="chapter paper-conference entry entry-dictionary entry-encyclopedia article article-journal article-magazine article-newspaper review review-book post post-weblog webpage speech interview song broadcast personal_communication" match="any">
        <text variable="title" quotes="true"/>
      </if>
      <else-if type="legislation legal_case bill hearing regulation treaty" match="any">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" font-weight="bold"/>
      </else>
    </choose>
  </macro>
  <macro name="title-short">
    <choose>
      <if type="chapter paper-conference entry entry-dictionary entry-encyclopedia article article-journal article-magazine article-newspaper review review-book post post-weblog webpage speech interview song broadcast personal_communication" match="any">
        <text variable="title" form="short" quotes="true"/>
      </if>
      <else-if type="legislation legal_case bill hearing regulation treaty" match="any">
        <text variable="title" form="short"/>
      </else-if>
      <else>
        <text variable="title" form="short" font-weight="bold"/>
      </else>
    </choose>
  </macro>
  <!-- ========== Publication details ========== -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group>
          <text term="edition" form="short"/>
          <number variable="edition"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="volume-book">
    <choose>
      <if variable="volume">
        <group>
          <text term="volume" form="short"/>
          <text variable="volume"/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <text variable="number-of-volumes"/>
          <text term="number-of-volumes" form="short"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="series">
    <group delimiter="، ">
      <text variable="collection-title"/>
      <group delimiter=" ">
        <text term="number" form="short"/>
        <text variable="collection-number"/>
      </group>
    </group>
  </macro>
  <macro name="publisher">
    <group delimiter=": ">
      <choose>
        <if variable="publisher-place">
          <text variable="publisher-place"/>
        </if>
        <else-if type="book chapter" match="any">
          <text term="no-place" form="short"/>
        </else-if>
      </choose>
      <choose>
        <if variable="publisher">
          <text variable="publisher"/>
        </if>
        <else-if type="book chapter" match="any">
          <text term="no-publisher" form="short"/>
        </else-if>
      </choose>
    </group>
  </macro>
  <macro name="archive">
    <group delimiter="، ">
      <text variable="archive"/>
      <text variable="archive-place"/>
      <text variable="archive_location"/>
    </group>
  </macro>
  <macro name="holding">
    <!-- Holding library of a manuscript: Zotero "Archive" (or "Institution"),
         then city ("Lieu"), location in archive and shelfmark ("Cote") -->
    <group delimiter="، ">
      <choose>
        <if variable="archive">
          <text variable="archive"/>
        </if>
        <else>
          <text variable="publisher"/>
        </else>
      </choose>
      <choose>
        <if variable="archive-place">
          <text variable="archive-place"/>
        </if>
        <else>
          <text variable="publisher-place"/>
        </else>
      </choose>
      <text variable="archive_location"/>
      <group delimiter=" ">
        <text term="number" form="short"/>
        <text variable="call-number"/>
      </group>
    </group>
  </macro>
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="extent">
    <!-- Total extent ("# of Pages" in Zotero): "350 ص", or "120 ق" (folios) for
         manuscripts; abbreviations avoid Arabic number agreement -->
    <group delimiter=" ">
      <text variable="number-of-pages"/>
      <choose>
        <if type="manuscript">
          <text term="folio" form="short"/>
        </if>
        <else>
          <text term="number-of-pages" form="short"/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="genre-number">
    <group delimiter=" ">
      <text variable="genre"/>
      <group delimiter=" ">
        <text term="number" form="short"/>
        <text variable="number"/>
      </group>
    </group>
  </macro>
  <macro name="event">
    <!-- "ورقة قُدِّمت في ندوة ...، مسقط، 12 مارس" -->
    <group delimiter="، ">
      <group delimiter=" ">
        <choose>
          <if variable="genre">
            <text variable="genre"/>
          </if>
          <else-if type="speech">
            <text term="speech"/>
          </else-if>
          <else>
            <text term="paper-conference"/>
          </else>
        </choose>
        <text term="presented at"/>
        <text variable="event-title"/>
      </group>
      <text variable="event-place"/>
      <text macro="day-month"/>
    </group>
  </macro>
  <macro name="review">
    <group delimiter="، ">
      <group delimiter=" ">
        <text term="review-of"/>
        <text variable="reviewed-title" font-weight="bold"/>
      </group>
      <names variable="reviewed-author">
        <label form="verb" suffix=" "/>
        <name and="text" delimiter="، " delimiter-precedes-last="never"/>
      </names>
    </group>
  </macro>
  <macro name="periodical">
    <group delimiter="، ">
      <text variable="container-title" font-weight="bold"/>
      <choose>
        <if type="article-journal review review-book periodical" match="any">
          <group delimiter=" ">
            <label variable="volume" form="symbol"/>
            <text variable="volume"/>
          </group>
          <group delimiter=" ">
            <label variable="issue" form="short"/>
            <text variable="issue"/>
          </group>
        </if>
        <else>
          <text macro="day-month"/>
          <text variable="section"/>
        </else>
      </choose>
      <text macro="pages"/>
    </group>
  </macro>
  <macro name="access">
    <group delimiter=". ">
      <text macro="accessed"/>
      <choose>
        <if variable="DOI">
          <text variable="DOI" prefix="https://doi.org/"/>
        </if>
        <else>
          <text variable="URL"/>
        </else>
      </choose>
    </group>
  </macro>
  <!-- ========== Body by item type ========== -->
  <macro name="body">
    <choose>
      <!-- Parts of books -->
      <if type="chapter entry entry-dictionary entry-encyclopedia" match="any">
        <group delimiter=". ">
          <group delimiter="، ">
            <group delimiter=" ">
              <text term="in"/>
              <text variable="container-title" font-weight="bold"/>
            </group>
            <text macro="container-editors"/>
            <text macro="edition"/>
            <text macro="volume-book"/>
            <text macro="pages"/>
          </group>
          <text macro="series"/>
          <text macro="publisher"/>
        </group>
      </if>
      <else-if type="paper-conference">
        <choose>
          <if variable="container-title">
            <group delimiter=". ">
              <group delimiter="، ">
                <group delimiter=" ">
                  <text term="in"/>
                  <text variable="container-title" font-weight="bold"/>
                </group>
                <text macro="container-editors"/>
                <text macro="volume-book"/>
                <text macro="pages"/>
              </group>
              <text macro="series"/>
              <text macro="publisher"/>
            </group>
          </if>
          <else>
            <text macro="event"/>
          </else>
        </choose>
      </else-if>
      <!-- Periodicals -->
      <else-if type="article-journal article-magazine article-newspaper review review-book periodical" match="any">
        <group delimiter=". ">
          <text macro="review"/>
          <names variable="translator">
            <label form="verb" suffix=" "/>
            <name and="text" delimiter="، " delimiter-precedes-last="never"/>
          </names>
          <text macro="periodical"/>
        </group>
      </else-if>
      <!-- Theses: contributor = supervisor (إشراف) -->
      <else-if type="thesis">
        <group delimiter=". ">
          <group delimiter=" ">
            <text term="editorial-director" form="verb"/>
            <names variable="contributor">
              <name and="text" delimiter="، " delimiter-precedes-last="never"/>
            </names>
          </group>
          <group delimiter="، ">
            <choose>
              <if variable="genre">
                <text variable="genre"/>
              </if>
              <else>
                <text term="thesis"/>
              </else>
            </choose>
            <text variable="publisher"/>
            <text variable="publisher-place"/>
          </group>
          <text macro="extent"/>
        </group>
      </else-if>
      <!-- Manuscripts -->
      <else-if type="manuscript">
        <group delimiter=". ">
          <text macro="book-contributors"/>
          <!-- Zotero "Contributor" = copyist (no CSL term exists for this role) -->
          <group delimiter=" ">
            <text value="نسخ"/>
            <names variable="contributor">
              <name and="text" delimiter="، " delimiter-precedes-last="never"/>
            </names>
          </group>
          <group delimiter="، ">
            <choose>
              <if variable="genre">
                <text variable="genre"/>
              </if>
              <else>
                <text term="manuscript"/>
              </else>
            </choose>
            <text macro="holding"/>
            <!-- Folios of a text inside a codex: "page: 38ظ-42" in Zotero's Extra field -->
            <group delimiter=" ">
              <text term="folio" form="short"/>
              <text variable="page"/>
            </group>
          </group>
          <text macro="extent"/>
        </group>
      </else-if>
      <!-- Web -->
      <else-if type="webpage post post-weblog" match="any">
        <group delimiter=". ">
          <group delimiter="، ">
            <text variable="container-title"/>
            <text variable="genre"/>
            <text macro="day-month"/>
          </group>
          <text variable="publisher"/>
        </group>
      </else-if>
      <!-- Talks -->
      <else-if type="speech event" match="any">
        <text macro="event"/>
      </else-if>
      <!-- Interviews and correspondence -->
      <else-if type="interview">
        <group delimiter=". ">
          <group delimiter=" ">
            <text term="interview"/>
            <names variable="interviewer">
              <label form="verb" suffix=" "/>
              <name and="text" delimiter="، " delimiter-precedes-last="never"/>
            </names>
          </group>
          <group delimiter="، ">
            <text variable="container-title" font-weight="bold"/>
            <text variable="medium"/>
            <text variable="publisher"/>
          </group>
          <text macro="archive"/>
        </group>
      </else-if>
      <else-if type="personal_communication">
        <!-- Letters and e-mails: "رسالة إلى فلان، نزوى، 12 مارس" then the holding archive -->
        <group delimiter=". ">
          <group delimiter="، ">
            <group delimiter=" ">
              <choose>
                <if variable="genre">
                  <text variable="genre"/>
                </if>
                <else>
                  <text term="letter"/>
                </else>
              </choose>
              <names variable="recipient">
                <label form="verb" suffix=" "/>
                <name and="text" delimiter="، " delimiter-precedes-last="never"/>
              </names>
            </group>
            <text variable="event-place"/>
            <text macro="day-month"/>
          </group>
          <names variable="translator">
            <label form="verb" suffix=" "/>
            <name and="text" delimiter="، " delimiter-precedes-last="never"/>
          </names>
          <names variable="contributor">
            <label form="verb" suffix=" "/>
            <name and="text" delimiter="، " delimiter-precedes-last="never"/>
          </names>
          <text macro="holding"/>
        </group>
      </else-if>
      <!-- Audiovisual -->
      <else-if type="motion_picture broadcast song" match="any">
        <group delimiter=". ">
          <group delimiter="، ">
            <text variable="container-title" font-weight="bold"/>
            <text variable="number"/>
          </group>
          <names variable="director">
            <label form="verb" suffix=" "/>
            <name and="text" delimiter="، " delimiter-precedes-last="never"/>
          </names>
          <names variable="performer">
            <label form="verb" suffix=" "/>
            <name and="text" delimiter="، " delimiter-precedes-last="never"/>
          </names>
          <group delimiter="، ">
            <text variable="genre"/>
            <text variable="medium"/>
          </group>
          <text macro="publisher"/>
        </group>
      </else-if>
      <!-- Legal documents -->
      <else-if type="legislation legal_case bill hearing regulation treaty" match="any">
        <group delimiter="، ">
          <text variable="authority"/>
          <group delimiter=" ">
            <text term="number" form="short"/>
            <text variable="number"/>
          </group>
          <text variable="container-title" font-weight="bold"/>
          <group delimiter=" ">
            <label variable="issue" form="short"/>
            <text variable="issue"/>
          </group>
          <text macro="pages"/>
          <date variable="issued" form="text"/>
        </group>
      </else-if>
      <else-if type="patent">
        <group delimiter=". ">
          <group delimiter=" ">
            <choose>
              <if variable="genre">
                <text variable="genre"/>
              </if>
              <else>
                <text term="patent"/>
              </else>
            </choose>
            <group delimiter=" ">
              <text term="number" form="short"/>
              <text variable="number"/>
            </group>
          </group>
          <text variable="authority"/>
        </group>
      </else-if>
      <!-- Reports, software, datasets -->
      <else-if type="report dataset software standard" match="any">
        <group delimiter=". ">
          <text macro="book-contributors"/>
          <text macro="edition"/>
          <group delimiter=" ">
            <text term="version"/>
            <text variable="version"/>
          </group>
          <text macro="genre-number"/>
          <text macro="series"/>
          <text macro="publisher"/>
          <text macro="extent"/>
        </group>
      </else-if>
      <!-- Books and everything else -->
      <else>
        <group delimiter=". ">
          <text macro="book-contributors"/>
          <text macro="edition"/>
          <text macro="volume-book"/>
          <group delimiter="، ">
            <text variable="genre"/>
            <text variable="medium"/>
          </group>
          <text macro="series"/>
          <text macro="publisher"/>
          <text macro="extent"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="archive-trailing">
    <!-- Archival information for types that do not render it in their body -->
    <choose>
      <if type="manuscript interview personal_communication" match="none">
        <text macro="archive"/>
      </if>
    </choose>
  </macro>
  <!-- ========== Citation locator ========== -->
  <macro name="locator">
    <choose>
      <if locator="page">
        <group delimiter="، ">
          <choose>
            <if type="article-journal article-magazine article-newspaper review review-book periodical" match="none">
              <group>
                <text term="volume" form="short"/>
                <text variable="volume"/>
              </group>
            </if>
          </choose>
          <group delimiter=" ">
            <label variable="locator" form="short"/>
            <text variable="locator"/>
          </group>
        </group>
      </if>
      <else-if locator="volume">
        <group>
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </else-if>
      <else>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- ========== Sorting ========== -->
  <macro name="sort-date">
    <choose>
      <if variable="issued">
        <date variable="issued" form="numeric"/>
      </if>
      <else>
        <date variable="original-date" form="numeric"/>
      </else>
    </choose>
  </macro>
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="true" disambiguate-add-givenname="true" givenname-disambiguation-rule="primary-name" collapse="year" cite-group-delimiter="، ">
    <layout prefix="(" suffix=")" delimiter="؛ ">
      <group delimiter="، ">
        <group delimiter=" ">
          <text macro="author-short"/>
          <text macro="date"/>
        </group>
        <text macro="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="true" et-al-min="7" et-al-use-first="3" delimiter-precedes-et-al="never" entry-spacing="0">
    <sort>
      <key macro="author-bib"/>
      <key macro="sort-date"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="author-bib"/>
        <text macro="date"/>
        <text macro="title"/>
        <text macro="body"/>
        <text macro="archive-trailing"/>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
