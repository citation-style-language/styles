<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="pt-BR" demote-non-dropping-particle="never">
  <info>
    <title>Universidade Federal Rural do Rio de Janeiro - Instituto Três Rios - Curso de Administração</title>
    <title-short>UFRURAL-ITR-ADM</title-short>
    <id>http://www.zotero.org/styles/universidade-federal-rural-do-rio-de-janeiro-instituto-tres-rios-curso-de-administracao</id>
    <link href="http://www.zotero.org/styles/universidade-federal-rural-do-rio-de-janeiro-instituto-tres-rios-curso-de-administracao" rel="self"/>
    <link href="http://www.zotero.org/styles/associacao-brasileira-de-normas-tecnicas" rel="template"/>
    <author>
      <name>Gabriel Rocha Matos</name>
      <email>gbrmt1@ufrrj.br</email>
    </author>
    <category citation-format="author-date"/>
    <summary>Estilo brasileiro autor-data baseado exclusivamente na ABNT NBR 6023:2025 e na ABNT NBR 10520:2023.</summary>
    <updated>2026-08-25T12:09:23+00:00</updated>
  </info>
  <locale xml:lang="pt-BR">
    <terms>
      <term name="and">e</term>
      <term name="available at">Disponível em</term>
      <term name="et-al">et al.</term>
      <term name="page" form="short">p.</term>
      <term name="volume" form="short">v.</term>
      <term name="issue" form="short">n.</term>
      <term name="edition" form="short">ed.</term>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds.</multiple>
      </term>
      <term name="translator" form="short">trad.</term>
      <term name="month-01" form="short">jan.</term>
      <term name="month-02" form="short">fev.</term>
      <term name="month-03" form="short">mar.</term>
      <term name="month-04" form="short">abr.</term>
      <term name="month-05" form="short">maio</term>
      <term name="month-06" form="short">jun.</term>
      <term name="month-07" form="short">jul.</term>
      <term name="month-08" form="short">ago.</term>
      <term name="month-09" form="short">set.</term>
      <term name="month-10" form="short">out.</term>
      <term name="month-11" form="short">nov.</term>
      <term name="month-12" form="short">dez.</term>
    </terms>
  </locale>
  <macro name="author-bibliography">
    <names variable="author" delimiter="; ">
      <name name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " delimiter-precedes-last="always">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " delimiter-precedes-last="always">
            <name-part name="family" text-case="uppercase"/>
            <name-part name="given"/>
          </name>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <names variable="translator">
          <name name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " delimiter-precedes-last="always">
            <name-part name="family" text-case="uppercase"/>
            <name-part name="given"/>
          </name>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-citation">
    <names variable="author">
      <name form="short" name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " delimiter-precedes-last="never">
        <name-part name="family" text-case="capitalize-first"/>
      </name>
      <substitute>
        <names variable="editor">
          <name form="short" name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " delimiter-precedes-last="never">
            <name-part name="family" text-case="capitalize-first"/>
          </name>
        </names>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text value="[s.d.]"/>
      </else>
    </choose>
  </macro>
  <macro name="date-full">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text value="[s.d.]"/>
      </else>
    </choose>
  </macro>
  <macro name="date-periodical">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text value="[s.d.]"/>
      </else>
    </choose>
  </macro>
  <macro name="title-book">
    <text variable="title" font-weight="bold"/>
  </macro>
  <macro name="title-plain">
    <text variable="title"/>
  </macro>
  <macro name="container-title">
    <text variable="container-title" font-weight="bold"/>
  </macro>
  <macro name="edition">
    <choose>
      <if variable="edition">
        <number variable="edition" form="numeric"/>
        <text term="edition" prefix=" "/>
      </if>
    </choose>
  </macro>
  <macro name="publisher">
    <choose>
      <if variable="publisher-place publisher" match="any">
        <group delimiter=": ">
          <choose>
            <if variable="publisher-place">
              <text variable="publisher-place"/>
            </if>
            <else>
              <text value="[s. l.]"/>
            </else>
          </choose>
          <choose>
            <if variable="publisher">
              <text variable="publisher"/>
            </if>
            <else>
              <text value="[s. n.]"/>
            </else>
          </choose>
        </group>
      </if>
      <else>
        <text value="[s. l.: s. n.]"/>
      </else>
    </choose>
  </macro>
  <macro name="journal-details">
    <group delimiter=", ">
      <choose>
        <if variable="volume">
          <text variable="volume" prefix="v. "/>
        </if>
      </choose>
      <choose>
        <if variable="issue">
          <text variable="issue" prefix="n. "/>
        </if>
      </choose>
      <choose>
        <if variable="page">
          <text variable="page" prefix="p. "/>
        </if>
      </choose>
    </group>
  </macro>
  <macro name="chapter-details">
    <group delimiter=", ">
      <choose>
        <if variable="volume">
          <text variable="volume" prefix="v. "/>
        </if>
      </choose>
      <choose>
        <if variable="page">
          <text variable="page" prefix="p. "/>
        </if>
      </choose>
    </group>
  </macro>
  <macro name="online">
    <group delimiter=". ">
      <choose>
        <if variable="DOI">
          <text variable="DOI" prefix="https://doi.org/"/>
        </if>
      </choose>
      <choose>
        <if variable="URL">
          <group delimiter=": ">
            <text term="available at" text-case="capitalize-first"/>
            <text variable="URL"/>
          </group>
          <date variable="accessed" prefix=". Acesso em: ">
            <date-part name="day" suffix=" "/>
            <date-part name="month" form="short" suffix=" "/>
            <date-part name="year"/>
          </date>
        </if>
      </choose>
    </group>
  </macro>
  <macro name="locator">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>
  <macro name="event">
    <choose>
      <if variable="event">
        <group delimiter=", ">
          <text variable="event" text-case="uppercase"/>
          <choose>
            <if variable="event-place">
              <text variable="event-place"/>
            </if>
          </choose>
        </group>
      </if>
    </choose>
  </macro>
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <sort>
      <key macro="author-citation"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-citation"/>
        <text macro="year"/>
        <text macro="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="false" et-al-min="4" et-al-use-first="1" entry-spacing="1" line-spacing="1">
    <sort>
      <key macro="author-bibliography"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="book" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-book"/>
            <text macro="edition"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="online"/>
          </group>
        </if>
        <else-if type="chapter" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <group delimiter=" ">
              <text value="In:"/>
              <text macro="container-title"/>
            </group>
            <text macro="author-bibliography"/>
            <text macro="edition"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="chapter-details"/>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="article-journal article-magazine" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <group delimiter=", ">
              <text macro="container-title"/>
              <text macro="journal-details"/>
            </group>
            <text macro="date-periodical"/>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="article-newspaper" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <group delimiter=", ">
              <text macro="container-title"/>
              <choose>
                <if variable="volume">
                  <text variable="volume" prefix="ano "/>
                </if>
              </choose>
              <choose>
                <if variable="issue">
                  <text variable="issue" prefix="n. "/>
                </if>
              </choose>
              <choose>
                <if variable="page">
                  <text variable="page" prefix="p. "/>
                </if>
              </choose>
            </group>
            <text macro="date-periodical"/>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="paper-conference" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <group delimiter=" ">
              <text value="In:"/>
              <text macro="event"/>
            </group>
            <choose>
              <if variable="container-title">
                <text variable="container-title" font-weight="bold"/>
              </if>
              <else>
                <text value="Anais [...]" font-weight="bold"/>
              </else>
            </choose>
            <group delimiter=", ">
              <choose>
                <if variable="publisher-place">
                  <text variable="publisher-place"/>
                </if>
              </choose>
              <choose>
                <if variable="publisher">
                  <text variable="publisher"/>
                </if>
              </choose>
              <text macro="year"/>
            </group>
            <choose>
              <if variable="page">
                <text variable="page" prefix="p. "/>
              </if>
            </choose>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="thesis" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-book"/>
            <choose>
              <if variable="genre">
                <text variable="genre"/>
              </if>
            </choose>
            <group delimiter=", ">
              <choose>
                <if variable="publisher-place">
                  <text variable="publisher-place"/>
                </if>
              </choose>
              <choose>
                <if variable="publisher">
                  <text variable="publisher"/>
                </if>
              </choose>
              <text macro="year"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="report" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-book"/>
            <choose>
              <if variable="genre">
                <text variable="genre"/>
              </if>
            </choose>
            <group delimiter=", ">
              <choose>
                <if variable="publisher-place">
                  <text variable="publisher-place"/>
                </if>
              </choose>
              <choose>
                <if variable="publisher">
                  <text variable="publisher"/>
                </if>
              </choose>
              <text macro="year"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="webpage" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-book"/>
            <text macro="year"/>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="entry-dictionary entry-encyclopedia" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <text macro="container-title"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="patent" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <choose>
              <if variable="number">
                <text variable="number"/>
              </if>
            </choose>
            <group delimiter=", ">
              <choose>
                <if variable="publisher-place">
                  <text variable="publisher-place"/>
                </if>
              </choose>
              <text macro="year"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <else>
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-book"/>
            <choose>
              <if variable="container-title">
                <text macro="container-title"/>
              </if>
            </choose>
            <choose>
              <if variable="publisher-place publisher" match="any">
                <text macro="publisher"/>
              </if>
            </choose>
            <text macro="year"/>
            <text macro="online"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
