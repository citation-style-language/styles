<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="never" initialize="false" initialize-with="." initialize-with-hyphen="false" sort-separator=" " and="text" delimiter-precedes-last="never" et-al-min="99" et-al-use-first="1">
  <info>
    <title>Zeitschrift für ausländisches öffentliches Recht und Völkerrecht (ZaöRV)/Heidelberg Journal of International Law (HJIL) (EN/DE)</title>
    <title-short>ZaöRV/HJIL</title-short>
    <id>http://www.zotero.org/styles/hjil-zaoerv-multilingual</id>
    <link href="http://www.zotero.org/styles/hjil-zaoerv-multilingual" rel="self"/>
    <link href="https://www.nomos.de/en/journals/zaoerv/#guidelines-for-authors" rel="documentation"/>
    <author>
      <name>Erik Tuchtfeld</name>
      <email>tuchtfeld@mpil.de</email>
    </author>
    <category citation-format="note"/>
    <category field="law"/>
    <issn>0044-2348</issn>
    <eissn>2942-3562</eissn>
    <issnl>0044-2348</issnl>
    <summary>Footnote citations for the Heidelberg Journal of International Law / ZaöRV, English and German manuscripts in one style. The language follows the DOCUMENT language (Zotero Document Preferences): German terms and dates for German, English for everything else. Footnote-only: no bibliography. The creation of this style was assisted by Claude Sonnet 5.5.</summary>
    <updated>2026-11-19T23:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <!--
    Language switch: by DOCUMENT language (Zotero: Document Preferences > Language).
    This style deliberately has NO default-locale attribute: a style with default-locale fixes the language and
    Zotero then greys out the language menu.
    - Block without xml:lang = English (also the fallback for every other language).
    - Block xml:lang="de" = German.
    The terms "from", "at", "cited" and the long form of "edition" are used as carriers for wording that differs
    between the two sheets ("of"/"v.", "cited from"/"zitiert nach", "edn"/""). The term "at" (separator before the date of UN resolutions) is identical in both languages.
  -->
  <locale>
    <style-options punctuation-in-quote="false"/>
    <date form="text">
      <date-part name="day" suffix=" "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
    <terms>
      <term name="and">and</term>
      <term name="in">in</term>
      <term name="ordinal">th</term>
      <term name="ordinal-01" match="last-digit">st</term>
      <term name="ordinal-02" match="last-digit">nd</term>
      <term name="ordinal-03" match="last-digit">rd</term>
      <term name="ordinal-11" match="whole-number">th</term>
      <term name="ordinal-12" match="whole-number">th</term>
      <term name="ordinal-13" match="whole-number">th</term>
      <term name="open-quote">‘</term>
      <term name="close-quote">’</term>
      <term name="open-inner-quote">“</term>
      <term name="close-inner-quote">”</term>
      <term name="page-range-delimiter">-</term>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds</multiple>
      </term>
      <term name="edition" form="short">edn</term>
      <term name="edition" form="long">edn</term>
      <term name="paragraph" form="short">
        <single>para.</single>
        <multiple>paras</multiple>
      </term>
      <term name="note" form="short">
        <single>n.</single>
        <multiple>nn.</multiple>
      </term>
      <term name="issue" form="short">
        <single>no.</single>
        <multiple>nos</multiple>
      </term>
      <term name="accessed">last access</term>
      <term name="from">of</term>
      <term name="at">, </term>
      <term name="cited">cited from</term>
      <term name="month-01">January</term>
      <term name="month-02">February</term>
      <term name="month-03">March</term>
      <term name="month-04">April</term>
      <term name="month-05">May</term>
      <term name="month-06">June</term>
      <term name="month-07">July</term>
      <term name="month-08">August</term>
      <term name="month-09">September</term>
      <term name="month-10">October</term>
      <term name="month-11">November</term>
      <term name="month-12">December</term>
    </terms>
  </locale>
  <locale xml:lang="de">
    <style-options punctuation-in-quote="false"/>
    <date form="text">
      <date-part name="day" suffix=". "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
    <terms>
      <term name="and">und</term>
      <term name="in">in</term>
      <term name="ordinal">.</term>
      <term name="ordinal-01" match="last-digit">.</term>
      <term name="ordinal-02" match="last-digit">.</term>
      <term name="ordinal-03" match="last-digit">.</term>
      <term name="ordinal-11" match="whole-number">.</term>
      <term name="ordinal-12" match="whole-number">.</term>
      <term name="ordinal-13" match="whole-number">.</term>
      <term name="open-quote">‘</term>
      <term name="close-quote">’</term>
      <term name="open-inner-quote">‚</term>
      <term name="close-inner-quote">‘</term>
      <term name="page-range-delimiter">-</term>
      <term name="editor" form="short">
        <single>Hrsg.</single>
        <multiple>Hrsg.</multiple>
      </term>
      <term name="edition" form="short">Aufl.</term>
      <term name="edition" form="long"></term>
      <term name="paragraph" form="short">
        <single>Rn.</single>
        <multiple>Rn.</multiple>
      </term>
      <term name="note" form="short">
        <single>Fn.</single>
        <multiple>Fn.</multiple>
      </term>
      <term name="issue" form="short">
        <single>Nr.</single>
        <multiple>Nr.</multiple>
      </term>
      <term name="accessed">zuletzt besucht</term>
      <term name="from">v.</term>
      <term name="at">, </term>
      <term name="cited">zitiert nach</term>
      <term name="month-01">Januar</term>
      <term name="month-02">Februar</term>
      <term name="month-03">März</term>
      <term name="month-04">April</term>
      <term name="month-05">Mai</term>
      <term name="month-06">Juni</term>
      <term name="month-07">Juli</term>
      <term name="month-08">August</term>
      <term name="month-09">September</term>
      <term name="month-10">Oktober</term>
      <term name="month-11">November</term>
      <term name="month-12">Dezember</term>
    </terms>
  </locale>

  <!-- ===================== Building blocks ===================== -->

  <!-- Authors, or editors "(ed./eds)" if there is no author. -->
  <macro name="contributors-full">
    <choose>
      <if variable="author">
        <names variable="author">
          <name/>
        </names>
      </if>
      <else-if variable="editor">
        <text macro="editors-full"/>
      </else-if>
    </choose>
  </macro>
  <macro name="editors-full">
    <names variable="editor">
      <name/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <!-- Surname only, for subsequent references. -->
  <macro name="contributors-short">
    <choose>
      <if variable="author">
        <names variable="author">
          <name form="short"/>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name form="short"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </else-if>
      <else>
        <text variable="title" form="short" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="edition-label">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <text variable="edition"/>
          <text term="edition" form="long"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- (2nd edn, Publisher 2011) -->
  <macro name="publication-info">
    <group prefix="(" suffix=")" delimiter=", ">
      <text macro="edition-label"/>
      <group delimiter=" ">
        <text variable="publisher"/>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </group>
    </group>
  </macro>

  <!-- Pinpoint. Zotero locator label "page" prints no label; "paragraph" prints "para."/"paras". -->
  <macro name="locator-text">
    <choose>
      <if locator="page">
        <text variable="locator"/>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- First reference: "497-508 (500)" if the entry has its own pages, otherwise ", 29-30". -->
  <macro name="pinpoint-first">
    <choose>
      <if variable="locator">
        <choose>
          <if variable="page">
            <group prefix=" (" suffix=")">
              <text macro="locator-text"/>
            </group>
          </if>
          <else>
            <group prefix=", ">
              <text macro="locator-text"/>
            </group>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- Subsequent references (and ILC-type documents): always ", pinpoint". -->
  <macro name="pinpoint-comma">
    <choose>
      <if variable="locator">
        <group prefix=", ">
          <text macro="locator-text"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="note-ref">
    <group prefix=" (" suffix=")" delimiter=" ">
      <text term="note" form="short"/>
      <text variable="first-reference-note-number"/>
    </group>
  </macro>

  <!-- ===================== First references ===================== -->

  <macro name="journal-first">
    <group delimiter=", ">
      <text macro="contributors-full"/>
      <text variable="title" quotes="true"/>
      <group delimiter=" ">
        <text variable="container-title" form="short"/>
        <text variable="volume"/>
        <date variable="issued" prefix="(" suffix=")">
          <date-part name="year"/>
        </date>
      </group>
      <text variable="page"/>
    </group>
    <text macro="pinpoint-first"/>
  </macro>

  <macro name="book-first">
    <group delimiter=", ">
      <text macro="contributors-full"/>
      <group delimiter=" ">
        <text variable="title" font-style="italic"/>
        <text macro="publication-info"/>
      </group>
    </group>
    <text macro="pinpoint-first"/>
  </macro>

  <!-- Chapters in edited volumes, commentaries, MPEPIL entries. -->
  <macro name="chapter-first">
    <group delimiter=", ">
      <names variable="author">
        <name/>
      </names>
      <group delimiter=" ">
        <text variable="title" quotes="true"/>
        <group delimiter=": ">
          <text term="in"/>
          <group delimiter=", ">
            <text macro="editors-full"/>
            <group delimiter=" ">
              <text variable="container-title" font-style="italic"/>
              <text macro="publication-info"/>
            </group>
          </group>
        </group>
      </group>
      <text variable="page"/>
    </group>
    <text macro="pinpoint-first"/>
  </macro>

  <macro name="blog-first">
    <group delimiter=", ">
      <text macro="contributors-full"/>
      <text variable="title" quotes="true"/>
      <text variable="container-title"/>
      <date variable="issued" form="text"/>
      <group delimiter=" ">
        <text value="doi:"/>
        <text variable="DOI"/>
      </group>
    </group>
    <text macro="pinpoint-comma"/>
  </macro>

  <!-- Working papers / preprints (Zotero: Preprint; Report).
       Full stop between "'Title' (date)" and the rest ONLY if series AND "available at ..." are both present (example of the sheets);
       otherwise a comma. -->
  <macro name="wp-title-date">
    <group delimiter=" ">
      <text variable="title" quotes="true"/>
      <date variable="issued" form="text" prefix="(" suffix=")"/>
    </group>
  </macro>
  <macro name="wp-series">
    <group delimiter=" ">
      <text variable="collection-title"/>
      <choose>
        <if variable="collection-number">
          <group delimiter=" ">
            <text value="No."/>
            <text variable="collection-number"/>
          </group>
        </if>
        <else-if type="report">
          <group delimiter=" ">
            <text value="No."/>
            <text variable="number"/>
          </group>
        </else-if>
      </choose>
    </group>
  </macro>
  <macro name="wp-available">
    <choose>
      <if variable="URL">
        <group delimiter=": ">
          <group delimiter=" ">
            <text value="available at"/>
            <choose>
              <if type="article">
                <text variable="publisher"/>
              </if>
            </choose>
          </group>
          <text variable="URL"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="workingpaper-first">
    <group delimiter=", ">
      <text macro="contributors-full"/>
      <choose>
        <if variable="URL">
          <choose>
            <if variable="collection-title collection-number" match="any">
              <group delimiter=". ">
                <text macro="wp-title-date"/>
                <group delimiter=", ">
                  <text macro="wp-series"/>
                  <text macro="wp-available"/>
                </group>
              </group>
            </if>
            <else>
              <group delimiter=", ">
                <text macro="wp-title-date"/>
                <text macro="wp-available"/>
              </group>
            </else>
          </choose>
        </if>
        <else>
          <group delimiter=", ">
            <text macro="wp-title-date"/>
            <text macro="wp-series"/>
          </group>
        </else>
      </choose>
    </group>
    <text macro="pinpoint-comma"/>
  </macro>

  <macro name="webpage-cite">
    <group delimiter=", ">
      <text variable="URL" prefix="&lt;" suffix="&gt;"/>
      <group delimiter=" ">
        <text term="accessed"/>
        <date variable="accessed" form="text"/>
      </group>
    </group>
  </macro>

  <!--
    Court decisions / Gerichtsentscheidungen. Zotero "Case" fields:
    A) Official collection (BVerfGE, BGHZ ...): leave "Court" EMPTY.
         Reporter = "BVerfGE", Reporter Volume = "141", First Page = "1", Case Name = nickname (italic, after " - ").
    B) All other decisions:
         Court -> authority, form of the first reference ("ECtHR (Grand Chamber)", "WTO, Appellate Body", "BVerfG")
         Case Name -> title (italic; parties in brackets belong INTO the name)
         Extra -> note (further bracketed addition, not italic, WITH brackets, e.g. "(prompt release)")
         Rights -> license (stage: "merits" / "Merits")
         History -> references (type of decision: "judgment" / "Urteil" / "award" ...)
         Date Decided -> issued
         Docket Number -> number: verbatim incl. prefix ("case no. 8/74, ECLI:EU:C:1974:82" / "Rs. 8/74, ECLI:..."); a BARE number ("48756/14") gets "no." / "Nr." in front
         Reporter / Reporter Volume / First Page -> container-title / volume / page
         source (line in Extra: "Source: juris") gives " - zitiert nach juris" / " - cited from juris"
         jurisdiction (line in Extra: "Jurisdiction: ECtHR") = short court name for subsequent references ("ECtHR", "WTO")
    Subsequent reference: Short Title filled = short form "Court, Short title (n. X), pinpoint".
    Short Title empty = full citation again (German rule for German decisions).
    ALWAYS fill Short Title for international decisions.
      Extra line "Citation Label: ..." -> citation-label: FREE TEXT for decisions of other legal systems. If present, it replaces the structured output
        (all other case fields are ignored); italics via <i>...</i>; the pinpoint is appended with a comma.
        Subsequent reference: Short Title filled = Short Title exactly as typed + (n. X) + pinpoint; empty = the full Citation Label again.
  -->
  <macro name="case-first">
    <choose>
      <if variable="citation-label">
        <text variable="citation-label"/>
        <text macro="pinpoint-comma"/>
      </if>
      <else>
        <text macro="case-first-structured"/>
      </else>
    </choose>
  </macro>
  <macro name="case-first-structured">
    <choose>
      <if variable="authority">
        <group delimiter=", ">
          <text variable="authority"/>
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <text variable="note"/>
          </group>
          <text variable="license"/>
          <choose>
            <if variable="references">
              <group delimiter=" ">
                <text variable="references"/>
                <text term="from"/>
                <date variable="issued" form="text"/>
              </group>
            </if>
            <else>
              <date variable="issued" form="text"/>
            </else>
          </choose>
          <choose>
            <if is-numeric="number">
              <group delimiter=" ">
                <text term="issue" form="short"/>
                <text variable="number"/>
              </group>
            </if>
            <else>
              <text variable="number"/>
            </else>
          </choose>
          <choose>
            <if variable="container-title">
              <group delimiter=" ">
                <text variable="container-title"/>
                <choose>
                  <if variable="volume">
                    <text variable="volume"/>
                  </if>
                  <else>
                    <date variable="issued">
                      <date-part name="year"/>
                    </date>
                  </else>
                </choose>
              </group>
            </if>
          </choose>
          <text variable="page"/>
        </group>
        <text macro="pinpoint-first"/>
        <group delimiter=" " prefix=" – ">
          <text term="cited"/>
          <text variable="source"/>
        </group>
      </if>
      <else>
        <group delimiter=", ">
          <group delimiter=" ">
            <text variable="container-title"/>
            <text variable="volume"/>
          </group>
          <text variable="page"/>
        </group>
        <text macro="pinpoint-first"/>
        <group prefix=" – ">
          <text variable="title" font-style="italic"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- Subsequent references use the short court name ("ECtHR", "WTO") from the Extra line "Jurisdiction: ..." if present, otherwise the court. -->
  <macro name="court-short">
    <choose>
      <if variable="jurisdiction">
        <text variable="jurisdiction"/>
      </if>
      <else>
        <text variable="authority"/>
      </else>
    </choose>
  </macro>
  <macro name="case-subsequent">
    <choose>
      <if variable="citation-label">
        <choose>
          <if variable="title-short">
            <group>
              <text variable="title-short"/>
              <text macro="note-ref"/>
            </group>
            <text macro="pinpoint-comma"/>
          </if>
          <else>
            <text macro="case-first"/>
          </else>
        </choose>
      </if>
      <else>
        <text macro="case-subsequent-structured"/>
      </else>
    </choose>
  </macro>
  <macro name="case-subsequent-structured">
    <choose>
      <if variable="title-short">
        <group delimiter=", ">
          <text macro="court-short"/>
          <group>
            <text variable="title" form="short" font-style="italic"/>
            <text macro="note-ref"/>
          </group>
        </group>
        <text macro="pinpoint-comma"/>
      </if>
      <else>
        <text macro="case-first"/>
      </else>
    </choose>
  </macro>

  <!--
    International documents (Zotero "Bill").
    Without Code (resolutions). EN: Title "UNSC Resolution 2537" (Legislative Body empty). DE: Title "VN, SR Resolution 2537" (Legislative Body empty). Bill Number "S/RES/2537".
    With Code (yearbook): Legislative Body "ILC", Code "ILCYB", Code Volume "Vol. II", Section "Part Two", Pages "31".
  -->
  <macro name="bill-first">
    <choose>
      <if variable="container-title">
        <group delimiter=", ">
          <text variable="authority"/>
          <text variable="title" quotes="true"/>
          <group delimiter=" ">
            <date variable="issued" prefix="(" suffix=")">
              <date-part name="year"/>
            </date>
            <text variable="container-title"/>
          </group>
          <text variable="volume"/>
          <text variable="section"/>
          <text variable="page"/>
        </group>
        <text macro="pinpoint-comma"/>
      </if>
      <else>
        <group delimiter=", ">
          <text variable="authority"/>
          <group>
            <text variable="title"/>
            <group>
              <text term="at"/>
              <date variable="issued" form="text"/>
            </group>
          </group>
          <text variable="number"/>
        </group>
        <text macro="pinpoint-first"/>
      </else>
    </choose>
  </macro>

  <!--
    Treaties and legislation (Zotero "Statute").
    Name of Act -> full designation incl. date, e.g. "Vienna Convention on the Law of Treaties of 23 May 1969"
    Short Title -> abbreviation, printed in brackets on first reference, e.g. "Rome I"
    History -> official publication, verbatim, e.g. "1155 UNTS 331" or "OJ 2008 L 177/6"
  -->
  <macro name="legislation-first">
    <group delimiter=", ">
      <group delimiter=" ">
        <text variable="title"/>
        <text variable="title-short" prefix="(" suffix=")"/>
      </group>
      <text variable="references"/>
    </group>
    <text macro="pinpoint-first"/>
  </macro>
  <macro name="doc-subsequent">
    <group delimiter=", ">
      <text variable="authority"/>
      <group>
        <text variable="title" form="short"/>
        <text macro="note-ref"/>
      </group>
    </group>
    <text macro="pinpoint-comma"/>
  </macro>

  <!-- Fallback for item types the Style Sheet does not cover (thesis, manuscript, ...). -->
  <macro name="fallback-first">
    <group delimiter=", ">
      <text macro="contributors-full"/>
      <group delimiter=" ">
        <text variable="title" font-style="italic"/>
        <text macro="publication-info"/>
      </group>
    </group>
    <text macro="pinpoint-first"/>
  </macro>

  <!-- ===================== Subsequent references ===================== -->

  <!-- Short title only if the Zotero field "Short Title" is filled (several works by the same author). -->
  <macro name="short-title-if-any">
    <choose>
      <if variable="title-short">
        <choose>
          <if variable="author editor" match="any">
            <choose>
              <if type="book thesis">
                <text variable="title" form="short" font-style="italic"/>
              </if>
              <else-if type="article-journal chapter entry-encyclopedia entry-dictionary post-weblog">
                <text variable="title" form="short" quotes="true"/>
              </else-if>
              <else>
                <text variable="title" form="short"/>
              </else>
            </choose>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="default-subsequent">
    <group>
      <group delimiter=", ">
        <text macro="contributors-short"/>
        <text macro="short-title-if-any"/>
      </group>
      <text macro="note-ref"/>
    </group>
    <text macro="pinpoint-comma"/>
  </macro>

  <!-- ===================== Citation ===================== -->
  <citation>
    <layout delimiter="; " suffix=".">
      <choose>
        <if position="first">
          <choose>
            <if type="article-journal">
              <text macro="journal-first"/>
            </if>
            <else-if type="book">
              <text macro="book-first"/>
            </else-if>
            <else-if type="chapter entry-encyclopedia entry-dictionary">
              <text macro="chapter-first"/>
            </else-if>
            <else-if type="post-weblog">
              <text macro="blog-first"/>
            </else-if>
            <else-if type="article report">
              <text macro="workingpaper-first"/>
            </else-if>
            <else-if type="webpage">
              <text macro="webpage-cite"/>
            </else-if>
            <else-if type="legal_case">
              <text macro="case-first"/>
            </else-if>
            <else-if type="bill">
              <text macro="bill-first"/>
            </else-if>
            <else-if type="legislation">
              <text macro="legislation-first"/>
            </else-if>
            <else>
              <text macro="fallback-first"/>
            </else>
          </choose>
        </if>
        <else>
          <choose>
            <if type="webpage">
              <text macro="webpage-cite"/>
            </if>
            <else-if type="legal_case">
              <text macro="case-subsequent"/>
            </else-if>
            <else-if type="bill legislation">
              <text macro="doc-subsequent"/>
            </else-if>
            <else>
              <text macro="default-subsequent"/>
            </else>
          </choose>
        </else>
      </choose>
    </layout>
  </citation>
</style>
