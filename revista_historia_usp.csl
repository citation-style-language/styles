<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="pt-BR">
  <info>
    <title>Revista de História (USP)</title>
    <id>http://www.zotero.org/styles/revista-de-historia-usp-custom</id>
    <link href="https://revistas.usp.br/revhistoria/pt_BR/especificacoes-tecnicas" rel="documentation"/>
    <author><name>OpenAI</name></author>
    <category citation-format="author-date"/>
    <category field="history"/>
    <updated>2026-08-25T00:00:00+00:00</updated>
    <summary>Estilo para a Revista de História (USP): autor-data no texto e referências conforme especificações editoriais.</summary>
  </info>
  <locale xml:lang="pt-BR">
    <terms>
      <term name="et-al">et al.</term>
      <term name="accessed">Acesso em</term>
      <term name="available at">Disponível em</term>
    </terms>
  </locale>

  <macro name="author-cite">
    <names variable="author">
      <name form="short" name-as-sort-order="all" sort-separator=", " and="text" delimiter=", " delimiter-precedes-last="always" text-case="uppercase"/>
      <substitute><text variable="title" form="short" text-case="uppercase"/></substitute>
    </names>
  </macro>
  <macro name="year-cite">
    <group delimiter=" ">
      <date variable="issued"><date-part name="year"/></date>
      <date variable="original-date" prefix="[" suffix="]"><date-part name="year"/></date>
    </group>
  </macro>
  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="first" sort-separator=", " initialize="false" and="text" delimiter="; " delimiter-precedes-last="never"><name-part name="family" text-case="uppercase"/></name>
      <substitute>
        <names variable="editor"><name name-as-sort-order="first" sort-separator=", " initialize="false" and="text" delimiter="; "><name-part name="family" text-case="uppercase"/></name></names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="editors">
    <names variable="editor">
      <name name-as-sort-order="first" sort-separator=", " initialize="false" and="text" delimiter="; "><name-part name="family" text-case="uppercase"/></name>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="edition">
    <choose><if variable="edition"><text variable="edition" suffix=". ed."/></if></choose>
  </macro>
  <macro name="pubplace-publisher">
    <group delimiter=": "><text variable="publisher-place"/><text variable="publisher"/></group>
  </macro>
  <macro name="issued-bib">
    <group delimiter=" ">
      <date variable="issued"><date-part name="year"/></date>
      <date variable="original-date" prefix="[" suffix="]"><date-part name="year"/></date>
    </group>
  </macro>
  <macro name="access">
    <group delimiter=". ">
      <text variable="URL" prefix="Disponível em: &lt;" suffix="&gt;"/>
      <date variable="accessed" prefix="Acesso em: "><date-part name="day" form="numeric-leading-zeros" suffix="/"/><date-part name="month" form="numeric-leading-zeros" suffix="/"/><date-part name="year"/></date>
      <text variable="DOI" prefix="doi: https://doi.org/"/>
    </group>
  </macro>
  <macro name="bib-entry">
    <choose>
      <if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=". ">
          <text macro="author-bib"/>
          <text variable="title"/>
          <group delimiter=" "><text value="In:"/><text macro="editors"/></group>
          <text variable="container-title" font-style="italic"/>
          <text variable="translator" prefix="Tradução: "/>
          <text macro="edition"/>
          <group delimiter=", "><text macro="pubplace-publisher"/><text macro="issued-bib"/></group>
          <text variable="page" prefix="p. "/>
          <text macro="access"/>
        </group>
      </if>
      <else-if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=". ">
          <text macro="author-bib"/>
          <text variable="title"/>
          <text variable="container-title" font-style="italic"/>
          <group delimiter=", ">
            <text variable="publisher-place"/>
            <text variable="publisher"/>
            <text variable="volume" prefix="v. "/>
            <text variable="issue" prefix="n. "/>
            <date variable="issued"><date-part name="month" form="long"/><date-part name="year" prefix=" "/></date>
            <text variable="page" prefix="p. "/>
          </group>
          <text macro="access"/>
        </group>
      </else-if>
      <else-if type="thesis">
        <group delimiter=". ">
          <text macro="author-bib"/>
          <text variable="title" font-style="italic"/>
          <group delimiter=", "><text variable="genre"/><text variable="publisher"/><text variable="publisher-place"/><text macro="issued-bib"/></group>
          <text macro="access"/>
        </group>
      </else-if>
      <else-if type="manuscript">
        <group delimiter=". ">
          <text macro="author-bib"/>
          <text variable="title"/>
          <date variable="issued"><date-part name="day" suffix="/"/><date-part name="month" form="numeric-leading-zeros" suffix="/"/><date-part name="year"/></date>
          <text variable="archive_location"/>
          <text variable="archive"/>
        </group>
      </else-if>
      <else>
        <group delimiter=". ">
          <text macro="author-bib"/>
          <text variable="title" font-style="italic"/>
          <text variable="translator" prefix="Tradução: "/>
          <text macro="edition"/>
          <group delimiter=", "><text macro="pubplace-publisher"/><text macro="issued-bib"/></group>
          <text variable="number-of-pages" suffix=" p."/>
          <text macro="access"/>
        </group>
      </else>
    </choose>
  </macro>

  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-cite"/>
        <text macro="year-cite"/>
        <text variable="locator" prefix="p. "/>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="true" et-al-min="100" et-al-use-first="100" entry-spacing="1" line-spacing="1.5">
    <sort><key variable="author"/><key variable="issued"/><key variable="title"/></sort>
    <layout suffix="."><text macro="bib-entry"/></layout>
  </bibliography>
</style>
