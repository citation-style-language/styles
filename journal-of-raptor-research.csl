<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" demote-non-dropping-particle="sort-only" page-range-format="expanded" default-locale="en-US">
  <info>
    <title>Journal of Raptor Research</title>
    <title-short>JRR</title-short>
    <id>http://www.zotero.org/styles/journal-of-raptor-research</id>
    <link href="http://www.zotero.org/styles/journal-of-raptor-research" rel="self"/>
    <link href="https://rapt.kglmeridian.com/fileasset/rapt/04_Full_Formatting_Instructions_030226_CLEAN.docx" rel="documentation"/>
    <link href="https://rapt.kglmeridian.com/" rel="documentation"/>
    <author>
      <name>Michael Stewart</name>
      <uri>https://orcid.org/0000-0002-1913-0046</uri>
    </author>
    <category citation-format="author-date"/>
    <category field="biology"/>
    <issn>0892-1016</issn>
    <eissn>2162-4569</eissn>
    <summary>Author-date citations and references formatted for the Journal of Raptor Research.</summary>
    <updated>2026-10-11T23:15:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="editor" form="long">
        <single>Editor</single>
        <multiple>Editors</multiple>
      </term>
    </terms>
  </locale>
  <!-- In-text author names: "Jones", "Smith and Jones", "Hernandez et al."
       The et-al thresholds are set on the <citation> element below, because
       in CSL 1.0 et-al-min/et-al-use-first are only valid on <name>,
       <citation>, <bibliography>, or <style>, not on <names>. -->
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <!-- Literature Cited names: "Henny, C. J., and M. S. Martell".
       First author inverted, later authors given-name first, comma before "and".
       More than 12 authors: first 11, a comma, then "et al." (thresholds set on
       the <bibliography> element). -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="first" sort-separator=", " initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="always" delimiter-precedes-et-al="always"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="first" sort-separator=", " initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="always" delimiter-precedes-et-al="always"/>
          <label form="long" prefix=", "/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <!-- Year, or "in press" (set "Status: in press" in the Zotero Extra field),
       or "n.d." when no date exists. Year suffixes (2020a, 2020b) are added
       automatically by the citation processor. -->
  <macro name="year">
    <choose>
      <if variable="status">
        <text variable="status"/>
      </if>
      <else-if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </else-if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="author-year">
    <group delimiter=" ">
      <text macro="author"/>
      <text macro="year" prefix="(" suffix=")"/>
    </group>
  </macro>
  <!-- DOI if present, otherwise URL -->
  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi:"/>
      </if>
      <else>
        <text variable="URL"/>
      </else>
    </choose>
  </macro>
  <!-- "Springer, New York, NY, USA" -->
  <macro name="publisher-place">
    <group delimiter=", ">
      <choose>
        <if variable="publisher">
          <text variable="publisher"/>
        </if>
        <else>
          <text variable="authority"/>
        </else>
      </choose>
      <text variable="publisher-place"/>
    </group>
  </macro>
  <!-- "Journal of Raptor Research 52:180&#8211;183" -->
  <macro name="journal-volume-pages">
    <group delimiter=" ">
      <text variable="container-title"/>
      <group delimiter=":">
        <text variable="volume"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>
  <!-- "In Raptor Research and Management Techniques (D. M. Bird and K. L. Bildstein, Editors)" -->
  <macro name="container-in">
    <group delimiter=" ">
      <text term="in" text-case="capitalize-first"/>
      <text variable="container-title"/>
      <names variable="editor" prefix="(" suffix=")">
        <name initialize-with=". " and="text" delimiter=", " delimiter-precedes-last="contextual"/>
        <label form="long" prefix=", "/>
      </names>
    </group>
  </macro>
  <!-- In-text: (Zar 1992, Anderson and Hill 1999, Hill et al. 2020)
       Sorted chronologically, then alphabetically. -->
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year">
    <sort>
      <key macro="year"/>
      <key macro="author-short"/>
      <key variable="title"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter=", ">
      <group delimiter=" ">
        <text macro="author-short"/>
        <text macro="year"/>
      </group>
    </layout>
  </citation>
  <!-- Literature Cited: alphabetical by first author; a single-author work
       precedes multiauthor works by the same senior author; then by year,
       then by title (which also orders the a/b year suffixes). -->
  <bibliography hanging-indent="true" et-al-min="13" et-al-use-first="11">
    <sort>
      <key macro="author"/>
      <key macro="year"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="article-journal article-magazine article-newspaper article" match="any">
          <group delimiter=". ">
            <text macro="author-year"/>
            <text variable="title"/>
            <text macro="journal-volume-pages"/>
            <text macro="access"/>
          </group>
        </if>
        <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
          <group delimiter=". ">
            <text macro="author-year"/>
            <text variable="title"/>
            <text macro="container-in"/>
            <text macro="publisher-place"/>
            <group delimiter=" ">
              <label variable="page" form="short"/>
              <text variable="page"/>
            </group>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="book" match="any">
          <group delimiter=". ">
            <text macro="author-year"/>
            <text variable="title"/>
            <text macro="publisher-place"/>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="thesis" match="any">
          <group delimiter=". ">
            <text macro="author-year"/>
            <text variable="title"/>
            <group delimiter=", ">
              <text variable="genre"/>
              <text variable="publisher"/>
              <text variable="publisher-place"/>
            </group>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="report" match="any">
          <group delimiter=". ">
            <text macro="author-year"/>
            <text variable="title"/>
            <text macro="publisher-place"/>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="webpage post-weblog" match="any">
          <!-- "Title. In Birds of the World (A. F. Poole, Editor). Publisher, Place. doi" -->
          <group delimiter=". ">
            <text macro="author-year"/>
            <text variable="title"/>
            <text macro="container-in"/>
            <text macro="publisher-place"/>
            <text macro="access"/>
          </group>
        </else-if>
        <else>
          <group delimiter=". ">
            <text macro="author-year"/>
            <text variable="title"/>
            <text variable="container-title"/>
            <text macro="publisher-place"/>
            <text variable="page"/>
            <text macro="access"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
