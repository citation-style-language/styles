<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="sort-only" page-range-format="expanded" default-locale="nl-NL">
  <info>
    <title>De Buck (Nederlands)</title>
    <id>http://www.zotero.org/styles/de-buck</id>
    <link href="http://www.zotero.org/styles/de-buck" rel="self"/>
    <link href="http://forums.zotero.org/discussion/13964/style-sheet-de-buck/" rel="documentation"/>
    <author>
      <name>Rombert Stapel</name>
      <email>rombert.stapel@iisg.nl</email>
    </author>
    <author>
      <name>Robin C. Roos</name>
      <uri>https://orcid.org/0009-0007-6836-0036</uri>
    </author>
    <contributor>
      <name>Rintze Zelle</name>
      <uri>https://twitter.com/rintzezelle</uri>
    </contributor>
    <contributor>
      <name>Sebastian Karcher</name>
    </contributor>
    <contributor>
      <name>Frank Bennett</name>
    </contributor>
    <category citation-format="note"/>
    <category field="generic-base"/>
    <category field="history"/>
    <category field="humanities"/>
    <summary>Annotatie en literatuurlijst volgens P. de Buck e.a., Zoeken en schrijven. Handleiding bij het maken van een historisch werkstuk (Haarlem 1982), en J.M. Kamp e.a., Geschiedenis schrijven! Wegwijzer voor historici (Amsterdam 2016). Gebaseerd op "MHRA format with full notes and bibliography"</summary>
    <updated>2026-10-29T16:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="nl-NL">
    <terms>
      <term name="open-quote">‘</term>
      <term name="close-quote">’</term>
      <term name="open-inner-quote">“</term>
      <term name="close-inner-quote">”</term>
      <term name="ibid">ibidem</term>
      <term name="et-al">e.a.</term>
      <term name="editor" form="verb-short">
        <single>ed.</single>
        <multiple>eds.</multiple>
      </term>
      <term name="edition" form="short">druk</term>
      <term name="translator" form="verb-short">vert.</term>
      <term name="volume" form="short">
        <single>vol.</single>
        <multiple>vols.</multiple>
      </term>
      <term name="at">aldaar</term>
      <term name="on">op</term>
      <term name="note" form="long">
        <single>voetnoot</single>
        <multiple>voetnoten</multiple>
      </term>
      <term name="note" form="short">
        <single>noot</single>
        <multiple>noten</multiple>
      </term>
      <term name="sub-verbo" form="short">s.v.</term>
      <term name="folio" form="short">
        <single>f.</single>
        <multiple>ff.</multiple>
      </term>
      <term name="column" form="short">
        <single>col.</single>
        <multiple>coll.</multiple>
      </term>
      <term name="table" form="long">
        <single>tabel</single>
        <multiple>tabellen</multiple>
      </term>
      <term name="letter">persoonlijke correspondentie</term>
      <term name="no-place">s.l.</term>
      <term name="no date">s.d.</term>
      <term name="review-of">recensie van</term>
      <term name="ad"> n.C.</term>
      <term name="bc"> v.C.</term>
      <term name="circa" form="short">ca.</term>
      <term name="original-work-published" form="short">orig.</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author" suffix=", ">
      <name name-as-sort-order="first" and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="after-inverted-name" delimiter-precedes-et-al="after-inverted-name" initialize="false" initialize-with="."/>
      <substitute>
        <choose>
          <if variable="container-title" match="none">
            <names variable="editor" suffix=", ">
              <name name-as-sort-order="first" and="text" delimiter=", " delimiter-precedes-last="after-inverted-name" delimiter-precedes-et-al="after-inverted-name" initialize="false" initialize-with="."/>
              <label form="verb-short" text-case="lowercase" prefix=" "/>
            </names>
          </if>
        </choose>
        <choose>
          <if type="article-newspaper article-magazine" match="any">
            <text variable="container-title" font-style="italic" suffix=", "/>
          </if>
        </choose>
      </substitute>
    </names>
    <text macro="recipient-note" suffix=", "/>
    <text macro="interviewer-note" suffix=", "/>
  </macro>
  <macro name="contributors-note">
    <choose>
      <if variable="author recipient">
        <names variable="author">
          <name and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with="."/>
        </names>
        <text macro="recipient-note" prefix=", " suffix=", "/>
      </if>
      <else-if variable="author interviewer">
        <names variable="author">
          <name and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with="."/>
        </names>
        <text macro="interviewer-note" prefix=", " suffix=", "/>
      </else-if>
      <else>
        <names variable="author" suffix=", ">
          <name and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with="."/>
          <substitute>
            <choose>
              <if variable="container-title" match="none">
                <names variable="editor" suffix=", ">
                  <name and="text" delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with="."/>
                  <label form="verb-short" text-case="lowercase" prefix=" "/>
                </names>
              </if>
            </choose>
          </substitute>
        </names>
        <text macro="recipient-note" suffix=", "/>
        <text macro="interviewer-note" suffix=", "/>
      </else>
    </choose>
  </macro>
  <macro name="title-note">
    <choose>
      <if variable="reviewed-author">
        <group delimiter=" ">
          <text term="review-of"/>
          <text variable="title" quotes="true"/>
          <text term="by"/>
          <names variable="reviewed-author">
            <name and="text" delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with="."/>
          </names>
        </group>
      </if>
      <else-if type="bill book graphic legal_case motion_picture report song classic" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else-if type="thesis speech article" match="any">
        <text variable="title"/>
      </else-if>
      <else-if type="manuscript" match="any">
        <group delimiter=", ">
          <text variable="title" quotes="true"/>
          <choose>
            <if variable="issued">
              <group>
                <choose>
                  <if is-uncertain-date="issued">
                    <text term="circa" form="short" suffix=" "/>
                  </if>
                </choose>
                <date variable="issued">
                  <date-part name="year" range-delimiter="-"/>
                </date>
              </group>
            </if>
          </choose>
        </group>
      </else-if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>
  <macro name="translator">
    <names variable="translator">
      <label form="verb-short" text-case="lowercase" suffix=" "/>
      <name and="text" delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with="."/>
    </names>
  </macro>
  <macro name="editor-translator">
    <group delimiter=", ">
      <choose>
        <if variable="editor" match="any">
          <names variable="editor" delimiter=", ">
            <name and="text" delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with="."/>
            <label form="verb-short" text-case="lowercase" prefix=" "/>
          </names>
        </if>
      </choose>
      <names variable="container-author" delimiter=", ">
        <name and="text" delimiter=", " delimiter-precedes-last="never" initialize="false" initialize-with="."/>
      </names>
    </group>
  </macro>
  <macro name="collection-title">
    <text variable="collection-title"/>
    <text variable="collection-number" prefix=" "/>
  </macro>
  <macro name="locators-note">
    <choose>
      <if type="article-journal">
        <text macro="volume-issue"/>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="volume" form="short"/>
          <text variable="volume"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="volume">
    <choose>
      <if type="article-journal">
        <text variable="volume"/>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="volume" form="short"/>
          <text variable="volume"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="volume-issue">
    <choose>
      <if type="article-journal">
        <choose>
          <if variable="issue">
            <group delimiter=":">
              <text variable="volume"/>
              <text variable="issue"/>
            </group>
          </if>
          <else>
            <text variable="volume"/>
          </else>
        </choose>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="volume" form="short"/>
          <text variable="volume"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="original-info">
    <choose>
      <if variable="original-date original-author original-title original-publisher-place" match="any">
        <group prefix="; " delimiter=" ">
          <text term="original-work-published" form="short"/>
          <group delimiter=", ">
            <choose>
              <if variable="original-author">
                <group delimiter=" ">
                  <names variable="original-author">
                    <name and="text" delimiter=", "/>
                  </names>
                </group>
              </if>
            </choose>
            <text variable="original-title" font-style="italic"/>
            <group delimiter=" ">
              <text variable="original-publisher-place"/>
              <choose>
                <if variable="original-date">
                  <date variable="original-date">
                    <date-part name="year" range-delimiter="-"/>
                  </date>
                </if>
                <else-if variable="original-publisher-place">
                  <text term="no date"/>
                </else-if>
              </choose>
            </group>
          </group>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="issue-note">
    <choose>
      <if type="article-journal">
        <text macro="issued" prefix=" (" suffix=")"/>
      </if>
      <else-if type="article-newspaper">
        <text macro="issued" prefix=", "/>
      </else-if>
      <else-if variable="publisher-place publisher" match="any">
        <group prefix=" (" suffix=")">
          <group delimiter=" ">
            <text macro="edition-note" suffix=";"/>
            <group delimiter=" ">
              <choose>
                <if variable="title" match="none"/>
                <else-if type="thesis">
                  <text variable="genre" suffix=","/>
                  <text variable="publisher" suffix=","/>
                  <text variable="publisher-place"/>
                  <text macro="issued"/>
                </else-if>
                <else-if type="speech">
                  <text variable="genre" suffix=","/>
                  <text macro="event"/>
                  <text macro="issued"/>
                </else-if>
                <else>
                  <text macro="publisher"/>
                  <text macro="issued"/>
                </else>
              </choose>
            </group>
          </group>
          <text macro="original-info"/>
        </group>
      </else-if>
      <else>
        <group prefix=" (" suffix=")">
          <text macro="issued"/>
          <text macro="original-info"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="container-title-note">
    <choose>
      <if type="chapter paper-conference map entry-encyclopedia entry-dictionary" match="any">
        <text term="in" text-case="lowercase" suffix=": "/>
        <text macro="editor-translator" suffix=", "/>
      </if>
    </choose>
    <text variable="container-title" font-style="italic"/>
  </macro>
  <macro name="edition-note">
    <choose>
      <if type="bill book graphic legal_case motion_picture report song chapter paper-conference map classic" match="any">
        <choose>
          <if is-numeric="edition">
            <group delimiter=" ">
              <number variable="edition" form="long-ordinal"/>
              <text term="edition" form="short" strip-periods="true"/>
            </group>
          </if>
          <else>
            <text variable="edition"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="recipient-note">
    <names variable="recipient" delimiter=", ">
      <label form="verb" text-case="lowercase" suffix=" "/>
      <name and="text" delimiter=", " delimiter-precedes-last="never"/>
    </names>
  </macro>
  <macro name="recipient-short">
    <names variable="recipient" delimiter=", ">
      <label form="verb" text-case="lowercase" suffix=" "/>
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
    </names>
  </macro>
  <macro name="contributors-short">
    <choose>
      <if variable="author recipient">
        <names variable="author">
          <name form="short" and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
            <name-part name="family" text-case="capitalize-first"/>
          </name>
        </names>
        <text macro="recipient-short" prefix=", " suffix=", "/>
      </if>
      <else-if variable="author interviewer">
        <names variable="author">
          <name form="short" and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
            <name-part name="family" text-case="capitalize-first"/>
          </name>
        </names>
        <text macro="interviewer-short" prefix=", " suffix=", "/>
      </else-if>
      <else>
        <names variable="author" suffix=", ">
          <name form="short" and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
            <name-part name="family" text-case="capitalize-first"/>
          </name>
          <substitute>
            <choose>
              <if variable="container-title" match="none">
                <names variable="editor" suffix=", ">
                  <name form="short" and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
                    <name-part name="family" text-case="capitalize-first"/>
                  </name>
                  <label form="verb-short" prefix=" " suffix="." strip-periods="true"/>
                </names>
              </if>
            </choose>
            <names variable="translator" suffix=", ">
              <name form="short" and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
                <name-part name="family" text-case="capitalize-first"/>
              </name>
              <label form="verb-short" prefix=" (" suffix=")" strip-periods="false"/>
            </names>
          </substitute>
        </names>
        <text macro="recipient-short" suffix=", "/>
        <text macro="interviewer-short" suffix=", "/>
      </else>
    </choose>
  </macro>
  <macro name="interviewer-note">
    <names variable="interviewer" delimiter=", ">
      <label form="verb" text-case="lowercase" suffix=" "/>
      <name and="text" delimiter=", " delimiter-precedes-last="never"/>
    </names>
  </macro>
  <macro name="interviewer-short">
    <names variable="interviewer" delimiter=", ">
      <label form="verb" text-case="lowercase" suffix=" "/>
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
    </names>
  </macro>
  <macro name="locators-newspaper">
    <choose>
      <if type="article-newspaper">
        <group delimiter=", ">
          <group>
            <text variable="edition" suffix=" "/>
            <text term="edition"/>
          </group>
          <group>
            <text term="section" suffix=" "/>
            <text variable="section" suffix=","/>
          </group>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="event">
    <group>
      <text term="presented at" suffix=" "/>
      <text variable="event"/>
    </group>
  </macro>
  <macro name="publisher">
    <choose>
      <if variable="publisher-place">
        <text variable="publisher-place"/>
      </if>
      <else>
        <text term="no-place"/>
      </else>
    </choose>
  </macro>
  <macro name="issued">
    <choose>
      <if variable="issued">
        <choose>
          <if type="graphic report article-newspaper personal_communication speech" match="any">
            <date variable="issued">
              <date-part name="day" suffix=" " range-delimiter="-"/>
              <date-part name="month" suffix=" " range-delimiter="-"/>
              <date-part name="year" range-delimiter="-"/>
            </date>
          </if>
          <else>
            <choose>
              <if is-uncertain-date="issued">
                <text term="circa" form="short" suffix=" "/>
              </if>
            </choose>
            <date variable="issued">
              <date-part name="year" range-delimiter="-"/>
            </date>
          </else>
        </choose>
      </if>
      <else-if type="classic webpage" match="none">
        <text term="no date"/>
      </else-if>
    </choose>
  </macro>
  <macro name="pages">
    <choose>
      <if type="article-journal">
        <text variable="page" prefix=" "/>
      </if>
      <else>
        <choose>
          <if variable="volume">
            <text variable="page" prefix=" "/>
          </if>
          <else>
            <text variable="page" prefix=" "/>
          </else>
        </choose>
      </else>
    </choose>
  </macro>
  <macro name="point-locators">
    <text macro="pages"/>
    <choose>
      <if type="chapter paper-conference article-journal article-magazine article-newspaper entry-dictionary entry-encyclopedia article" match="any">
        <choose>
          <if locator="page">
            <group prefix=", ">
              <text term="at" suffix=" "/>
              <text variable="locator"/>
            </group>
          </if>
          <else-if locator="folio" match="any">
            <group prefix=", ">
              <text term="at" suffix=" "/>
              <label variable="locator" form="short" prefix=" " suffix=" "/>
              <text variable="locator"/>
            </group>
          </else-if>
          <else-if locator="note paragraph section figure part line table verse" match="any">
            <group prefix=", ">
              <text term="at" suffix=" "/>
              <label variable="locator" form="long" prefix=" " suffix=" "/>
              <text variable="locator"/>
            </group>
          </else-if>
          <else-if locator="sub-verbo">
            <group prefix=", ">
              <text term="at" suffix=" "/>
              <label variable="locator" form="short" suffix=" "/>
              <text variable="locator"/>
            </group>
          </else-if>
          <else>
            <group prefix=", ">
              <text term="at" prefix=" " suffix=" "/>
              <label variable="locator" form="long" prefix=" " suffix=" "/>
              <text variable="locator"/>
            </group>
          </else>
        </choose>
      </if>
      <else-if type="manuscript">
        <choose>
          <if locator="page">
            <text variable="locator"/>
          </if>
          <else>
            <label variable="locator" form="short" suffix=" "/>
            <text variable="locator"/>
          </else>
        </choose>
      </else-if>
      <else>
        <choose>
          <if locator="folio">
            <label variable="locator" form="short" prefix=" " suffix=" "/>
            <text variable="locator"/>
          </if>
          <else-if locator="note">
            <group prefix=", ">
              <label variable="locator" form="long" suffix=" "/>
              <text variable="locator"/>
            </group>
          </else-if>
          <else-if locator="column">
            <group prefix=", ">
              <label variable="locator" form="short" suffix=" "/>
              <text variable="locator"/>
            </group>
          </else-if>
          <else-if locator="rule">
            <group prefix=", ">
              <label variable="locator" form="short" suffix=" "/>
              <text variable="locator"/>
            </group>
          </else-if>
          <else-if locator="paragraph section line verse" match="any">
            <group prefix=", ">
              <text term="at" suffix=" "/>
              <label variable="locator" form="long" prefix=" " suffix=" "/>
              <text variable="locator"/>
            </group>
          </else-if>
          <else-if locator="table figure" match="any">
            <group prefix=", ">
              <text term="at" prefix=" " suffix=" "/>
              <label variable="locator" form="long" prefix=" " suffix=" "/>
              <text variable="locator"/>
            </group>
          </else-if>
          <else-if locator="sub-verbo">
            <group prefix=", ">
              <label variable="locator" form="short" suffix=" "/>
              <text variable="locator"/>
            </group>
          </else-if>
          <else>
            <text variable="locator" prefix=" "/>
          </else>
        </choose>
      </else>
    </choose>
  </macro>
  <macro name="archive-note">
    <group delimiter=", ">
      <choose>
        <if variable="archive-place">
          <text variable="archive-place"/>
        </if>
        <else>
          <text variable="publisher-place"/>
        </else>
      </choose>
      <text variable="archive"/>
      <text variable="collection-title" font-style="italic"/>
      <text variable="archive_location"/>
      <choose>
        <if variable="call-number">
          <group>
            <text variable="call-number"/>
          </group>
        </if>
        <else-if variable="number">
          <group delimiter=" ">
            <text value="inv.nr."/>
            <text variable="number"/>
          </group>
        </else-if>
      </choose>
    </group>
  </macro>
  <macro name="access-note">
    <group delimiter=", ">
      <choose>
        <if type="book article-journal article-magazine thesis chapter manuscript paper-conference entry-encyclopedia entry-dictionary" match="none">
          <group delimiter=", " prefix=", ">
            <text variable="archive"/>
            <text variable="archive_location"/>
          </group>
        </if>
      </choose>
    </group>
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix=". doi:"/>
      </if>
      <else>
        <text variable="URL" prefix=". "/>
        <group prefix=" (" suffix=")">
          <text term="accessed" text-case="lowercase" suffix=" "/>
          <date variable="accessed" form="text"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="short-title-note">
    <choose>
      <if type="bill book graphic legal_case motion_picture report song classic" match="any">
        <text variable="title" font-style="italic" form="short"/>
      </if>
      <else-if type="manuscript">
        <group delimiter=", ">
          <text variable="publisher-place"/>
          <text variable="title" form="short"/>
          <text variable="archive_location"/>
        </group>
      </else-if>
      <else-if type="thesis speech article" match="any">
        <text variable="title" form="short"/>
      </else-if>
      <else>
        <text variable="title" quotes="true" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="point-locators-subsequent">
    <choose>
      <if locator="page">
        <text variable="locator"/>
      </if>
      <else-if locator="folio">
        <label variable="locator" form="short" suffix=" "/>
        <text variable="locator"/>
      </else-if>
      <else-if locator="note">
        <label variable="locator" form="long" suffix=" "/>
        <text variable="locator"/>
      </else-if>
      <else-if locator="sub-verbo">
        <label variable="locator" form="short" suffix=" "/>
        <text variable="locator"/>
      </else-if>
      <else-if locator="rule">
        <label variable="locator" form="short" suffix=" "/>
        <text variable="locator"/>
      </else-if>
      <else-if locator="column">
        <label variable="locator" form="short" suffix=" "/>
        <text variable="locator"/>
      </else-if>
      <else-if locator="table figure" match="any">
        <group>
          <label variable="locator" form="long" prefix=" " suffix=" "/>
          <text variable="locator"/>
        </group>
      </else-if>
      <else-if locator="paragraph section line verse" match="any">
        <group>
          <label variable="locator" form="long" prefix=" " suffix=" "/>
          <text variable="locator"/>
        </group>
      </else-if>
      <else-if type="manuscript">
        <choose>
          <if locator="page">
            <text variable="locator"/>
