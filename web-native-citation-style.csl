<?xml version="1.0" encoding="UTF-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Web-Native Citation Style</title>
    <title-short>Web-Native (numeric citations)</title-short>
    <id>http://www.zotero.org/styles/web-native-citation-style</id>
    <link rel="self" href="http://www.zotero.org/styles/web-native-citation-style"/>
    <link rel="documentation" href="https://citekit.com/web-native-citation-style/"/>
    <author>
      <name>CiteKit Publishing Technologies</name>
    </author>
    <summary>General-purpose citation style for web publishing, using individually bracketed numeric citations and title-first references across digital and traditional media.</summary>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <updated>2026-10-12T15:51:31+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <citation>
    <layout delimiter="">
      <text variable="citation-number" prefix="[" suffix="]"/>
    </layout>
  </citation>

  <macro name="author-names">
    <names variable="author">
      <name form="long" initialize="false" delimiter=", "/>
    </names>
  </macro>
  <macro name="editor-names">
    <names variable="editor">
      <name form="long" initialize="false" delimiter=", "/>
      <label form="long" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="director-names">
    <names variable="director">
      <name form="long" initialize="false" delimiter=", "/>
      <label form="long" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="script-writer-names">
    <names variable="script-writer">
      <name form="long" initialize="false" delimiter=", "/>
      <label form="long" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="producer-names">
    <names variable="producer">
      <name form="long" initialize="false" delimiter=", "/>
      <label form="long" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="performer-names">
    <names variable="performer">
      <name form="long" initialize="false" delimiter=", "/>
      <label form="long" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="host-names">
    <names variable="host">
      <name form="long" initialize="false" delimiter=", "/>
      <label form="long" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="composer-names">
    <group delimiter="">
      <names variable="composer">
        <name form="long" initialize="false" delimiter=", "/>
      </names>
      <text value=" (composer)"/>
    </group>
  </macro>
  <macro name="narrator-names">
    <names variable="narrator">
      <name form="long" initialize="false" delimiter=", "/>
      <label form="long" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="guest-names">
    <names variable="guest">
      <name form="long" initialize="false" delimiter=", "/>
      <label form="long" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <macro name="creators">
    <group delimiter=", ">
      <text macro="author-names"/>
      <choose>
        <if type="chapter" match="none">
          <text macro="editor-names"/>
        </if>
      </choose>
      <text macro="director-names"/>
      <text macro="script-writer-names"/>
      <text macro="producer-names"/>
      <text macro="performer-names"/>
      <text macro="host-names"/>
      <text macro="composer-names"/>
      <text macro="narrator-names"/>
      <text macro="guest-names"/>
    </group>
  </macro>

  <macro name="source-url">
    <choose>
      <if variable="URL">
        <text variable="URL"/>
      </if>
      <else-if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </else-if>
    </choose>
  </macro>

  <macro name="platform-publisher">
    <choose>
      <if type="broadcast">
        <group delimiter=", ">
          <text variable="container-title"/>
          <number variable="volume" prefix="Season "/>
          <number variable="number" prefix="Episode "/>
          <text variable="publisher"/>
        </group>
      </if>
      <else-if type="software dataset" match="any">
        <group delimiter=", ">
          <text variable="publisher"/>
          <group delimiter="">
            <text term="version" text-case="capitalize-first" suffix=" "/>
            <text variable="version"/>
          </group>
        </group>
      </else-if>
      <else-if type="webpage post-weblog" match="any">
        <choose>
          <if variable="container-title"><text variable="container-title"/></if>
          <else><text variable="publisher"/></else>
        </choose>
      </else-if>
      <else-if type="song">
        <group delimiter=", ">
          <text variable="container-title"/>
          <text variable="publisher"/>
        </group>
      </else-if>
      <else-if type="chapter">
        <group delimiter=", ">
          <text variable="container-title"/>
          <text macro="editor-names"/>
          <text variable="publisher"/>
        </group>
      </else-if>
      <else-if type="article-journal article-magazine article-newspaper paper-conference" match="any">
        <choose>
          <if variable="container-title"><text variable="container-title"/></if>
          <else><text variable="publisher"/></else>
        </choose>
      </else-if>
      <else>
        <choose>
          <if variable="publisher"><text variable="publisher"/></if>
          <else><text variable="container-title"/></else>
        </choose>
      </else>
    </choose>
  </macro>

  <macro name="publication-date">
    <date variable="issued" prefix="Published: ">
      <date-part name="month" form="long" suffix=" "/>
      <date-part name="day" suffix=", "/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="access-date">
    <group delimiter="">
      <text term="accessed" text-case="capitalize-first" suffix=": "/>
      <date variable="accessed">
        <date-part name="month" form="long" suffix=" "/>
        <date-part name="day" suffix=", "/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>

  <bibliography second-field-align="flush" entry-spacing="1">
    <layout>
      <text variable="citation-number" suffix=". "/>
      <group delimiter=". ">
        <text variable="title"/>
        <text macro="source-url"/>
        <text macro="creators"/>
        <text macro="platform-publisher"/>
        <text macro="publication-date"/>
        <text macro="access-date"/>
      </group>
    </layout>
  </bibliography>
</style>
