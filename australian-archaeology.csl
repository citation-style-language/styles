<?xml version='1.0' encoding='UTF-8'?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-GB">
  <info>
    <title>Australian Archaeology</title>
    <title-short>AAA</title-short>
    <id>http://www.zotero.org/styles/australian-archaeology</id>
    <link href="http://www.zotero.org/styles/australian-archaeology" rel="self"/>
    <link href="http://www.zotero.org/styles/ecology" rel="template"/>
    <link href="https://australianarchaeologicalassociation.com.au/our-journal/" rel="documentation"/>
    <author>
      <name>Patrick O'Brien</name>
    </author>
    <contributor>
      <name>Mick Morrison</name>
      <email>mick.morrison@une.edu.au</email>
    </contributor>
    <category citation-format="author-date"/>
    <category field="anthropology"/>
    <category field="history"/>
    <category field="humanities"/>
    <issn>0312-2417</issn>
    <eissn>2470-0363</eissn>
    <updated>2026-11-20T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds</multiple>
      </term>
    </terms>
  </locale>
  <macro name="container-contributors">
    <names variable="editor" prefix="In " suffix=", ">
      <name and="text" delimiter=", " delimiter-precedes-last="never" initialize-with="."/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="author">
    <choose>
      <if type="article-newspaper">
        <choose>
          <if variable="author">
            <names variable="author">
              <name and="text" delimiter=", " delimiter-precedes-last="never" initialize-with="." name-as-sort-order="first"/>
            </names>
          </if>
          <else>
            <group delimiter=" ">
              <text variable="container-title"/>
              <text variable="publisher-place" prefix="(" suffix=")"/>
            </group>
          </else>
        </choose>
      </if>
      <else>
        <names variable="author">
          <name and="text" delimiter=", " delimiter-precedes-last="never" initialize-with="." name-as-sort-order="first"/>
          <substitute>
            <names variable="editor">
              <name and="text" delimiter=", " delimiter-precedes-last="never" initialize-with="." name-as-sort-order="first"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
            <names variable="translator"/>
            <text variable="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="author-short">
    <choose>
      <if type="article-newspaper">
        <choose>
          <if variable="author">
            <names variable="author">
              <name form="short" and="text" delimiter=", "/>
            </names>
          </if>
          <else>
            <group delimiter=" ">
              <text variable="container-title"/>
              <text variable="publisher-place" prefix="[" suffix="]"/>
            </group>
          </else>
        </choose>
      </if>
      <else>
        <names variable="author">
          <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
          <substitute>
            <names variable="editor">
              <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
              <label form="short" prefix=" [" suffix="]"/>
            </names>
            <names variable="translator"/>
            <text variable="title" form="short"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="access">
    <group delimiter=" ">
      <text value="Retrieved"/>
      <date variable="accessed" form="text"/>
      <text value="from"/>
      <text variable="URL" prefix="&lt; " suffix=" &gt;"/>
    </group>
  </macro>
  <macro name="issued">
    <text macro="issued-year"/>
  </macro>
  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if variable="edition">
        <group prefix="(" suffix=")">
          <text variable="edition"/>
          <text value="edn" prefix=" "/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="citation-locator">
    <text variable="locator" prefix=":"/>
  </macro>
  <macro name="title">
    <choose>
      <if type="book">
        <text variable="title" text-case="title" font-style="italic"/>
      </if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>
  <macro name="publication-details">
    <choose>
      <if type="article-journal article-magazine" match="any">
        <group delimiter=" ">
          <text variable="container-title" font-style="italic"/>
          <group delimiter=":">
            <group delimiter="">
              <text variable="volume"/>
              <text variable="issue" prefix="(" suffix=")"/>
            </group>
            <text variable="page"/>
          </group>
        </group>
      </if>
      <else-if type="chapter paper-conference" match="any">
        <group delimiter=". ">
          <group delimiter="">
            <text macro="container-contributors"/>
            <group delimiter=", ">
              <text variable="container-title" font-style="italic"/>
              <group delimiter="">
                <text value="pp."/>
                <text variable="page"/>
              </group>
            </group>
          </group>
          <group delimiter=": ">
            <text variable="publisher-place"/>
            <text variable="publisher"/>
          </group>
        </group>
      </else-if>
      <else-if type="thesis">
        <group delimiter=", ">
          <group delimiter=" ">
            <text value="Unpublished"/>
            <text variable="genre"/>
          </group>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
        </group>
      </else-if>
      <else-if type="report">
        <group delimiter=" ">
          <text variable="genre"/>
          <text variable="publisher" prefix="prepared for "/>
        </group>
      </else-if>
      <else-if type="book">
        <group delimiter=": ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
      </else-if>
      <else-if type="dataset">
        <group delimiter=". ">
          <text variable="publisher"/>
          <text value="Dataset"/>
        </group>
      </else-if>
      <else-if type="map">
        <group delimiter=" ">
          <text variable="scale"/>
          <text value="[Map]"/>
        </group>
      </else-if>
      <else-if type="manuscript">
        <group delimiter=". ">
          <text variable="archive"/>
          <text variable="archive_location"/>
        </group>
      </else-if>
      <else>
        <text variable="container-title"/>
      </else>
    </choose>
  </macro>
  <macro name="identifiers">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>
  <macro name="newspaper-date">
    <date variable="issued" delimiter=" ">
      <date-part name="day"/>
      <date-part name="month" form="long"/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="newspaper-details">
    <group delimiter="">
      <text variable="title" suffix=", "/>
      <text variable="page" prefix="p."/>
    </group>
  </macro>
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year" cite-group-delimiter=", " disambiguate-add-givenname="true" givenname-disambiguation-rule="primary-name">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout delimiter="; " prefix="(" suffix=")">
      <group>
        <group delimiter=" ">
          <text macro="author-short"/>
          <text macro="issued-year"/>
        </group>
        <text macro="citation-locator"/>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="false" entry-spacing="1" line-spacing="1" et-al-min="6" et-al-use-first="4" et-al-use-last="true">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout suffix="">
      <choose>
        <if type="article-newspaper">
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="newspaper-date"/>
          </group>
          <text macro="newspaper-details" prefix=". " suffix="."/>
          <text macro="identifiers" prefix=" "/>
        </if>
        <else-if type="manuscript">
          <group delimiter=" ">
            <text macro="author"/>
            <date variable="issued" prefix="(" suffix=")">
              <date-part name="day" suffix=" "/>
              <date-part name="month" form="long" suffix=" "/>
              <date-part name="year"/>
            </date>
          </group>
          <text variable="title" prefix=". " suffix="."/>
          <text macro="publication-details" prefix=" " suffix="."/>
        </else-if>
        <else>
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="issued"/>
            <group delimiter="">
              <text macro="title"/>
              <text macro="edition" prefix=" "/>
            </group>
          </group>
          <choose>
            <if type="webpage post post-weblog" match="any">
              <text macro="access" prefix=". " suffix="."/>
            </if>
            <else>
              <text macro="publication-details" prefix=". " suffix="."/>
              <text macro="identifiers" prefix=" "/>
            </else>
          </choose>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
