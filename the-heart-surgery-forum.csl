<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" page-range-format="expanded" default-locale="en-US">
  <!-- Drafted with AI assistance (Claude Sonnet 5, Anthropic) on 6 September 2026, from the journal's
       EndNote (.ens) style and its published author instructions/sample references. The output was
       tested against citeproc-js and validated against the CSL 1.0 schema, then reviewed by the author. -->
  <info>
    <title>The Heart Surgery Forum</title>
    <title-short>HSF</title-short>
    <id>http://www.zotero.org/styles/the-heart-surgery-forum</id>
    <link href="http://www.zotero.org/styles/the-heart-surgery-forum" rel="self"/>
    <link href="https://www.imrpress.com/journal/HSF/page/instructions" rel="documentation"/>
    <author>
      <name>Delphine Szecel</name>
      <uri>https://orcid.org/0000-0001-5728-7338</uri>
    </author>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <issn>1098-3511</issn>
    <eissn>1522-6662</eissn>
    <summary>Numeric bracketed style for The Heart Surgery Forum. Authors listed in full up to 6; 7+ authors truncated to first 6 + et al. Journal titles not abbreviated. DOIs appended when available.</summary>
    <updated>2026-09-06T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- ============ NAME FORMATTING ============ -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", " delimiter-precedes-last="never" et-al-min="7" et-al-use-first="6"/>
      <et-al font-style="normal"/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>
  <!-- ============ SHARED PIECES ============ -->
  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
    </choose>
  </macro>
  <macro name="language-note">
    <choose>
      <if variable="language">
        <text variable="language" prefix="(In " suffix=")"/>
      </if>
    </choose>
  </macro>
  <macro name="author-title">
    <group delimiter=". " suffix=".">
      <text macro="author"/>
      <text variable="title"/>
    </group>
  </macro>
  <!-- ============ JOURNAL ARTICLE ============ -->
  <macro name="journal-article">
    <group delimiter=" ">
      <group delimiter=". " suffix=".">
        <text macro="author"/>
        <text variable="title"/>
        <text variable="container-title" form="long"/>
      </group>
      <group delimiter="; " suffix=".">
        <date variable="issued">
          <date-part name="year"/>
        </date>
        <group delimiter=": ">
          <text variable="volume"/>
          <text variable="page"/>
        </group>
      </group>
      <text macro="doi"/>
      <text macro="language-note"/>
    </group>
  </macro>
  <!-- ============ BOOK / CHAPTER ============ -->
  <macro name="book">
    <group delimiter=" ">
      <text macro="author-title"/>
      <choose>
        <if variable="edition">
          <text variable="edition" suffix=" edn."/>
        </if>
      </choose>
      <group delimiter=": " suffix=".">
        <text variable="publisher"/>
        <text variable="publisher-place"/>
      </group>
      <date variable="issued" suffix=".">
        <date-part name="year"/>
      </date>
    </group>
  </macro>
  <!-- ============ PATENT ============ -->
  <macro name="patent">
    <group delimiter=" ">
      <group delimiter="; " suffix=".">
        <group delimiter=", ">
          <names variable="author">
            <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", " delimiter-precedes-last="never" et-al-min="7" et-al-use-first="6"/>
          </names>
          <text value="inventors"/>
        </group>
        <group delimiter=", ">
          <text variable="authority"/>
          <text value="assignee"/>
        </group>
      </group>
      <text variable="title" suffix="."/>
      <group delimiter=": " suffix=".">
        <text variable="jurisdiction"/>
        <group delimiter=" ">
          <text value="United States patent"/>
          <text variable="number"/>
        </group>
      </group>
      <date variable="issued" suffix=".">
        <date-part name="day"/>
        <date-part name="month" form="short" prefix=" "/>
        <date-part name="year" prefix=" "/>
      </date>
    </group>
  </macro>
  <!-- ============ WEBPAGE ============ -->
  <macro name="webpage">
    <group delimiter=" ">
      <text macro="author-title"/>
      <group delimiter=", " suffix=".">
        <text variable="container-title"/>
        <date variable="issued">
          <date-part name="day"/>
          <date-part name="month" prefix=" "/>
          <date-part name="year" prefix=" "/>
        </date>
      </group>
      <text value="Available at:"/>
      <text variable="URL"/>
      <group prefix="(" suffix=")" delimiter=": ">
        <text term="accessed" text-case="capitalize-first"/>
        <date variable="accessed">
          <date-part name="day"/>
          <date-part name="month" prefix=" "/>
          <date-part name="year" prefix=" "/>
        </date>
      </group>
    </group>
  </macro>
  <!-- ============ FALLBACK (anything else) ============ -->
  <macro name="generic">
    <group delimiter=" ">
      <text macro="author-title"/>
      <date variable="issued" suffix=".">
        <date-part name="year"/>
      </date>
      <text macro="doi"/>
    </group>
  </macro>
  <!-- ============ CITATION (in text) ============ -->
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <!-- ============ BIBLIOGRAPHY ============ -->
  <bibliography>
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <text macro="journal-article"/>
        </if>
        <else-if type="book chapter thesis report" match="any">
          <text macro="book"/>
        </else-if>
        <else-if type="patent">
          <text macro="patent"/>
        </else-if>
        <else-if type="webpage post-weblog" match="any">
          <text macro="webpage"/>
        </else-if>
        <else>
          <text macro="generic"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
