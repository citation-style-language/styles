<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="never" default-locale="fi-FI">
  <info>
    <title>Viittaaminen kotimaisissa oikeustieteellisissä julkaisuissa (pitkä alaviite, av nro, suomi)</title>
    <title-short>Oikeustiede (pitkä alaviite)</title-short>
    <id>http://www.zotero.org/styles/viittaaminen-kotimaisissa-oikeustieteellisissa-julkaisuissa-pitka-alaviite</id>
    <link href="http://www.zotero.org/styles/viittaaminen-kotimaisissa-oikeustieteellisissa-julkaisuissa-pitka-alaviite" rel="self"/>
    <link href="https://static1.squarespace.com/static/60069f286f0b7e66aaa9d673/t/64245c1317a5770774443b03/1680104468492/Viittaaminen-kotimaisissa-oikeustieteellisissa%CC%88-julkaisuissa.pdf" rel="documentation"/>
    <link href="https://www.lakimiesyhdistys.fi/wp-content/uploads/2025/04/LM-kirjoittajaohjeet-290425.pdf" rel="documentation"/>
    <link href="https://ulapland.fi/wp-content/uploads/sites/3/2025/07/Oikeustieteiden-kirjallisten-toiden-tekniset-ohjeet.pdf" rel="documentation"/>
    <link href="http://www.zotero.org/styles/oscola" rel="template"/>
    <author>
      <name>Otava Piha</name>
      <uri>https://orcid.org/0000-0002-9455-1836</uri>
    </author>
    <category citation-format="note"/>
    <category field="law"/>
    <summary>Viittaustyyli pitkää ensimmäistä alaviitettä käyttäville oikeustieteen julkaisuille, esim. Oikeus-, Lakimies ja Defensor Legis-lehdille.</summary>
    <updated>2026-08-29T16:57:57+01:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale>
    <terms>
      <term name="volume" form="short"></term>
      <term name="chapter" form="short">
        <single>luku</single>
        <multiple>luvut</multiple>
      </term>
      <term name="paragraph" form="short">
        <single>kappale</single>
        <multiple>kappaleet</multiple>
      </term>
      <term name="section" form="short">§</term>
      <term name="note" form="short">
        <single>kohta</single>
        <multiple>kohdat</multiple>
      </term>
      <term name="edition" form="short">painos</term>
      <term name="editor" form="short">toim.</term>
    </terms>
  </locale>
  <!--Authors and Persons-->
  <macro name="author-note">
    <choose>
      <if type="interview">
        <group delimiter=", ">
          <names variable="interviewer">
            <name delimiter=", " initialize="false" initialize-with=""/>
          </names>
          <names variable="author" prefix="Interview with ">
            <name delimiter-precedes-last="never" and="text" delimiter=", " initialize="false" initialize-with=""/>
          </names>
        </group>
      </if>
      <else-if type="personal_communication">
        <group delimiter=" ">
          <group delimiter=" from ">
            <text variable="genre"/>
            <names variable="author">
              <name delimiter-precedes-last="never" and="text" delimiter=", " initialize="false" initialize-with=""/>
            </names>
          </group>
          <names variable="recipient" prefix="to ">
            <name delimiter-precedes-last="never" and="text" delimiter=", " initialize="false" initialize-with=""/>
          </names>
        </group>
      </else-if>
      <else-if type="article-newspaper">
        <group delimiter=" ">
          <text variable="container-title"/>
          <names variable="author" prefix="(" suffix=")">
            <name initialize="false" initialize-with="."/>
          </names>
        </group>
      </else-if>
      <else-if type="bill legal_case" match="any">
        <text variable="authority"/>
      </else-if>
      <else-if type="legislation treaty" match="any">
      </else-if>
      <else-if type="report">
            <group delimiter=" ">
            <text variable="publisher"/>
            <names variable="author" prefix="(" suffix=")">
              <name delimiter=", " initialize="false"/>
            </names>
            </group>
      </else-if>
      <else>
        <names variable="author">
          <name delimiter=" – " initialize="false" initialize-with="."/>
          <label form="short" prefix=" (" suffix=")"/>
          <substitute>
            <names variable="editor"/>
            <names variable="translator"/>
            <text macro="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="author-short">
    <choose>
      <if type="interview">
        <group delimiter=" – ">
          <names variable="interviewer">
            <name form="short" delimiter=" – " initialize="false" initialize-with="."/>
          </names>
          <names variable="author" prefix="Interview with ">
            <name delimiter-precedes-last="never" and="text" form="short" delimiter=", " initialize="false" initialize-with="."/>
          </names>
        </group>
      </if>
      <else-if type="personal_communication">
        <group delimiter=" ">
          <group delimiter=" from ">
            <text variable="genre"/>
            <names variable="author">
              <name delimiter=", " form="short" initialize="false" initialize-with="."/>
            </names>
          </group>
          <names variable="recipient" prefix="to ">
            <name delimiter-precedes-last="never" and="text" delimiter=", " initialize="false" form="short" initialize-with=""/>
          </names>
        </group>
      </else-if>
      <else-if type="report">
            <text variable="publisher"/>
      </else-if>
      <else-if type="article-newspaper">
        <text variable="container-title"/>
      </else-if>
      <else-if type="bill legal_case" match="any">
        <text variable="authority"/>
      </else-if>
      <else-if type="legislation treaty" match="any">
      </else-if>
      <else>
        <names variable="author">
          <name delimiter-precedes-last="never" delimiter=" – " form="short"/>
          <substitute>
            <names variable="editor"/>
            <names variable="translator"/>
            <text macro="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="author">
    <choose>
      <if type="interview">
        <group delimiter=", ">
          <names variable="interviewer">
            <name delimiter-precedes-last="never" and="text" delimiter=", " initialize-with="." name-as-sort-order="all" sort-separator=", "/>
          </names>
          <names variable="author" prefix="Interview with ">
            <name delimiter-precedes-last="never" and="text" delimiter=", " initialize="false" initialize-with="."/>
          </names>
        </group>
      </if>
      <else-if type="personal_communication">
        <group delimiter=" ">
          <group delimiter=", ">
            <names variable="author">
              <name delimiter-precedes-last="never" and="text" delimiter=", " initialize-with="" name-as-sort-order="all" sort-separator=", "/>
            </names>
            <text variable="genre"/>
          </group>
          <names variable="recipient" prefix="to ">
            <name delimiter-precedes-last="never" and="text" delimiter=", " initialize="false" initialize-with=""/>
          </names>
        </group>
      </else-if>
      <else-if type="article-newspaper">
        <group delimiter=" ">
          <text variable="container-title"/>
          <names variable="author" prefix="(" suffix=")"> 
            <name delimiter=", " initialize="false" initialize-with="."/>
          </names>
        </group>
      </else-if>
      <else-if type="bill legal_case" match="any">
        <text variable="authority"/>
      </else-if>
      <else-if type="legislation treaty" match="any">
      </else-if>
      <else-if type="report">
            <group delimiter=" ">
            <text variable="publisher"/>
            <names variable="author" prefix="(" suffix=")">
              <name delimiter=", " initialize="false"/>
            </names>
            </group>
      </else-if>
      <else>
        <names variable="author">
          <name delimiter=" – " initialize="false" initialize-with="." name-as-sort-order="all" sort-separator=", "/>
          <label form="short" prefix=" (" suffix=")"/>
          <substitute>
            <names variable="editor"/>
            <names variable="translator"/>
            <text macro="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="editor">
    <choose>
      <if type="chapter paper-conference entry-encyclopedia" match="none">
        <names variable="editor translator container-author" delimiter=", ">
          <name delimiter=" – " initialize="false" initialize-with="."/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </if>
    </choose>
  </macro>
  <macro name="editor-chapter">
    <group>
      <text term="in" suffix=" "/>
      <names variable="editor translator container-author" delimiter=", ">
        <name delimiter=" – " initialize="false" initialize-with="."/>
        <label form="short" prefix=" (" suffix=")"/>
      </names>
    </group>
  </macro>
  <!-- Titles -->
  <macro name="title">
    <choose>
      <if type="legislation treaty">
        <group delimiter=" ">
        <text variable="title"/>
        <text variable="number"/>
        </group>
      </if>
      <else-if type="bill">
        <group delimiter=": ">
          <group delimiter=" ">
          <text variable="container-title"/>
          <text variable="volume"/>
          </group>
        <group delimiter=" ">
        <text variable="title"/>
        <text variable="number"/>
        </group>
        </group>
      </else-if>
      <else-if type="report">
        <group delimiter=". ">
          <text variable="title"/>
          <group delimiter=" ">
          <text variable="genre"/>
            <text variable="number"/>
          </group>
          <group delimiter=" ">
          <text variable="collection-title"/>
            <text variable="collection-number"/>
          </group>
          <choose>
          <if variable="number collection-number" match="none">
            <text macro="issued-year"/>
          </if>
          </choose>
        </group>
      </else-if>
      <else-if type="legal_case">
        <group delimiter=" ">
        <text variable="number"/>
        <text variable="title"/>
        </group>
      </else-if>
      <else-if type="chapter">
        <text variable="title" suffix=", "/>
      </else-if>
      <else>
        <text variable="title" suffix="."/>
      </else>
    </choose>
  </macro>
  <macro name="title-short">
    <choose>
      <if type="book motion_picture" match="any">
        <text variable="title" form="short"/>
      </if>
      <else-if type="bill legislation treaty" match="any">
        <choose>
          <if variable="title-short" match="any">
            <text variable="title-short"/>
          </if>
          <else-if variable="title-short" match="none">
            <group delimiter=" ">
              <text variable="title"/>
              <text variable="number"/>
            </group>
          </else-if>
        </choose>
      </else-if>
      <else-if type="legal_case">
        <choose>
          <if variable="title-short">
            <text variable="title-short"/>
          </if>
          <else-if variable="title">
            <group delimiter=", ">
            <text variable="authority"/>
            <text variable="number"/>
            <text variable="title"/>
            <text macro="case-info"/>
            </group>
          </else-if>
          <else>
            <group delimiter=", ">
            <text variable="authority"/>
            <text variable="number"/>
            </group>
          </else>
        </choose>
      </else-if>
      <else>
        <text variable="title" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="title-short-bill">
    <choose>
    <if type="bill report" match="any">
      <text variable="title-short"/>
    </if>
    </choose>
  </macro>
  <!--Dates-->
  <macro name="issued-year">
      <date variable="issued" form="text" date-parts="year"/>
      <text variable="year-suffix"/>
  </macro>
  <macro name="issued-full">
    <date variable="issued" form="numeric"/>
  </macro>
  <macro name="date-parenthesis">
    <choose>
      <if type="article-magazine" match="any">
        <choose>
          <if variable="number authority" match="all">
            <text macro="issued-year" prefix="[" suffix="]"/>
          </if>
          <else-if variable="volume">
            <text macro="issued-year" prefix="(" suffix=")"/>
          </else-if>
          <else-if variable="container-title volume number" match="any">
            <!--no year in square brackets for unreported case w/o medium neutral citation-->
            <text macro="issued-year" prefix="[" suffix="]"/>
          </else-if>
        </choose>
      </if>
    </choose>
  </macro>
  <!--publication info -->
  <macro name="publisher">
    <choose>
      <if type="book chapter broadcast document personal_communication manuscript paper-conference motion_picture speech interview thesis entry-encyclopedia webpage post-weblog article" match="any">
        <group delimiter=" ">
          <group delimiter=". ">
            <choose>
              <if type="broadcast personal_communication" match="any">
                <date variable="issued" form="text"/>
              </if>
              <else-if type="bill" match="any">
                <text variable="container-title"/>
              </else-if>
              <else>
                <text macro="editor"/>
                <choose>
                  <if variable="collection-title" match="any">
                    <group delimiter=" ">
                    <text variable="collection-title"/>
                    <text variable="collection-number"/>
                    </group>
                  </if>
                  <else-if variable="genre" match="any">
                    <group delimiter=" ">
                    <text variable="genre"/>
                    <text variable="number"/>
                    </group>
                  </else-if>
                </choose>
                <choose>
                  <!--if none of these, this we don't want edition either. Might be Loose-Leaf-->
                  <if variable="publisher issued genre container-title" match="any">
                    <text macro="edition"/>
                  </if>
                </choose>
                <choose>
                  <if type="speech">
                    <text variable="event"/>
                    <text variable="event-place"/>
                    <text macro="issued-full"/>
                  </if>
                  <else-if type="thesis" match="any">
                    <text variable="genre" strip-periods="true"/>
                    <group delimiter=" ">
                      <text variable="publisher" strip-periods="true"/>
                      <text macro="issued-year"/>
                    </group>
                  </else-if>
                  <else-if type="webpage post-weblog" match="any">
                    <text variable="container-title"/>
                    <text macro="issued-full"/>
                  </else-if>
                  <else-if type="interview" match="any">
                    <text macro="issued-full"/>
                  </else-if>
                  <else-if type="article" match="any">
                    <text variable="publisher" strip-periods="true"/>
                    <text macro="issued-full"/>
                  </else-if>
                  <else>
                    <group delimiter=" ">
                      <text variable="publisher"/>
                      <text macro="issued-year"/>
                    </group>
                  </else>
                </choose>
              </else>
            </choose>
          </group>
          <choose>
            <if type="interview manuscript" match="any">
              <group delimiter=" ">
                <text variable="genre"/>
                <text variable="number"/>
              </group>
            </if>
          </choose>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="looseleaf-note">
    <choose>
      <if type="book">
        <choose>
          <if variable="publisher issued" match="none">
            <choose>
              <if variable="locator">
                <group delimiter=" ">
                  <label variable="locator" form="short" strip-periods="true"/>
                  <text variable="locator"/>
                  <text variable="edition" prefix="(" suffix=")"/>
                </group>
              </if>
            </choose>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <label variable="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="book-container">
    <choose>
      <if type="chapter paper-conference entry-encyclopedia" match="any">
        <group>
          <text variable="page" prefix="s. "/>
          <text macro="editor-chapter" prefix=" "/>
          <text variable="container-title" prefix=", " suffix="."/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="bill-number">
    <choose>
      <if type="bill">
        <text variable="number" prefix="[" suffix="]"/>
      </if>
    </choose>
  </macro>
  <macro name="article-info">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <group delimiter=" ">
            <choose>
              <if type="article-magazine article-newspaper" match="any">
                <date variable="issued" form="numeric"/>
              </if>
              <else>
                <text variable="container-title"/>
                <choose>
                  <if variable="volume" match="any">
                  <group delimiter="">
                    <text variable="volume"/>
                    <text variable="issue" prefix="(" suffix=")"/>
                  </group>
                    <text macro="issued-year"/>
                  </if>
                  <else>
                    <group delimiter="">
                      <text variable="issue" suffix="/"/>
                      <text macro="issued-year"/>
                    </group>
                  </else>
                </choose>
              </else>
            </choose>
          </group>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="case-info">
    <choose>
      <if type="legal_case">
        <group delimiter=" ">
         <text variable="references"/>
         <text macro="issued-full"/>
         <text variable="container-title"/>
         <text variable="volume"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="pages">
    <choose>
      <if type="bill legislation chapter report paper-conference legal_case" match="none">
        <text variable="page" prefix=" s. "/>
      </if>
    </choose>
  </macro>
  <macro name="locator-basic">
    <choose>
      <if type="article-journal" position="first">
            <text variable="locator"/>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="locator-space">
    <choose>
      <if type="legislation book article-journal article-magazine" match="none">
        <text macro="locator-basic"/>
      </if>
      <else-if type="book">
        <choose>
          <if variable="issued publisher" match="any">
            <text macro="locator-basic"/>
          </if>
        </choose>
      </else-if>
    </choose>
  </macro>
  <macro name="locator-comma">
    <choose>
      <if type="legal_case">
        <choose>
          <if locator="paragraph" match="none">
            <choose>
              <if variable="authority" match="none">
                <text variable="locator"/>
              </if>
              <else-if variable="number container-title volume page" match="all">
                <text variable="locator"/>
              </else-if>
            </choose>
          </if>
        </choose>
      </if>
      <else-if type="book legislation article-journal article-magazine" match="any">
        <text macro="locator-basic"/>
      </else-if>
    </choose>
  </macro>
  <!--Others -->
  <macro name="law-info">
    <choose>
      <if type="legislation">
        <choose>
        <if variable="container-title" match="any">
        <group delimiter=" ">
        <text variable="container-title"/>
        <text variable="title-short" prefix="(" suffix=")"/>
        </group>
        </if>
        <else>
        <group delimiter=" ">
        <text variable="container-title"/>
        <date variable="issued" form="numeric"/>
        </group>
        </else>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="URL">
    <choose>
      <if type="webpage article-magazine article-newspaper post post-weblog dataset document report" match="any">
        <choose>
          <if variable="URL">
            <group delimiter=" ">
              <text variable="URL"/>
              <date variable="accessed" form="numeric" prefix="(" suffix=")"/>
            </group>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="author-count">
    <names variable="author">
      <name form="count"/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>
  <macro name="sort-type">
    <!--Virallislähteet (bill) ensin, sitten tieteelliset lähteet, sitten muut lähteet, sitten oikeuslähteet, sitten lainsäädäntö-->
    <choose>
      <if type="bill">
        <text value="1"/>
      </if>
      <else-if type="book chapter paper-conference article-journal manuscript" match="any">
        <text value="2"/>
      </else-if>
      <else-if type="legal_case">
        <text value="4"/>
      </else-if>
      <else-if type="legislation">
        <text value="5"/>
            <names variable="author"/>
      </else-if>
      <else>
        <text value="3"/>
      </else>
    </choose>
  </macro>
  <macro name="sort-bill">
    <choose>
      <if type="bill">
        <names variable="author"/>
      </if>
    </choose>
  </macro>
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <layout suffix="." delimiter="; ">
      <choose>
        <if position="subsequent">
          <choose>
            <if type="legal_case legislation treaty" match="any">
              <group delimiter=", ">
                <group delimiter=" "> 
                  <text macro="title-short"/>
                  <choose>
                    <if variable="title-short" match="any">
                      <text variable="first-reference-note-number" prefix="(av. " suffix=")"/>
                    </if>
                  </choose>
                </group>
                <text macro="locator-basic"/>
              </group>
            </if>
            <else-if type="article-newspaper">
              <group delimiter=", ">
                <group delimiter=" ">
                  <text macro="author-short"/>
                  <text macro="issued-full"/>
                  <text variable="first-reference-note-number" prefix="(av. " suffix=")"/>
                </group>
               <text macro="locator-basic"/>
              </group>
            </else-if>
            <else-if type="bill">
              <choose>
                <if variable="title-short" match="any">
                  <group delimiter=", ">
                    <text macro="title-short"/>
                    <text macro="locator-basic"/>
                  </group>
                </if>
                <else>
                  <group delimiter=", ">
                    <text macro="author"/>
                    <text macro="title"/>
                    <text macro="locator-basic"/>
                 </group>
                </else>
              </choose>
            </else-if>
            <else-if type="report">
              <choose>
                <if variable="title-short" match="any">
                <group delimiter=", ">
                  <text macro="title-short"/>
                  <text macro="locator-basic"/>
                </group>
                </if>
                <else>
                  <group delimiter=", ">
                    <group delimiter=" ">
                      <text macro="author-short"/>
                      <text macro="issued-year"/>
                      <text variable="first-reference-note-number" prefix="(av. " suffix=")"/>
                    </group>
                  <text macro="locator-basic"/>
                  </group>
                </else>
              </choose>
            </else-if>
            <else>
              <group delimiter=", ">
                <group delimiter=" ">
                  <text macro="author-short"/>
                  <text macro="issued-year"/>
                  <text variable="first-reference-note-number" prefix="(av. " suffix=")"/>
                </group>
                <text macro="locator-basic"/>
              </group>
            </else>
          </choose>
        </if>
        <else>
          <!--general whole citation -->
          <group delimiter=". ">
          <group delimiter=", ">
            <group delimiter=", ">
              <group delimiter=" ">
                <group delimiter=", ">
                  <text macro="author-note"/>
                  <group>
                    <text macro="title"/>
                    <text macro="book-container"/>
                  </group>
                  <text macro="looseleaf-note"/>
                  <text macro="case-info"/>
                </group>
                <group delimiter=" ">
                  <text macro="date-parenthesis"/>
                  <text macro="article-info"/>
                  <text macro="publisher"/>
                </group>
              </group>
              <text macro="law-info"/>
            </group>
            <group delimiter=", ">
              <group delimiter=" ">
                <text macro="pages"/>
                <text macro="locator-space"/>
              </group>
              <text macro="locator-comma"/>
            </group>
            </group>
            <text macro="URL"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography>
    <sort>
      <key macro="sort-type"/>      
      <key macro="sort-bill"/>
      <key macro="author" names-min="1" names-use-first="1"/>
      <key macro="author-count" names-min="2" names-use-first="2"/>
      <key macro="author"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
       <text macro="title-short-bill"/>
       <group delimiter=". ">
        <group delimiter=", ">
          <group delimiter=", ">
            <group delimiter=" ">
              <group delimiter=", ">
                <text macro="author"/>
                <group>
                  <text macro="title"/>
                  <text macro="book-container"/>
                </group>
                <text macro="looseleaf-note"/>
                <text macro="case-info"/>
              </group>
              <group delimiter=" ">
                <text macro="date-parenthesis"/>
                <text macro="article-info"/>
                <text macro="publisher"/>
              </group>
            </group>
            <text macro="law-info"/>
          </group>
          <group delimiter=" ">
            <text macro="pages"/>
          </group>
          </group>
          <text macro="URL"/>
        </group>
        </group>
    </layout>
  </bibliography>
</style>
