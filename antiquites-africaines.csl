<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Style CSL pour la revue Antiquités africaines (système auteur-date)
  ============================================================================

  RENDU ATTENDU
    Citation dans le texte : (Ackermann 2022, p. 312 ; Dasen 2006)
    Bibliographie          : Ackermann G. 2022, « Titre », RA 74, p. 307-348.
                             Dasen V. 2006, « Titre », dans F. Prost, J. Wilgaux (éd.),
                               Titre du volume, Rennes (Histoire), p. 95-113.
                             Naissance 2004, V. Dasen (éd.), Titre complet, Fribourg (…).

  ORGANISATION DU FICHIER
    1. <locale>      : termes propres au style (« dans », « et alii », « éd. »…)
    2. <macro>       : briques réutilisables, regroupées par fonction :
                         noms, titres, dates, publication, pages, accès
    3. <citation>    : forme de l'appel dans le texte
    4. <bibliography>: forme de l'entrée bibliographique

  SAISIE DANS ZOTERO (champs qui pilotent le rendu)
    - Particules : saisir Nom « Larminat », Prénom « Solenn de »
                   → Larminat S. de (classée à L).
    - Initiales  : le style réduit le prénom à sa première lettre (Christine → C.).
                   Pour Chr., Th., Ph., etc., saisir directement « Chr. » comme prénom.
    - Revue      : le champ « Abrév. de revue » (container-title-short) remplace
                   le titre complet de la revue s'il est rempli : RA, AntAfr…
    - Volume collectif cité par titre abrégé : ouvrage sans auteur avec un
                   « Titre abrégé » (ex. « Naissance », « Puissance (La) »).
    - Chapitre renvoyant à ce volume : dans le champ Extra du chapitre,
                   ajouter la ligne  container-title-short: Naissance
                   → « dans Naissance 2004, p. 187-198 ».
    - À paraître : laisser la date vide et ajouter dans Extra une ligne
                   status: à paraître   (le contenu est libre : le style affiche
                   le terme de la langue choisie — à paraître, forthcoming…).
    - Thèse      : « Type » = thèse de doctorat en …, « Université » = établissement.
    - Livre avec auteur ET éditeur scientifique (édition critique, posthume…) :
                   l'auteur reste en tête, l'éditeur suit le titre → , éd. H.-G. Pflaum
                   (même personne éditrice et traductrice → , éd. et trad. J. Desanges).
    - 4 auteurs ou plus : par défaut, tous les auteurs sont en tête d'entrée.
                   Le script Zotero « marquer-et-alii.js » ajoute au champ Extra la
                   ligne  keyword: et-alii  ; la tête devient alors
                   « Premier A. et alii année, » suivie de la liste complète.
                   À relancer avant de produire la bibliographie (un oubli donne
                   une entrée complète, sans tête abrégée : rien n'est perdu).
    - Contributeurs secondaires : rôle « Collaborateur » dans Zotero
                   → « Titre », avec une contribution de P. Dupont, …
                   (ils n'apparaissent ni en tête d'entrée ni dans la citation).

  MULTILINGUISME
    Le style n'impose pas de langue (pas d'attribut default-locale) : la langue
    se choisit dans Zotero, par document (module Word/LibreOffice :
    Préférences du document > Langue) ou dans la fenêtre « Créer une
    bibliographie ». Les termes suivent alors la langue choisie :
      fr : dans, éd., trad., s.d., à paraître, p. 12
      en : in, ed./eds., trans. by, n.d., forthcoming, p. 12
      it : in, a c. di, trad. da, s.d., in corso di pubblicazione
      es : en, ed./eds., trad., s. f., previsto
    Les blocs <locale> ci-dessous ne surchargent que quelques termes ;
    tout le reste vient des fichiers de langue standard de Zotero.
    Restent identiques dans toutes les langues : [s.l.], [s.n.] (abréviations
    latines) et le séparateur « ; » des citations groupées, précédé d'une espace
    insécable à la française (CSL 1.0 ne permet pas de le faire varier selon
    la langue ; voir l'attribut delimiter de <citation>).

  POUR ADAPTER LE STYLE
    - Seuil de « et alii » en bibliographie : constante SEUIL du script
      « marquer-et-alii.js » (actuellement 4).
    - Seuil de « et alii » dans les citations : attributs de <citation> (3 et 1).
    - Ordre des citations groupées : <sort> de <citation>.
  ============================================================================
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="display-and-sort">
  <info>
    <title>Antiquités africaines</title>
    <title-short>AntAfr</title-short>
    <id>http://www.zotero.org/styles/antiquites-africaines</id>
    <link href="http://www.zotero.org/styles/antiquites-africaines" rel="self"/>
    <link href="http://www.zotero.org/styles/invisu" rel="template"/>
    <link href="https://journals.openedition.org/antafr/340" rel="documentation"/>
    <author>
      <name>Antonio Mendes da Silva</name>
      <email>antonio.mendes@cnrs.fr</email>
    </author>
    <category citation-format="author-date"/>
    <category field="humanities"/>
    <category field="history"/>
    <issn>0066-4871</issn>
    <eissn>2117-539X</eissn>
    <summary>Style conçu pour la revue Antiquités africaines. Histoire et archéologie de l’Afrique
      du Nord, de la protohistoire à la conquête arabe &#8211; History and archaeology of North
      Africa, from protohistory to the Arab conquests. Centre Camille Jullian, CNRS Éditions</summary>
    <updated>2026-11-05T08:00:00+01:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <!-- ======================================================================
       1. TERMES
       Un bloc par langue ; il ne contient que les termes qui diffèrent
       des fichiers de langue standard. Pour ajouter une langue, copier un
       bloc et changer xml:lang.
       ====================================================================== -->
  <locale xml:lang="fr">
    <terms>
      <term name="in">dans</term>
      <term name="no date" form="short">s.d.</term>
      <term name="et-al">et alii</term>
      <term name="editor" form="short">
        <single>éd.</single>
        <multiple>éd.</multiple>
      </term>
      <term name="translator" form="verb-short">trad.</term>
      <!-- Éditeur scientifique d'un ouvrage d'auteur : , éd. H.-G. Pflaum -->
      <term name="editor" form="verb-short">éd.</term>
      <term name="editortranslator" form="verb-short">éd. et trad.</term>
      <!-- Contributeurs secondaires (rôle « Collaborateur » dans Zotero) -->
      <term name="contributor" form="verb">
        <single>avec une contribution de</single>
        <multiple>avec des contributions de</multiple>
      </term>
    </terms>
  </locale>
  <locale xml:lang="it">
    <terms>
      <term name="editor" form="verb-short">a cura di</term>
      <term name="editortranslator" form="verb-short">a cura e trad. di</term>
      <term name="et-al">et alii</term>
      <term name="page" form="short">p.</term>
      <!-- Contributeurs secondaires (rôle « Collaborateur » dans Zotero) -->
      <term name="contributor" form="verb">
        <single>con un contributo di</single>
        <multiple>con contributi di</multiple>
      </term>
    </terms>
  </locale>
  <locale xml:lang="es">
    <terms>
      <term name="et-al">y otros</term>
      <term name="page" form="short">p.</term>
      <term name="accessed">fecha de consulta</term>
      <!-- Contributeurs secondaires (rôle « Collaborateur » dans Zotero) -->
      <term name="contributor" form="verb">
        <single>con una contribución de</single>
        <multiple>con contribuciones de</multiple>
      </term>
    </terms>
  </locale>
  <locale xml:lang="en">
    <!-- Ponctuation hors des guillemets, même en en-US : “Title”, in … -->
    <style-options punctuation-in-quote="false"/>
    <terms>
      <term name="editor" form="verb-short">ed.</term>
      <term name="translator" form="verb-short">trans.</term>
      <term name="editortranslator" form="verb-short">ed. and trans.</term>
      <term name="page" form="short">p.</term>
      <term name="et-al">et alii</term>
      <!-- Contributeurs secondaires (rôle « Collaborateur » dans Zotero) -->
      <term name="contributor" form="verb">
        <single>with a contribution by</single>
        <multiple>with contributions by</multiple>
      </term>
    </terms>
  </locale>

  <!-- ======================================================================
       2a. NOMS
       ====================================================================== -->

  <!-- Nom dans la citation : (Ackermann 2022), (D'Andrea, Lamy 2016),
       (Charles-Picard et alii 1970), (Naissance 2004).
       Les seuils d'et alii sont fixés sur l'élément <citation>. -->
  <macro name="author-citation">
    <choose>
      <if variable="author">
        <names variable="author">
          <name form="short">
            <name-part name="family" font-variant="small-caps"/>
          </name>
          <et-al font-style="italic"/>
        </names>
      </if>
      <!-- Volume collectif cité par son titre abrégé, comme en bibliographie -->
      <else-if type="book" variable="title-short" match="all">
        <text variable="title-short" font-style="italic"/>
      </else-if>
      <else-if variable="editor editorial-director translator collection-editor" match="any">
        <names variable="editor">
          <name form="short">
            <name-part name="family" font-variant="small-caps"/>
          </name>
          <et-al font-style="italic"/>
          <substitute>
            <names variable="editorial-director"/>
            <names variable="translator"/>
            <names variable="collection-editor"/>
          </substitute>
        </names>
      </else-if>
      <else>
        <text variable="title" form="short" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- Tête de l'entrée bibliographique, sans redoublement des noms :
         Ackermann G. 2022 / D'Andrea B., Lamy P.-A. 2016 /
         Charles-Picard G. et alii 1970 / Hitchner B. (éd.) 2022 / Naissance 2004
       Par défaut, tous les noms sont affichés. Si le champ Extra contient la ligne
         keyword: et-alii   (posée par le script « marquer-et-alii.js » sur les fiches
       de 4 noms ou plus), la tête devient : premier nom + et alii, et la liste
       complète suit (macro « full-author-list »).
       Sert aussi de clé de tri (premier auteur seulement, cf. <bibliography>). -->
  <macro name="author-short">
    <choose>
      <if variable="author">
        <choose>
          <!-- Marqueur présent (4 auteurs ou plus) : premier auteur + et alii -->
          <if variable="keyword">
            <names variable="author">
              <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", " delimiter-precedes-et-al="never" et-al-min="4" et-al-use-first="1">
                <name-part name="family" font-variant="small-caps"/>
              </name>
              <et-al font-style="italic"/>
            </names>
          </if>
          <!-- Par défaut : tous les auteurs -->
          <else>
            <names variable="author">
              <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", ">
                <name-part name="family" font-variant="small-caps"/>
              </name>
            </names>
          </else>
        </choose>
      </if>
      <else-if type="book" variable="title-short" match="all">
        <!-- Ouvrage collectif cité par titre abrégé : Naissance 2004, Puissance (La) 2008 -->
        <text variable="title-short" font-style="italic"/>
      </else-if>
      <else-if variable="editor editorial-director collection-editor" match="any">
        <choose>
          <!-- 4 éditeurs ou plus (marqueur présent) : « (éd.) » passe après la liste complète -->
          <if variable="keyword">
            <names variable="editor">
              <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", " delimiter-precedes-et-al="never" et-al-min="4" et-al-use-first="1">
                <name-part name="family" font-variant="small-caps"/>
              </name>
              <et-al font-style="italic"/>
              <substitute>
                <names variable="editorial-director"/>
                <names variable="collection-editor"/>
              </substitute>
            </names>
          </if>
          <!-- Par défaut : tous les éditeurs, puis « (éd.) » -->
          <else>
            <names variable="editor">
              <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", ">
                <name-part name="family" font-variant="small-caps"/>
              </name>
              <label form="short" prefix=" (" suffix=")"/>
              <substitute>
                <names variable="editorial-director"/>
                <names variable="collection-editor"/>
              </substitute>
            </names>
          </else>
        </choose>
      </else-if>
      <else>
        <text variable="title" form="short" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- Liste complète des auteurs (ou des éditeurs) après la tête, pour 4 noms ou plus :
         Ben Jerbania I. et alii 2020a, Ben Jerbania I., López Castro J. L., …, « Titre »
         Arena F. et alii 2023, Arena F., Dasen V., …, Solfaroli Camillocci D. (éd.), Titre
       CSL ne sait pas compter les noms : la tête abrégée et la liste ne sont données
       que si le champ Extra de la fiche contient la ligne   keyword: et-alii
       (ajoutée automatiquement par le script Zotero fourni avec le style).
       Seule la présence de la variable keyword est testée, pas sa valeur. -->
  <macro name="full-author-list">
    <choose>
      <if variable="keyword">
        <choose>
          <if variable="author">
            <names variable="author" suffix=", ">
              <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", ">
                <name-part name="family" font-variant="small-caps"/>
              </name>
            </names>
          </if>
          <else-if type="book" variable="title-short" match="all"/>
          <else>
            <names variable="editor" suffix=", ">
              <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", ">
                <name-part name="family" font-variant="small-caps"/>
              </name>
              <label form="short" prefix=" (" suffix=")"/>
              <substitute>
                <names variable="editorial-director"/>
                <names variable="collection-editor"/>
              </substitute>
            </names>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <!-- Éditeurs en ordre naturel après un titre abrégé : Naissance 2004, V. Dasen (éd.), … -->
  <macro name="author-bib">
    <choose>
      <if variable="author" match="none">
        <choose>
          <if type="book" variable="title-short" match="all">
            <text macro="editor" suffix=", "/>
          </if>
        </choose>
      </if>
    </choose>
  </macro>

  <!-- Éditeurs scientifiques en ordre naturel, tous cités, sans « et » :
       F. Prost, J. Wilgaux (éd.) -->
  <macro name="editor">
    <names variable="editor">
      <name initialize-with=". " delimiter=", ">
        <name-part name="family" font-variant="small-caps"/>
      </name>
      <label form="short" prefix="&#160;(" suffix=")"/>
      <substitute>
        <names variable="editorial-director"/>
      </substitute>
    </names>
  </macro>

  <!-- Traducteur des chapitres, articles, etc. : , trad. C. Kraus
       (pour les livres et rapports, voir la macro « secondary-responsibility »). -->
  <macro name="translator">
    <choose>
      <if type="book report" match="none">
        <names variable="translator" prefix=", ">
          <label form="verb-short" suffix=" "/>
          <name initialize-with=". " delimiter=", ">
            <name-part name="family" font-variant="small-caps"/>
          </name>
        </names>
      </if>
    </choose>
  </macro>

  <!-- Éditeur scientifique et traducteur d'un livre ou d'un rapport, après le titre :
         Gsell S. 1957, Inscriptions latines de l'Algérie, II, 1, éd. H.-G. Pflaum, Paris.
         Pline l'Ancien 2003, Histoire naturelle, V, éd. et trad. J. Desanges, Paris.
         Butler J. 2005, Trouble dans le genre, trad. C. Kraus, Paris.
       Si la même personne est éditrice et traductrice, les deux rôles sont fusionnés
       (terme editortranslator). Si l'ouvrage n'a pas d'auteur, l'éditeur est déjà
       en tête d'entrée : seul le traducteur est alors affiché ici. -->
  <macro name="secondary-responsibility">
    <choose>
      <if variable="author">
        <names variable="editor translator" delimiter=", " prefix=", ">
          <label form="verb-short" suffix=" "/>
          <name initialize-with=". " delimiter=", ">
            <name-part name="family" font-variant="small-caps"/>
          </name>
        </names>
      </if>
      <else>
        <names variable="translator" prefix=", ">
          <label form="verb-short" suffix=" "/>
          <name initialize-with=". " delimiter=", ">
            <name-part name="family" font-variant="small-caps"/>
          </name>
        </names>
      </else>
    </choose>
  </macro>

  <!-- Contributeurs secondaires (rôle « Collaborateur » dans Zotero), placés juste
       après le titre de la contribution qu'ils concernent :
         « Titre », avec une contribution de P. Dupont, AntAfr 4 …
         Titre, avec des contributions de P. Dupont, M. Durand, Paris.
       La formule suit la langue choisie (term contributor form="verb" des blocs <locale>). -->
  <macro name="contributor">
    <names variable="contributor" prefix=", ">
      <label form="verb" suffix=" "/>
      <name initialize-with=". " delimiter=", ">
        <name-part name="family" font-variant="small-caps"/>
      </name>
    </names>
  </macro>

  <macro name="interviewer">
    <group>
      <names variable="interviewer">
        <label form="verb" prefix=" " suffix=" "/>
        <name form="long" and="text" delimiter=", ">
          <name-part name="family" font-variant="small-caps"/>
        </name>
      </names>
    </group>
  </macro>

  <!-- ======================================================================
       2b. TITRES (titre, revue ou volume hôte, volume, numéro)
       ====================================================================== -->
  <macro name="title">
    <choose>
      <!-- Livre, rapport : Titre en italique, tome, éditeur/traducteur, contributeurs :
           Inscriptions latines de l'Algérie, II, 1, éd. H.-G. Pflaum, avec une contribution de … -->
      <if type="book report" match="any">
        <group>
          <group delimiter=", ">
            <text variable="title" text-case="capitalize-first" font-style="italic"/>
            <text macro="volume"/>
          </group>
          <text macro="secondary-responsibility"/>
          <text macro="contributor"/>
        </group>
      </if>
      <else-if type="graphic personal_communication interview" match="any">
        <text variable="title" text-case="capitalize-first" font-style="italic"/>
        <group delimiter=", " prefix=", " suffix=".">
          <text macro="interviewer"/>
          <text variable="medium"/>
          <text variable="genre"/>
          <text variable="dimensions"/>
          <text variable="issue"/>
        </group>
      </else-if>
      <else-if type="motion_picture" match="any">
        <group delimiter=", ">
          <text variable="title" text-case="capitalize-first" font-style="italic"/>
          <text variable="medium"/>
          <text variable="dimensions"/>
        </group>
      </else-if>
      <!-- Article : « Titre », Revue volume, numéro  →  « … », Clio 61, 1 -->
      <else-if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <group>
            <text variable="title" text-case="capitalize-first" quotes="true" font-style="normal"/>
            <text macro="contributor"/>
          </group>
          <!-- Revue (abrégée si possible) suivie du volume sans virgule : RA 74 -->
          <group delimiter=" ">
            <choose>
              <if variable="container-title-short">
                <text variable="container-title-short" font-style="italic"/>
              </if>
              <else>
                <text variable="container-title" font-style="italic"/>
              </else>
            </choose>
            <text variable="volume"/>
          </group>
          <text variable="issue"/>
        </group>
      </else-if>
      <!-- Thèse : Titre, thèse de doctorat en …, Université …, 2 vol. -->
      <else-if type="thesis broadcast" match="any">
        <group delimiter=", ">
          <group>
            <text variable="title" text-case="capitalize-first" font-style="italic"/>
            <text macro="contributor"/>
          </group>
          <text variable="genre"/>
          <choose>
            <if variable="publisher">
              <text variable="publisher"/>
            </if>
            <else>
              <text value="[s.n.]"/>
            </else>
          </choose>
          <text variable="container-title" font-style="italic"/>
          <group>
            <text term="issue" form="short" suffix=" "/>
            <text variable="number"/>
          </group>
          <text variable="medium"/>
          <text variable="dimensions"/>
          <group delimiter=" ">
            <number variable="number-of-volumes"/>
            <label variable="number-of-volumes" form="short"/>
          </group>
        </group>
      </else-if>
      <else-if type="manuscript" match="any">
        <group>
          <group suffix=",">
            <text variable="title" text-case="capitalize-first" font-style="italic"/>
          </group>
          <text variable="genre" prefix=" "/>
        </group>
      </else-if>
      <!-- Chapitre, communication, notice :
           « Titre », dans É. Éditeur (éd.), Volume, I
           ou, avec container-title-short : « Titre », dans Naissance 2004 -->
      <else-if type="entry-dictionary entry-encyclopedia paper-conference chapter" match="any">
        <group>
          <group suffix=",">
            <text variable="title" text-case="capitalize-first" quotes="true"/>
            <text macro="contributor"/>
          </group>
          <text term="in" suffix=" " prefix=" "/>
          <choose>
            <!-- Renvoi abrégé au volume collectif : dans Naissance 2004 -->
            <if variable="container-title-short">
              <group delimiter=" ">
                <text variable="container-title-short" font-style="italic"/>
                <text macro="year-date-short"/>
              </group>
            </if>
            <else>
              <text macro="editor" suffix=", "/>
              <group delimiter=", ">
                <text variable="container-title" text-case="capitalize-first" font-style="italic"/>
                <text macro="volume"/>
              </group>
            </else>
          </choose>
        </group>
      </else-if>
      <else-if type="post-weblog post webpage" match="any">
        <group delimiter=", ">
          <text variable="title" text-case="capitalize-first" quotes="true" font-style="normal"/>
          <text variable="genre"/>
          <text variable="container-title" font-style="italic"/>
        </group>
      </else-if>
      <else-if type="map" match="any">
        <group delimiter=", ">
          <text variable="title" text-case="capitalize-first" font-style="italic"/>
          <text variable="genre"/>
          <text variable="scale"/>
          <text variable="edition"/>
        </group>
      </else-if>
      <else>
        <text variable="title" text-case="capitalize-first" font-style="italic"/>
        <text macro="contributor"/>
      </else>
    </choose>
  </macro>

  <!-- Tome d'un ouvrage en plusieurs volumes : I, II… ; sinon nombre de volumes :
       2 vol. (fr), 2 vols. (en, es), 2 voll. (it) -->
  <macro name="volume">
    <choose>
      <if variable="volume">
        <text variable="volume"/>
      </if>
      <else>
        <group delimiter=" ">
          <number variable="number-of-volumes"/>
          <label variable="number-of-volumes" form="short"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- ======================================================================
       2c. DATES
       ====================================================================== -->

  <!-- Année de la tête d'entrée : 2022, 1966a, (à paraître), s.d.
       Une date de première édition éventuelle s'affiche entre crochets : [1900] 1985 -->
  <macro name="year-date">
    <choose>
      <if variable="issued">
        <group delimiter=" ">
          <text macro="originally-published"/>
          <date variable="issued">
            <date-part name="year" form="long"/>
          </date>
        </group>
      </if>
      <else-if variable="status">
        <!-- champ Extra de Zotero « status: … » : terme localisé (à paraître, forthcoming…) -->
        <text term="forthcoming" prefix="(" suffix=")"/>
      </else-if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <!-- Année dans les citations et les renvois abrégés : 2022, à paraître, s.d. -->
  <macro name="year-date-short">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else-if variable="status">
        <text term="forthcoming"/>
      </else-if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <macro name="originally-published">
    <group delimiter=", " prefix="[" suffix="]">
      <date variable="original-date">
        <date-part name="day" suffix=" "/>
        <date-part name="month" suffix=" "/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>

  <!-- ======================================================================
       2d. PUBLICATION (édition, colloque, lieu, collection)
       ====================================================================== -->

  <!-- Ensemble édition + colloque + lieu + collection.
       Supprimé après un renvoi abrégé (dans Naissance 2004, p. …),
       car ces informations figurent à l'entrée du volume. -->
  <macro name="publication">
    <choose>
      <if type="chapter paper-conference entry-dictionary entry-encyclopedia" variable="container-title-short" match="all"/>
      <else>
        <text macro="edition"/>
        <text macro="event"/>
        <text macro="place"/>
        <text macro="collection"/>
      </else>
    </choose>
  </macro>

  <!-- Édition : , 3e éd. -->
  <macro name="edition">
    <choose>
      <if type="book graphic report entry-dictionary entry-encyclopedia chapter speech paper-conference" match="any">
        <choose>
          <if is-numeric="edition">
            <group delimiter=" ">
              <number variable="edition" form="ordinal" prefix=", "/>
              <text term="edition" form="short"/>
            </group>
          </if>
          <else>
            <text variable="edition" prefix=", "/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <!-- Colloque (champ « Intitulé de la conférence ») -->
  <macro name="event">
    <choose>
      <if variable="event">
        <choose>
          <if variable="genre" match="none">
            <group delimiter=" " prefix=", ">
              <text term="presented at" suffix=" "/>
              <text variable="event"/>
            </group>
          </if>
          <else>
            <group delimiter=" " prefix=", ">
              <text variable="genre"/>
              <text term="presented at"/>
              <text variable="event"/>
            </group>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <!-- Lieu d'édition : , Paris  (ou , [s.l.] pour les livres et chapitres sans lieu).
       Pas de lieu pour les thèses (l'université suffit) ni pour les revues. -->
  <macro name="place">
    <choose>
      <if type="thesis article-magazine article-journal personal_communication interview graphic webpage" match="any"/>
      <else-if type="article-newspaper paper-conference" match="any">
        <text variable="publisher-place" prefix=", "/>
      </else-if>
      <else-if type="book chapter motion_picture report entry-dictionary entry-encyclopedia map speech manuscript broadcast" match="any">
        <choose>
          <if variable="publisher-place">
            <text variable="publisher-place" prefix=", "/>
          </if>
          <else>
            <text value="[s.l.]" prefix=", "/>
          </else>
        </choose>
      </else-if>
    </choose>
  </macro>

  <!-- Collection entre parenthèses, après le lieu : Rome (CEFR 92) -->
  <macro name="collection">
    <choose>
      <if type="article-journal">
        <text variable="collection-title" font-style="italic" prefix=", "/>
      </if>
      <else>
        <group prefix=" (" suffix=")">
          <text variable="collection-title"/>
          <text variable="collection-number" prefix=" "/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- ======================================================================
       2e. PAGES
       ====================================================================== -->

  <!-- Pagination : , p. 307-348 (articles, chapitres) ; , 250 p. (thèses, cartes…).
       Rien pour les livres. -->
  <macro name="page-bib">
    <choose>
      <if type="book" match="any"/>
      <else-if type="map manuscript thesis motion_picture broadcast" match="any">
        <choose>
          <if is-numeric="number-of-pages">
            <text variable="number-of-pages" prefix=", "/>
            <text term="page" form="short" prefix="&#160;"/>
          </if>
          <else>
            <text variable="number-of-pages" prefix=", "/>
          </else>
        </choose>
      </else-if>
      <else-if type="report entry-dictionary entry-encyclopedia chapter" match="any">
        <group delimiter="&#160;" prefix=", " suffix=".">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if type="graphic personal_communication interview webpage" match="any"/>
      <else-if type="article-journal article-magazine" match="any">
        <choose>
          <if is-numeric="page">
            <group delimiter="&#160;" prefix=", ">
              <label variable="page" form="short"/>
              <text variable="page"/>
            </group>
          </if>
          <else>
            <text variable="page" prefix=", "/>
          </else>
        </choose>
      </else-if>
      <else-if type="article-newspaper speech paper-conference" match="any">
        <group delimiter="&#160;" prefix=", ">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else>
        <choose>
          <if is-numeric="number-of-pages">
            <text variable="number-of-pages" prefix=", "/>
            <text term="page" form="short" prefix="&#160;" suffix="."/>
          </if>
          <else>
            <text variable="number-of-pages" prefix=", " suffix="."/>
          </else>
        </choose>
      </else>
    </choose>
  </macro>

  <!-- ======================================================================
       2f. ARCHIVES ET ACCÈS EN LIGNE
       ====================================================================== -->
  <macro name="archive">
    <group suffix="." prefix=". ">
      <group delimiter=", ">
        <text variable="archive"/>
        <text variable="archive_location"/>
        <text variable="call-number"/>
      </group>
    </group>
  </macro>

  <!-- Lien en fin d'entrée : DOI sous forme d'URL s'il existe, sinon URL -->
  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else>
        <text variable="URL"/>
      </else>
    </choose>
  </macro>

  <!-- ======================================================================
       3. CITATION DANS LE TEXTE
       (Ackermann 2022, p. 312) — (Le Glay 1966a, 1966b) — (Ackermann 2022 ; Dasen 2006)
       Une seule paire de parenthèses par appel ; page citée à l'intérieur.
       ====================================================================== -->
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year" cite-group-delimiter=", " name-delimiter=", " initialize-with=". " delimiter-precedes-last="never" sort-separator=" ">
    <sort>
      <!-- Ordre des références groupées : de la plus récente à la plus ancienne.
           Pour un ordre alphabétique, remplacer par :
           <key macro="author-citation"/> <key variable="issued"/> -->
      <key variable="issued" sort="descending"/>
      <key macro="author-citation"/>
      <key macro="title"/>
    </sort>
    <!-- delimiter : espace insécable + « ; » (usage français). Pour les articles
         en anglais, en italien ou en espagnol, on peut le remplacer par "; ". -->
    <layout prefix="(" suffix=")" delimiter="&#160;; ">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="author-citation"/>
          <text macro="year-date-short"/>
        </group>
        <group delimiter="&#160;">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <!-- ======================================================================
       4. BIBLIOGRAPHIE
       Tête (noms + année), puis description, puis lien sur la même entrée.
       ====================================================================== -->
  <bibliography hanging-indent="true" entry-spacing="1">
    <sort>
      <!-- premier auteur seulement, puis année croissante, puis titre -->
      <key macro="author-short" names-min="1" names-use-first="1"/>
      <key variable="issued"/>
      <key macro="title"/>
    </sort>
    <layout>
      <group suffix=". ">
        <!-- Tête : Ackermann G. 2022, -->
        <group delimiter=" " suffix=", ">
          <text macro="author-short"/>
          <text macro="year-date"/>
        </group>
        <text macro="full-author-list"/>
        <text macro="author-bib"/>
        <text macro="title"/>
        <text macro="translator"/>
        <text macro="publication"/>
        <text macro="page-bib"/>
        <text macro="archive"/>
      </group>
      <text macro="access"/>
    </layout>
  </bibliography>
</style>
