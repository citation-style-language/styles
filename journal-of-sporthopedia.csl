<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Journal of Sporthopedia</title>
    <title-short>JSP</title-short>
    <id>http://www.zotero.org/styles/journal-of-sporthopedia</id>
    <link href="http://www.zotero.org/styles/journal-of-sporthopedia" rel="self"/>
    <link href="http://www.zotero.org/styles/nlm-citation-sequence" rel="template"/>
    <link href="https://www.nlm.nih.gov/bsd/uniform_requirements.html" rel="documentation"/>
    <link href="https://journal.sporthopedia.org/index.php/sportho/about/submissions" rel="documentation"/>
    <author>
      <name>Journal of Sporthopedia Editorial Office</name>
      <email>editor@sporthopedia.org</email>
    </author>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <summary>Official citation style for the Journal of Sporthopedia (JSP), an international open-access journal in sports orthopaedics and musculoskeletal medicine. Numeric in-text citations in square brackets, reference list numbered in order of first appearance, Vancouver/ICMJE-derived formatting.</summary>
    <updated>2026-08-14T10:39:43+02:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="editor" form="short">ed.</term>
      <term name="editortranslator" form="short">
        <single>ed. &amp; trans.</single>
        <multiple>eds. &amp; trans.</multiple>
      </term>
      <term name="translator" form="short">trans.</term>
      <term name="available at">available from</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", " delimiter-precedes-last="always"/>
      <label form="short" prefix=", " strip-periods="true"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>
  <macro name="editor">
    <names variable="editor" delimiter=", ">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", " delimiter-precedes-last="always"/>
      <label form="short" prefix=", " strip-periods="true"/>
    </names>
  </macro>
  <macro name="access">
    <choose>
      <if type="webpage post-weblog post" match="any">
        <text variable="URL"/>
      </if>
    </choose>
  </macro>
  <macro name="title">
    <text variable="title"/>
  </macro>
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <label variable="edition" form="short" strip-periods="true"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="locators">
    <choose>
      <if locator="page" match="none">
        <group prefix=", " delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="date">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="container-title">
    <choose>
      <if type="chapter paper-conference" match="any">
        <text term="in" text-case="capitalize-first" suffix=": "/>
      </if>
    </choose>
    <text variable="container-title" font-style="italic"/>
  </macro>
  <macro name="issued">
    <choose>
      <if type="patent">
        <date variable="issued">
          <date-part name="year" suffix=" "/>
          <date-part name="month" suffix=" "/>
          <date-part name="day"/>
        </date>
      </if>
      <else-if type="legal_case bill" variable="issued" match="all">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </else-if>
      <else>
        <choose>
          <if variable="issued">
            <group delimiter=" ">
              <date variable="issued">
                <date-part name="year"/>
              </date>
              <choose>
                <if type="article-journal" match="none">
                  <date variable="issued">
                    <date-part name="month" form="short" suffix=" "/>
                    <date-part name="day"/>
                  </date>
                </if>
              </choose>
            </group>
          </if>
          <else>
            <text term="no date" form="long"/>
          </else>
        </choose>
      </else>
    </choose>
  </macro>
  <macro name="volume">
    <choose>
      <if type="legal_case" match="none">
        <choose>
          <if match="any" variable="volume">
            <text variable="volume"/>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="issue">
    <group>
      <choose>
        <if type="article-journal" match="any">
          <choose>
            <if variable="issue">
              <text prefix="(" variable="issue" suffix=")"/>
            </if>
          </choose>
        </if>
      </choose>
    </group>
  </macro>
  <macro name="pages">
    <text variable="page"/>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" et-al-min="7" et-al-use-first="6">
    <layout suffix=".">
      <text variable="citation-number"/>
      <group prefix=". " delimiter=". ">
        <text macro="author"/>
        <text macro="title"/>
        <choose>
          <if type="bill book graphic legal_case legislation motion_picture report song" match="any">
            <group delimiter=". ">
              <text macro="container-title"/>
              <text macro="edition"/>
              <text macro="publisher"/>
            </group>
            <text macro="date"/>
          </if>
          <else-if type="chapter paper-conference" match="any">
            <group delimiter=". ">
              <text macro="container-title"/>
              <text macro="editor"/>
              <text macro="edition"/>
              <text macro="publisher"/>
            </group>
            <group>
              <text macro="date"/>
              <text macro="locators"/>
            </group>
          </else-if>
          <else-if type="thesis" match="any">
            <group delimiter=". ">
              <text variable="genre"/>
              <text macro="publisher"/>
            </group>
            <text macro="date"/>
          </else-if>
          <else-if type="webpage post-weblog post" match="any">
            <text macro="container-title"/>
            <group delimiter=" " prefix="[" suffix="]">
              <text term="accessed" text-case="capitalize-first"/>
              <date variable="accessed" form="text"/>
            </group>
            <group delimiter=": ">
              <text term="available at" text-case="capitalize-first"/>
              <text macro="access"/>
            </group>
          </else-if>
          <else>
            <text macro="container-title" font-style="italic"/>
            <group delimiter=";">
              <text macro="issued"/>
              <group delimiter=":">
                <group>
                  <text macro="volume"/>
                  <text macro="issue"/>
                </group>
                <text macro="pages"/>
              </group>
            </group>
          </else>
        </choose>
      </group>
      <choose>
        <if variable="DOI">
          <text variable="DOI" prefix=" doi:"/>
        </if>
      </choose>
    </layout>
  </bibliography>
</style>
