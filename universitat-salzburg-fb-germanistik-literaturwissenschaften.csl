
<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" delimiter-precedes-et-al="never" delimiter-precedes-last="always" default-locale="de-AT">
  <!-- This style was edited with the Visual CSL Editor (https://editor.citationstyles.org/visualEditor/) -->
  <info>
    <title>Universität Salzburg - FB Germanistik Literaturwissenschaften (Deutsch)</title>
    <title-short>USBGLit</title-short>
    <id>http://www.zotero.org/styles/universitat-salzburg-fb-germanistik-literaturwissenschaften</id>
    <link href="http://www.zotero.org/styles/universitat-salzburg-fb-germanistik-literaturwissenschaften" rel="self"/>
    <link href="http://www.zotero.org/styles/historio-plus" rel="template"/>
    <link href="https://www.plus.ac.at/wp-content/uploads/2026/10/Leitfaden-zum-Zitieren-und-Bibliographieren-in-der-Literaturwissenschaft.pdf" rel="documentation"/>
    <author>
      <name>Paul Haase</name>
    </author>
    <contributor>
      <name>Jo Schmidbaur</name>
    </contributor>
    <category citation-format="note"/>
    <category field="humanities"/>
    <category field="literature"/>
    <category field="philosophy"/>
    <summary>Citation style for German Literary Studies at the University of Salzburg. type: classic is used in order to variably render the editors of classical works and to show contributors for classical works included in a book. For chapters, the citation style also checks if the name variable book-author is present to render the editors after the container title.</summary>
    <updated>2026-10-25T14:44:13+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="de-AT">
    <terms>
      <term name="editor" form="short">Hg.</term>
      <term name="editor" form="verb-short">hg. v.</term>
      <term name="et-al">et al.</term>
      <term name="issue" form="short">H.</term>
      <term name="accessed">letzter Zugriff am</term>
      <term name="editortranslator" form="verb-short">übers. u. hg. v.</term>
      <term name="contributor" form="verb-short">bearb. v.</term>
      <term name="and">u.</term>
      <term name="version" form="short">Ver.</term>
      <term name="translator" form="verb-short">übers. v.</term>
      <term name="anonymous" form="short">N. N.</term>
      <term name="recipient" form="short">an</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author director">
      <name delimiter=" / " name-as-sort-order="all"/>
      <label form="short" plural="never" prefix=" (" suffix=")"/>
      <substitute>
        <choose>
          <if type="entry-encyclopedia entry-dictionary classic" match="none">
            <text macro="editor"/>
          </if>
        </choose>
        <names variable="host guest" delimiter=" mit ">
          <name and="text" delimiter-precedes-last="never" name-as-sort-order="all"/>
        </names>
        <names variable="composer">
          <name delimiter=" / " name-as-sort-order="all"/>
        </names>
      </substitute>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author director composer">
      <name form="short" delimiter=" / "/>
      <substitute>
        <names variable="editor"/>
        <text macro="anon"/>
      </substitute>
    </names>
  </macro>
  <macro name="anon">
    <choose>
      <if variable="author editor contributor translator director collection-title composer" match="none">
        <choose>
          <if type="webpage">
            <text variable="title"/>
          </if>
          <else-if type="periodical"/>
          <else>
            <text term="anonymous" form="short"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="title-short">
    <text variable="title" form="short"/>
  </macro>
  <macro name="editor">
    <names variable="editor">
      <name delimiter=" / " name-as-sort-order="all"/>
      <label form="short" plural="never" prefix=" (" suffix=")"/>
      <substitute>
        <text macro="anon"/>
      </substitute>
    </names>
  </macro>
  <macro name="contributor-classic">
    <choose>
      <if type="classic">
        <names variable="contributor" delimiter=", ">
          <label form="verb-short" text-case="capitalize-first"/>
          <name prefix=" " and="text" delimiter-precedes-last="never"/>
        </names>
      </if>
    </choose>
  </macro>
  <macro name="editor-classic">
    <group delimiter=" ">
      <group delimiter=", ">
        <names variable="editor translator" delimiter=", ">
          <label form="verb-short" text-case="capitalize-first"/>
          <name prefix=" " and="text" delimiter-precedes-last="never"/>
          <substitute>
            <names variable="contributor" delimiter=", ">
              <label form="verb-short" text-case="capitalize-first"/>
              <name prefix=" " and="text" delimiter-precedes-last="never"/>
            </names>
          </substitute>
        </names>
      </group>
      <text macro="language"/>
    </group>
  </macro>
  <macro name="editor-collection">
    <group delimiter=" ">
      <text term="editor" form="verb-short" text-case="capitalize-first"/>
      <names variable="collection-editor" delimiter=", ">
        <name and="text" delimiter-precedes-last="never"/>
      </names>
    </group>
  </macro>
  <macro name="title-journal">
    <choose>
      <if type="article-journal">
        <group delimiter=": ">
          <text term="in" text-case="capitalize-first"/>
          <text variable="container-title"/>
        </group>
      </if>
      <else-if type="periodical">
        <text variable="container-title"/>
      </else-if>
    </choose>
  </macro>
  <macro name="container-title">
    <choose>
      <if type="post-weblog webpage article-journal article-magazine article-newspaper article periodical" match="any">
        <text macro="editor-classic"/>
      </if>
      <else-if type="song">
        <group delimiter=": ">
          <text term="on" text-case="capitalize-first"/>
          <group delimiter=", ">
            <text variable="collection-title"/>
            <group delimiter="/">
              <text variable="volume" prefix="Track "/>
              <text variable="number-of-volumes"/>
            </group>
          </group>
        </group>
      </else-if>
      <else-if variable="container-title container-author" match="all">
        <group delimiter=". ">
          <group delimiter=": ">
            <text term="in" text-case="capitalize-first"/>
            <text variable="container-title"/>
          </group>
          <text macro="editor-classic"/>
        </group>
      </else-if>
      <else-if variable="container-title">
        <group delimiter=" ">
          <text term="in" text-case="capitalize-first" suffix=":"/>
          <group delimiter=": ">
            <text macro="editor"/>
            <text variable="container-title"/>
          </group>
        </group>
      </else-if>
      <else>
        <text macro="editor-classic"/>
      </else>
    </choose>
  </macro>
  <macro name="review">
    <choose>
      <if variable="reviewed-author">
        <text term="review" prefix="[" suffix="]"/>
      </if>
    </choose>
  </macro>
  <macro name="collection-number">
    <choose>
      <if is-numeric="collection-number">
        <group delimiter=" ">
          <text term="volume" form="short"/>
          <number variable="collection-number"/>
        </group>
      </if>
      <else-if variable="collection-number">
        <text variable="collection-number"/>
      </else-if>
      <else-if type="broadcast" variable="number" match="all">
        <group delimiter=" ">
          <text variable="number" prefix="Folg."/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="collection-title">
    <choose>
      <if variable="collection-title collection-editor" match="all">
        <group delimiter=". " prefix="(= " suffix=")">
          <text variable="collection-title"/>
          <group delimiter=", ">
            <text macro="editor-collection"/>
            <text macro="collection-number"/>
          </group>
        </group>
      </if>
      <else-if type="song"/>
      <else-if variable="collection-title">
        <group delimiter=", " prefix="(= " suffix=")">
          <text variable="collection-title"/>
          <text macro="collection-number"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="locator-periodical">
    <choose>
      <if type="article-journal article-magazine periodical" match="any">
        <group delimiter=", ">
          <group delimiter=" ">
            <text variable="volume"/>
            <date variable="issued" form="numeric" date-parts="year" prefix="(" suffix=")"/>
          </group>
          <group delimiter=", ">
            <group delimiter=" ">
              <label variable="issue" form="short"/>
              <text variable="issue"/>
            </group>
            <choose>
              <if is-numeric="page" match="none">
                <text variable="page"/>
              </if>
              <else>
                <group delimiter=" ">
                  <label variable="locator" form="short"/>
                  <text variable="page"/>
                </group>
              </else>
            </choose>
          </group>
        </group>
      </if>
      <else-if type="article-newspaper">
        <group delimiter=": ">
          <text term="in" text-case="capitalize-first"/>
          <group delimiter=", ">
            <text variable="container-title"/>
            <text variable="volume"/>
            <date variable="issued" form="numeric">
              <date-part name="day"/>
              <date-part name="month"/>
              <date-part name="year"/>
            </date>
            <group delimiter=" ">
              <text variable="section"/>
              <label variable="locator" form="short"/>
              <text variable="page"/>
            </group>
          </group>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="edition-number">
    <choose>
      <if is-numeric="edition">
        <number vertical-align="sup" variable="edition" form="numeric"/>
      </if>
    </choose>
  </macro>
  <macro name="edition-text">
    <choose>
      <if is-numeric="edition" match="none">
        <text variable="edition"/>
      </if>
    </choose>
  </macro>
  <macro name="volume-book">
    <choose>
      <if type="book chapter entry-encyclopedia entry-dictionary classic" match="any">
        <choose>
          <if is-numeric="volume">
            <group delimiter=" ">
              <label variable="volume" form="short"/>
              <text variable="volume"/>
            </group>
          </if>
          <else-if variable="volume">
            <text variable="volume"/>
          </else-if>
          <else-if variable="number-of-volumes">
            <group delimiter=" ">
              <text variable="number-of-volumes"/>
              <text term="volume" form="short" plural="true"/>
            </group>
          </else-if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="publisher-place">
    <choose>
      <if variable="publisher-place">
        <text variable="publisher-place"/>
      </if>
      <else-if variable="event-place" match="all">
        <text variable="event-place"/>
      </else-if>
      <else-if type="book chapter paper-conference entry-dictionary entry-encyclopedia classic speech" match="any">
        <text term="no-place" form="short"/>
      </else-if>
    </choose>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <group>
          <text macro="edition-number"/>
          <date variable="issued" form="numeric" date-parts="year"/>
        </group>
      </if>
      <else-if type="webpage document" match="any"/>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="original-year">
    <date date-parts="year" form="numeric" variable="original-date" prefix="[" suffix="]"/>
  </macro>
  <macro name="publisher">
    <choose>
      <if type="thesis">
        <group delimiter=", ">
          <text variable="genre"/>
          <group delimiter=" ">
            <text variable="publisher-place"/>
            <text macro="year"/>
          </group>
        </group>
      </if>
      <else-if type="speech">
        <group delimiter=", ">
          <text macro="publisher-place"/>
          <date variable="issued" form="numeric">
            <date-part name="day"/>
            <date-part name="month"/>
            <date-part name="year"/>
          </date>
        </group>
      </else-if>
      <else-if type="article-journal article-magazine article-newspaper periodical" match="none">
        <group delimiter=", ">
          <group delimiter=" ">
            <group delimiter=": ">
              <text macro="publisher-place"/>
              <text variable="publisher"/>
            </group>
            <group delimiter=" ">
              <text macro="year"/>
              <text macro="collection-title"/>
            </group>
          </group>
          <group delimiter=" ">
            <label variable="page" form="short"/>
            <text variable="page"/>
          </group>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="archive">
    <group delimiter=", ">
      <text variable="archive"/>
      <text variable="archive_location"/>
    </group>
  </macro>
  <macro name="locator">
    <choose>
      <if variable="page">
        <group delimiter=" ">
          <label prefix="hier " variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="locator-subsequent">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>
  <macro name="last-access">
    <choose>
      <if type="webpage post post-weblog dataset" match="any">
        <group delimiter=". ">
          <group delimiter=": ">
            <text term="in" text-case="capitalize-first"/>
            <text variable="container-title"/>
          </group>
          <group delimiter="; ">
            <group delimiter=" ">
              <text variable="URL" prefix="URL: "/>
              <group delimiter=" " prefix="(" suffix=")">
                <text term="accessed"/>
                <date form="numeric" variable="accessed"/>
              </group>
            </group>
            <text variable="DOI" prefix="DOI: "/>
          </group>
        </group>
      </if>
      <else-if variable="DOI">
        <text variable="DOI" prefix="DOI: "/>
      </else-if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text variable="URL" prefix="URL: "/>
          <group delimiter=" " prefix="(" suffix=")">
            <text term="accessed"/>
            <date form="numeric" variable="accessed"/>
          </group>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="interview-short">
    <names variable="author" delimiter=", " prefix="Interview mit ">
      <name and="text" delimiter-precedes-last="never"/>
    </names>
  </macro>
  <macro name="interview-long">
    <group delimiter=". ">
      <names variable="author" prefix="Interview mit ">
        <name delimiter=" / "/>
      </names>
      <group delimiter=", ">
        <text macro="publisher-place"/>
        <date variable="issued" form="numeric"/>
      </group>
    </group>
  </macro>
  <macro name="year-citation">
    <group prefix="(" suffix=")">
      <choose>
        <if variable="issued">
          <date date-parts="year" form="numeric" variable="issued"/>
        </if>
        <else-if type="webpage document" match="any"/>
        <else>
          <text term="no date" form="short"/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="manuscript">
    <group delimiter=", ">
      <group delimiter=": ">
        <text variable="call-number"/>
        <text macro="publisher-place"/>
      </group>
      <text variable="publisher"/>
      <text variable="title"/>
      <text macro="locator"/>
    </group>
  </macro>
  <macro name="language">
    <choose>
      <if variable="translator">
        <group delimiter=" " prefix="[" suffix="]">
          <text value="Originalsprache:"/>
          <text variable="language" text-case="capitalize-first"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="medium-dimensions">
    <group delimiter=", ">
      <choose>
        <if type="motion_picture" variable="genre" match="all">
          <text variable="genre"/>
          <text variable="dimensions"/>
        </if>
        <else-if type="software"/>
        <else>
          <text variable="medium"/>
          <text variable="dimensions"/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="sort-key">
    <choose>
      <if type="manuscript dataset" variable="archive" match="any">
        <text value="1"/>
      </if>
      <else-if type="interview">
        <text value="2"/>
      </else-if>
      <else-if type="webpage post post-weblog" match="any">
        <text value="4"/>
      </else-if>
      <else>
        <text value="3"/>
      </else>
    </choose>
  </macro>
  <macro name="title">
    <choose>
      <if type="software">
        <group delimiter=" ">
          <text variable="title"/>
          <group delimiter=", " prefix="(" suffix=")">
            <text variable="medium"/>
            <group delimiter=" ">
              <label variable="version" form="short"/>
              <text variable="version" form="short"/>
            </group>
          </group>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <text variable="title"/>
          <text macro="genre-document"/>
          <text macro="review"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="personal-communication">
    <group delimiter=". ">
      <group delimiter=", ">
        <group delimiter=": ">
          <text macro="author"/>
          <group delimiter=" ">
            <text variable="genre"/>
            <names variable="recipient">
              <label form="short"/>
              <name prefix=" "/>
            </names>
          </group>
        </group>
        <date variable="issued" form="numeric"/>
      </group>
      <text macro="archive"/>
    </group>
  </macro>
  <macro name="genre-document">
    <choose>
      <if type="document">
        <text variable="genre" prefix="[" suffix="]"/>
      </if>
    </choose>
  </macro>
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <layout delimiter="; " suffix=".">
      <choose>
        <if position="ibid-with-locator">
          <group delimiter=" ">
            <text term="ibid"/>
            <label variable="locator" form="short"/>
            <text variable="locator"/>
          </group>
        </if>
        <else-if position="ibid">
          <text term="ibid"/>
        </else-if>
        <else-if type="personal_communication">
          <text macro="personal-communication"/>
        </else-if>
        <else-if position="subsequent">
          <choose>
            <if type="manuscript">
              <group delimiter=" ">
                <text variable="call-number"/>
                <group delimiter=" ">
                  <label plural="never" variable="locator" form="short"/>
                  <number variable="locator"/>
                </group>
              </group>
            </if>
            <else-if variable="title-short">
              <group delimiter=", ">
                <group delimiter=": ">
                  <text macro="author-short"/>
                  <text macro="title-short"/>
                </group>
                <text macro="locator-subsequent"/>
              </group>
            </else-if>
            <else>
              <group delimiter=", ">
                <group delimiter=" ">
                  <text macro="author-short"/>
                  <text macro="year-citation"/>
                </group>
                <text macro="locator-subsequent"/>
              </group>
            </else>
          </choose>
        </else-if>
        <else-if type="interview">
          <text macro="interview-short"/>
        </else-if>
        <else-if type="manuscript">
          <text macro="manuscript"/>
        </else-if>
        <else>
          <group delimiter=". ">
            <group delimiter=": ">
              <text macro="author"/>
              <group delimiter=" ">
                <text macro="title"/>
                <text macro="original-year"/>
              </group>
            </group>
            <text macro="contributor-classic"/>
            <text macro="container-title"/>
            <text macro="volume-book"/>
            <text macro="edition-text"/>
            <text macro="medium-dimensions"/>
            <text macro="archive"/>
            <group delimiter=", ">
              <group delimiter=" ">
                <text macro="title-journal"/>
                <group delimiter=". ">
                  <text macro="locator-periodical"/>
                  <text macro="publisher"/>
                </group>
              </group>
              <text macro="locator"/>
            </group>
            <text macro="last-access"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography et-al-min="4" et-al-use-first="1" hanging-indent="true">
    <sort>
      <key macro="sort-key"/>
      <key variable="author"/>
      <key variable="editor"/>
      <key variable="issued"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="interview">
          <text macro="interview-long"/>
        </if>
        <else-if type="manuscript">
          <text macro="manuscript"/>
        </else-if>
        <else-if type="personal_communication">
          <text macro="personal-communication"/>
        </else-if>
        <else>
          <group delimiter=". ">
            <group delimiter=": ">
              <text macro="author"/>
              <group delimiter=" ">
                <text macro="title"/>
                <text macro="original-year"/>
              </group>
            </group>
            <text macro="contributor-classic"/>
            <text macro="container-title"/>
            <text macro="volume-book"/>
            <text macro="edition-text"/>
            <text macro="medium-dimensions"/>
            <text macro="archive"/>
            <group delimiter=" ">
              <text macro="title-journal"/>
              <group delimiter=". ">
                <text macro="locator-periodical"/>
                <text macro="publisher"/>
              </group>
            </group>
            <text macro="last-access"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
