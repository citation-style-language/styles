    <author>
      <name>Jeremy Alexis Ventura Ricardez</name>
      <email>jeremyalexis_132@hotmail.com</email>
    </author>
    <category citation-format="note"/>
    <category field="law"/>
    <category field="social_science"/>
    <summary>Estilo de citación para el Instituto de Investigaciones Jurídicas de la UNAM (IIJ-UNAM).</summary>
