<style xmlns="http://purl.org/net/xbiblio/csl" class="note" default-locale="es-MX" initialize-with=". " page-range-format="chicago-16" version="1.0">
<info>
    <title>Instituto de Investigaciones Jurídicas - UNAM (notas, Español - México)</title>
    <title-short>IIJ-UNAM</title-short>
