<?xml version='1.0' encoding='UTF-8'?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" default-locale="de-DE" page-range-format="expanded" et-al-min="3" et-al-use-first="1" demote-non-dropping-particle="sort-only">
  <info>
    <title>Universität Wien - Institut für Theater-, Film- und Medienwissenschaft (Deutsch)</title>
    <title-short>TFM Wien</title-short>
    <id>http://www.zotero.org/styles/universitat-wien-institut-fur-theater-film-und-medienwissenschaft</id>
    <link href="http://www.zotero.org/styles/universitat-wien-institut-fur-theater-film-und-medienwissenschaft" rel="self"/>
    <link href="https://phaidra.univie.ac.at/o:1047915" rel="documentation"/>
    <link href="https://doi.org/10.25365/phaidra.94" rel="documentation"/>
    <author>
      <name>Elias Märk</name>
    </author>
    <category citation-format="note"/>
    <category field="humanities"/>
    <summary>Dieser Stil beruht in großen Teilen auf dem Handbuch "Wissenschaftliches Arbeiten in der Theater-, Film- und Medienwissenschaft". Er wurde unter Zuhilfenahme von künstlicher Intelligenz erstellt.</summary>
    <updated>2026-11-23T17:38:04+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="de">
    <terms>
      <term name="accessed">Letzter Zugriff am</term>
      <term name="et-al">et al.</term>
      <term name="editor" form="short">Hg.</term>
      <term name="editor" form="verb-short">hg. v.</term>
      <term name="translator" form="verb-short">übers. v.</term>
      <term name="director" form="short">R.</term>
      <term name="composer">Komposition</term>
      <term name="performer">Interpretation</term>
      <term name="anonymous" form="short">O. A.</term>
      <term name="no-place" form="short">o. A.</term>
      <term name="original-work-published" form="short">Orig.</term>
      <term name="no date">o. A.</term>
      <term name="open-quote">„</term>
      <term name="close-quote">“</term>
      <term name="open-inner-quote">‚</term>
      <term name="close-inner-quote">‘</term>
      <term name="ibid">Ebd.</term>
    </terms>
  </locale>
  <macro name="creator">
    <choose>
      <if type="interview" variable="interviewer" match="all">
        <names variable="interviewer">
          <name delimiter="/" initialize="false"/>
        </names>
      </if>
      <else-if variable="author editor" match="any">
        <names variable="author">
          <name delimiter="/" initialize="false"/>
          <substitute>
            <names variable="editor">
              <name delimiter="/" initialize="false"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
            <text term="anonymous" form="short"/>
          </substitute>
        </names>
      </else-if>
      <else>
        <text term="anonymous" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="creator-short">
    <choose>
      <if type="interview" variable="interviewer" match="all">
        <names variable="interviewer">
          <name delimiter="/" initialize="false" form="short"/>
        </names>
      </if>
      <else-if variable="author editor" match="any">
        <names variable="author">
          <name form="short" delimiter="/"/>
          <substitute>
            <names variable="editor">
              <name form="short" delimiter="/"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
            <text term="anonymous" form="short"/>
          </substitute>
        </names>
      </else-if>
      <else>
        <text term="anonymous" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="creator-bibliography">
    <choose>
      <if type="interview" variable="interviewer" match="all">
        <names variable="interviewer">
          <name delimiter="/" initialize="false" name-as-sort-order="first" sort-separator=", "/>
        </names>
      </if>
      <else-if variable="author editor" match="any">
        <names variable="author">
          <name delimiter="/" initialize="false" name-as-sort-order="first" sort-separator=", "/>
          <substitute>
            <names variable="editor">
              <name delimiter="/" initialize="false" name-as-sort-order="first" sort-separator=", "/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
            <text term="anonymous" form="short"/>
          </substitute>
        </names>
      </else-if>
      <else>
        <text term="anonymous" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="creator-context">
    <choose>
      <if position="first subsequent" match="any">
        <text macro="creator"/>
      </if>
      <else>
        <text macro="creator-bibliography"/>
      </else>
    </choose>
  </macro>
  <macro name="editors">
    <choose>
      <if variable="author container-title" match="any">
        <group delimiter=" ">
          <text term="editor" form="verb-short"/>
          <names variable="editor">
            <name delimiter="/" initialize="false"/>
          </names>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="translator">
    <group delimiter=" ">
      <text term="translator" form="verb-short"/>
      <names variable="translator">
        <name delimiter="/" initialize="false"/>
      </names>
    </group>
  </macro>
  <macro name="title">
    <choose>
      <if type="chapter paper-conference entry-dictionary entry-encyclopedia article-journal article-magazine article-newspaper thesis post post-weblog" match="any">
        <text variable="title" quotes="true"/>
      </if>
      <else-if type="webpage">
        <choose>
          <if variable="container-title">
            <text variable="title" quotes="true"/>
          </if>
          <else>
            <text variable="title" font-style="italic"/>
          </else>
        </choose>
      </else-if>
      <else-if type="song">
        <choose>
          <if variable="director">
            <choose>
              <if variable="container-title URL" match="any">
                <text variable="title" quotes="true"/>
              </if>
              <else>
                <text variable="title" font-style="italic"/>
              </else>
            </choose>
          </if>
          <else>
            <text variable="title" font-style="italic"/>
          </else>
        </choose>
      </else-if>
      <else-if type="motion_picture broadcast" match="any">
        <choose>
          <if variable="container-title URL" match="any">
            <text variable="title" quotes="true"/>
          </if>
          <else>
            <text variable="title" font-style="italic"/>
          </else>
        </choose>
      </else-if>
      <else-if type="manuscript personal_communication interview graphic" match="any">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>
  <macro name="title-short">
    <choose>
      <if type="chapter paper-conference entry-dictionary entry-encyclopedia article-journal article-magazine article-newspaper thesis post post-weblog" match="any">
        <text variable="title" form="short" quotes="true"/>
      </if>
      <else-if type="webpage">
        <choose>
          <if variable="container-title">
            <text variable="title" form="short" quotes="true"/>
          </if>
          <else>
            <text variable="title" form="short" font-style="italic"/>
          </else>
        </choose>
      </else-if>
      <else-if type="song">
        <choose>
          <if variable="director">
            <choose>
              <if variable="container-title URL" match="any">
                <text variable="title" form="short" quotes="true"/>
              </if>
              <else>
                <text variable="title" form="short" font-style="italic"/>
              </else>
            </choose>
          </if>
          <else>
            <text variable="title" font-style="italic" form="short"/>
          </else>
        </choose>
      </else-if>
      <else-if type="motion_picture broadcast" match="any">
        <choose>
          <if variable="container-title URL" match="any">
            <text variable="title" form="short" quotes="true"/>
          </if>
          <else>
            <text variable="title" form="short" font-style="italic"/>
          </else>
        </choose>
      </else-if>
      <else-if type="manuscript personal_communication interview graphic" match="any">
        <text variable="title" form="short"/>
      </else-if>
      <else>
        <text variable="title" form="short" font-style="italic"/>
      </else>
    </choose>
  </macro>
  <macro name="volume">
    <group delimiter=": ">
      <group delimiter=" ">
        <label variable="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <text variable="volume-title"/>
    </group>
  </macro>
  <macro name="container">
    <group delimiter=". " font-style="italic">
      <text variable="container-title"/>
      <text macro="volume"/>
    </group>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date"/>
      </else>
    </choose>
  </macro>
  <macro name="date">
    <date variable="issued" delimiter=".">
      <date-part name="day" form="numeric-leading-zeros"/>
      <date-part name="month" form="numeric-leading-zeros"/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="accessed">
    <group delimiter=" ">
      <text term="accessed"/>
      <date variable="accessed" delimiter=".">
        <date-part name="day" form="numeric-leading-zeros"/>
        <date-part name="month" form="numeric-leading-zeros"/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>
  <macro name="edition-year">
    <group>
      <choose>
        <if is-numeric="edition">
          <choose>
            <if variable="edition">
              <choose>
                <if type="book chapter paper-conference entry-dictionary entry-encyclopedia report" match="any">
                  <number variable="edition" vertical-align="sup"/>
                </if>
              </choose>
            </if>
          </choose>
        </if>
        <else>
          <text variable="edition" suffix=", "/>
        </else>
      </choose>
      <text macro="year"/>
    </group>
  </macro>
  <macro name="publisher">
    <group delimiter=" ">
      <group delimiter=": ">
        <choose>
          <if variable="publisher-place">
            <text variable="publisher-place"/>
          </if>
          <else>
            <text term="no-place" form="short"/>
          </else>
        </choose>
        <text variable="publisher"/>
      </group>
      <text macro="edition-year"/>
    </group>
  </macro>
  <macro name="original">
    <group prefix=" (" suffix=")" delimiter=" ">
      <text term="original-work-published" form="short" suffix=":"/>
      <group delimiter=", ">
        <choose>
          <if type="motion_picture broadcast song" match="any">
            <text variable="original-title" font-style="italic"/>
            <group delimiter=" ">
              <text variable="original-publisher-place"/>
              <date variable="original-date">
                <date-part name="year"/>
              </date>
            </group>
          </if>
          <else>
            <names variable="original-author">
              <name delimiter="/" initialize="false"/>
            </names>
            <text variable="original-title" font-style="italic"/>
            <group delimiter=" ">
              <group delimiter=": ">
                <text variable="original-publisher-place"/>
                <text variable="original-publisher"/>
              </group>
              <date variable="original-date">
                <date-part name="year"/>
              </date>
            </group>
          </else>
        </choose>
      </group>
    </group>
  </macro>
  <macro name="online">
    <group delimiter=", ">
      <text variable="URL"/>
      <text macro="accessed"/>
    </group>
  </macro>
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="locator">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>
  <macro name="pages-locator">
    <group delimiter=", ">
      <text macro="pages"/>
      <choose>
        <if variable="page">
          <!-- CSL has no exact term for this pinpoint-page introduction. -->
          <text macro="locator" prefix="hier "/>
        </if>
        <else>
          <text macro="locator"/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="directors">
    <group delimiter=": ">
      <text term="director" form="short"/>
      <names variable="director">
        <name delimiter="/" initialize="false"/>
        <substitute>
          <names variable="author"/>
        </substitute>
      </names>
    </group>
  </macro>
  <macro name="episode">
    <group delimiter=" ">
      <text variable="container-title" font-style="italic"/>
      <group delimiter="/">
        <text variable="volume"/>
        <text variable="number"/>
      </group>
    </group>
  </macro>
  <macro name="archive">
    <group delimiter=", ">
      <choose>
        <if variable="archive-place">
          <text variable="archive-place"/>
        </if>
        <else-if type="manuscript">
          <text variable="publisher-place"/>
        </else-if>
      </choose>
      <text variable="archive"/>
      <text variable="archive_location"/>
      <text variable="call-number"/>
    </group>
  </macro>
  <macro name="music-full">
    <group delimiter=", ">
      <text macro="title"/>
      <group delimiter=": ">
        <text term="composer"/>
        <names variable="composer">
          <name delimiter="/" initialize="false"/>
        </names>
      </group>
      <group delimiter=": ">
        <text term="performer"/>
        <names variable="author">
          <name delimiter="/" initialize="false"/>
        </names>
      </group>
      <text variable="medium"/>
      <group>
        <group delimiter=" ">
          <text variable="publisher"/>
          <text macro="year"/>
        </group>
        <text macro="original"/>
      </group>
      <text macro="online"/>
      <text macro="locator"/>
    </group>
  </macro>
  <macro name="full">
    <choose>
      <if type="song">
        <choose>
          <if variable="director">
            <group delimiter=", ">
              <text macro="title"/>
              <text macro="episode"/>
              <text macro="directors"/>
              <text variable="medium"/>
              <group>
                <choose>
                  <if variable="URL">
                    <group delimiter=", ">
                      <group delimiter=" ">
                        <text variable="publisher-place"/>
                        <text variable="publisher"/>
                      </group>
                      <text macro="date"/>
                    </group>
                  </if>
                  <else>
                    <group delimiter=" ">
                      <text variable="publisher-place"/>
                      <text variable="publisher"/>
                      <choose>
                        <if type="broadcast">
                          <text macro="date"/>
                        </if>
                        <else>
                          <text macro="year"/>
                        </else>
                      </choose>
                    </group>
                  </else>
                </choose>
                <text macro="original"/>
              </group>
              <text variable="archive"/>
              <text macro="online"/>
              <text macro="locator"/>
            </group>
          </if>
          <else>
            <text macro="music-full"/>
          </else>
        </choose>
      </if>
      <else-if type="motion_picture broadcast" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <text macro="episode"/>
          <text macro="directors"/>
          <text variable="medium"/>
          <group>
            <choose>
              <if variable="URL">
                <group delimiter=", ">
                  <group delimiter=" ">
                    <text variable="publisher-place"/>
                    <text variable="publisher"/>
                  </group>
                  <text macro="date"/>
                </group>
              </if>
              <else>
                <group delimiter=" ">
                  <text variable="publisher-place"/>
                  <text variable="publisher"/>
                  <choose>
                    <if type="broadcast">
                      <text macro="date"/>
                    </if>
                    <else>
                      <text macro="year"/>
                    </else>
                  </choose>
                </group>
              </else>
            </choose>
            <text macro="original"/>
          </group>
          <text variable="archive"/>
          <text macro="online"/>
          <text macro="locator"/>
        </group>
      </else-if>
      <else-if type="software">
        <group delimiter=", ">
          <text macro="title"/>
          <!-- CSL 1.0 has no dedicated game-design role term; keep the handbook label. -->
          <names variable="author" prefix="Design: ">
            <name delimiter="/" initialize="false"/>
          </names>
          <group delimiter=" ">
            <text variable="publisher"/>
            <text macro="year"/>
          </group>
          <text macro="locator"/>
        </group>
      </else-if>
      <else-if type="post">
        <group delimiter=", ">
          <choose>
            <if position="first subsequent" match="any">
              <group delimiter=", ">
                <text macro="creator-context"/>
                <text macro="date"/>
              </group>
            </if>
            <else>
              <group delimiter=": ">
                <text macro="creator-context"/>
                <text macro="date"/>
              </group>
            </else>
          </choose>
          <text variable="event-title"/>
          <group delimiter=": ">
            <text variable="container-title"/>
            <text variable="URL"/>
          </group>
          <text macro="accessed"/>
        </group>
      </else-if>
      <else-if type="manuscript graphic personal_communication interview" match="any">
        <group delimiter=", ">
          <choose>
            <if position="first subsequent" match="any">
              <group delimiter=", ">
                <choose>
                  <if type="manuscript">
                    <choose>
                      <if variable="author">
                        <text macro="creator-context"/>
                      </if>
                    </choose>
                  </if>
                  <else-if type="graphic personal_communication interview" match="any">
                    <text macro="creator-context"/>
                  </else-if>
                </choose>
                <text macro="title"/>
              </group>
            </if>
            <else>
              <group delimiter=": ">
                <choose>
                  <if type="manuscript">
                    <choose>
                      <if variable="author">
                        <text macro="creator-context"/>
                      </if>
                    </choose>
                  </if>
                  <else-if type="graphic personal_communication interview" match="any">
                    <text macro="creator-context"/>
                  </else-if>
                </choose>
                <text macro="title"/>
              </group>
            </else>
          </choose>
          <text variable="medium"/>
          <text macro="date"/>
          <choose>
            <if variable="event-place">
              <text variable="event-place"/>
            </if>
            <else-if type="interview">
              <text variable="publisher-place"/>
            </else-if>
          </choose>
          <text macro="archive"/>
          <text macro="locator"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <choose>
            <if position="first subsequent" match="any">
              <group delimiter=", ">
                <choose>
                  <if type="chapter">
                    <choose>
                      <if variable="medium" match="none">
                        <text macro="creator-context"/>
                      </if>
                    </choose>
                  </if>
                  <else>
                    <text macro="creator-context"/>
                  </else>
                </choose>
                <group>
                  <text macro="title"/>
                  <choose>
                    <if type="book report" match="any">
                      <text macro="volume" prefix=". " font-style="italic"/>
                    </if>
                  </choose>
                </group>
              </group>
            </if>
            <else>
              <group delimiter=": ">
                <choose>
                  <if type="chapter">
                    <choose>
                      <if variable="medium" match="none">
                        <text macro="creator-context"/>
                      </if>
                    </choose>
                  </if>
                  <else>
                    <text macro="creator-context"/>
                  </else>
                </choose>
                <group>
                  <text macro="title"/>
                  <choose>
                    <if type="book report" match="any">
                      <text macro="volume" prefix=". " font-style="italic"/>
                    </if>
                  </choose>
                </group>
              </group>
            </else>
          </choose>
          <choose>
            <if type="article-journal article-magazine" match="any">
              <group>
                <group delimiter=", ">
                  <group delimiter=" ">
                    <text variable="container-title" font-style="italic"/>
                    <group delimiter="/">
                      <text variable="volume"/>
                      <text variable="issue"/>
                    </group>
                  </group>
                  <group delimiter=" ">
                    <date variable="issued">
                      <date-part name="month" form="short"/>
                    </date>
                    <text macro="year"/>
                  </group>
                </group>
                <text macro="original"/>
              </group>
              <text macro="pages-locator"/>
            </if>
            <else-if type="article-newspaper">
              <text variable="container-title" font-style="italic"/>
              <text macro="date"/>
              <choose>
                <if variable="URL">
                  <text macro="online"/>
                </if>
              </choose>
              <text macro="pages-locator"/>
            </else-if>
            <else-if type="thesis">
              <text variable="genre"/>
              <group>
                <group delimiter=" ">
                  <text variable="publisher"/>
                  <text macro="year"/>
                </group>
                <text macro="original"/>
              </group>
              <text macro="locator"/>
            </else-if>
            <else-if type="webpage post-weblog" match="any">
              <text variable="container-title" font-style="italic"/>
              <text macro="editors"/>
              <text macro="date"/>
              <group>
                <text macro="online"/>
                <text macro="original"/>
              </group>
              <text macro="pages-locator"/>
            </else-if>
            <else-if type="book report" match="any">
              <text macro="editors"/>
              <text macro="translator"/>
              <text variable="genre"/>
              <choose>
                <if variable="publisher">
                  <group>
                    <text macro="publisher"/>
                    <text macro="original"/>
                  </group>
                </if>
                <else-if variable="URL">
                  <text macro="year"/>
                  <group>
                    <text macro="online"/>
                    <text macro="original"/>
                  </group>
                </else-if>
                <else>
                  <group>
                    <text macro="publisher"/>
                    <text macro="original"/>
                  </group>
                </else>
              </choose>
              <text macro="locator"/>
            </else-if>
            <else-if type="chapter entry-dictionary entry-encyclopedia" match="any">
              <choose>
                <if variable="URL">
                  <text macro="container"/>
                  <text macro="editors"/>
                  <text macro="date"/>
                  <group>
                    <text macro="online"/>
                    <text macro="original"/>
                  </group>
                  <text macro="pages-locator"/>
                </if>
                <else>
                  <choose>
                    <if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
                      <group delimiter=" ">
                        <text variable="medium"/>
                        <text macro="container"/>
                      </group>
                    </if>
                  </choose>
                  <text macro="editors"/>
                  <text macro="translator"/>
                  <text variable="genre"/>
                  <group>
                    <choose>
                      <if variable="publisher publisher-place" match="any">
                        <text macro="publisher"/>
                      </if>
                      <else>
                        <text macro="year"/>
                      </else>
                    </choose>
                    <text macro="original"/>
                  </group>
                  <choose>
                    <if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
                      <text macro="pages-locator"/>
                    </if>
                    <else>
                      <text macro="locator"/>
                    </else>
                  </choose>
                </else>
              </choose>
            </else-if>
            <else>
              <choose>
                <if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
                  <group delimiter=" ">
                    <text variable="medium"/>
                    <text macro="container"/>
                  </group>
                </if>
              </choose>
              <text macro="editors"/>
              <text macro="translator"/>
              <text variable="genre"/>
              <group>
                <choose>
                  <if variable="publisher publisher-place" match="any">
                    <text macro="publisher"/>
                  </if>
                  <else>
                    <text macro="year"/>
                  </else>
                </choose>
                <text macro="original"/>
              </group>
              <choose>
                <if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
                  <text macro="pages-locator"/>
                </if>
                <else>
                  <text macro="locator"/>
                </else>
              </choose>
            </else>
          </choose>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="short">
    <group delimiter=", ">
      <choose>
        <if type="motion_picture broadcast song software" match="any"/>
        <else-if type="manuscript">
          <choose>
            <if variable="author">
              <text macro="creator-short"/>
            </if>
          </choose>
        </else-if>
        <else-if type="chapter">
          <choose>
            <if variable="medium" match="none">
              <text macro="creator-short"/>
            </if>
          </choose>
        </else-if>
        <else>
          <text macro="creator-short"/>
        </else>
      </choose>
      <choose>
        <if type="post">
          <group delimiter=" ">
            <text variable="genre"/>
            <!-- Fixed German date connector; no exact CSL term is available. -->
            <text value="vom"/>
            <text macro="date"/>
          </group>
          <text variable="event-title"/>
        </if>
        <else-if type="chapter">
          <group delimiter=", ">
            <text macro="title-short"/>
            <group delimiter=" ">
              <text variable="medium"/>
              <choose>
                <if variable="medium">
                  <text variable="container-title" form="short" font-style="italic"/>
                </if>
              </choose>
            </group>
          </group>
        </else-if>
        <else>
          <group delimiter=" ">
            <text macro="title-short"/>
            <choose>
              <if type="manuscript">
                <text variable="call-number" prefix="(" suffix=")"/>
              </if>
            </choose>
          </group>
        </else>
      </choose>
      <choose>
        <if type="motion_picture broadcast song" match="any">
          <text macro="episode"/>
        </if>
        <else-if type="book report" match="any">
          <group delimiter=" ">
            <label variable="volume" form="short"/>
            <text variable="volume"/>
          </group>
        </else-if>
      </choose>
      <choose>
        <if variable="locator">
          <text macro="locator"/>
        </if>
        <else-if type="webpage post-weblog" match="any">
          <text macro="accessed"/>
        </else-if>
        <else-if type="chapter article-newspaper entry-dictionary entry-encyclopedia" match="any">
          <choose>
            <if variable="URL">
              <text macro="accessed"/>
            </if>
          </choose>
        </else-if>
        <else-if type="book report" variable="URL" match="all">
          <choose>
            <if variable="publisher" match="none">
              <text macro="accessed"/>
            </if>
          </choose>
        </else-if>
      </choose>
    </group>
  </macro>
  <macro name="sort-creator">
    <choose>
      <if type="motion_picture broadcast song software" match="any">
        <text variable="title"/>
      </if>
      <else-if type="interview" variable="interviewer" match="all">
        <names variable="interviewer">
          <name name-as-sort-order="all"/>
        </names>
      </else-if>
      <else>
        <names variable="author">
          <name name-as-sort-order="all"/>
          <substitute>
            <names variable="editor"/>
            <text variable="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <citation>
    <layout delimiter="; " suffix=".">
      <choose>
        <if position="ibid-with-locator">
          <group delimiter=", ">
            <text term="ibid"/>
            <text macro="locator"/>
          </group>
        </if>
        <else-if position="ibid">
          <text term="ibid"/>
        </else-if>
        <else-if position="subsequent">
          <text macro="short"/>
        </else-if>
        <else>
          <text macro="full"/>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography hanging-indent="true">
    <sort>
      <key macro="sort-creator"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <text macro="full"/>
    </layout>
  </bibliography>
</style>
