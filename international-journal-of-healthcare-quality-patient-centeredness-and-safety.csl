<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" page-range-format="minimal" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>International Journal of Healthcare Quality, Patient Centeredness and Safety</title>
    <title-short>IJHQPCS</title-short>
    <id>http://www.zotero.org/styles/international-journal-of-healthcare-quality-patient-centeredness-and-safety</id>
    <link href="http://www.zotero.org/styles/international-journal-of-healthcare-quality-patient-centeredness-and-safety" rel="self"/>
    <link href="http://www.zotero.org/styles/nlm-citation-sequence" rel="template"/>
    <link href="https://journals.lww.com/qaij/pages/default.aspx" rel="documentation"/>
    <author>
      <name>Jagadish Ramasamy</name>
      <email>iamjagankmr@gmail.com</email>
      <uri>https://orcid.org/0000-0003-4725-3227</uri>
    </author>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <issn>2666-3848</issn>
    <eissn>2666-3856</eissn>
    <summary>International Journal of Healthcare Quality, Patient Centeredness and Safety: NLM-style references with superscript square-bracketed numerical citations.</summary>
    <updated>2026-08-10T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- Authors -->
  <macro name="author">
    <names variable="author">
      <name initialize-with=" " delimiter=", " delimiter-precedes-last="always" name-as-sort-order="all" sort-separator=" "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>
  <!-- Editors -->
  <macro name="editor">
    <names variable="editor">
      <name initialize-with=" " delimiter=", " delimiter-precedes-last="always" name-as-sort-order="all" sort-separator=" "/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <!-- Publication year -->
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <!-- Edition -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <label variable="edition" form="short" plural="never"/>
        </group>
      </if>
      <else-if variable="edition">
        <text variable="edition"/>
      </else-if>
    </choose>
  </macro>
  <!-- Publisher and place -->
  <macro name="publisher">
    <group delimiter=". ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>
  <!-- Container and editors -->
  <macro name="container">
    <group delimiter=". ">
      <group delimiter=" ">
        <text term="in" text-case="sentence"/>
        <text macro="editor"/>
      </group>
      <text variable="container-title"/>
    </group>
  </macro>
  <!-- Electronic source information -->
  <macro name="electronic">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi:"/>
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text variable="URL"/>
          <group prefix="(" suffix=")" delimiter=" ">
            <text term="accessed"/>
            <date variable="accessed">
              <date-part name="month" form="long"/>
              <date-part name="day" suffix=", "/>
              <date-part name="year"/>
            </date>
          </group>
        </group>
      </else-if>
    </choose>
  </macro>
  <!-- Numeric citations in superscript square brackets -->
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter="," vertical-align="sup">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <!-- Bibliography -->
  <bibliography entry-spacing="1" et-al-min="7" et-al-use-first="6">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="] "/>
      <text macro="author" suffix=". "/>
      <choose>
        <!-- Journal article -->
        <if type="article-journal">
          <group delimiter=". ">
            <text variable="title"/>
            <text variable="container-title" form="short"/>
            <group delimiter=":">
              <group delimiter=";">
                <text macro="year"/>
                <text variable="volume"/>
              </group>
              <text variable="page"/>
            </group>
            <text macro="electronic"/>
          </group>
        </if>
        <!-- Book, report, graphic, motion picture, song -->
        <else-if type="book report graphic motion_picture song" match="any">
          <group delimiter=". ">
            <text variable="title"/>
            <text macro="edition"/>
            <text macro="publisher"/>
            <text macro="year"/>
          </group>
        </else-if>
        <!-- Book chapter / conference paper -->
        <else-if type="chapter paper-conference" match="any">
          <group delimiter=". ">
            <text variable="title"/>
            <text macro="container"/>
            <text macro="publisher"/>
            <text macro="year"/>
          </group>
          <group delimiter=" ">
            <label variable="page" form="short"/>
            <text variable="page"/>
          </group>
        </else-if>
        <!-- Legal case / legislation / bill -->
        <else-if type="legal_case legislation bill" match="any">
          <group delimiter=". ">
            <text variable="title"/>
            <text macro="year"/>
          </group>
        </else-if>
        <!-- Patent -->
        <else-if type="patent">
          <group delimiter=". ">
            <text variable="title"/>
            <text variable="number"/>
            <text macro="year"/>
          </group>
        </else-if>
        <!-- Thesis / dissertation -->
        <else-if type="thesis">
          <group delimiter=". ">
            <text variable="title"/>
            <text variable="genre"/>
            <text variable="publisher"/>
            <text macro="year"/>
          </group>
        </else-if>
        <!-- Web page / software / other electronic source -->
        <else>
          <group delimiter=". ">
            <text variable="title"/>
            <text macro="year"/>
            <text macro="electronic"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
