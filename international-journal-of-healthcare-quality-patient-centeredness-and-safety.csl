<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" page-range-format="minimal" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
  <title>International Journal of Healthcare Quality, Patient Centeredness and Safety</title>
  <title-short>IJHQPCS</title-short>

  <id>http://www.zotero.org/styles/international-journal-of-healthcare-quality-patient-centeredness-and-safety</id>

  <link href="http://www.zotero.org/styles/international-journal-of-healthcare-quality-patient-centeredness-and-safety"
        rel="self"/>

  <link href="http://www.zotero.org/styles/vancouver"
        rel="template"/>

  <link href="https://journals.lww.com/qaij/pages/default.aspx"
        rel="documentation"/>

  <author>
    <name>Jagadish Ramasamy</name>
    <email>iamjagankmr@gmail.com</email>
    <uri>https://orcid.org/0000-0003-4725-3227</uri>
  </author>

  <category citation-format="numeric"/>
  <category field="medicine"/>

  <issn>2666-3848</issn>
  <eissn>2666-3856</eissn>

  <summary>
    International Journal of Healthcare Quality, Patient Centeredness and Safety:
    NLM-style references with superscript square-bracketed numerical citations.
  </summary>

  <updated>2026-08-10T00:00:00+00:00</updated>

  <rights license="http://creativecommons.org/licenses/by-sa/3.0/">
    This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License
  </rights>
</info>  
<!-- Authors: family name followed by initials separated by spaces.
       The bibliography itself limits output to the first six authors. -->
  <macro name="author">
    <names variable="author">
      <name initialize-with=" " delimiter=", " delimiter-precedes-last="always" name-as-sort-order="all" sort-separator=" "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>
  <!-- Editors used in book/chapter references. -->
  <macro name="editor">
    <names variable="editor">
      <name initialize-with=" " delimiter=", " delimiter-precedes-last="always" name-as-sort-order="all" sort-separator=" "/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <!-- Edition: e.g. 3rd ed. -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else-if variable="edition">
        <text variable="edition"/>
      </else-if>
    </choose>
  </macro>
  <!-- DOI and electronic-source information.
       IJHQPCS example uses doi:... followed by the URL. -->
  <macro name="electronic">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi:"/>
        <text variable="URL" prefix=" [" suffix="]"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
        <choose>
          <if variable="accessed">
            <group prefix=" (accessed " suffix=")" delimiter=" ">
              <date variable="accessed">
                <date-part name="month" form="long"/>
                <date-part name="day" suffix=", "/>
                <date-part name="year"/>
              </date>
            </group>
          </if>
        </choose>
      </else-if>
    </choose>
  </macro>
  <!-- Numeric citations in superscript square brackets.
       Citation placement after punctuation is an author/insertion-position rule,
       not something CSL can reliably enforce. -->
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter="," vertical-align="sup">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="1" et-al-min="7" et-al-use-first="6">
    <layout suffix=".">
      <!-- Reference number -->
      <text variable="citation-number" prefix="[" suffix="] "/>
      <!-- Author(s) -->
      <text macro="author" suffix=". "/>
      <choose>
        <!-- Standard journal article -->
        <if type="article-journal">
          <text variable="title" suffix=". "/>
          <text variable="container-title" form="short" suffix=". "/>
          <group delimiter=";">
            <text macro="year"/>
            <text variable="volume"/>
          </group>
          <text variable="page" prefix=":"/>
          <text macro="electronic" prefix=". "/>
        </if>
        <!-- Book and other monographs -->
        <else-if type="book report graphic motion_picture song" match="any">
          <text variable="title" suffix=". "/>
          <text macro="edition" suffix=". "/>
          <group delimiter=". ">
            <text variable="publisher"/>
            <text variable="publisher-place"/>
          </group>
          <text macro="year" prefix=". "/>
        </else-if>
        <!-- Book chapter / conference paper -->
        <else-if type="chapter paper-conference" match="any">
          <text variable="title" suffix=". "/>
          <group suffix=". ">
            <text term="in" text-case="sentence" suffix=" "/>
            <text macro="editor"/>
          </group>
          <text variable="container-title" suffix=". "/>
          <group delimiter=". ">
            <text variable="publisher"/>
            <text variable="publisher-place"/>
          </group>
          <text macro="year" prefix=". "/>
          <text variable="page" prefix=", pp. "/>
        </else-if>
        <!-- Legal/legislative material -->
        <else-if type="legal_case legislation bill" match="any">
          <text variable="title" suffix=". "/>
          <text macro="year"/>
        </else-if>
        <!-- Patent -->
        <else-if type="patent">
          <text variable="title" suffix=". "/>
          <text variable="number" suffix=". "/>
          <text macro="year"/>
        </else-if>
        <!-- Thesis/dissertation -->
        <else-if type="thesis">
          <text variable="title" suffix=". "/>
          <text variable="genre" suffix=". "/>
          <text variable="publisher" suffix=". "/>
          <text macro="year"/>
        </else-if>
        <!-- Web pages/software and other electronic sources -->
        <else>
          <text variable="title" suffix=". "/>
          <text macro="year"/>
          <choose>
            <if variable="URL">
              <text variable="URL" prefix=". "/>
              <choose>
                <if variable="accessed">
                  <group prefix=" (accessed " suffix=")">
                    <date variable="accessed">
                      <date-part name="month" form="long"/>
                      <date-part name="day" suffix=", "/>
                      <date-part name="year"/>
                    </date>
                  </group>
                </if>
              </choose>
            </if>
          </choose>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
