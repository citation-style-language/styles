<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only">
  <info>
    <title>Universiti Kebangsaan Malaysia</title>
    <title-short>UKM</title-short>
    <id>http://www.zotero.org/styles/universiti-kebangsaan-malaysia</id>
    <link href="http://www.zotero.org/styles/universiti-kebangsaan-malaysia" rel="self"/>
    <link href="http://www.zotero.org/styles/mhra-author-date" rel="template"/>
    <link href="https://www.ukm.my/pusatsiswazah/templat-gayaukm/" rel="documentation"/>
    <author>
      <name>Fareed Sairi</name>
      <uri>http://www.mendeley.com/profiles/fareed-sairi/</uri>
    </author>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <summary>Gaya UKM (Edisi ke-3, 2015): author-date system for UKM theses and dissertations. English by default; choose Malay (Bahasa Melayu) in the word processor or bibliography language menu for Gaya UKM Malay wording.</summary>
    <updated>2026-10-29T00:00:00+08:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- English is the standard: the unlabelled locale below applies to every language,
       and the user's language (English for most installs) is used by default.
       Malay is chosen per document in Zotero's Language menu; the ms block then
       applies Gaya UKM wording on top of the official locales-ms-MY.xml.
       Do NOT add default-locale: Zotero locks (greys out) the Language menu
       for any style that sets one, so users could no longer pick Malay. -->
  <locale>
    <terms>
      <!-- Edition: "2nd ed." pattern for non-Malay languages -->
      <term name="edition" form="verb-short"></term>
    </terms>
  </locale>
  <locale xml:lang="ms">
    <terms>
      <!-- Gaya UKM wording (5.3, 5.3.1, 5.3.8, 5.3.11, 5.12.3, 5.12.6) -->
      <term name="in">dlm.</term>
      <term name="anonymous" form="short">anon.</term>
      <term name="edition" form="verb-short">edisi ke-</term>
      <term name="edition" form="short"></term>
      <term name="translator" form="verb-short">terj.</term>
      <term name="interview">temu bual</term>
      <term name="paper-conference">kertas kerja</term>
      <term name="organizer" form="verb">anjuran</term>
      <!-- corrects "Ogoss" in locales-ms-MY.xml -->
      <term name="month-08">Ogos</term>
      <!-- 5.3.4 penyusun, 5.3.6 penyelenggara -->
      <term name="compiler" form="short">
        <single>pnys.</single>
        <multiple>pnys.</multiple>
      </term>
      <term name="editorial-director" form="short">
        <single>pngr.</single>
        <multiple>pngr.</multiple>
      </term>
    </terms>
  </locale>
  <!-- ===================== NAMES (Gaya UKM 5.1.3) ===================== -->
  <macro name="author">
    <choose>
      <if variable="author editor translator compiler editorial-director" match="any">
        <names variable="author">
          <name and="symbol" delimiter-precedes-last="never" initialize-with="." name-as-sort-order="all"/>
          <label form="short" prefix=" (" suffix=")"/>
          <substitute>
            <names variable="editor"/>
            <!-- 5.3.4: Farid M. Onn (pnys.) -->
            <names variable="compiler"/>
            <!-- 5.3.6: Othman Ismail (pngr.) -->
            <names variable="editorial-director"/>
            <names variable="translator"/>
          </substitute>
        </names>
      </if>
      <else-if variable="composer">
        <!-- 5.11.4: Mozart, W.A. -->
        <names variable="composer">
          <name and="symbol" delimiter-precedes-last="never" initialize-with="." name-as-sort-order="all"/>
        </names>
      </else-if>
      <else-if type="hearing">
        <!-- 5.4 Hansard: Dewan Rakyat Malaysia -->
        <text variable="authority"/>
      </else-if>
      <else-if type="personal_communication manuscript" match="any">
        <choose>
          <if variable="archive_location">
            <!-- 5.4b: CO 273/657/50601 / Straits Settlements Records. IOR G/34/13 -->
            <group delimiter=". ">
              <text variable="archive"/>
              <text variable="archive_location"/>
            </group>
          </if>
          <else>
            <text macro="title"/>
          </else>
        </choose>
      </else-if>
      <else-if type="article-newspaper">
        <choose>
          <if variable="title">
            <text term="anonymous" form="short" text-case="capitalize-first"/>
          </if>
          <else>
            <!-- 5.10: Berita Harian. 2005. 28 November -->
            <text variable="container-title" font-style="italic"/>
          </else>
        </choose>
      </else-if>
      <else-if type="article-journal article-magazine chapter paper-conference webpage post post-weblog" match="any">
        <!-- 4.2.4, 5.8.2, 5.9.2: articles without author = Anon. -->
        <text term="anonymous" form="short" text-case="capitalize-first"/>
      </else-if>
      <else>
        <!-- 5.3.2, 5.11, 5.12.5, 5.12.8: works known by title -->
        <text macro="title"/>
      </else>
    </choose>
  </macro>
  <macro name="author-short">
    <choose>
      <if variable="author editor translator compiler editorial-director" match="any">
        <names variable="author">
          <name form="short" and="symbol" delimiter-precedes-last="never" delimiter-precedes-et-al="never" initialize-with=". "/>
          <substitute>
            <names variable="editor"/>
            <names variable="compiler"/>
            <names variable="editorial-director"/>
            <names variable="translator"/>
          </substitute>
        </names>
      </if>
      <else-if variable="composer">
        <names variable="composer">
          <name form="short" and="symbol" delimiter-precedes-last="never" delimiter-precedes-et-al="never" initialize-with=". "/>
        </names>
      </else-if>
      <else-if type="hearing">
        <text variable="authority"/>
      </else-if>
      <else-if type="personal_communication manuscript" match="any">
        <choose>
          <if variable="archive">
            <!-- (Straits Settlements Records 1806) -->
            <text variable="archive"/>
          </if>
          <else-if variable="archive_location">
            <!-- (CO 273/657/50601 1939) -->
            <text variable="archive_location"/>
          </else-if>
          <else>
            <text variable="title" form="short"/>
          </else>
        </choose>
      </else-if>
      <else-if type="article-newspaper">
        <choose>
          <if variable="title">
            <text term="anonymous" form="short" text-case="capitalize-first"/>
          </if>
          <else>
            <!-- v5: newspaper name italic in text, as in Rujukan: (Berita Harian 2005) -->
            <text variable="container-title" font-style="italic"/>
          </else>
        </choose>
      </else-if>
      <else-if type="article-journal article-magazine chapter paper-conference webpage post post-weblog" match="any">
        <text term="anonymous" form="short" text-case="capitalize-first"/>
      </else-if>
      <else>
        <!-- v5: a title standing in for the author keeps the same italics as in Rujukan:
             (Kamus Dewan 1991), (Ali Baba Bujang Lapok 1960); minutes, software stay roman -->
        <text macro="title-short"/>
      </else>
    </choose>
  </macro>
  <macro name="title-short">
    <choose>
      <if type="book report motion_picture broadcast graphic song map entry-dictionary entry-encyclopedia" match="any">
        <text variable="title" form="short" font-style="italic"/>
      </if>
      <else>
        <text variable="title" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="container-contributors">
    <names variable="editor translator" delimiter=", ">
      <name and="symbol" delimiter-precedes-last="never" initialize-with="." name-as-sort-order="all"/>
      <label form="short" prefix=" (" suffix=")."/>
    </names>
  </macro>
  <!-- ===================== DATES ===================== -->
  <macro name="issued">
    <choose>
      <if type="song" variable="original-date" match="all">
        <!-- 5.11.4: composition year, release year at the end -->
        <date variable="original-date">
          <date-part name="year"/>
        </date>
      </if>
      <else-if variable="issued">
        <!-- A quoted date in Extra (Issued: "1311H/1894") prints as written -->
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </else-if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="day-month">
    <date variable="issued" delimiter=" ">
      <date-part name="day" range-delimiter="-"/>
      <date-part name="month"/>
    </date>
  </macro>
  <macro name="full-date">
    <date variable="issued">
      <date-part name="day" suffix=" "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="month">
    <date variable="issued">
      <date-part name="month"/>
    </date>
  </macro>
  <!-- ===================== SORTING ===================== -->
  <macro name="sort-first">
    <!-- 5.2a: Al-Quran (Extra: "Status: kitab suci") heads the list; items without this key sort after it -->
    <text variable="status"/>
  </macro>
  <!-- ===================== TITLE (5.1.4) ===================== -->
  <macro name="title">
    <choose>
      <if type="legislation bill" match="any">
        <!-- v5: titles of acts, enactments and bills are never italic (7.6),
             with or without a gazette; only the gazette name (container) is italic -->
        <text variable="title"/>
      </if>
      <else-if type="book report motion_picture broadcast graphic song map entry-dictionary entry-encyclopedia" match="any">
        <!-- Italic: books, technical reports, films/video, music (5.1.4, 5.11). Acts, theses, software, manuscripts are not. -->
        <text variable="title" font-style="italic"/>
      </else-if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>
  <macro name="title-in-body">
    <!-- Prints the title unless it has moved to the author position -->
    <choose>
      <if type="personal_communication">
        <!-- 5.4b: Surat ... kepada ..., 24 Januari 1939 -->
        <choose>
          <if variable="author editor translator compiler editorial-director archive_location" match="any">
            <group delimiter=", ">
              <text macro="title"/>
              <text macro="full-date"/>
            </group>
          </if>
        </choose>
      </if>
      <else-if variable="author editor translator compiler editorial-director composer" match="any">
        <text macro="title"/>
      </else-if>
      <else-if type="hearing article-newspaper" match="any">
        <text macro="title"/>
      </else-if>
      <else-if type="manuscript">
        <choose>
          <if variable="archive_location">
            <text macro="title"/>
          </if>
        </choose>
      </else-if>
      <else-if type="article-journal article-magazine chapter paper-conference webpage post post-weblog" match="any">
        <text macro="title"/>
      </else-if>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <!-- ms: "Edisi ke-2"; en: "2nd ed." -->
        <group>
          <text term="edition" form="verb-short" text-case="capitalize-first"/>
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short" prefix=" "/>
        </group>
      </if>
      <else>
        <!-- e.g. "Edisi semak", "Edisi baru", "Ulang cetak" (5.3.1) -->
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="series">
    <group delimiter=" ">
      <text variable="collection-title"/>
      <text variable="collection-number"/>
    </group>
  </macro>
  <macro name="volume">
    <group delimiter=" ">
      <label variable="volume" form="short" text-case="capitalize-first"/>
      <text variable="volume"/>
    </group>
  </macro>
  <macro name="place-publisher">
    <!-- 5.3: Tempat: Penerbit -->
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <macro name="periodical">
    <!-- Nama Jurnal 12(3): 45-67 -->
    <group>
      <text variable="container-title" font-style="italic"/>
      <text variable="volume" prefix=" "/>
      <text variable="issue" prefix="(" suffix=")"/>
      <text variable="page" prefix=": "/>
    </group>
  </macro>
  <macro name="book-details">
    <!-- 5.3: Judul. Penyunting (pnyt.). Terj. Penterjemah. Siri. Edisi ke-2. Jil. 1. Tempat: Penerbit -->
    <group delimiter=". ">
      <text variable="genre"/>
      <names variable="editor">
        <name and="symbol" delimiter-precedes-last="never" initialize-with="."/>
        <label form="short" prefix=" (" suffix=")"/>
      </names>
      <group delimiter=" ">
        <text term="translator" form="verb-short" text-case="capitalize-first"/>
        <names variable="translator">
          <name and="symbol" delimiter-precedes-last="never" initialize-with="."/>
        </names>
      </group>
      <text macro="series"/>
      <text macro="edition"/>
      <text macro="volume"/>
      <text macro="place-publisher"/>
    </group>
  </macro>
  <!-- ===================== ACCESS ===================== -->
  <macro name="access">
    <choose>
      <if type="webpage post post-weblog dataset document" match="any">
        <!-- 5.13: URL [DD Bulan YYYY] -->
        <group delimiter=" ">
          <text variable="URL"/>
          <group prefix="[" suffix="]">
            <date variable="accessed">
              <date-part name="day" suffix=" "/>
              <date-part name="month" suffix=" "/>
              <date-part name="year"/>
            </date>
          </group>
        </group>
      </if>
      <else-if type="article-journal article-magazine article-newspaper" match="any">
        <choose>
          <if variable="medium">
            <!-- 5.13 CD-ROM (Extra: "Medium: CD-ROM"): (CD-ROM). 1994 SIRS/... [13 Jun 1995] -->
            <text macro="access-cdrom"/>
          </if>
          <else-if type="article-journal">
            <!-- v5: journal articles never print URL/DOI (as v4); archive location only, if any -->
            <text macro="access-cdrom"/>
          </else-if>
          <else-if variable="URL accessed" match="all">
            <!-- v5, 5.13 online magazine/newspaper article: ... URL [8 Jun 1995].
                 Printed only when both URL and Accessed are filled; clear them for print sources -->
            <group delimiter=" ">
              <text variable="URL"/>
              <group prefix="[" suffix="]">
                <date variable="accessed">
                  <date-part name="day" suffix=" "/>
                  <date-part name="month" suffix=" "/>
                  <date-part name="year"/>
                </date>
              </group>
            </group>
          </else-if>
          <else>
            <!-- as v4: archive location only, if any -->
            <text macro="access-cdrom"/>
          </else>
        </choose>
      </else-if>
    </choose>
  </macro>
  <macro name="access-cdrom">
        <group delimiter=". ">
          <text variable="medium" prefix="(" suffix=")"/>
          <group delimiter=" ">
            <text variable="archive_location"/>
            <choose>
              <if variable="medium">
                <group prefix="[" suffix="]">
                  <date variable="accessed">
                    <date-part name="day" suffix=" "/>
                    <date-part name="month" suffix=" "/>
                    <date-part name="year"/>
                  </date>
                </group>
              </if>
            </choose>
          </group>
        </group>
  </macro>
  <!-- ===================== BODY BY ITEM TYPE ===================== -->
  <macro name="details">
    <choose>
      <if type="article-journal">
        <text macro="periodical"/>
      </if>
      <else-if type="article-magazine">
        <!-- 5.7: Dewan Sastera Mei: 79-83 (journal format if a volume is given) -->
        <choose>
          <if variable="volume issue" match="any">
            <text macro="periodical"/>
          </if>
          <else>
            <group>
              <text variable="container-title" font-style="italic"/>
              <text macro="month" prefix=" "/>
              <text variable="page" prefix=": "/>
            </group>
          </else>
        </choose>
      </else-if>
      <else-if type="article-newspaper">
        <choose>
          <if variable="title">
            <!-- 5.8, 5.9: Utusan Malaysia, 2 Februari: 3.  5.9.3: Surat. Berita Harian, 30 Oktober: 13 -->
            <group delimiter=". ">
              <text variable="genre"/>
              <group>
                <group delimiter=", ">
                  <text variable="container-title" font-style="italic"/>
                  <text macro="day-month"/>
                </group>
                <text variable="page" prefix=": "/>
              </group>
            </group>
          </if>
          <else>
            <!-- 5.10 general newspaper reference -->
            <text macro="day-month"/>
          </else>
        </choose>
      </else-if>
      <else-if type="chapter entry-encyclopedia entry-dictionary" match="any">
        <!-- 5.3.11: Dlm. Penyunting (pnyt.). Judul Buku, hlm. x-y. Tempat: Penerbit -->
        <group delimiter=". ">
          <group delimiter=" ">
            <text term="in" text-case="capitalize-first"/>
            <text macro="container-contributors"/>
            <group delimiter=", ">
              <text variable="container-title" font-style="italic"/>
              <group delimiter=" ">
                <label variable="page" form="short"/>
                <text variable="page"/>
              </group>
            </group>
          </group>
          <text macro="place-publisher"/>
        </group>
      </else-if>
      <else-if type="paper-conference speech" match="any">
        <choose>
          <if variable="container-title">
            <!-- 5.6: Prosiding ..., hlm. x-y -->
            <group delimiter=", ">
              <text variable="container-title" font-style="italic"/>
              <group delimiter=" ">
                <label variable="page" form="short"/>
                <text variable="page"/>
              </group>
            </group>
          </if>
          <else>
            <!-- 5.12.3: Kertas kerja Persidangan ... Anjuran ... Tempat, 8 September -->
            <group delimiter=". ">
              <group delimiter=" ">
                <choose>
                  <if variable="genre">
                    <text variable="genre"/>
                  </if>
                  <else>
                    <text term="paper-conference" text-case="capitalize-first"/>
                  </else>
                </choose>
                <text variable="event-title"/>
              </group>
              <group delimiter=" ">
                <text term="organizer" form="verb" text-case="capitalize-first"/>
                <text variable="publisher"/>
              </group>
              <group delimiter=", ">
                <text variable="event-place"/>
                <text macro="day-month"/>
              </group>
            </group>
          </else>
        </choose>
      </else-if>
      <else-if type="thesis">
        <!-- 5.12.1: Tesis Dr. Fal, Jabatan ..., Universiti Kebangsaan Malaysia -->
        <group delimiter=", ">
          <text variable="genre"/>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
        </group>
      </else-if>
      <else-if type="hearing">
        <!-- 5.4 Hansard: Penyata Rasmi Dewan Rakyat 2(12): 1792-1850. Parlimen Keenam Penggal Kedua -->
        <group delimiter=". ">
          <text macro="periodical"/>
          <text variable="chapter-number"/>
        </group>
      </else-if>
      <else-if type="legislation bill" match="any">
        <choose>
          <if variable="container-title">
            <!-- 5.4 gazette: Warta Kerajaan 34(26): Nombor Makluman 10926 -->
            <text macro="periodical"/>
          </if>
          <else>
            <!-- 5.4 act: (Act 127) -->
            <group delimiter=" " prefix="(" suffix=")">
              <text variable="genre"/>
              <text variable="number"/>
            </group>
          </else>
        </choose>
      </else-if>
      <else-if type="report">
        <!-- 5.12.4: Laporan Teknik 5. Pusat ..., Universiti Kebangsaan Malaysia -->
        <group delimiter=". ">
          <group delimiter=" ">
            <text variable="genre"/>
            <text variable="number"/>
          </group>
          <text macro="edition"/>
          <text macro="place-publisher"/>
        </group>
      </else-if>
      <else-if type="manuscript">
        <!-- 5.12.2: MSS. Cod. Or. 7291(11), Perpustakaan University Leiden -->
        <group delimiter=". ">
          <text variable="genre"/>
          <choose>
            <if variable="author editor translator compiler editorial-director" match="any">
              <group delimiter=", ">
                <text variable="archive_location"/>
                <text variable="archive"/>
              </group>
            </if>
          </choose>
        </group>
      </else-if>
      <else-if type="personal_communication">
        <!-- 5.4b letters: the date is printed with the title -->
        <text variable="genre"/>
      </else-if>
      <else-if type="document">
        <choose>
          <if variable="event-place event-date" match="any">
            <!-- 5.12.5 minutes: Lumut, Perak D.R., 7-9 Ogos -->
            <group delimiter=", ">
              <text variable="event-place"/>
              <date variable="event-date" delimiter=" ">
                <date-part name="day" range-delimiter="-"/>
                <date-part name="month"/>
              </date>
            </group>
          </if>
          <else>
            <text macro="book-details"/>
          </else>
        </choose>
      </else-if>
      <else-if type="song">
        <!-- 5.11.4: performers, series. Place: Label, release year -->
        <group delimiter=". ">
          <group delimiter=", ">
            <names variable="performer" delimiter=", ">
              <name/>
            </names>
            <text macro="series"/>
          </group>
          <group delimiter=", ">
            <text macro="place-publisher"/>
            <choose>
              <if variable="original-date">
                <date variable="issued">
                  <date-part name="year"/>
                </date>
              </if>
            </choose>
          </group>
        </group>
      </else-if>
      <else-if type="interview">
        <!-- 5.12.6: Temu bual, 12 Mei -->
        <group delimiter=", ">
          <text term="interview" text-case="capitalize-first"/>
          <text macro="day-month"/>
        </group>
      </else-if>
      <else-if type="software">
        <!-- 5.12.8: MATLAB. 2005. Versi 7.1. Massachusetts: Math Works Inc. -->
        <group delimiter=". ">
          <group delimiter=" ">
            <text term="version" text-case="capitalize-first"/>
            <text variable="version"/>
          </group>
          <text macro="place-publisher"/>
        </group>
      </else-if>
      <else>
        <text macro="book-details"/>
      </else>
    </choose>
  </macro>
  <!-- ===================== IN-TEXT (4.2) ===================== -->
  <citation delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-givenname="true" givenname-disambiguation-rule="by-cite" collapse="year">
    <sort>
      <key macro="sort-first"/>
      <key macro="author"/>
      <key macro="issued"/>
    </sort>
    <layout delimiter="; " prefix="(" suffix=")">
      <choose>
        <if variable="status">
          <!-- 4.2.7: (Al-Quran, Al cImran 3:92); surah and ayat go in the citation's locator -->
          <group delimiter=", ">
            <text variable="title"/>
            <text variable="locator"/>
          </group>
        </if>
        <else>
          <!-- (Hawkings 2012), author-year only -->
          <group delimiter=" ">
            <text macro="author-short"/>
            <text macro="issued"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <!-- ===================== RUJUKAN (5.1, 5.2) ===================== -->
  <bibliography delimiter-precedes-last="never" hanging-indent="true" line-spacing="1" entry-spacing="1">
    <sort>
      <key macro="sort-first"/>
      <key macro="author"/>
      <key macro="issued"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if variable="status">
          <!-- 5.2a: Al-Quran. -->
          <text variable="title"/>
        </if>
        <else>
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="issued"/>
            <text macro="title-in-body"/>
            <text macro="details"/>
            <text macro="access"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
