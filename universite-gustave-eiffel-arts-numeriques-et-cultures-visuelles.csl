<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" default-locale="fr-FR" demote-non-dropping-particle="never">
  <info>
    <title>Université Gustave Eiffel - Arts numériques et Cultures Visuelles (Français)</title>
    <title-short>Master ANCV</title-short>
    <id>http://www.zotero.org/styles/universite-gustave-eiffel-arts-numeriques-et-cultures-visuelles</id>
    <link href="http://www.zotero.org/styles/universite-gustave-eiffel-arts-numeriques-et-cultures-visuelles" rel="self"/>
    <category citation-format="note"/>
    <category field="humanities"/>
    <summary>Notes de bas de page avec référence complète à la première occurrence, Ibid. et op. cit. ensuite ; bibliographie alphabétique. Établi d'après le Guide du mémoire du Master ANCV 2026-2027 (version du 5 octobre 2026).</summary>
    <updated>2026-10-07T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="fr">
    <terms>
      <term name="editor" form="short">
        <single>dir.</single>
        <multiple>dir.</multiple>
      </term>
    </terms>
  </locale>

  <!-- ===================== AUTEURS ===================== -->
  <!-- Format : NOM Prénom ; plusieurs auteurs : « A, B et C » ; sans auteur : le directeur de publication, sinon le titre -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " and="text" delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=" " and="text" delimiter=", " delimiter-precedes-last="never">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <et-al font-style="italic"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <names variable="director">
          <name name-as-sort-order="all" sort-separator=" " and="text" delimiter=", " delimiter-precedes-last="never">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <et-al font-style="italic"/>
        </names>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor-container">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=" " and="text" delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <et-al font-style="italic"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <macro name="translator">
    <group delimiter=" ">
      <text value="traduit par"/>
      <names variable="translator">
        <name and="text" delimiter=", " delimiter-precedes-last="never"/>
      </names>
    </group>
  </macro>

  <!-- ===================== TITRES ===================== -->
  <macro name="title">
    <choose>
      <if type="article-journal article-magazine article-newspaper chapter paper-conference entry-encyclopedia entry-dictionary webpage post-weblog post" match="any">
        <text variable="title" quotes="true"/>
      </if>
      <else-if type="manuscript interview" match="any">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="title-short">
    <choose>
      <if type="article-journal article-magazine article-newspaper chapter paper-conference entry-encyclopedia entry-dictionary webpage post-weblog post" match="any">
        <text variable="title" form="short" quotes="true"/>
      </if>
      <else-if type="manuscript interview" match="any">
        <text variable="title" form="short"/>
      </else-if>
      <else>
        <text variable="title" form="short" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- Titre suivi de la date de l'édition originale : Titre (1958) -->
  <macro name="title-with-original">
    <group>
      <text macro="title"/>
      <date variable="original-date" prefix=" (" suffix=")">
        <date-part name="year"/>
      </date>
    </group>
  </macro>

  <!-- ===================== BRIQUES COMMUNES ===================== -->
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="date-full">
    <date variable="issued">
      <date-part name="day" suffix=" "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="publication">
    <group delimiter=", ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <macro name="collection">
    <group>
      <group delimiter=" ">
        <text value="coll."/>
        <text variable="collection-title" quotes="true"/>
      </group>
      <text variable="collection-number" prefix=", n° "/>
    </group>
  </macro>

  <macro name="volume-issue">
    <group delimiter=", ">
      <group delimiter=" ">
        <label variable="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <group delimiter=" ">
        <text value="n°"/>
        <text variable="issue"/>
      </group>
    </group>
  </macro>

  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="number-of-pages">
    <text variable="number-of-pages" suffix=" p."/>
  </macro>

  <macro name="dans">
    <choose>
      <if variable="container-title">
        <group delimiter=" ">
          <text value="dans :"/>
          <group delimiter=", ">
            <text macro="editor-container"/>
            <text variable="container-title" font-style="italic"/>
          </group>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="software-details">
    <group delimiter=", ">
      <text variable="genre"/>
      <text variable="medium"/>
    </group>
  </macro>

  <!-- URL (ou DOI) + « consulté le jour mois année » (accord au féminin pour vidéo, film, documentation d'œuvre) -->
  <macro name="access">
    <choose>
      <if variable="URL DOI" match="any">
        <group delimiter=", ">
          <choose>
            <if variable="URL">
              <text variable="URL"/>
            </if>
            <else>
              <text variable="DOI" prefix="https://doi.org/"/>
            </else>
          </choose>
          <group delimiter=" ">
            <choose>
              <if type="motion_picture graphic broadcast" match="any">
                <text value="consultée le"/>
              </if>
              <else>
                <text value="consulté le"/>
              </else>
            </choose>
            <date variable="accessed">
              <date-part name="day" suffix=" "/>
              <date-part name="month" suffix=" "/>
              <date-part name="year"/>
            </date>
          </group>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="locator">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>

  <!-- ===================== RÉFÉRENCE COMPLÈTE, PAR TYPE ===================== -->
  <macro name="reference">
    <choose>
      <!-- Chapitre de livre -->
      <if type="chapter entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title-with-original"/>
          <text macro="dans"/>
          <text macro="volume-issue"/>
          <text macro="publication"/>
          <text macro="year"/>
          <text macro="pages"/>
          <text macro="access"/>
        </group>
      </if>
      <!-- Article de revue -->
      <else-if type="article-journal">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <text variable="container-title" font-style="italic"/>
          <text macro="volume-issue"/>
          <text macro="year"/>
          <text macro="pages"/>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Presse -->
      <else-if type="article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <text variable="container-title" font-style="italic"/>
          <text macro="volume-issue"/>
          <text macro="date-full"/>
          <text macro="pages"/>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Communication de colloque -->
      <else-if type="paper-conference">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <text macro="dans"/>
          <text macro="volume-issue"/>
          <text macro="year"/>
          <text macro="pages"/>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Thèse ou mémoire -->
      <else-if type="thesis">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <text variable="genre"/>
          <text variable="publisher"/>
          <text macro="year"/>
          <text macro="number-of-pages"/>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Texte en ligne -->
      <else-if type="webpage post-weblog post" match="any">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <text variable="container-title" font-style="italic"/>
          <text macro="year"/>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Logiciel, dépôt de code, jeu vidéo, programme -->
      <else-if type="software">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <choose>
            <if variable="URL">
              <choose>
                <if variable="publisher">
                  <!-- Logiciel tiers : Éditeur, depuis année, URL, consulté le -->
                  <text variable="publisher"/>
                  <group delimiter=" ">
                    <text value="depuis"/>
                    <text macro="year"/>
                  </group>
                  <text macro="software-details"/>
                  <text macro="access"/>
                </if>
                <else>
                  <!-- Programme propre : année, langage, dépôt : URL -->
                  <text macro="year"/>
                  <text macro="software-details"/>
                  <group delimiter=" ">
                    <text value="dépôt :"/>
                    <text macro="access"/>
                  </group>
                </else>
              </choose>
            </if>
            <else>
              <!-- Jeu vidéo ou logiciel sans URL : éd. Éditeur, année, plateforme -->
              <group delimiter=" ">
                <text value="éd."/>
                <text variable="publisher"/>
              </group>
              <text macro="year"/>
              <text macro="software-details"/>
            </else>
          </choose>
        </group>
      </else-if>
      <!-- Vidéo en ligne, film -->
      <else-if type="motion_picture broadcast" match="any">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <text macro="year"/>
          <text variable="genre"/>
          <text variable="medium"/>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Œuvre (y compris votre propre travail de création) -->
      <else-if type="graphic">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <text macro="year"/>
          <text variable="genre"/>
          <text variable="medium"/>
          <text variable="dimensions"/>
          <choose>
            <if variable="URL DOI" match="any">
              <group delimiter=" ">
                <text value="documentation :"/>
                <text macro="access"/>
              </group>
            </if>
          </choose>
        </group>
      </else-if>
      <!-- Document d'archive -->
      <else-if type="manuscript">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <text variable="archive_collection"/>
          <text variable="archive"/>
          <text variable="archive_location"/>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Entretien -->
      <else-if type="interview">
        <group delimiter=", ">
          <text macro="author"/>
          <choose>
            <if variable="medium">
              <text variable="medium"/>
            </if>
            <else>
              <text value="entretien"/>
            </else>
          </choose>
          <text macro="date-full"/>
          <text variable="publisher-place"/>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Exposition (type Zotero « Document ») -->
      <else-if type="document">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text macro="date-full"/>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Livre (par défaut) -->
      <else>
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title-with-original"/>
          <text variable="genre"/>
          <text macro="translator"/>
          <text macro="volume-issue"/>
          <text macro="publication"/>
          <text macro="collection"/>
          <text variable="edition"/>
          <text macro="year"/>
          <text macro="number-of-pages"/>
          <text macro="access"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- ===================== NOTES DE BAS DE PAGE ===================== -->
  <citation et-al-min="4" et-al-use-first="1">
    <layout suffix="." delimiter=" ; ">
      <choose>
        <if position="ibid-with-locator">
          <group delimiter=", ">
            <text value="Ibid." font-style="italic"/>
            <text macro="locator"/>
          </group>
        </if>
        <else-if position="ibid">
          <text value="Ibid." font-style="italic"/>
        </else-if>
        <else-if position="subsequent">
          <group delimiter=", ">
            <text macro="author"/>
            <text macro="title-short"/>
            <text value="op. cit." font-style="italic"/>
            <text macro="locator"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <text macro="reference"/>
            <text macro="locator"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>

  <!-- ===================== BIBLIOGRAPHIE ===================== -->
  <bibliography hanging-indent="true" et-al-min="11" et-al-use-first="10" entry-spacing="1" line-spacing="1">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <text macro="reference"/>
    </layout>
  </bibliography>
</style>
