<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" page-range-format="expanded" default-locale="en-US">
  <info>
    <!-- The Dumbarton Oaks Pre-Columbian CSL style was drafted with the assistance of Claude Opus 4.8 (Anthropic) and reviewed and edited by the authors. 2026 -->
    <title>Dumbarton Oaks Pre-Columbian Studies</title>
    <title-short>DO Pre-Columbian</title-short>
    <id>http://www.zotero.org/styles/dumbarton-oaks-pre-columbian</id>
    <link href="http://www.zotero.org/styles/dumbarton-oaks-pre-columbian" rel="self"/>
    <link href="http://www.zotero.org/styles/chicago-author-date" rel="template"/>
    <link href="https://www.doaks.org/resources/publications/resources-for-authors-and-editors/style-guide-pre-columbian-studies" rel="documentation"/>
    <author>
      <name>Esther Jackson</name>
    </author>
    <author>
      <name>Lisa Trever</name>
    </author>
    <contributor>
      <name>Based on the Dumbarton Oaks Pre-Columbian Style Guide (Rev. 06/20)</name>
    </contributor>
    <category citation-format="author-date"/>
    <category field="anthropology"/>
    <category field="history"/>
    <summary>Author-date style following the Dumbarton Oaks Pre-Columbian Style Guide, which is based on the American Antiquity / Society for American Archaeology reference conventions with departures specified by Dumbarton Oaks. In-text citations use the form (Author Year:page); the "References Cited" list places the year on its own and uses full first names.</summary>
    <updated>2026-08-28T09:36:55-04:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="editor" form="short">
        <single>editor</single>
        <multiple>editors</multiple>
      </term>
      <term name="editor" form="verb-short">edited by</term>
      <term name="translator" form="verb-short">translated by</term>
      <term name="translator" form="short">
        <single>translator</single>
        <multiple>translators</multiple>
      </term>
      <term name="collection-number" form="short">
        <single>vol.</single>
        <multiple>vols.</multiple>
      </term>
      <term name="volume" form="short">
        <single>vol.</single>
        <multiple>vols.</multiple>
      </term>
      <term name="page" form="short">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
      <term name="no date">n.d.</term>
      <term name="in">in</term>
      <term name="edition" form="short">ed.</term>
      <term name="and">and</term>
    </terms>
  </locale>
  <!-- ============ MACROS ============ -->
  <macro name="author">
    <names variable="author">
      <name and="text" delimiter-precedes-last="always" name-as-sort-order="first" sort-separator=", " delimiter=", "/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <choose>
          <if type="bill book graphic legal_case legislation motion_picture report song" match="any">
            <text variable="title" form="short" font-style="italic"/>
          </if>
          <else>
            <text variable="title" form="short"/>
          </else>
        </choose>
      </substitute>
    </names>
  </macro>
  <macro name="editor">
    <names variable="editor">
      <label form="verb-short" suffix=" "/>
      <name and="text" delimiter=", "/>
    </names>
  </macro>
  <macro name="translator">
    <names variable="translator">
      <label form="verb-short" suffix=" "/>
      <name and="text" delimiter=", "/>
    </names>
  </macro>
  <macro name="container-editor-translator">
    <group delimiter=", ">
      <text macro="editor"/>
      <text macro="translator"/>
    </group>
  </macro>
  <!-- Year on its own; original (reprint) dates in brackets preceding -->
  <macro name="issued-bib">
    <group delimiter=" ">
      <choose>
        <if variable="original-date">
          <date variable="original-date" prefix="[" suffix="]">
            <date-part name="year"/>
          </date>
        </if>
      </choose>
      <choose>
        <if variable="issued">
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <text variable="year-suffix"/>
        </if>
        <else>
          <text term="no date"/>
          <text variable="year-suffix"/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="issued-intext">
    <group delimiter=" ">
      <choose>
        <if variable="original-date">
          <date variable="original-date" prefix="[" suffix="]">
            <date-part name="year"/>
          </date>
        </if>
      </choose>
      <choose>
        <if variable="issued">
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <text variable="year-suffix"/>
        </if>
        <else>
          <text term="no date"/>
          <text variable="year-suffix"/>
        </else>
      </choose>
    </group>
  </macro>
  <!-- Title: italic for stand-alone works, roman for articles/chapters. -->
  <!-- text-case="title" is automatically suppressed by CSL processors for items whose -->
  <!-- `language` field is set to a non-English code, so Spanish/French/German titles -->
  <!-- retain their sentence-style capitalization as imported. -->
  <macro name="title">
    <choose>
      <if type="bill book graphic legal_case legislation motion_picture report song manuscript" match="any">
        <text variable="title" font-style="italic" text-case="title"/>
      </if>
      <else-if type="thesis speech" match="any">
        <text variable="title" text-case="title"/>
      </else-if>
      <else>
        <text variable="title" text-case="title"/>
      </else>
    </choose>
  </macro>
  <macro name="container-title">
    <text variable="container-title" font-style="italic" text-case="title"/>
  </macro>
  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>
  <macro name="locator-intext">
    <group>
      <choose>
        <if locator="page">
          <text variable="locator"/>
        </if>
        <else>
          <group delimiter=" ">
            <label variable="locator" form="short"/>
            <text variable="locator"/>
          </group>
        </else>
      </choose>
    </group>
  </macro>
  <!-- ============ CITATION ============ -->
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="true" collapse="year" cite-group-delimiter=", " year-suffix-delimiter="" after-collapse-delimiter="; ">
    <sort>
      <key macro="author-short"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=" ">
        <text macro="author-short"/>
        <group>
          <text macro="issued-intext"/>
          <text macro="locator-intext" prefix=":"/>
        </group>
      </group>
    </layout>
  </citation>
  <!-- ============ BIBLIOGRAPHY ============ -->
  <bibliography hanging-indent="true" et-al-min="11" et-al-use-first="7" subsequent-author-substitute="" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <!-- Author line -->
      <group display="block">
        <text macro="author"/>
      </group>
      <!-- Year + content as a block; year hangs, content indented in DO layout -->
      <group display="block">
        <group delimiter=" ">
          <text macro="issued-bib"/>
          <choose>
            <!-- JOURNAL ARTICLE -->
            <if type="article-journal article-magazine" match="any">
              <group delimiter=" ">
                <group delimiter=". " suffix=".">
                  <text macro="title"/>
                  <group delimiter=" ">
                    <text macro="container-title"/>
                    <group>
                      <text variable="volume"/>
                      <text variable="issue" prefix="(" suffix=")"/>
                      <text variable="page" prefix=":"/>
                    </group>
                  </group>
                </group>
                <text variable="publisher-place" suffix="."/>
              </group>
            </if>
            <!-- NEWSPAPER -->
            <else-if type="article-newspaper">
              <group delimiter=". " suffix=".">
                <text macro="title"/>
                <group delimiter=", ">
                  <text macro="container-title"/>
                  <text variable="publisher-place"/>
                </group>
              </group>
            </else-if>
            <!-- CHAPTER / ARTICLE IN EDITED VOLUME -->
            <else-if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
              <choose>
                <!-- presented paper (has event, no container editor) -->
                <if type="paper-conference" match="any">
                  <choose>
                    <if variable="container-title editor" match="none">
                      <group delimiter=" " suffix=".">
                        <text macro="title" suffix="."/>
                        <group delimiter=" ">
                          <text value="Paper presented at the"/>
                          <text variable="event"/>
                          <text variable="event-place" prefix=", "/>
                        </group>
                      </group>
                    </if>
                    <else>
                      <group delimiter=". " suffix=".">
                        <text macro="title"/>
                        <group delimiter=" ">
                          <text term="in" text-case="capitalize-first"/>
                          <text macro="container-title" suffix=","/>
                          <text macro="container-editor-translator" suffix=","/>
                          <group delimiter=" ">
                            <label variable="page" form="short"/>
                            <text variable="page"/>
                          </group>
                        </group>
                        <text macro="publisher"/>
                      </group>
                    </else>
                  </choose>
                </if>
                <else>
                  <group delimiter=". " suffix=".">
                    <text macro="title"/>
                    <group>
                      <group delimiter=" ">
                        <text term="in" text-case="capitalize-first"/>
                        <text macro="container-title" suffix=","/>
                        <text macro="container-editor-translator" suffix=","/>
                        <group delimiter=" ">
                          <label variable="page" form="short"/>
                          <text variable="page"/>
                        </group>
                      </group>
                    </group>
                    <text macro="publisher"/>
                  </group>
                </else>
              </choose>
            </else-if>
            <!-- THESIS / DISSERTATION -->
            <else-if type="thesis">
              <group delimiter=". " suffix=".">
                <text macro="title"/>
                <group delimiter=", ">
                  <text variable="genre"/>
                  <text variable="publisher"/>
                  <text variable="publisher-place"/>
                </group>
              </group>
            </else-if>
            <!-- WEBPAGE / ELECTRONIC -->
            <else-if type="webpage post post-weblog dataset" match="any">
              <group delimiter=" " suffix=".">
                <text macro="title" suffix="."/>
                <group delimiter=", ">
                  <text value="Electronic document"/>
                  <text variable="URL"/>
                  <group delimiter=" ">
                    <text term="accessed"/>
                    <date variable="accessed" form="text"/>
                  </group>
                </group>
              </group>
            </else-if>
            <!-- BOOK / DEFAULT -->
            <else>
              <group delimiter=". " suffix=".">
                <text macro="title"/>
                <group delimiter=" ">
                  <choose>
                    <if variable="container-title">
                      <group delimiter=" ">
                        <group delimiter=" ">
                          <label variable="volume" form="short" text-case="capitalize-first"/>
                          <text variable="volume"/>
                        </group>
                        <text value="of"/>
                        <text macro="container-title"/>
                        <group prefix=", ">
                          <text macro="container-editor-translator"/>
                        </group>
                      </group>
                    </if>
                  </choose>
                  <text macro="translator"/>
                  <text macro="editor"/>
                  <group delimiter=" ">
                    <text variable="number-of-volumes"/>
                    <label variable="number-of-volumes" form="short"/>
                  </group>
                </group>
                <text macro="publisher"/>
              </group>
            </else>
          </choose>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
