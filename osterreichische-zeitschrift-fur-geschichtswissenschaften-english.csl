<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="never" page-range-format="expanded" default-locale="en-US">
  <info>
    <title>Österreichische Zeitschrift für Geschichtswissenschaften (English)</title>
    <title-short>OeZG Austrian Journal of Historical Studies</title-short>
    <id>http://www.zotero.org/styles/osterreichische-zeitschrift-fur-geschichtswissenschaften-english</id>
    <link href="http://www.zotero.org/styles/osterreichische-zeitschrift-fur-geschichtswissenschaften-english" rel="self"/>
    <link href="https://journals.univie.ac.at/index.php/oezg/oezgstylesheet" rel="documentation"/>
    <author>
      <name>Maximilian Dick</name>
      <uri>https://orcid.org/0000-0002-8198-3939</uri>
    </author>
    <category citation-format="note"/>
    <category field="history"/>
    <category field="humanities"/>
    <issn>1016-765X</issn>
    <eissn>2707-966X</eissn>
    <summary>Citation style of the Austrian Journal of Historical Studies (OeZG) for English-language manuscripts, based on the English version of the OeZG stylesheet (2026). Full note for the first citation, short title thereafter; "Ibid." for immediately consecutive references.</summary>
    <updated>2026-09-24T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <!-- OeZG 2026 list of abbreviations: "edition > edn", "editor(s) > (ed.) or (eds)",
            "volume(s) > vol. or vols". No full stop where the abbreviation ends in the last letter of the word, hence "edn",
            "eds" and "vols", but "ed." and "vol." in the singular. -->
      <term name="edition" form="short">edn</term>
      <!-- The stylesheet sets ordinal suffixes in superscript ("2nd edn", "3rd enl. edn"). -->
      <term name="ordinal">ᵗʰ</term>
      <term name="ordinal-01">ˢᵗ</term>
      <term name="ordinal-02">ⁿᵈ</term>
      <term name="ordinal-03">ʳᵈ</term>
      <term name="ordinal-11">ᵗʰ</term>
      <term name="ordinal-12">ᵗʰ</term>
      <term name="ordinal-13">ᵗʰ</term>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds</multiple>
      </term>
      <term name="volume" form="short">
        <single>vol.</single>
        <multiple>vols</multiple>
      </term>
    </terms>
  </locale>
  <!-- Authors (first name last name, separated by slashes; "et al." from four names on); editors with (ed.)/(eds) if there are no authors -->
  <macro name="contributors">
    <names variable="author">
      <name delimiter="/" delimiter-precedes-last="always" et-al-min="4" et-al-use-first="1"/>
      <substitute>
        <names variable="editor">
          <name delimiter="/" delimiter-precedes-last="always" et-al-min="4" et-al-use-first="1"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </substitute>
    </names>
  </macro>
  <macro name="contributors-short">
    <names variable="author">
      <name form="short" delimiter="/" delimiter-precedes-last="always" et-al-min="4" et-al-use-first="1"/>
      <substitute>
        <names variable="editor">
          <name form="short" delimiter="/" delimiter-precedes-last="always" et-al-min="4" et-al-use-first="1"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>
  <!-- Editors of the edited volume after "in:" -->
  <macro name="container-contributors">
    <names variable="editor container-author">
      <name delimiter="/" delimiter-precedes-last="always" et-al-min="4" et-al-use-first="1"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <!-- Year of publication; [n.d.] if missing -->
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text value="[n.d.]"/>
      </else>
    </choose>
  </macro>
  <!-- Full date: 20 July 1940 -->
  <macro name="full-date">
    <date variable="issued" delimiter=" ">
      <date-part name="day" form="numeric"/>
      <date-part name="month" form="long"/>
      <date-part name="year"/>
    </date>
  </macro>
  <!-- Place year; [n.p.] if the place is missing -->
  <macro name="place-year">
    <group delimiter=" ">
      <choose>
        <if variable="publisher-place">
          <text variable="publisher-place"/>
        </if>
        <else>
          <text value="[n.p.]"/>
        </else>
      </choose>
      <text macro="year"/>
    </group>
  </macro>
  <!-- Place year without the [n.p.] fallback (theses, reports etc.) -->
  <macro name="place-year-soft">
    <group delimiter=" ">
      <text variable="publisher-place"/>
      <text macro="year"/>
    </group>
  </macro>
  <!-- Edition: enter from the 2nd edition onwards only (leave the field empty for first editions) -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <!-- Volumes: "5 vols" or "vol. 3" -->
  <macro name="volumes">
    <group delimiter=", ">
      <group delimiter=" ">
        <number variable="number-of-volumes"/>
        <text term="volume" form="short" plural="true"/>
      </group>
      <group delimiter=" ">
        <text term="volume" form="short"/>
        <number variable="volume"/>
      </group>
    </group>
  </macro>
  <!-- Access date: (28 June 2000) -->
  <macro name="accessed">
    <date variable="accessed" delimiter=" " prefix="(" suffix=")">
      <date-part name="day" form="numeric"/>
      <date-part name="month" form="long"/>
      <date-part name="year"/>
    </date>
  </macro>
  <!-- DOI (as https://doi.org/…) or URL with access date -->
  <macro name="online">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text variable="URL"/>
          <text macro="accessed"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="locator">
    <text variable="locator"/>
  </macro>
  <!-- Interviews: "Interview with [name] (b. yyyy). Interview conducted on [date] by
        [name], transcript, [page] (location of the transcript: [location])."
        Zotero item type "Interview": interviewee = author, interviewer = interviewer,
        medium = "transcript", archive = location of the transcript;
        the optional year of birth goes into the "Extra" field as: original-date: 1936 -->
  <macro name="interview-medium">
    <choose>
      <if variable="medium">
        <text variable="medium"/>
      </if>
      <else>
        <text value="transcript"/>
      </else>
    </choose>
  </macro>
  <macro name="interview">
    <group delimiter=", ">
      <group delimiter=". ">
        <group delimiter=" ">
          <names variable="author" prefix="Interview with ">
            <name delimiter="/" delimiter-precedes-last="always"/>
          </names>
          <date variable="original-date" prefix="(b. " suffix=")">
            <date-part name="year"/>
          </date>
        </group>
        <choose>
          <if variable="issued">
            <group delimiter=" ">
              <text value="Interview conducted on"/>
              <text macro="full-date"/>
              <names variable="interviewer" prefix="by ">
                <name delimiter="/" delimiter-precedes-last="always"/>
              </names>
            </group>
          </if>
          <else>
            <names variable="interviewer" prefix="Interview conducted by ">
              <name delimiter="/" delimiter-precedes-last="always"/>
            </names>
          </else>
        </choose>
      </group>
      <choose>
        <if variable="locator">
          <group delimiter=" ">
            <group delimiter=", ">
              <text macro="interview-medium"/>
              <text macro="locator"/>
            </group>
            <text variable="archive" prefix="(location of the transcript: " suffix=")"/>
          </group>
        </if>
        <else>
          <group delimiter=" ">
            <text macro="interview-medium"/>
            <text variable="archive" prefix="(location of the transcript: " suffix=")"/>
          </group>
        </else>
      </choose>
    </group>
  </macro>
  <!-- Archival sources: "Státní ústřední archiv (SÚA) Praha [State Central Archive Prague],
        Berní rula (BR) [Steuerrolle] 52." Subsequent: "SÚA, BR 52."
        Zotero item type "Manuscript" with the "Archive" field filled in; shelfmark in
        "Loc. in Archive"; the abbreviation used later in the "Short Title" field. -->
  <macro name="archival">
    <group delimiter=", ">
      <text macro="contributors"/>
      <text variable="title"/>
      <text variable="archive"/>
      <text variable="archive_location"/>
      <text macro="locator"/>
    </group>
  </macro>
  <!-- Full citation -->
  <macro name="full-citation">
    <choose>
      <!-- Journal article -->
      <if type="article-journal">
        <group delimiter=", ">
          <text macro="contributors"/>
          <text variable="title"/>
          <group delimiter=" " prefix="in: ">
            <text variable="container-title"/>
            <group delimiter="/">
              <text variable="volume"/>
              <text variable="issue"/>
            </group>
            <text macro="year" prefix="(" suffix=")"/>
          </group>
          <text variable="page"/>
          <text macro="locator"/>
          <text macro="online"/>
        </group>
      </if>
      <!-- Chapter in an edited volume -->
      <else-if type="chapter entry entry-encyclopedia entry-dictionary paper-conference">
        <group delimiter=", ">
          <text macro="contributors"/>
          <text variable="title"/>
          <group delimiter=", " prefix="in: ">
            <text macro="container-contributors"/>
            <text variable="container-title"/>
            <text macro="volumes"/>
            <text macro="edition"/>
            <text macro="place-year"/>
            <text variable="page"/>
            <text macro="locator"/>
          </group>
          <text macro="online"/>
        </group>
      </else-if>
      <!-- Interviews -->
      <else-if type="interview">
        <text macro="interview"/>
      </else-if>
      <!-- Archival sources (manuscript with the archive field filled in) -->
      <else-if type="manuscript" variable="archive" match="all">
        <text macro="archival"/>
      </else-if>
      <!-- Theses and unpublished manuscripts -->
      <else-if type="thesis manuscript report">
        <group delimiter=", ">
          <text macro="contributors"/>
          <text variable="title"/>
          <text variable="genre"/>
          <choose>
            <if variable="publisher-place">
              <group delimiter=", ">
                <text variable="publisher"/>
                <text macro="place-year-soft"/>
              </group>
            </if>
            <else>
              <group delimiter=" ">
                <text variable="publisher"/>
                <text macro="year"/>
              </group>
            </else>
          </choose>
          <text macro="locator"/>
          <text macro="online"/>
        </group>
      </else-if>
      <!-- Newspaper and magazine articles -->
      <else-if type="article-newspaper article-magazine">
        <group delimiter=", ">
          <group delimiter=", ">
            <text macro="contributors"/>
            <text variable="title"/>
          </group>
          <choose>
            <if variable="title author" match="any">
              <group delimiter=", " prefix="in: ">
                <text variable="container-title"/>
                <text macro="full-date"/>
              </group>
            </if>
            <else>
              <group delimiter=", ">
                <text variable="container-title"/>
                <text macro="full-date"/>
              </group>
            </else>
          </choose>
          <text variable="page"/>
          <text macro="locator"/>
          <text macro="online"/>
        </group>
      </else-if>
      <!-- Internet sources -->
      <else-if type="webpage post-weblog post">
        <group delimiter=", ">
          <text macro="contributors"/>
          <text variable="title"/>
          <text variable="container-title" prefix="in: "/>
          <text macro="full-date"/>
          <text macro="locator"/>
          <group delimiter=" ">
            <text variable="URL"/>
            <text macro="accessed"/>
          </group>
        </group>
      </else-if>
      <!-- Books, edited volumes and everything else -->
      <else>
        <group delimiter=", ">
          <text macro="contributors"/>
          <text variable="title"/>
          <text macro="edition"/>
          <text macro="volumes"/>
          <text macro="place-year"/>
          <text macro="locator"/>
          <text macro="online"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation disambiguate-add-names="false" disambiguate-add-givenname="false">
    <layout suffix="." delimiter="; ">
      <choose>
        <!-- Ibid. only for immediately consecutive references -->
        <if position="ibid-with-locator">
          <group delimiter=", ">
            <text term="ibid" text-case="capitalize-first"/>
            <text macro="locator"/>
          </group>
        </if>
        <else-if position="ibid">
          <text term="ibid" text-case="capitalize-first"/>
        </else-if>
        <!-- Short citation: last name, short title, year, page -->
        <!-- Subsequent reference to an interview: "Interview with Peter Weish, 2015, 14." -->
        <else-if position="subsequent" type="interview" match="all">
          <group delimiter=", ">
            <names variable="author" prefix="Interview with ">
              <name delimiter="/" delimiter-precedes-last="always"/>
            </names>
            <text macro="year"/>
            <text macro="locator"/>
          </group>
        </else-if>
        <!-- Subsequent reference to an archival source: "SÚA, BR 52." -->
        <else-if position="subsequent" type="manuscript" variable="archive" match="all">
          <group delimiter=", ">
            <text variable="title" form="short"/>
            <text variable="archive_location"/>
            <text macro="locator"/>
          </group>
        </else-if>
        <else-if position="subsequent">
          <group delimiter=", ">
            <text macro="contributors-short"/>
            <text variable="title" form="short"/>
            <choose>
              <if type="book chapter entry entry-encyclopedia entry-dictionary" match="any">
                <group delimiter=" ">
                  <text term="volume" form="short"/>
                  <number variable="volume"/>
                </group>
              </if>
            </choose>
            <choose>
              <if type="article-newspaper article-magazine webpage post-weblog post" match="any">
                <text macro="full-date"/>
              </if>
              <else>
                <text macro="year"/>
              </else>
            </choose>
            <text macro="locator"/>
          </group>
        </else-if>
        <else>
          <text macro="full-citation"/>
        </else>
      </choose>
    </layout>
  </citation>
  <!-- Note: the OeZG uses footnotes only; the bibliography (same format as the full citation) is included as a convenience. -->
  <bibliography>
    <sort>
      <key macro="contributors"/>
      <key macro="year"/>
    </sort>
    <layout suffix=".">
      <text macro="full-citation"/>
    </layout>
  </bibliography>
</style>
