<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" page-range-format="expanded" default-locale="en-US">
  <info>
    <title>International Journal of Drug Discovery and Pharmaceutical Innovation</title>
    <title-short>Int. J. Drug Discov. Pharm. Innov.</title-short>
    <id>http://www.zotero.org/styles/international-journal-of-drug-discovery-and-pharmaceutical-innovation</id>
    <link href="http://www.zotero.org/styles/international-journal-of-drug-discovery-and-pharmaceutical-innovation" rel="self"/>
    <link href="https://ijddpi.com/index.php/ijddpi/about/submissions" rel="documentation"/>
    <author>
      <name>IJDDPI Editorial Office</name>
      <email>editor@ijddpi.com</email>
    </author>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <category field="chemistry"/>
    <summary>Numeric reference style for the International Journal of Drug Discovery
      and Pharmaceutical Innovation (IJDDPI), based on Vancouver conventions.
      References use numbered citations, abbreviated journal titles, up to six
      authors followed by et al., and DOI links where available.</summary>
    <updated>2026-09-20T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="et-al">et al.</term>
      <term name="page-range-delimiter">-</term>
      <term name="editor" form="short">editor</term>
    </terms>
  </locale>
  <!-- AUTHORS -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", " delimiter-precedes-last="always" delimiter-precedes-et-al="always"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>
  <!-- EDITORS -->
  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", " delimiter-precedes-last="always"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <!-- PUBLISHER -->
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <!-- YEAR -->
  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <!-- ACCESS DATE -->
  <macro name="accessed">
    <date variable="accessed" prefix=" [cited " suffix="]">
      <date-part name="day" suffix=" "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>
  <!-- EDITION -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <!-- DOI -->
  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
    </choose>
  </macro>
  <!-- IN-TEXT CITATIONS -->
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <!-- REFERENCES -->
  <bibliography et-al-min="7" et-al-use-first="6" second-field-align="flush">
    <layout>
      <text variable="citation-number" suffix=". "/>
      <choose>
        <!-- BOOKS AND REPORTS -->
        <if type="book report" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title"/>
            <text macro="edition"/>
            <group delimiter="; ">
              <text macro="publisher"/>
              <text macro="issued"/>
            </group>
          </group>
          <text macro="doi" prefix=". "/>
        </if>
        <!-- BOOK CHAPTERS AND CONFERENCE PAPERS -->
        <else-if type="chapter paper-conference" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title"/>
            <group delimiter=" ">
              <text term="in" text-case="capitalize-first"/>
              <text macro="editor"/>
              <text variable="container-title" prefix=": "/>
            </group>
            <text macro="edition"/>
            <group delimiter="; ">
              <text macro="publisher"/>
              <text macro="issued"/>
            </group>
            <group delimiter=" ">
              <label variable="page" form="short" plural="never"/>
              <text variable="page"/>
            </group>
          </group>
          <text macro="doi" prefix=". "/>
        </else-if>
        <!-- THESES AND DISSERTATIONS -->
        <else-if type="thesis">
          <group delimiter=". ">
            <text macro="author"/>
            <group delimiter=" ">
              <text variable="title"/>
              <text variable="genre" prefix="[" suffix="]"/>
            </group>
            <group delimiter="; ">
              <text macro="publisher"/>
              <text macro="issued"/>
            </group>
          </group>
          <text macro="doi" prefix=". "/>
        </else-if>
        <!-- PATENTS -->
        <else-if type="patent">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title"/>
            <text variable="number"/>
            <text macro="issued"/>
          </group>
          <text macro="doi" prefix=". "/>
        </else-if>
        <!-- WEBSITES -->
        <else-if type="webpage post-weblog" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title" suffix=" [Internet]"/>
            <group delimiter="; ">
              <text macro="publisher"/>
              <text macro="issued"/>
            </group>
          </group>
          <text macro="accessed"/>
          <text variable="URL" prefix=". Available from: "/>
        </else-if>
        <!-- JOURNAL ARTICLES -->
        <else>
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title"/>
            <group delimiter=". ">
              <text variable="container-title" form="short"/>
              <group delimiter=";">
                <text macro="issued"/>
                <group>
                  <text variable="volume"/>
                  <text variable="issue" prefix="(" suffix=")"/>
                  <text variable="page" prefix=":"/>
                </group>
              </group>
            </group>
          </group>
          <text macro="doi" prefix=". "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
