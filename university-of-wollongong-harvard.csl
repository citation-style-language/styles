<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" page-range-format="minimal" demote-non-dropping-particle="never" default-locale="en-GB">
  <info>
    <title>University of Wollongong (author-date/Harvard)</title>
    <title-short>UOW</title-short>
    <id>http://www.zotero.org/styles/university-of-wollongong-harvard</id>
    <link href="http://www.zotero.org/styles/university-of-wollongong-harvard" rel="self"/>
    <link href="http://www.zotero.org/styles/elsevier-harvard" rel="template"/>
    <link href="https://www.uow.edu.au/student/learning-co-op/referencing-and-citing/" rel="documentation"/>
    <author>
      <name>Terence Geoffrey Watts</name>
    </author>
    <contributor>
      <name>Patrick O'Brien</name>
    </contributor>
    <category citation-format="author-date"/>
    <summary>The Harvard referencing style as published by the University of Wollongong, Australia.</summary>
    <updated>2026-08-08T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="accessed">viewed</term>
      <term name="retrieved">retrieved from</term>
    </terms>
  </locale>
  <!-- SLOT 1: author. Surname first, initials closed up: Smith, MJ -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="" delimiter=", " and="symbol" delimiter-precedes-last="never"/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="composer"/>
        <text variable="authority"/>
        <text macro="av-name"/>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="symbol" delimiter=", " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor">
          <label form="short" suffix=" "/>
          <name form="short" and="symbol" delimiter=", " delimiter-precedes-last="never"/>
        </names>
        <names variable="composer"/>
        <text variable="authority"/>
        <text macro="av-name"/>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>
  <!-- Broadcasts with no author lead with "Episode title, Series title" -->
  <macro name="av-name">
    <choose>
      <if type="broadcast">
        <choose>
          <if variable="container-title">
            <group delimiter=", ">
              <text variable="title"/>
              <text variable="container-title" font-style="italic"/>
            </group>
          </if>
          <else>
            <text variable="title" font-style="italic"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- Sort key: legal material files under its title, everything else under its author -->
  <macro name="sort-name">
    <choose>
      <if type="legal_case legislation bill" match="any">
        <text variable="title"/>
      </if>
      <else>
        <text macro="author"/>
      </else>
    </choose>
  </macro>
  <!-- SLOT 2: year -->
  <macro name="issued">
    <group>
      <choose>
        <if variable="issued">
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </if>
        <else>
          <text term="no date" form="short"/>
        </else>
      </choose>
      <text variable="year-suffix"/>
    </group>
  </macro>
  <macro name="issued-sort">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text value="0000"/>
      </else>
    </choose>
  </macro>
  <macro name="issued-day-month">
    <date variable="issued">
      <date-part name="day" suffix=" "/>
      <date-part name="month" form="long"/>
    </date>
  </macro>
  <!-- SLOT 3: title. Italic if the work stands alone, single quotes if contained or unpublished -->
  <macro name="title">
    <choose>
      <!-- Social media posts take no quotes and no italics -->
      <if type="post">
        <text variable="title"/>
      </if>
      <else-if type="book document graphic hearing manuscript map motion_picture broadcast musical_score pamphlet patent report software standard song webpage dataset" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>
  <!-- SLOT 4: container. Journal, book, blog, conference or encyclopedia the item sits inside -->
  <macro name="container">
    <choose>
      <if type="chapter paper-conference" match="any">
        <group delimiter=" ">
          <text term="in"/>
          <group delimiter=", ">
            <text macro="container-editor"/>
            <text variable="container-title" font-style="italic"/>
          </group>
        </group>
      </if>
      <else-if type="entry-dictionary entry-encyclopedia" match="any">
        <group delimiter=", ">
          <group delimiter=" ">
            <text term="in"/>
            <text variable="container-title" font-style="italic"/>
          </group>
          <text macro="container-editor"/>
        </group>
      </else-if>
      <!-- Social media platform, course subject code -->
      <else-if type="post">
        <text variable="container-title"/>
      </else-if>
      <!-- Course material subject code is rendered in the locators slot -->
      <else-if type="speech"/>
      <else>
        <text variable="container-title" font-style="italic" text-case="title"/>
      </else>
    </choose>
  </macro>
  <macro name="container-editor">
    <names variable="editor">
      <name initialize-with="" delimiter=", " and="symbol" delimiter-precedes-last="never"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <!-- SLOT 5: format. Covers thesis, AV, blog posts, pamphlets and media releases in one place -->
  <macro name="format">
    <choose>
      <if type="software">
        <text value="[Computer software]"/>
      </if>
      <!-- Handled inside the locators slot instead, for ordering -->
      <else-if type="map speech" match="any"/>
      <else-if type="motion_picture broadcast song graphic musical_score" match="any">
        <choose>
          <if variable="medium">
            <text variable="medium"/>
          </if>
          <else>
            <text variable="genre"/>
          </else>
        </choose>
      </else-if>
      <else-if variable="genre">
        <text variable="genre"/>
      </else-if>
      <else>
        <text variable="medium"/>
      </else>
    </choose>
  </macro>
  <!-- Credits after the publication details: "directed by Woody Allen" -->
  <macro name="credits">
    <choose>
      <if type="motion_picture broadcast" match="any">
        <names variable="director">
          <label form="verb" suffix=" "/>
          <name and="text" delimiter=", "/>
        </names>
      </if>
    </choose>
  </macro>
  <!-- SLOT 6: publication details -->
  <macro name="locators">
    <choose>
      <if type="article-journal">
        <group delimiter=", ">
          <text macro="volume-issue"/>
          <text macro="pages"/>
        </group>
      </if>
      <else-if type="article-newspaper article-magazine post-weblog post" match="any">
        <group delimiter=", ">
          <text macro="issued-day-month"/>
          <text macro="pages"/>
        </group>
      </else-if>
      <else-if type="paper-conference">
        <group delimiter=", ">
          <text macro="publisher"/>
          <text macro="issued-day-month"/>
          <text macro="pages"/>
        </group>
      </else-if>
      <else-if type="standard">
        <group delimiter=", ">
          <text variable="number"/>
          <text macro="publisher"/>
        </group>
      </else-if>
      <else-if type="map">
        <group delimiter=", ">
          <text variable="collection-title"/>
          <text variable="genre"/>
          <text variable="scale"/>
          <text macro="edition"/>
          <text macro="publisher"/>
        </group>
      </else-if>
      <!-- Course material: subject code sits in the container slot, institution here -->
      <else-if type="speech">
        <group delimiter=", ">
          <text variable="genre"/>
          <text variable="container-title"/>
          <text macro="publisher"/>
        </group>
      </else-if>
      <else-if type="software">
        <group delimiter=", ">
          <group delimiter=" ">
            <label variable="version"/>
            <text variable="version"/>
          </group>
          <text macro="publisher"/>
        </group>
      </else-if>
      <else-if type="patent">
        <group delimiter=" ">
          <text variable="authority"/>
          <text variable="number"/>
        </group>
      </else-if>
      <else-if type="report">
        <group delimiter=", ">
          <choose>
            <!-- Series report: "series name, no. 12" -->
            <if variable="collection-title">
              <group delimiter=", ">
                <text variable="collection-title"/>
                <group delimiter=" ">
                  <text term="issue" form="short"/>
                  <text variable="collection-number"/>
                </group>
              </group>
            </if>
            <!-- Otherwise treat a report number as an ABS catalogue number -->
            <else>
              <text variable="number" prefix="cat. no. "/>
            </else>
          </choose>
          <text macro="publisher"/>
        </group>
      </else-if>
      <!-- Hansard and parliamentary papers -->
      <else-if type="hearing">
        <group delimiter=", ">
          <group delimiter=" ">
            <text variable="section" prefix="(" suffix=")"/>
            <text variable="number"/>
          </group>
          <group delimiter=" ">
            <label variable="volume" form="short"/>
            <text variable="volume"/>
          </group>
          <text macro="pages"/>
          <text macro="publisher"/>
        </group>
      </else-if>
      <else-if type="motion_picture broadcast song graphic document pamphlet" match="any">
        <choose>
          <if variable="URL accessed" match="none">
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="issued-day-month"/>
            </group>
          </if>
          <else>
            <group delimiter=", ">
              <text macro="issued-day-month"/>
              <text macro="publisher"/>
            </group>
          </else>
        </choose>
      </else-if>
      <else-if type="personal_communication">
        <text macro="issued-day-month"/>
      </else-if>
      <else>
        <group delimiter=", ">
          <text macro="edition"/>
          <text macro="translator"/>
          <text macro="publisher"/>
          <text macro="pages"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="volume-issue">
    <group delimiter=", ">
      <group delimiter=" ">
        <label variable="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <group delimiter=" ">
        <label variable="issue" form="short"/>
        <text variable="issue"/>
      </group>
    </group>
  </macro>
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <label variable="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="translator">
    <names variable="translator">
      <label form="short" suffix=" "/>
      <name initialize-with="" delimiter=", " and="symbol" delimiter-precedes-last="never"/>
    </names>
  </macro>
  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>
  <!-- SLOT 8: DOI, shown wherever one exists regardless of item type -->
  <macro name="doi">
    <text variable="DOI" prefix="DOI: "/>
  </macro>
  <!-- SLOT 7: viewed date and URL. UOW only wants these where the source has no
       print equivalent, so print-form types suppress them even when Zotero has
       auto-filled an access date. -->
  <macro name="access">
    <choose>
      <!-- A DOI supersedes the URL and viewed date entirely -->
      <if variable="DOI"/>
      <!-- Ebooks are referenced exactly as printed books -->
      <else-if type="book chapter thesis" match="any"/>
      <!-- Articles: only when there are no page numbers, i.e. online-only -->
      <else-if type="article-journal article-magazine article-newspaper paper-conference" match="any">
        <choose>
          <if variable="page" match="none">
            <text macro="access-detail"/>
          </if>
        </choose>
      </else-if>
      <else>
        <text macro="access-detail"/>
      </else>
    </choose>
  </macro>
  <macro name="access-detail">
    <group delimiter=", ">
      <group delimiter=" ">
        <text term="accessed"/>
        <date variable="accessed">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="long" suffix=" "/>
          <date-part name="year"/>
        </date>
      </group>
      <choose>
        <if variable="URL">
          <text variable="URL" prefix="&lt;" suffix="&gt;"/>
        </if>
        <!-- Subscription databases have no citable URL -->
        <else-if type="report document patent standard dataset" match="any">
          <group delimiter=" ">
            <text term="retrieved"/>
            <choose>
              <if variable="archive">
                <text variable="archive"/>
              </if>
              <else>
                <text variable="source"/>
              </else>
            </choose>
          </group>
        </else-if>
      </choose>
    </group>
  </macro>
  <!-- Jurisdiction: Extra field "jurisdiction: Cth", else Legislative Body, else Code -->
  <macro name="jurisdiction">
    <group prefix="(" suffix=")">
      <choose>
        <if variable="jurisdiction">
          <text variable="jurisdiction"/>
        </if>
        <else-if variable="authority">
          <text variable="authority"/>
        </else-if>
        <else>
          <text variable="container-title"/>
        </else>
      </choose>
    </group>
  </macro>
  <!-- Legal material bypasses the pipeline: no author, no publisher, no URL -->
  <!-- Reference list. Case names are roman here and italic in-text, per the guide. -->
  <macro name="legal">
    <choose>
      <if type="legal_case">
        <group delimiter=" ">
          <text variable="title"/>
          <date variable="issued" prefix="(" suffix=")">
            <date-part name="year"/>
          </date>
          <text variable="volume"/>
          <text variable="container-title"/>
          <text variable="page"/>
        </group>
      </if>
      <!-- Bills are unpublished, so roman type throughout -->
      <else-if type="bill">
        <group delimiter=" ">
          <text variable="title"/>
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <text macro="jurisdiction"/>
        </group>
      </else-if>
      <!-- Acts: title and year both italicised -->
      <else>
        <group delimiter=" ">
          <group delimiter=" " font-style="italic">
            <text variable="title"/>
            <date variable="issued">
              <date-part name="year"/>
            </date>
          </group>
          <text macro="jurisdiction"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- In-text. Acts drop the date and lose italics after the first citation. -->
  <macro name="legal-intext">
    <choose>
      <if type="legal_case">
        <group delimiter=" ">
          <text variable="title" font-style="italic"/>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </group>
      </if>
      <else-if type="bill">
        <group delimiter=" ">
          <text variable="title"/>
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <text macro="jurisdiction"/>
        </group>
      </else-if>
      <else-if position="subsequent">
        <text variable="title"/>
      </else-if>
      <else>
        <group delimiter=" ">
          <group delimiter=" " font-style="italic">
            <text variable="title"/>
            <date variable="issued">
              <date-part name="year"/>
            </date>
          </group>
          <text macro="jurisdiction"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="cite-locator">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="true" disambiguate-add-givenname="true" givenname-disambiguation-rule="primary-name" collapse="year" cite-group-delimiter=", ">
    <sort>
      <key macro="author-short"/>
      <key macro="issued-sort"/>
      <key variable="title"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <choose>
        <if type="legal_case legislation bill" match="any">
          <group delimiter=", ">
            <text macro="legal-intext"/>
            <text macro="cite-locator"/>
          </group>
        </if>
        <else>
          <group delimiter=", ">
            <group delimiter=" ">
              <text macro="author-short"/>
              <text macro="issued"/>
            </group>
            <text macro="cite-locator"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography hanging-indent="true" line-spacing="2" entry-spacing="0">
    <sort>
      <key macro="sort-name"/>
      <key macro="issued-sort"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="legal_case legislation bill" match="any">
          <text macro="legal"/>
        </if>
        <else>
          <group delimiter=", ">
            <group delimiter=" ">
              <text macro="author"/>
              <text macro="issued"/>
            </group>
            <text macro="title"/>
            <text macro="container"/>
            <text macro="format"/>
            <text macro="locators"/>
            <text macro="credits"/>
            <text macro="access"/>
            <text macro="doi"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
