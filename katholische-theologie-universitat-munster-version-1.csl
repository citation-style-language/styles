<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="never">
  <!-- This style was edited with the Visual CSL Editor (https://editor.citationstyles.org/visualEditor/) -->
  <info>
    <title>Katholische Theologie | Universität Münster | Version: 1.0</title>
    <title-short>kath_theo_uni_mue</title-short>
    <id>http://www.zotero.org/styles/katholische-theologie-universitat-munster-version-1</id>
    <link href="http://www.zotero.org/styles/katholische-theologie-universitat-munster-version-1" rel="self"/>
    <link href="https://www.uni-muenster.de/FB2/studienbuero/allgemeines.html" rel="documentation"/>
    <link href="https://www.ulb.uni-muenster.de/ulb-tutor/literaturverwaltung_zitieren/citavi/zitierstile.html" rel="documentation"/>
    <author>
      <name>Janis Jaspers</name>
      <email>jjaspers@uni-muenster.de</email>
    </author>
    <category citation-format="note"/>
    <category field="theology"/>
    <summary>A German citation style according to the guidelines of the Faculty of Catholic Theology at the University of Muenster.</summary>
    <updated>2026-09-21T09:55:22+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="de">
    <terms>
      <term name="et-al">u. a.</term>
      <term name="editor" form="short">
        <single>Hg.</single>
        <multiple>Hg.</multiple>
      </term>
      <term name="ibid">ebd.</term>
      <term name="circa" form="short">um</term>
    </terms>
  </locale>
  <macro name="contributors">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter="/">
        <name-part name="family" font-variant="small-caps"/>
      </name>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " delimiter="/">
            <name-part name="family" font-variant="small-caps"/>
          </name>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </substitute>
    </names>
  </macro>
  <macro name="contributors-short">
    <names variable="author">
      <name form="short" delimiter="/">
        <name-part name="family" font-variant="small-caps"/>
      </name>
      <substitute>
        <names variable="editor">
          <name form="short" delimiter="/">
            <name-part name="family" font-variant="small-caps"/>
          </name>
        </names>
      </substitute>
    </names>
  </macro>
  <macro name="title">
    <choose>
      <if type="entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=" ">
          <text value="Art."/>
          <text variable="title"/>
        </group>
      </if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>
  <macro name="series-note">
    <choose>
      <if variable="collection-title">
        <group prefix=" (" suffix=")">
          <text variable="collection-title"/>
          <text variable="collection-number" prefix=" "/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="volume-multivolume">
    <choose>
      <if variable="number-of-volumes">
        <group prefix=", ">
          <number variable="number-of-volumes"/>
          <text value=" Bde."/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="publisher-date">
    <group delimiter=" ">
      <group>
        <text variable="publisher-place"/>
        <number variable="edition" vertical-align="sup"/>
      </group>
      <date variable="issued">
        <date-part name="year" range-delimiter="&#8211;"/>
      </date>
    </group>
  </macro>
  <macro name="container-contributors">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=", " delimiter="/">
        <name-part name="family" font-variant="small-caps"/>
      </name>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="container-locators">
    <choose>
      <if type="article-journal article-magazine" match="any">
        <group>
          <text value="In: "/>
          <group delimiter=" ">
            <text variable="container-title" form="long"/>
            <group>
              <text variable="volume"/>
              <text variable="issue" prefix="/"/>
            </group>
          </group>
          <date variable="issued" prefix=" (" suffix=")">
            <date-part name="year"/>
          </date>
          <text variable="page" prefix=", "/>
        </group>
      </if>
      <else-if type="chapter paper-conference" match="any">
        <group delimiter=". ">
          <group>
            <text value="In: "/>
            <group delimiter=": ">
              <text macro="container-contributors"/>
              <group>
                <text variable="container-title"/>
                <text macro="series-note"/>
              </group>
            </group>
          </group>
          <group delimiter=", ">
            <text macro="publisher-date"/>
            <text variable="page"/>
          </group>
        </group>
      </else-if>
      <else-if type="entry-encyclopedia entry-dictionary" match="any">
        <choose>
          <if variable="editor" match="none">
            <group>
              <text value="In: "/>
              <text variable="container-title" form="long"/>
              <text variable="volume" prefix=" "/>
              <group prefix=" (" suffix=")">
                <number variable="edition" vertical-align="sup"/>
                <date variable="issued">
                  <date-part name="year"/>
                </date>
              </group>
              <text variable="page" prefix=", "/>
            </group>
          </if>
          <else>
            <group delimiter=". ">
              <group>
                <text value="In: "/>
                <group delimiter=": ">
                  <text macro="container-contributors"/>
                  <text variable="container-title"/>
                </group>
              </group>
              <group delimiter=", ">
                <group delimiter=" ">
                  <text variable="publisher-place"/>
                  <group>
                    <number variable="edition" vertical-align="sup"/>
                    <date variable="issued">
                      <date-part name="year"/>
                    </date>
                  </group>
                </group>
                <text variable="page"/>
              </group>
            </group>
          </else>
        </choose>
      </else-if>
      <else-if type="article-newspaper">
        <group>
          <text value="In: "/>
          <text variable="container-title" form="long"/>
          <text value=" vom "/>
          <date variable="issued">
            <date-part name="day" form="numeric-leading-zeros" suffix="."/>
            <date-part name="month" form="numeric-leading-zeros" suffix="."/>
            <date-part name="year"/>
          </date>
          <text variable="page" prefix=", "/>
        </group>
      </else-if>
      <else-if type="webpage post post-weblog" match="any">
        <group>
          <text value="Online unter: "/>
          <text variable="URL"/>
          <group prefix=" (Stand: " suffix=")">
            <date variable="accessed">
              <date-part name="day" form="numeric-leading-zeros" suffix="."/>
              <date-part name="month" form="numeric-leading-zeros" suffix="."/>
              <date-part name="year"/>
            </date>
          </group>
        </group>
      </else-if>
      <else-if type="graphic">
        <group delimiter=". ">
          <group delimiter=", ">
            <text variable="title"/>
            <group>
              <choose>
                <if is-uncertain-date="issued">
                  <text term="circa" form="short" suffix=" "/>
                </if>
              </choose>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </group>
            <text variable="medium"/>
          </group>
          <group delimiter=": ">
            <text variable="archive-place"/>
            <text variable="archive"/>
          </group>
        </group>
      </else-if>
      <else>
        <text macro="publisher-date"/>
      </else>
    </choose>
  </macro>
  <macro name="locator">
    <text variable="locator"/>
  </macro>
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-names="true" disambiguate-add-givenname="true">
    <sort>
      <key macro="contributors"/>
    </sort>
    <layout suffix="." delimiter="; ">
      <choose>
        <if position="ibid-with-locator">
          <group delimiter=", ">
            <text term="ibid" text-case="capitalize-first"/>
            <text macro="locator"/>
          </group>
        </if>
        <else-if position="ibid">
          <text term="ibid" text-case="capitalize-first"/>
        </else-if>
        <else-if position="subsequent">
          <group delimiter=", ">
            <text macro="contributors-short"/>
            <text variable="title" form="short"/>
            <text macro="locator"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <choose>
              <if type="graphic">
                <group delimiter=": ">
                  <text macro="contributors"/>
                  <text macro="container-locators"/>
                </group>
              </if>
              <else>
                <group delimiter=": ">
                  <text macro="contributors"/>
                  <group delimiter=". ">
                    <group>
                      <text macro="title"/>
                      <text macro="volume-multivolume"/>
                      <choose>
                        <if type="article-journal article-magazine article-newspaper chapter paper-conference entry-encyclopedia entry-dictionary webpage post post-weblog graphic" match="none">
                          <text macro="series-note"/>
                        </if>
                      </choose>
                    </group>
                    <text macro="container-locators"/>
                  </group>
                </group>
              </else>
            </choose>
            <text macro="locator"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography et-al-min="4" et-al-use-first="1" hanging-indent="true" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="contributors"/>
      <key variable="issued" sort="ascending"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="graphic">
          <group delimiter=": ">
            <text macro="contributors"/>
            <text macro="container-locators"/>
          </group>
        </if>
        <else>
          <group delimiter=": ">
            <text macro="contributors"/>
            <group delimiter=". ">
              <group>
                <text macro="title"/>
                <text macro="volume-multivolume"/>
                <choose>
                  <if type="article-journal article-magazine article-newspaper chapter paper-conference entry-encyclopedia entry-dictionary webpage post post-weblog graphic" match="none">
                    <text macro="series-note"/>
                  </if>
                </choose>
              </group>
              <text macro="container-locators"/>
            </group>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
