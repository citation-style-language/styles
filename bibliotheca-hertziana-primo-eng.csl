<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" 
  version="1.0" page-range-format="expanded" 
  delimiter-precedes-last="never" et-al-min="4" 
  et-al-use-first="1" demote-non-dropping-particle="sort-only"
  default-locale="en-GB">

  <!-- ================================================
       Bibliotheca Hertziana - Max Planck Institute 
       for Art History
       English-language variant (for citing publications
       written in English). See bibliotheca-hertziana-primo-ger.csl for
       the German counterpart.
       Optimized for Ex Libris Alma/Primo
       ================================================ -->

  <info>
    <title>Bibliotheca Hertziana - Max Planck Institute for Art History (Primo/Alma, English)</title>
    <title-short>BHR-Primo-ENG</title-short>
    <id>http://www.zotero.org/styles/bibliotheca-hertziana-primo-eng</id>
    <link href="http://www.zotero.org/styles/bibliotheca-hertziana-primo-eng" rel="self"/>
    <link href="http://www.zotero.org/styles/bibliotheca-hertziana-max-planck-institute-for-art-history" rel="template"/>
    <link href="https://www.biblhertz.it/3170244/rjbh_editorial_guidelines_en.pdf" rel="documentation"/>
    <author>
      <name>Bibliotheca Hertziana</name>
    </author>
    <author>
      <name>Hedda Staub</name>
    </author>
    <category citation-format="note"/>
    <category field="humanities"/>
    <updated>2026-06-25T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <!-- ================================================
       LOCALE (English only - the connector words and
       punctuation conventions follow the language of
       the CITING publication, not of each cited item;
       see bibliotheca-hertziana-primo-ger.csl for the German counterpart)
       ================================================ -->

  <locale xml:lang="en">
    <terms>
      <term name="open-quote">&#8220;</term>
      <term name="close-quote">&#8221;</term>
      <term name="open-inner-quote">&#8216;</term>
      <term name="close-inner-quote">&#8217;</term>
      <term name="editor">
        <single>ed.</single>
        <multiple>ed.</multiple>
      </term>
      <term name="collection-editor">
        <single>ed.</single>
        <multiple>ed.</multiple>
      </term>
      <term name="page">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
      <term name="page-range-delimiter">&#8211;</term>
      <term name="anonymous">Anon.</term>
      <term name="accessed">accessed</term>
      <term name="thesis">thesis</term>
      <term name="number-of-volumes" form="short">
        <single>vol.</single>
        <multiple>vols.</multiple>
      </term>
      <term name="review-of">review of</term>
    </terms>
  </locale>

  <!-- ================================================
       KNOWN DATA-DEPENDENT LIMITATIONS (publisher-place)
       CSL cannot translate or reformat free-text field
       content - it only passes variables through as-is.
       This affects publisher-place in two ways:
       1. Place names appear in whatever language the
          cataloguing record uses (e.g. a record with
          "Napoli" instead of the English "Naples"),
          since CSL has no place-name translation
          mechanism.
       2. Multi-place notations follow whatever convention
          the record itself uses. If Alma maps MARC 264 $a
          verbatim to publisher-place, a record catalogued
          with "Napoli [u.a.]" (MARC/German cataloguing
          convention) will render literally as "Napoli
          [u.a.]" - not as the guideline-required "Naples
          et al." CSL has no way to detect or rewrite this
          notation, since it cannot inspect the variable's
          text content (see also the DOI and genre/thesis-
          type limitations documented elsewhere in this
          file for the same underlying reason).
       ================================================ -->

  <!-- ================================================
       MACROS
       ================================================ -->

  <!-- AUTHOR -->
  <!-- Falls back to editor/collection-editor (rendered -->
  <!-- empty here, handled by the title/type-specific    -->
  <!-- blocks) or "anonymous" if neither is present.      -->
  <!-- Oxford comma for 3+ authors per editorial guidelines -->
  <macro name="author">
    <choose>
      <if variable="author">
        <names variable="author" suffix=",">
          <name and="text" 
                initialize="false" 
                initialize-with="."
                delimiter=", "
                delimiter-precedes-last="contextual">
            <name-part name="given" 
                       text-case="capitalize-first"/>
            <name-part name="family" 
                       text-case="capitalize-first"/>
          </name>
        </names>
      </if>
      <else-if variable="editor collection-editor" 
               match="any"/>
      <else>
        <text term="anonymous" prefix="[" suffix="],"/>
      </else>
    </choose>
  </macro>

  <!-- EDITOR -->
  <!-- Produces: ed. First Last, / hg. v. First Last, -->
  <!-- Oxford comma for 3+ names per editorial guidelines -->
  <macro name="editor">
    <choose>
      <if variable="editor">
        <names variable="editor" suffix=", ">
          <label form="long" 
                 text-case="lowercase" 
                 suffix=" "/>
          <name and="text" 
                delimiter=", "
                delimiter-precedes-last="contextual"/>
        </names>
      </if>
      <else-if variable="collection-editor">
        <names variable="collection-editor" suffix=", ">
          <label form="long" 
                 text-case="lowercase" 
                 suffix=" "/>
          <name and="text" 
                delimiter=", "
                delimiter-precedes-last="contextual"/>
        </names>
      </else-if>
    </choose>
  </macro>

  <!-- VOLUMES -->
  <!-- Produces: 2 vols., / 2 Bde., -->
  <macro name="volumes">
    <choose>
      <if variable="number-of-volumes">
        <group delimiter=" " suffix=",">
          <text variable="number-of-volumes"/>
          <label variable="number-of-volumes" 
                 form="short" plural="always"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- ORIGINAL DATE -->
  <!-- Called from the "title" macro (book branch),   -->
  <!-- right after the title, so it can precede the    -->
  <!-- editor with the correct surrounding punctuation. -->
  <!-- Two patterns per the guidelines:                 -->
  <!--   With a numbered edition:                       -->
  <!--     Title, 1st ed. 1977, ed. Name, Place Year.   -->
  <!--   Without a numbered edition (bare original       -->
  <!--   year only):                                     -->
  <!--     Title (1550), ed. Name, Place Year.           -->
  <!-- Note: year ranges (e.g. "1977-1978") cannot be    -->
  <!-- rendered - CSL has only one "issued"/"original-   -->
  <!-- date" value per entry, not a range; must be       -->
  <!-- entered manually in the source data if needed.    -->
  <macro name="original-date">
    <choose>
      <if variable="original-date">
        <choose>
          <if is-numeric="edition">
            <group prefix=", " delimiter=" ">
              <number variable="edition" form="ordinal"/>
              <text term="edition" form="short"/>
              <date variable="original-date">
                <date-part name="year"/>
              </date>
            </group>
          </if>
          <else>
            <group prefix=" (" suffix=")">
              <date variable="original-date">
                <date-part name="year"/>
              </date>
            </group>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <!-- TITLE -->
  <!-- Books/theses/manuscripts: italic -->
  <!-- Articles/chapters: quoted -->
  <!-- Books: optional (genre, event-place event-date) -->
  <!-- before the comma, e.g. "Title (exhibition catalogue -->
  <!-- Rome 2009), ed. ..." -->
  <macro name="title">
    <choose>
      <if type="book" match="any">
        <group>
          <text variable="title" font-style="italic"/>
          <text macro="conference-info" prefix=" "/>
          <text macro="original-date"/>
          <text value=", "/>
        </group>
      </if>
      <else-if type="thesis manuscript" match="any">
        <text variable="title" 
              font-style="italic" 
              suffix=", "/>
      </else-if>
      <else>
        <text variable="title" 
              quotes="true" 
              suffix=", "/>
      </else>
    </choose>
  </macro>

  <!-- SERIES -->
  <!-- Produces: (Studi della Bibliotheca Hertziana 4) -->
  <macro name="series">
    <choose>
      <if variable="collection-title">
        <group prefix="(" suffix=")" delimiter=" ">
          <text variable="collection-title"/>
          <text variable="collection-number"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- PAGES -->
  <!-- Produces: pp. 9-13 -->
  <macro name="pages">
    <choose>
      <if variable="page">
        <group delimiter=" ">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- VOLUME-REF -->
  <!-- Produces: vol. 2 / vol. 4: The Papal State -->
  <!-- (uses CSL's standard "volume-title" variable -->
  <!-- for the sub-title of an individual volume     -->
  <!-- within a multi-volume work)                   -->
  <macro name="volume-ref">
    <choose>
      <if variable="volume">
        <group delimiter=" ">
          <label variable="volume" form="short"/>
          <group delimiter=": ">
            <text variable="volume"/>
            <text variable="volume-title"/>
          </group>
        </group>
      </if>
    </choose>
  </macro>

  <!-- CONFERENCE INFO -->
  <!-- Optional: only rendered if genre/event-place/    -->
  <!-- event-date are present in the data.               -->
  <!-- With event-date (conference proceedings):        -->
  <!--   (conference proceedings, Bonn 2006)             -->
  <!-- Without event-date (exhibition catalogues,        -->
  <!-- which per the guidelines omit the year here):     -->
  <!--   (exhibition catalogue Rome/Naples)               -->
  <macro name="conference-info">
    <choose>
      <if variable="genre event-place event-date" match="any">
        <choose>
          <if variable="event-date">
            <group prefix="(" suffix=")" delimiter=", ">
              <text variable="genre"/>
              <group delimiter=" ">
                <text variable="event-place"/>
                <date variable="event-date">
                  <date-part name="year"/>
                </date>
              </group>
            </group>
          </if>
          <else>
            <group prefix="(" suffix=")" delimiter=" ">
              <text variable="genre"/>
              <text variable="event-place"/>
            </group>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <!-- REVIEW OF -->
  <!-- Produces: review of "Title", -->
  <macro name="review-of">
    <choose>
      <if variable="reviewed-title">
        <group suffix=",">
          <text term="review-of" suffix=" "/>
          <text variable="reviewed-title" quotes="true"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- ACCESS / URL / DOI -->
  <!-- DOI produces: DOI: 10.xxxx. (bare identifier, no  -->
  <!-- URL prefix, no accessed date - per the majority   -->
  <!-- of current editorial guidelines across all three  -->
  <!-- languages; only the older English "Articles in    -->
  <!-- Edited Works" PDF still showed the URL+accessed   -->
  <!-- form, appears outdated/unsynced with the rest).    -->
  <!-- Plain web URLs (no DOI) still get accessed date.   -->
  <!-- Assumption: the DOI variable holds the bare identifier -->
  <!-- only (e.g. "10.1177/..."), per correct MARC practice -->
  <!-- (024 = bare identifier, 856 = full resolvable URL). -->
  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: " suffix="."/>
      </if>
      <else-if variable="URL">
        <group>
          <text variable="URL" prefix="URL: "/>
          <choose>
            <if variable="accessed">
              <group prefix=" (" suffix=")">
                <text term="accessed" suffix=" "/>
                <date variable="accessed">
                  <date-part name="day" form="numeric-leading-zeros" suffix="."/>
                  <date-part name="month" 
                             form="numeric-leading-zeros" 
                             suffix="."/>
                  <date-part name="year"/>
                </date>
              </group>
            </if>
          </choose>
        </group>
      </else-if>
    </choose>
  </macro>

  <!-- CONTRIBUTORS SHORT (for citation key) -->
  <!-- Produces: Vasari / Smith et al. -->
  <macro name="contributors-short">
    <choose>
      <if variable="author">
        <names variable="author">
          <name form="short" 
                delimiter="/" 
                delimiter-precedes-et-al="never"
                delimiter-precedes-last="never"
                et-al-min="4" 
                et-al-use-first="1"/>
          <substitute>
            <text variable="title-short" 
                  font-style="italic"/>
          </substitute>
        </names>
      </if>
      <else>
        <choose>
          <if variable="title-short">
            <text variable="title-short" font-style="italic"/>
          </if>
          <else>
            <text variable="title" font-style="italic"/>
          </else>
        </choose>
      </else>
    </choose>
  </macro>

  <!-- DATE REFERENCE (for citation key) -->
  <!-- Produces: (1550) 1986 / 2008 -->
  <macro name="date-reference">
    <choose>
      <if variable="issued">
        <choose>
          <if variable="original-date">
            <date variable="original-date" 
                  prefix="(" suffix=") ">
              <date-part name="year"/>
            </date>
          </if>
        </choose>
        <date variable="issued" 
              date-parts="year" 
              form="text"/>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <!-- POINT LOCATORS (for footnote citation) -->
  <macro name="point-locators">
    <group>
      <choose>
        <if locator="page" match="none">
          <label variable="locator" 
                 form="short" 
                 suffix=" "/>
        </if>
      </choose>
      <text variable="locator"/>
    </group>
  </macro>

  <!-- ================================================
       CITATION (footnote)
       Produces: Vasari 1986: 45
       ================================================ -->

  <citation disambiguate-add-year-suffix="true" 
            disambiguate-add-names="true" 
            disambiguate-add-givenname="true">
    <sort>
      <key variable="issued" sort="ascending"/>
      <key macro="author"/>
    </sort>
    <layout delimiter="; ">
      <group delimiter=": ">
        <group delimiter=" ">
          <text macro="contributors-short"/>
          <text macro="date-reference"/>
        </group>
        <text macro="point-locators"/>
      </group>
    </layout>
  </citation>

  <!-- ================================================
       BIBLIOGRAPHY
       ================================================ -->

  <bibliography et-al-min="12" et-al-use-first="6">
    <sort>
      <key macro="contributors-short"/>
      <key macro="date-reference"/>
    </sort>
    <layout>

      <!-- Main entry -->
      <group delimiter=" ">
        <text macro="author"/>
        <text macro="title"/>
        <text macro="review-of"/>

        <choose>

          <!-- ============ BOOK ============ -->
          <!-- First name Last name, Title      -->
          <!-- [(1st ed. YEAR) or (YEAR)],      -->
          <!-- [ed. Name,] [X vols.,]           -->
          <!-- Place Year [(Series Number)].    -->
          <!-- (The original-date/edition part  -->
          <!-- is rendered inside the "title"    -->
          <!-- macro, right after the title      -->
          <!-- itself, so it precedes the        -->
          <!-- editor - see the "original-date"  -->
          <!-- macro above.)                     -->
          <if type="book" match="any">
            <group delimiter=" ">
              <text macro="editor"/>
              <text macro="volumes"/>
              <group delimiter=", " suffix=".">
                <group delimiter=" ">
                  <choose>
                    <if variable="volume">
                      <group delimiter=", ">
                        <text variable="publisher-place"/>
                        <text macro="volume-ref"/>
                        <date variable="issued" 
                              date-parts="year" 
                              form="text"/>
                      </group>
                    </if>
                    <else>
                      <group delimiter=" ">
                        <text variable="publisher-place"/>
                        <date variable="issued" 
                              date-parts="year" 
                              form="text"/>
                      </group>
                    </else>
                  </choose>
                  <text macro="series"/>
                </group>
                <text macro="access"/>
              </group>
            </group>
          </if>

          <!-- ============ ARTICLE-JOURNAL / REVIEW ============ -->
          <!-- First name Last name, ["review of" "Title",]     -->
          <!-- Journal, vol [, issue] (year), pp. x-x.          -->
          <else-if type="article-journal review review-book" 
                   match="any">
            <group delimiter=" ">
              <text variable="container-title" 
                    font-style="italic" 
                    suffix=","/>
              <group delimiter=", " suffix=".">
                <group suffix=")">
                  <text variable="volume"/>
                  <text variable="issue" prefix=", "/>
                  <date variable="issued" 
                        date-parts="year" 
                        form="text" 
                        prefix=" ("/>
                </group>
                <text macro="pages"/>
                <text macro="access"/>
              </group>
            </group>
          </else-if>

          <!-- ============ CHAPTER ============ -->
          <!-- First name Last name, "Title",   -->
          <!-- in Container Title               -->
          <!-- [(conf. proceedings, Place Year)]-->
          <!-- ed. Name, [X vols.,]             -->
          <!-- [vol. 3/2,] Place [vol. 4:       -->
          <!-- Sub-Title,] Year [(Series)],     -->
          <!-- pp. x-x.                         -->
          <!-- Distinguishes: a specific volume  -->
          <!-- within a counted multi-volume set -->
          <!-- (number-of-volumes present, e.g.  -->
          <!-- "Florence, vol. 4, 1994", volume  -->
          <!-- may add ": Sub-Title" via the     -->
          <!-- volume-title variable) from a     -->
          <!-- bare sub-volume/part reference    -->
          <!-- with no total count (e.g. "vol.   -->
          <!-- 3/2, Verona 1969") - these use     -->
          <!-- different word order.             -->
          <else-if type="chapter" match="any">
            <group delimiter=" ">
              <group>
                <text term="in" 
                      text-case="lowercase" 
                      suffix=" "/>
                <text variable="container-title" 
                      font-style="italic"/>
                <text macro="conference-info" 
                      prefix=" "/>
                <text value=","/>
              </group>
              <text macro="editor"/>
              <text macro="volumes"/>
              <group delimiter=", " suffix=".">
                <group delimiter=" ">
                  <choose>
                    <if variable="number-of-volumes">
                      <group delimiter=", ">
                        <text variable="publisher-place"/>
                        <text macro="volume-ref"/>
                        <date variable="issued" 
                              date-parts="year" 
                              form="text"/>
                      </group>
                    </if>
                    <else-if variable="volume">
                      <group delimiter=", ">
                        <text macro="volume-ref"/>
                        <group delimiter=" ">
                          <text variable="publisher-place"/>
                          <date variable="issued" 
                                date-parts="year" 
                                form="text"/>
                        </group>
                      </group>
                    </else-if>
                    <else>
                      <group delimiter=" ">
                        <text variable="publisher-place"/>
                        <date variable="issued" 
                              date-parts="year" 
                              form="text"/>
                      </group>
                    </else>
                  </choose>
                  <text macro="series"/>
                </group>
                <text macro="pages"/>
                <text macro="access"/>
              </group>
            </group>
          </else-if>

          <!-- ============ ENTRY-DICTIONARY /        -->
          <!-- ENTRY-ENCYCLOPEDIA ============        -->
          <!-- First name Last name, "Title",        -->
          <!-- in Container/Title-short, vol. X,     -->
          <!-- Place Year, pp. x-x / col. x-x.      -->
          <else-if type="entry-dictionary entry-encyclopedia" 
                   match="any">
            <group delimiter=" ">
              <group>
                <text term="in" 
                      text-case="lowercase" 
                      suffix=" "/>
                <choose>
                  <if variable="title-short">
                    <text variable="title-short" 
                          font-style="italic" 
                          suffix=","/>
                  </if>
                  <else>
                    <text variable="container-title" 
                          font-style="italic" 
                          suffix=","/>
                  </else>
                </choose>
              </group>
              <text macro="editor"/>
              <group suffix=",">
                <text macro="volume-ref"/>
              </group>
              <group delimiter=", " suffix=".">
                <group delimiter=" ">
                  <text variable="publisher-place"/>
                  <date variable="issued" 
                        date-parts="year" 
                        form="text"/>
                </group>
                <text macro="pages"/>
                <text macro="access"/>
              </group>
            </group>
          </else-if>

          <!-- ============ THESIS ============      -->
          <!-- First name Last name, Title,         -->
          <!-- [type] thesis, University, Year.     -->
          <else-if type="thesis" match="any">
            <group delimiter=", " suffix=".">
              <group delimiter=" ">
                <text variable="genre"/>
                <text term="thesis"/>
              </group>
              <text variable="publisher"/>
              <date variable="issued" 
                    date-parts="year" 
                    form="text"/>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- ============ WEBPAGE ============ -->
          <!-- First name Last name, Title.     -->
          <!-- URL: ... (accessed dd.mm.yyyy).  -->
          <else-if type="webpage post post-weblog" 
                   match="any">
            <group delimiter=", " suffix=".">
              <date variable="issued" 
                    date-parts="year" 
                    form="text"/>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- ============ MANUSCRIPT ============ -->
          <else-if type="manuscript" match="any">
            <group delimiter=", " suffix=".">
              <text variable="publisher"/>
              <text term="manuscript" 
                    text-case="capitalize-first"/>
              <date variable="issued" 
                    date-parts="year" 
                    form="text"/>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- ============ FALLBACK ============ -->
          <else>
            <group delimiter=", " suffix=".">
              <group delimiter=" ">
                <text variable="publisher-place"/>
                <date variable="issued" 
                      date-parts="year" 
                      form="text"/>
              </group>
              <text macro="access"/>
            </group>
          </else>

        </choose>
      </group>
    </layout>
  </bibliography>

</style>
