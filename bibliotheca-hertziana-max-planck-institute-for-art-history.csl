<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" page-range-format="expanded" demote-non-dropping-particle="sort-only">
  <!-- Polyglot; we publish books and journals in German, English, and Italian. -->
  <info>
    <title>Bibliotheca Hertziana - Max Planck Institute for Art History</title>
    <title-short>BH</title-short>
    <id>http://www.zotero.org/styles/bibliotheca-hertziana-max-planck-institute-for-art-history</id>
    <link href="http://www.zotero.org/styles/bibliotheca-hertziana-max-planck-institute-for-art-history" rel="self"/>
    <link href="http://www.zotero.org/styles/bmj" rel="template"/>
    <link href="https://www.biblhertz.it/3170244/rjbh_editorial_guidelines_en.pdf" rel="documentation"/>
    <author>
      <name>Chris Tomlinson</name>
    </author>
    <contributor>
      <name>Pietro Liuzzo</name>
    </contributor>
    <contributor>
      <name>Patrick O'Brien</name>
    </contributor>
    <category citation-format="note"/>
    <updated>2026-08-06T15:04:31+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="it">
    <terms>
      <term name="open-quote">“</term>
      <term name="close-quote">”</term>
      <term name="open-inner-quote">'</term>
      <term name="close-inner-quote">'</term>
      <term name="editor">
        <single>a cura di</single>
        <multiple>a cura di</multiple>
      </term>
      <term name="collection-editor">
        <single>a cura di</single>
        <multiple>a cura di</multiple>
      </term>
      <term name="accessed">accesso</term>
      <term name="number-of-volumes">
        <single>vol.</single>
        <multiple>voll.</multiple>
      </term>
      <term name="page-range-delimiter">&#8211;</term>
      <term name="anonymous">s.a.</term>
    </terms>
  </locale>
  <locale xml:lang="de">
    <terms>
      <term name="open-quote">„</term>
      <term name="close-quote">”</term>
      <term name="open-inner-quote">‚</term>
      <term name="close-inner-quote">’</term>
      <term name="editor">
        <single>hg. v.</single>
        <multiple>hg. v.</multiple>
      </term>
      <term name="collection-editor">
        <single>hg. v.</single>
        <multiple>hg. v.</multiple>
      </term>
      <term name="accessed">abgerufen am</term>
      <term name="number-of-volumes">
        <single>Bd.</single>
        <multiple>Bde.</multiple>
      </term>
      <term name="page-range-delimiter">&#8211;</term>
      <term name="anonymous">s.a.</term>
    </terms>
  </locale>
  <locale xml:lang="en">
    <terms>
      <term name="open-quote">”</term>
      <term name="close-quote">”</term>
      <term name="open-inner-quote">’</term>
      <term name="close-inner-quote">’</term>
      <term name="editor">
        <single>ed.</single>
        <multiple>ed.</multiple>
      </term>
      <term name="collection-editor">
        <single>ed.</single>
        <multiple>ed.</multiple>
      </term>
      <term name="page-range-delimiter">&#8211;</term>
      <term name="anonymous">s.a.</term>
    </terms>
  </locale>
  <macro name="author">
    <choose>
      <if variable="author" match="any">
        <names variable="author" suffix=",">
          <name and="text" initialize="false" initialize-with=".">
            <name-part name="given" text-case="capitalize-first"/>
            <name-part name="family" text-case="capitalize-first"/>
          </name>
        </names>
      </if>
      <else-if variable="editor collection-editor" match="any"/>
      <else>
        <text term="anonymous" prefix="[" suffix="],"/>
      </else>
    </choose>
  </macro>
  <macro name="editor">
    <choose>
      <if variable="editor" match="any">
        <names variable="editor" suffix=", ">
          <label form="long" suffix=" "/>
          <name sort-separator=" " and="text" delimiter-precedes-last="never"/>
        </names>
      </if>
      <else-if variable="collection-editor" match="any">
        <names variable="collection-editor" suffix=", ">
          <label form="long" text-case="lowercase" suffix=" "/>
          <name sort-separator=" " and="text" delimiter-precedes-last="never"/>
        </names>
      </else-if>
    </choose>
  </macro>
  <macro name="publisher">
    <text variable="publisher"/>
  </macro>
  <macro name="volumes">
    <group suffix="," delimiter=" ">
      <text variable="number-of-volumes"/>
      <text term="number-of-volumes" plural="true"/>
    </group>
  </macro>
  <macro name="doi-punct">
    <choose>
      <if variable="DOI">
        <text value=","/>
      </if>
      <else>
        <text value="."/>
      </else>
    </choose>
  </macro>
  <macro name="url-with-date">
    <group>
      <text variable="URL" prefix=", URL: "/>
      <choose>
        <if variable="accessed">
          <group prefix=" (" suffix=")" delimiter=" ">
            <text term="accessed"/>
            <date variable="accessed">
              <date-part name="day" suffix="."/>
              <date-part name="month" form="numeric" suffix="."/>
              <date-part name="year"/>
            </date>
          </group>
        </if>
      </choose>
      <text macro="doi-punct"/>
    </group>
  </macro>
  <macro name="access">
    <choose>
      <if type="webpage post post-weblog" match="any">
        <text macro="url-with-date"/>
      </if>
    </choose>
    <text variable="DOI" text-case="lowercase" prefix=" DOI: https://doi.org/" suffix="."/>
  </macro>
  <macro name="title">
    <group>
      <choose>
        <if type="book" match="any">
          <group suffix=", ">
            <text variable="title" font-style="italic"/>
            <date variable="original-date" prefix=" (" suffix=")">
              <date-part name="year"/>
            </date>
            <choose>
              <if variable="collection-number" match="none">
                <text variable="collection-title" prefix=" (" suffix=")"/>
              </if>
            </choose>
          </group>
        </if>
        <else-if type="manuscript thesis" match="any">
          <text variable="title" font-style="italic"/>
        </else-if>
        <else>
          <text variable="title" quotes="true" suffix=","/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="review-of">
    <group delimiter=" " suffix=",">
      <text term="review-of"/>
      <text variable="reviewed-title" quotes="true"/>
    </group>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition" suffix="."/>
      </else>
    </choose>
  </macro>
  <macro name="point-locators">
    <group delimiter=" ">
      <choose>
        <if locator="page" match="none">
          <label variable="locator" form="short"/>
        </if>
      </choose>
      <text variable="locator"/>
    </group>
  </macro>
  <macro name="contributors-short">
    <choose>
      <if match="none" variable="author title-short">
        <names variable="editor">
          <name form="short" delimiter="/" delimiter-precedes-et-al="never" delimiter-precedes-last="always" et-al-min="4" et-al-use-first="1"/>
        </names>
      </if>
      <else>
        <names variable="author">
          <name form="short" delimiter="/" delimiter-precedes-et-al="never" delimiter-precedes-last="always" et-al-min="4" et-al-use-first="1"/>
          <substitute>
            <text variable="title-short" font-style="italic"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="date-reference">
    <choose>
      <if variable="collection-editor" match="any">
        <choose>
          <if variable="editor" match="any">
            <choose>
              <if variable="issued">
                <date variable="original-date" prefix=" (" suffix=") ">
                  <date-part name="year"/>
                </date>
                <date variable="issued" date-parts="year" form="text"/>
              </if>
              <else>
                <text term="no date" form="short"/>
              </else>
            </choose>
          </if>
        </choose>
      </if>
      <else>
        <choose>
          <if variable="issued">
            <date variable="original-date" prefix=" (" suffix=") ">
              <date-part name="year"/>
            </date>
            <date variable="issued" date-parts="year" form="text"/>
          </if>
          <else>
            <text term="no date" form="short"/>
          </else>
        </choose>
      </else>
    </choose>
  </macro>
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <citation disambiguate-add-year-suffix="true" disambiguate-add-names="true" disambiguate-add-givenname="true">
    <sort>
      <key variable="issued" sort="ascending"/>
      <key macro="author"/>
    </sort>
    <layout delimiter=", ">
      <group delimiter=":">
        <group delimiter=" ">
          <text macro="contributors-short"/>
          <text macro="date-reference"/>
        </group>
        <text macro="point-locators"/>
      </group>
    </layout>
  </citation>
  <bibliography et-al-min="12" et-al-use-first="6">
    <sort>
      <key variable="author" sort="ascending"/>
      <key macro="author"/>
    </sort>
    <layout>
      <group delimiter=" " display="block">
        <text macro="contributors-short"/>
        <text macro="date-reference"/>
      </group>
      <group delimiter=" ">
        <text macro="author"/>
        <text macro="title"/>
        <text macro="review-of"/>
        <choose>
          <if type="book" match="any">
            <group>
              <group delimiter=" ">
                <group>
                  <text macro="editor"/>
                  <text macro="volumes"/>
                </group>
                <text macro="edition" suffix=", "/>
                <choose>
                  <if variable="volume">
                    <group delimiter=", ">
                      <text variable="publisher-place"/>
                      <group delimiter=" ">
                        <label variable="volume" form="short"/>
                        <text variable="volume"/>
                      </group>
                      <date date-parts="year" form="text" variable="issued"/>
                    </group>
                  </if>
                  <else>
                    <group delimiter=" ">
                      <text variable="publisher-place"/>
                      <date date-parts="year" form="text" variable="issued"/>
                    </group>
                  </else>
                </choose>
                <choose>
                  <if variable="collection-number">
                    <group prefix="(" suffix=")" delimiter=" ">
                      <text variable="collection-title"/>
                      <text variable="collection-number"/>
                    </group>
                  </if>
                </choose>
              </group>
              <text macro="pages" prefix=", "/>
              <text macro="url-with-date"/>
            </group>
          </if>
          <else-if type="article-journal" match="any">
            <group>
              <group delimiter=" ">
                <text variable="container-title" font-style="italic" suffix=","/>
                <group>
                  <text variable="volume"/>
                  <text variable="issue" prefix=", "/>
                  <date date-parts="year" form="text" variable="issued" prefix=" (" suffix=")"/>
                </group>
              </group>
              <text macro="pages" prefix=", "/>
              <choose>
                <if variable="URL">
                  <text macro="url-with-date"/>
                </if>
                <else>
                  <text macro="doi-punct"/>
                </else>
              </choose>
            </group>
          </else-if>
          <else-if type="chapter" match="any">
            <group>
              <group delimiter=" ">
                <group>
                  <group delimiter=" ">
                    <text term="in" text-case="lowercase"/>
                    <group suffix=", " delimiter=" ">
                      <text variable="container-title" font-style="italic"/>
                      <choose>
                        <if variable="collection-number" match="none">
                          <text variable="collection-title" prefix="(" suffix=")"/>
                        </if>
                      </choose>
                    </group>
                  </group>
                  <text macro="edition"/>
                  <text macro="editor"/>
                  <text macro="volumes"/>
                </group>
                <choose>
                  <if variable="volume">
                    <choose>
                      <if variable="number-of-volumes">
                        <group delimiter=", ">
                          <text variable="publisher-place"/>
                          <group delimiter=" ">
                            <label variable="volume" form="short"/>
                            <text variable="volume"/>
                          </group>
                          <date date-parts="year" form="text" variable="issued"/>
                        </group>
                      </if>
                      <else>
                        <group delimiter=", ">
                          <group delimiter=" ">
                            <label variable="volume" form="short"/>
                            <text variable="volume"/>
                          </group>
                          <group delimiter=" ">
                            <text variable="publisher-place"/>
                            <date date-parts="year" form="text" variable="issued"/>
                          </group>
                        </group>
                      </else>
                    </choose>
                  </if>
                  <else>
                    <group delimiter=" ">
                      <text variable="publisher-place"/>
                      <date date-parts="year" form="text" variable="issued"/>
                    </group>
                  </else>
                </choose>
                <choose>
                  <if variable="collection-number">
                    <group prefix="(" suffix=")" delimiter=" ">
                      <text variable="collection-title"/>
                      <text variable="collection-number"/>
                    </group>
                  </if>
                </choose>
              </group>
              <text macro="pages" prefix=", "/>
              <choose>
                <if variable="URL">
                  <text macro="url-with-date"/>
                </if>
                <else>
                  <text macro="doi-punct"/>
                </else>
              </choose>
            </group>
          </else-if>
          <else-if type="entry-dictionary entry-encyclopedia" match="any">
            <group>
              <group delimiter=" ">
                <group>
                  <group delimiter=" ">
                    <text term="in" text-case="lowercase"/>
                    <group suffix=", ">
                      <choose>
                        <if variable="title-short">
                          <text variable="title-short" font-style="italic"/>
                        </if>
                        <else>
                          <text variable="container-title" font-style="italic"/>
                        </else>
                      </choose>
                    </group>
                  </group>
                  <text macro="edition"/>
                  <text macro="editor"/>
                  <text macro="volumes"/>
                </group>
                <choose>
                  <if variable="volume">
                    <group delimiter=", ">
                      <group>
                        <label variable="volume" form="short" suffix=" "/>
                        <text variable="volume"/>
                      </group>
                      <group delimiter=" ">
                        <text variable="publisher-place"/>
                        <date date-parts="year" form="text" variable="issued"/>
                      </group>
                    </group>
                  </if>
                  <else>
                    <group delimiter=" ">
                      <text variable="publisher-place"/>
                      <date date-parts="year" form="text" variable="issued"/>
                    </group>
                  </else>
                </choose>
              </group>
              <text macro="pages" prefix=", "/>
              <choose>
                <if variable="URL">
                  <text macro="url-with-date"/>
                </if>
                <else>
                  <text macro="doi-punct"/>
                </else>
              </choose>
            </group>
          </else-if>
          <else-if type="paper-conference" match="any">
            <group>
              <group delimiter=" ">
                <group delimiter=" ">
                  <group delimiter=" ">
                    <text term="in" text-case="lowercase"/>
                    <text variable="container-title" font-style="italic" suffix=", "/>
                  </group>
                  <text macro="edition"/>
                  <text macro="editor"/>
                  <text macro="volumes"/>
                  <text macro="publisher"/>
                </group>
                <date date-parts="year" form="text" variable="issued"/>
              </group>
              <text macro="pages" prefix=", "/>
              <choose>
                <if variable="URL">
                  <text macro="url-with-date"/>
                </if>
                <else>
                  <text macro="doi-punct"/>
                </else>
              </choose>
            </group>
          </else-if>
          <else-if type="thesis" match="any">
            <group>
              <group delimiter=" ">
                <group delimiter=", ">
                  <text variable="genre"/>
                  <text macro="publisher"/>
                </group>
                <date date-parts="year" form="text" variable="issued"/>
              </group>
              <choose>
                <if variable="URL">
                  <text macro="url-with-date"/>
                </if>
                <else>
                  <text macro="doi-punct"/>
                </else>
              </choose>
            </group>
          </else-if>
          <else-if type="manuscript" match="any">
            <group>
              <group delimiter=" ">
                <group delimiter=", ">
                  <text macro="publisher"/>
                  <text term="manuscript" text-case="capitalize-first"/>
                </group>
                <date date-parts="year" form="text" variable="issued"/>
              </group>
              <choose>
                <if variable="URL">
                  <text macro="url-with-date"/>
                </if>
                <else>
                  <text macro="doi-punct"/>
                </else>
              </choose>
            </group>
          </else-if>
          <else-if type="webpage post post-weblog" match="any">
            <group delimiter=" ">
              <text macro="publisher"/>
              <date date-parts="year" form="text" variable="issued"/>
            </group>
          </else-if>
          <else>
            <group>
              <group delimiter=" ">
                <text macro="publisher"/>
                <date date-parts="year" form="text" variable="issued"/>
              </group>
              <choose>
                <if variable="URL">
                  <text macro="url-with-date"/>
                </if>
                <else>
                  <text macro="doi-punct"/>
                </else>
              </choose>
            </group>
          </else>
        </choose>
      </group>
      <text macro="access"/>
    </layout>
  </bibliography>
</style>
