<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="sort-only" default-locale="tr-TR">
  <info>
    <title>Dokuz Eylül Üniversitesi - Sosyal Bilimler Enstitüsü (Dipnotlu - Türkçe)</title>
    <title-short>DEÜ SBE (Dipnot)</title-short>
    <id>http://www.zotero.org/styles/dokuz-eylul-universitesi-sosyal-bilimler-enstitusu-klasik</id>
    <link href="http://www.zotero.org/styles/dokuz-eylul-universitesi-sosyal-bilimler-enstitusu-klasik" rel="self"/>
    <link href="http://www.zotero.org/styles/chicago-notes-bibliography" rel="template"/>
    <link href="https://sbe.deu.edu.tr" rel="documentation"/>
    <author>
      <name>Fatih Genç</name>
      <email>fatih.genc1998@hotmail.com</email>
    </author>
    <category citation-format="note"/>
    <category field="social_science"/>
    <category field="humanities"/>
    <summary>Dokuz Eylül Üniversitesi Sosyal Bilimler Enstitüsü tez yazım kılavuzuna (Klasik Dipnot Yöntemi) uygun olarak Fatih Genç tarafından hazırlanmıştır.</summary>
    <updated>2026-08-16T17:35:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="tr">
    <terms>
      <term name="and">ve</term>
      <term name="et-al">ve diğerleri</term>
      <term name="page" form="short">
        <single>s.</single>
        <multiple>ss.</multiple>
      </term>
      <term name="page-range-delimiter">-</term>
      <term name="translator" form="short">çev.</term>
      <term name="editor" form="short">Ed.</term>
      <term name="edition">Baskı</term>
      <term name="issue">Sayı:</term>
      <term name="volume">Cilt:</term>
    </terms>
  </locale>

  <!-- ==================== MACROS ==================== -->

  <!-- Yazar: Dipnot İlk Geçiş (Adı Soyadı, 3+ yazarda ilk yazar ve diğerleri) -->
  <macro name="author-note">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="never" initialize="false">
        <name-part name="given"/>
        <name-part name="family"/>
      </name>
      <label form="short" prefix=" (" suffix=")"/>
      <et-al term="et-al"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <!-- Yazar: Dipnot Tekrar/İkinci Geçiş (Sadece Soyadı, 3+ yazarda Soyadı ve diğerleri) -->
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never">
        <name-part name="family"/>
      </name>
      <et-al term="et-al"/>
      <substitute>
        <names variable="editor">
          <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
        </names>
        <names variable="translator">
          <name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
        </names>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <!-- Yazar: Kaynakça (İlk Yazar: Soyadı, Adı; Diğer Yazarlar: Adı Soyadı; Tüm yazarlar listelenir) -->
  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="first" and="text" delimiter=", " delimiter-precedes-last="never" initialize="false">
        <name-part name="family"/>
        <name-part name="given"/>
      </name>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <!-- Eser Başlığı (Kitaplar ve Tezler Koyu / Makale ve Bölümler Tırnak İçinde) -->
  <macro name="title">
    <choose>
      <if type="bill book graphic legal_case legislation motion_picture report song thesis" match="any">
        <text variable="title" font-weight="bold"/>
      </if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>

  <!-- Anımsatıcı Başlık: İlk geçişte SADECE metin içinde aynı yazarın birden çok eseri çakışıyorsa devreye girer -->
  <macro name="reminder-title-note">
    <choose>
      <if disambiguate="true">
        <choose>
          <if variable="title-short">
            <text variable="title-short" prefix="(" suffix=")"/>
          </if>
          <else>
            <text variable="title" form="short" prefix="(" suffix=")"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <!-- Tekrar Geçişlerde Kısa Başlık: SADECE metin içinde aynı yazarın birden çok eseri çakışıyorsa devreye girer -->
  <macro name="subsequent-title-short">
    <choose>
      <if disambiguate="true">
        <choose>
          <if variable="title-short">
            <text variable="title-short"/>
          </if>
          <else-if type="bill book graphic legal_case legislation motion_picture report song thesis" match="any">
            <text variable="title" form="short" font-weight="bold"/>
          </else-if>
          <else>
            <text variable="title" form="short" quotes="true"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <!-- Çevirmen & Editör Bilgileri (Dipnot: Ed. parantezli / Kitap çevirmeni çev. ) -->
  <macro name="secondary-contributors-note">
    <choose>
      <if type="chapter paper-conference" match="any">
        <names variable="editor" prefix="(Ed. " suffix=")">
          <name and="text" delimiter=", " delimiter-precedes-last="never"/>
        </names>
      </if>
      <else-if type="book report" match="any">
        <names variable="translator" prefix="çev. ">
          <name and="text" delimiter=", " delimiter-precedes-last="never"/>
        </names>
      </else-if>
    </choose>
  </macro>

  <!-- Çevirmen & Editör Bilgileri (Kaynakça: Ed. düz / Kitap çevirmeni çev. ) -->
  <macro name="secondary-contributors-bib">
    <choose>
      <if type="chapter paper-conference" match="any">
        <names variable="editor" prefix="Ed. ">
          <name and="text" delimiter=", " delimiter-precedes-last="never"/>
        </names>
      </if>
      <else-if type="book report" match="any">
        <names variable="translator" prefix="çev. ">
          <name and="text" delimiter=", " delimiter-precedes-last="never"/>
        </names>
      </else-if>
    </choose>
  </macro>

  <!-- Üst Başlık / Dergi / Kitap Adı (Koyu) -->
  <macro name="container-title">
    <choose>
      <if type="chapter paper-conference article-journal article-magazine article-newspaper entry-encyclopedia entry-dictionary" match="any">
        <text variable="container-title" font-weight="bold"/>
      </if>
    </choose>
  </macro>

  <!-- Baskı Sayısı -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="numeric"/>
          <text term="edition" prefix="."/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <!-- Yayın Bilgisi: Yayınevi ve Basım Yeri -->
  <macro name="publisher-info">
    <choose>
      <if type="thesis">
        <group delimiter=", ">
          <text variable="genre" prefix="(" suffix=")"/>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
        </group>
      </if>
      <else-if type="paper-conference">
        <group delimiter=", ">
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text variable="event-date"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <text variable="publisher"/>
          <text variable="publisher-place"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- Cilt ve Sayı (Cilt: 5, Sayı: 1) -->
  <macro name="locators-journal">
    <group delimiter=", ">
      <group delimiter="">
        <text term="volume" suffix=" "/>
        <text variable="volume"/>
      </group>
      <group delimiter="">
        <text term="issue" suffix=" "/>
        <text variable="issue"/>
      </group>
    </group>
  </macro>

  <!-- Tarih Bilgisi (Gazete ve İnternet için GG.AA.YYYY, diğerleri için Yıl) -->
  <macro name="date">
    <choose>
      <if variable="issued">
        <choose>
          <if type="article-newspaper webpage post post-weblog" match="any">
            <date variable="issued" delimiter=".">
              <date-part name="day" form="numeric-leading-zeros"/>
              <date-part name="month" form="numeric-leading-zeros"/>
              <date-part name="year"/>
            </date>
          </if>
          <else>
            <date variable="issued">
              <date-part name="year"/>
            </date>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <!-- İnternet Erişim Bilgisi: URL, (Erişim Tarihi: GG.AA.YYYY) -->
  <macro name="access">
    <choose>
      <if variable="URL">
        <group delimiter=", ">
          <text variable="URL"/>
          <group prefix="(" suffix=")">
            <date variable="accessed" delimiter=".">
              <date-part name="day" form="numeric-leading-zeros"/>
              <date-part name="month" form="numeric-leading-zeros"/>
              <date-part name="year"/>
            </date>
          </group>
        </group>
      </if>
    </choose>
  </macro>

  <!-- Sayfa Numarası (Dipnot içi alıntı konumu) -->
  <macro name="point-locators">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>

  <!-- Kaynakça Sayfa Aralığı -->
  <macro name="page-range">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>


  <!-- ==================== DİPNOT (CITATION) ==================== -->
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-names="true" disambiguate-add-givenname="true">
    <layout delimiter="; " suffix=".">
      <choose>
        <!-- İkinci ve Sonraki Geçişler (a.g.e. KESİNLİKLE KULLANILMAZ) -->
        <if position="subsequent">
          <group delimiter=", ">
            <text macro="author-short"/>
            <text macro="subsequent-title-short"/>
            <text macro="point-locators"/>
          </group>
        </if>

        <!-- İlk Geçiş (Tam Künye) -->
        <else>
          <group delimiter=", ">
            <text macro="author-note"/>
            <text macro="title"/>
            <text macro="container-title"/>
            <text macro="secondary-contributors-note"/>
            <text macro="edition"/>
            <text macro="publisher-info"/>
            <text macro="locators-journal"/>
            <text macro="date"/>
            <text macro="reminder-title-note"/>
            <text macro="access"/>
            <text macro="point-locators"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>


  <!-- ==================== KAYNAKÇA (BIBLIOGRAPHY) ==================== -->
  <!-- Kaynakçada parantez içi anımsatıcı başlık KULLANILMAZ, tam künye yazılır -->
  <bibliography hanging-indent="false" entry-spacing="1">
    <sort>
      <key macro="author-bib"/>
      <key variable="title"/>
      <key variable="issued"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="author-bib"/>
        <group delimiter=", ">
          <text macro="title"/>
          <text macro="container-title"/>
          <text macro="secondary-contributors-bib"/>
          <text macro="edition"/>
          <text macro="publisher-info"/>
          <text macro="locators-journal"/>
          <text macro="date"/>
          <text macro="access"/>
          <text macro="page-range"/>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
