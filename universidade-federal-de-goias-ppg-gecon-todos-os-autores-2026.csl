<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" demote-non-dropping-particle="never" default-locale="pt-BR">
  <!-- UFG / PPG GECON — lista todos os autores na citação e na referência.
       NBR 10520:2023 e NBR 6023:2025. Sobrenome composto não é desmontado. -->
  <info>
    <title>Universidade Federal de Goiás - PPG GECON - ABNT (todos os autores, Português - Brasil)</title>
    <title-short>ABNT UFG PPG GECON todos os autores</title-short>
    <id>http://www.zotero.org/styles/universidade-federal-de-goias-ppg-gecon-todos-os-autores-2026</id>
    <link href="http://www.zotero.org/styles/universidade-federal-de-goias-ppg-gecon-todos-os-autores-2026" rel="self"/>
    <link href="http://www.zotero.org/styles/associacao-brasileira-de-normas-tecnicas" rel="template"/>
    <link href="https://gecon.eeca.ufg.br/" rel="documentation"/>
    <link href="https://bc.ufg.br/p/8290-normas-abnt" rel="documentation"/>
    <author>
      <name>Plínio Pires</name>
      <uri>https://github.com/pliniopires-git</uri>
    </author>
    <category citation-format="author-date"/>
    <category field="engineering"/>
    <summary>ABNT NBR 10520:2023 e NBR 6023:2025, versão PPG GECON/UFG que lista todos os autores.</summary>
    <updated>2026-09-08T13:40:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="pt-BR">
    <terms>
      <term name="month-01" form="short">jan.</term>
      <term name="month-02" form="short">fev.</term>
      <term name="month-03" form="short">mar.</term>
      <term name="month-04" form="short">abr.</term>
      <term name="month-05" form="short">maio</term>
      <term name="month-06" form="short">jun.</term>
      <term name="month-07" form="short">jul.</term>
      <term name="month-08" form="short">ago.</term>
      <term name="month-09" form="short">set.</term>
      <term name="month-10" form="short">out.</term>
      <term name="month-11" form="short">nov.</term>
      <term name="month-12" form="short">dez.</term>
      <term name="editor" form="short">
        <single>org</single>
        <multiple>orgs</multiple>
      </term>
      <term name="container-author" form="short">
        <single>ed</single>
        <multiple>eds</multiple>
      </term>
      <term name="collection-editor" form="short">
        <single>ed</single>
        <multiple>eds</multiple>
      </term>
      <term name="in">in</term>
      <term name="volume" form="short">v.</term>
      <term name="issue" form="short">n.</term>
      <term name="available at">disponível em</term>
      <term name="accessed">acesso em</term>
    </terms>
  </locale>
  <!-- Editores/organizadores da obra no todo (capítulo, verbetes, anais). SOBRENOME, Prenome (org.). -->
  <macro name="container-contributors">
    <choose>
      <if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
        <names variable="container-author" delimiter="; ">
          <name name-as-sort-order="all" sort-separator=", " initialize="false" initialize-with=". " delimiter="; " delimiter-precedes-last="always">
            <name-part name="family" text-case="uppercase"/>
            <name-part name="given"/>
          </name>
          <et-al font-style="italic"/>
          <label form="short" prefix=" (" suffix=".)" text-case="lowercase"/>
          <substitute>
            <names variable="editor"/>
            <names variable="collection-editor"/>
          </substitute>
        </names>
      </if>
    </choose>
  </macro>
  <!-- Organizadores em tipos que não usam a macro anterior. -->
  <macro name="secondary-contributors">
    <choose>
      <if type="paper-conference" match="any">
        <names variable="editor" delimiter="; ">
          <name name-as-sort-order="all" sort-separator=", " initialize="false" initialize-with=". " delimiter="; " delimiter-precedes-last="always">
            <name-part name="family" text-case="uppercase"/>
            <name-part name="given"/>
          </name>
          <et-al font-style="italic"/>
          <label form="short" prefix=" (" suffix=".)" text-case="lowercase"/>
        </names>
      </if>
      <else-if type="chapter entry-dictionary entry-encyclopedia" match="none">
        <names variable="editor" delimiter="; " prefix=" (" suffix=")">
          <name initialize="false" initialize-with=". " delimiter=", "/>
          <et-al font-style="italic"/>
          <label form="short" prefix=", " text-case="capitalize-first" suffix="."/>
        </names>
      </else-if>
    </choose>
  </macro>
  <!-- Tradução: Nome Sobrenome -->
  <macro name="translator">
    <names variable="translator" delimiter="; ">
      <name delimiter="; " sort-separator=" " delimiter-precedes-last="always" prefix="Tradução: ">
        <name-part name="given"/>
        <name-part name="family" text-case="capitalize-first"/>
      </name>
      <et-al font-style="italic"/>
    </names>
  </macro>
  <!-- Autores na referência: SOBRENOME, Prenome; todos os nomes são listados. -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize="false" initialize-with=". " delimiter="; " delimiter-precedes-last="always">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
      <et-al font-style="italic"/>
      <label form="short" prefix=" (" suffix=".)" text-case="lowercase"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>
  <!-- Citação no texto (NBR 10520:2023): Sobrenome em caixa alta e baixa, não em versal. -->
  <macro name="author-short">
    <names variable="author">
      <name form="short" name-as-sort-order="all" sort-separator=", " initialize="false" initialize-with=". " delimiter="; " delimiter-precedes-last="never">
        <name-part name="family" text-case="capitalize-first"/>
        <name-part name="given"/>
      </name>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <choose>
          <if type="book">
            <text variable="title" form="short"/>
          </if>
          <else>
            <text variable="title" form="short" quotes="true"/>
          </else>
        </choose>
      </substitute>
    </names>
  </macro>
  <!-- DOI como URL completa (NBR 6023:2025). Zotero deve guardar só o identificador 10.xxxx/yyyy. -->
  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: https://doi.org/"/>
      </if>
    </choose>
  </macro>
  <!-- URL sem sinais &lt; &gt; (já desde 2018). Acesso em: só quando há URL. -->
  <macro name="access">
    <choose>
      <if variable="URL">
        <group delimiter=". ">
          <group delimiter=": ">
            <text term="available at" text-case="capitalize-first"/>
            <text variable="URL"/>
          </group>
          <choose>
            <if variable="accessed">
              <group delimiter=": ">
                <text term="accessed" text-case="capitalize-first"/>
                <date variable="accessed">
                  <date-part name="day" suffix=" "/>
                  <date-part name="month" form="short" suffix=" " text-case="lowercase"/>
                  <date-part name="year"/>
                </date>
              </group>
            </if>
          </choose>
        </group>
      </if>
    </choose>
  </macro>
  <!-- DOI e/ou Disponível em / Acesso em, nesta ordem. -->
  <macro name="online">
    <group delimiter=". ">
      <text macro="doi"/>
      <text macro="access"/>
    </group>
  </macro>
  <!-- Título da obra: negrito no todo; artigo, capítulo, lei e trabalho em evento em redondo. -->
  <macro name="title">
    <choose>
      <if type="chapter bill legal_case" match="any">
        <text variable="title"/>
      </if>
      <else-if type="article-newspaper article-magazine article-journal paper-conference" match="any">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" font-weight="bold"/>
      </else>
    </choose>
  </macro>
  <macro name="container-title">
    <choose>
      <if type="paper-conference" match="any"/>
      <else>
        <text variable="container-title" font-weight="bold"/>
      </else>
    </choose>
  </macro>
  <!-- Local: Editora. Sem local = [s. l.]; sem editora = [s. n.] (itálico, NBR 6023). -->
  <macro name="publisher">
    <choose>
      <if match="any" variable="publisher-place publisher">
        <choose>
          <if variable="publisher-place">
            <text variable="publisher-place" suffix=": "/>
          </if>
          <else-if type="entry-encyclopedia"/>
          <else>
            <text value="[s. l.]" suffix=": " font-style="italic"/>
          </else>
        </choose>
        <choose>
          <if variable="publisher">
            <text variable="publisher"/>
          </if>
          <else>
            <text value="[s. n.]" font-style="italic"/>
          </else>
        </choose>
      </if>
      <else>
        <text value="[s. l.: s. n.]" font-style="italic"/>
      </else>
    </choose>
  </macro>
  <macro name="place">
    <choose>
      <if variable="publisher-place">
        <text variable="publisher-place"/>
      </if>
    </choose>
  </macro>
  <macro name="place-or-sl">
    <choose>
      <if variable="publisher-place">
        <text variable="publisher-place"/>
      </if>
      <else>
        <text value="[s. l.]" font-style="italic"/>
      </else>
    </choose>
  </macro>
  <!-- Evento: In: NOME DO EVENTO. Anais […]. -->
  <macro name="event">
    <choose>
      <if variable="event">
        <group delimiter=": " suffix=". ">
          <text term="in" text-case="capitalize-first" font-style="italic"/>
          <text variable="event" text-case="uppercase"/>
        </group>
        <choose>
          <if variable="container-title">
            <text variable="container-title" font-weight="bold"/>
          </if>
          <else>
            <text value="Anais […]" font-weight="bold"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- Data completa (dia mês ano), exceto livro/capítulo (só o ano). -->
  <macro name="issued">
    <choose>
      <if variable="issued">
        <group>
          <choose>
            <if type="book chapter thesis" match="none">
              <date variable="issued">
                <date-part name="day" suffix=" "/>
                <date-part name="month" form="short" suffix=" " text-case="lowercase"/>
              </date>
            </if>
          </choose>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </group>
      </if>
      <else>
        <text value="[s. d.]" font-style="italic"/>
      </else>
    </choose>
  </macro>
  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text value="[s. d.]" font-style="italic"/>
      </else>
    </choose>
  </macro>
  <!-- Julgado em: data (NBR 6023:2025, jurisprudência). -->
  <macro name="issued-julgado">
    <choose>
      <if variable="issued">
        <date variable="issued" prefix="Julgado em: ">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" " text-case="lowercase"/>
          <date-part name="year"/>
        </date>
      </if>
    </choose>
  </macro>
  <!-- Edição a partir da 2.ª: 2. ed. -->
  <macro name="edition">
    <choose>
      <if type="book chapter" match="any">
        <choose>
          <if is-numeric="edition">
            <group delimiter=" ">
              <number variable="edition" form="numeric" suffix="."/>
              <text term="edition" form="short"/>
            </group>
          </if>
          <else>
            <text variable="edition"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="locators">
    <choose>
      <if type="bill">
        <group delimiter=", ">
          <date variable="issued">
            <date-part name="day"/>
            <date-part prefix=" " name="month" form="short"/>
            <date-part prefix=" " name="year"/>
          </date>
          <text variable="section" prefix="seção "/>
          <text macro="pages"/>
        </group>
      </if>
      <else-if type="article-journal article-magazine" match="any">
        <group delimiter=", ">
          <group delimiter=" ">
            <label variable="volume" form="short"/>
            <text variable="volume"/>
          </group>
          <group delimiter=" ">
            <label variable="issue" form="short"/>
            <text variable="issue"/>
          </group>
          <text macro="pages"/>
        </group>
      </else-if>
      <else-if type="article-newspaper">
        <group delimiter=", ">
          <group delimiter=" ">
            <label variable="issue" form="short"/>
            <text variable="issue"/>
          </group>
          <text variable="section"/>
          <text macro="pages"/>
        </group>
      </else-if>
      <else-if type="book chapter paper-conference" match="any">
        <group delimiter=", ">
          <group delimiter=" ">
            <label variable="volume" form="short"/>
            <text variable="volume"/>
          </group>
          <text macro="pages"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="collection-title">
    <group delimiter=" ">
      <text variable="collection-title"/>
      <text variable="collection-number"/>
    </group>
  </macro>
  <macro name="genre">
    <text variable="genre"/>
  </macro>
  <macro name="medium">
    <text variable="medium" font-style="italic"/>
  </macro>
  <macro name="citation-locator">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>
  <macro name="archive">
    <text variable="archive"/>
  </macro>
  <!-- Citações: todos os autores, separados por ponto e vírgula. -->
  <citation collapse="year" disambiguate-add-year-suffix="true">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="issued-year"/>
        <text macro="citation-locator"/>
      </group>
    </layout>
  </citation>
  <!-- Referências: espaço simples, uma linha em branco entre entradas; todos os autores. -->
  <bibliography hanging-indent="false" entry-spacing="1">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <choose>
        <!-- Legislação -->
        <if type="bill">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="number"/>
            <text macro="title"/>
            <text variable="references" font-weight="bold"/>
            <text variable="note"/>
            <text macro="locators"/>
            <text macro="online"/>
          </group>
        </if>
        <!-- Jurisprudência: Julgado em (NBR 6023:2025) -->
        <else-if type="legal_case">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="authority"/>
            <text macro="title"/>
            <text variable="number"/>
            <text variable="references"/>
            <text macro="issued-julgado"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Mapa / documento cartográfico -->
        <else-if type="map">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="genre"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="issued"/>
            </group>
            <text variable="scale" prefix="Escala "/>
            <text macro="medium"/>
            <text variable="note"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Livro / monografia -->
        <else-if type="book">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="translator"/>
            <text macro="edition"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="issued"/>
            </group>
            <text macro="medium"/>
            <text macro="locators"/>
            <text macro="collection-title" prefix="(" suffix=")"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Capítulo: título do capítulo em redondo; In: em itálico; título do livro em negrito -->
        <else-if type="chapter">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <group delimiter=": ">
              <text term="in" font-style="italic" text-case="capitalize-first"/>
              <text macro="container-contributors"/>
            </group>
            <text macro="container-title"/>
            <text macro="collection-title"/>
            <text macro="translator"/>
            <text macro="edition"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="issued"/>
            </group>
            <text macro="locators"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Artigo de periódico / revista / jornal -->
        <else-if type="article-newspaper article-magazine article-journal" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <group delimiter=", ">
              <text macro="container-title"/>
              <text macro="place-or-sl"/>
              <text macro="edition"/>
              <text macro="locators"/>
              <text macro="issued"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Tese, dissertação, TCC: ano. Tipo (Grau) — Instituição, local, ano. -->
        <else-if type="thesis">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="issued-year"/>
            <group delimiter=" — ">
              <text macro="genre"/>
              <group delimiter=", ">
                <text variable="publisher"/>
                <text macro="place"/>
                <text macro="issued-year"/>
              </group>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Manuscrito -->
        <else-if type="manuscript">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="edition"/>
            <group delimiter=", ">
              <text macro="place"/>
              <text macro="issued"/>
            </group>
            <text macro="archive"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Página da web / documento exclusivo em meio eletrônico -->
        <else-if type="webpage">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="genre"/>
            <text macro="issued"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Rede social, post, blog (NBR 6023:2025) -->
        <else-if type="post post-weblog" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text variable="container-title"/>
            <text macro="genre"/>
            <text macro="issued"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Podcast, áudio, vídeo, entrevista gravada -->
        <else-if type="song broadcast speech motion_picture interview" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text variable="container-title"/>
            <text macro="genre"/>
            <text macro="medium"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="issued"/>
            </group>
            <text variable="dimensions"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Relatório técnico -->
        <else-if type="report">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="genre"/>
            <text macro="container-title"/>
            <text variable="collection-title" prefix="(" suffix=")"/>
            <text macro="locators"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="issued"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Texto para discussão (mapeado em verbete de dicionário, uso IPEA) -->
        <else-if type="entry-dictionary">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="issued"/>
            </group>
            <text macro="collection-title" prefix="(Texto para discussão, n. " suffix=")"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Nota técnica (mapeado em verbete de enciclopédia, uso IPEA) -->
        <else-if type="entry-encyclopedia">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <group delimiter=", ">
              <text variable="publisher-place" suffix=": "/>
              <text variable="publisher"/>
              <text macro="issued"/>
            </group>
            <text value="(Nota técnica)"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Trabalho em anais de evento -->
        <else-if type="paper-conference">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="event"/>
            <text macro="container-contributors"/>
            <text macro="secondary-contributors"/>
            <group delimiter=", ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
              <text macro="issued"/>
            </group>
            <text macro="locators"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Patente -->
        <else-if type="patent">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text variable="number"/>
            <text macro="issued" prefix="Depósito: "/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Figura / documento iconográfico -->
        <else-if type="graphic figure" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="issued"/>
            <text macro="genre"/>
            <text macro="medium"/>
            <text macro="online"/>
          </group>
        </else-if>
        <!-- Fallback -->
        <else>
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title"/>
            <text macro="container-contributors"/>
            <text macro="secondary-contributors"/>
            <text macro="container-title"/>
            <text variable="collection-title"/>
            <text macro="locators"/>
            <text macro="event"/>
            <group delimiter=", ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
              <text macro="issued"/>
            </group>
            <text macro="online"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
