<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" page-range-format="expanded" default-locale="sk-SK">
  <info>
    <title>STN ISO 690:2022 (ISO 690:2021, numeric, Slovenčina)</title>
    <title-short>ISO 690:2022 (numeric, SK)</title-short>
    <id>http://www.zotero.org/styles/iso690-2022-numeric-sk</id>
    <link href="http://www.zotero.org/styles/iso690-2022-numeric-sk" rel="self"/>
    <link href="https://doi.org/10.52036/1335793X.2023.3-4.10-22" rel="documentation"/>
    <author>
      <name>Milan Regec</name>
    </author>
    <contributor>
      <name>Tomáš Ferianc</name>
    </contributor>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Slovak numeric style for STN ISO 690:2022, the Slovak adoption of ISO 690:2021, following the Slovak Zotero samples and Lichnerová and Bellérová (ITlib 3–4/2023)</summary>
    <updated>2026-10-21T12:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- Sources, in order of precedence: the Slovak Zotero samples, Lichnerová and Bellérová (ITlib 3–4/2023,
       the documentation link), and ISO 690:2021. This style and iso690-2022-numeric-sk share every macro and the
       locale block; the numeric style adds the year where a "numeric:" comment stands here. -->
  <!-- Zotero 10.0.6 passes only the start year of a date range typed in Date; a line "issued: 2012/2020" in
       Extra passes the whole range, which prints as "2012 – 2020". -->
  <locale xml:lang="sk">
    <terms>
      <!-- "Program", not sk-SK's "softvér" (Lichnerová and Bellérová: "Program; online") -->
      <term name="software">program</term>
      <term name="in">In</term>
      <term name="at">v</term>
      <!-- sk-SK has the English ordinals ("th"); a Slovak edition is "3. vyd." -->
      <term name="ordinal">.</term>
      <term name="accessed">zobrazené</term>
      <term name="available at">Dostupné na</term>
      <term name="online">online</term>
      <term name="no date">s. a.</term>
      <term name="no date" form="short">s. a.</term>
      <term name="no-publisher">s. n.</term>
      <term name="no-publisher" form="short">s. n.</term>
      <term name="page-range-delimiter">&#160;–&#160;</term>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>ed.</multiple>
      </term>
      <term name="compiler" form="short">
        <single>zost.</single>
        <multiple>zost.</multiple>
      </term>
      <term name="director" form="short">
        <single>rež.</single>
        <multiple>rež.</multiple>
      </term>
      <term name="narrator" form="short">
        <single>rozpr.</single>
        <multiple>rozpr.</multiple>
      </term>
      <term name="illustrator" form="short">
        <single>ilustr.</single>
        <multiple>ilustr.</multiple>
      </term>
      <term name="curator" form="short">
        <single>kur.</single>
        <multiple>kur.</multiple>
      </term>
      <term name="performer" form="short">
        <single>účink.</single>
        <multiple>účink.</multiple>
      </term>
      <term name="composer" form="short">
        <single>skl.</single>
        <multiple>skl.</multiple>
      </term>
      <term name="contributor" form="short">
        <single>ved. práce</single>
        <multiple>ved. práce</multiple>
      </term>
    </terms>
  </locale>
  <!-- Creators: the first name inverted, family names in capitals, "; " between names and " a " before the last.
       A role is added when the primary creator is not the author (ed., zost., rež., skl.); a podcast's host
       (Zotero's Podcaster) leads without one. -->
  <macro name="creators">
    <names variable="author">
      <name and="text" delimiter="; " delimiter-precedes-last="never" delimiter-precedes-et-al="never" name-as-sort-order="first" sort-separator=", ">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="compiler"/>
        <names variable="director"/>
        <names variable="composer"/>
        <names variable="host">
          <name and="text" delimiter="; " delimiter-precedes-last="never" delimiter-precedes-et-al="never" name-as-sort-order="first" sort-separator=", ">
            <name-part name="family" text-case="uppercase"/>
          </name>
        </names>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>
  <!-- Subsidiary creators: direct order, family names in capitals, the role's short form in parentheses. -->
  <macro name="secondary">
    <group delimiter="; ">
      <text macro="secondary-editors"/>
      <names variable="translator illustrator narrator performer director composer curator" delimiter="; ">
        <name and="text" delimiter="; " delimiter-precedes-last="never">
          <name-part name="family" text-case="uppercase"/>
        </name>
        <label form="short" prefix=" (" suffix=")"/>
      </names>
      <text macro="secondary-supervisor"/>
    </group>
  </macro>
  <!-- A part's editors and compilers belong to its host (macro container). -->
  <macro name="secondary-editors">
    <choose>
      <if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="none">
        <names variable="editor compiler" delimiter="; ">
          <name and="text" delimiter="; " delimiter-precedes-last="never">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </if>
    </choose>
  </macro>
  <!-- Zotero's Contributor is a thesis's supervisor; on other types it is not printed (a reviewer has no field). -->
  <macro name="secondary-supervisor">
    <choose>
      <if type="thesis">
        <names variable="contributor">
          <name and="text" delimiter="; " delimiter-precedes-last="never">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </if>
    </choose>
  </macro>
  <!-- Numeric: the year after the publisher, "[s. a.]" when missing; recordings and broadcasts have their
       full date in both styles (date-recording). -->
  <macro name="date-pub">
    <choose>
      <if variable="issued">
        <choose>
          <if type="motion_picture broadcast song" match="none">
            <date variable="issued">
              <date-part name="year" range-delimiter="&#160;–&#160;"/>
            </date>
          </if>
        </choose>
      </if>
      <else-if type="book chapter paper-conference report thesis software dataset map" match="any">
        <text term="no date" form="short" prefix="[" suffix="]"/>
      </else-if>
    </choose>
  </macro>
  <!-- Numeric: the year in a serial's numbering, "roč. 4 (2003)". -->
  <macro name="serial-year">
    <date variable="issued" prefix="(" suffix=")">
      <date-part name="year"/>
    </date>
  </macro>
  <!-- Numeric: an archival letter's date follows the creators (L, archival materials). -->
  <macro name="date-archival">
    <choose>
      <if type="personal_communication" variable="archive" match="all">
        <text macro="date-full"/>
      </if>
    </choose>
  </macro>
  <!-- ISO 8601 date, as precise as entered: newspapers, posts, letters, presentations, patents, recordings. -->
  <macro name="date-full">
    <date variable="issued">
      <date-part name="year" range-delimiter="&#160;–&#160;"/>
      <date-part name="month" form="numeric-leading-zeros" prefix="-" range-delimiter="&#160;–&#160;"/>
      <date-part name="day" form="numeric-leading-zeros" prefix="-" range-delimiter="&#160;–&#160;"/>
    </date>
  </macro>
  <!-- Unpublished items carry their date at the end; archival letters after the creators (the numeric style only). -->
  <macro name="date-personal">
    <choose>
      <if variable="archive" match="none">
        <text macro="date-full"/>
      </if>
      <else-if type="interview speech" match="any">
        <text macro="date-full"/>
      </else-if>
    </choose>
  </macro>
  <!-- Italics mark the unit a reader can locate: the part only when its own link is certain (spec, italics). -->
  <macro name="title">
    <choose>
      <if type="chapter paper-conference article-journal article-magazine" match="any">
        <choose>
          <if variable="DOI">
            <text variable="title" font-style="italic"/>
          </if>
          <else>
            <text variable="title"/>
          </else>
        </choose>
      </if>
      <else-if type="article-newspaper webpage post post-weblog entry-encyclopedia entry-dictionary" match="any">
        <choose>
          <if variable="URL DOI" match="any">
            <text variable="title" font-style="italic"/>
          </if>
          <else>
            <text variable="title"/>
          </else>
        </choose>
      </else-if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>
  <macro name="container-title">
    <choose>
      <if type="chapter paper-conference article-journal article-magazine" match="any">
        <choose>
          <if variable="DOI">
            <text variable="container-title"/>
          </if>
          <else>
            <text variable="container-title" font-style="italic"/>
          </else>
        </choose>
      </if>
      <else-if type="article-newspaper entry-encyclopedia entry-dictionary" match="any">
        <choose>
          <if variable="URL DOI" match="any">
            <text variable="container-title"/>
          </if>
          <else>
            <text variable="container-title" font-style="italic"/>
          </else>
        </choose>
      </else-if>
    </choose>
  </macro>
  <!-- A web page's site and a blog post's blog, after the page title (ISO Table 15), even when it repeats the
       title or the creator: data in the record is not dropped (owner, 2026-10-21). A forum or social-media post
       names its service in the access element instead (L). -->
  <macro name="website-title">
    <choose>
      <if type="webpage post-weblog" match="any">
        <text variable="container-title"/>
      </if>
    </choose>
  </macro>
  <!-- "In: " + the host's creators + the host's title, for parts of monographs. -->
  <macro name="container">
    <choose>
      <if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=" ">
          <text term="in" suffix=":"/>
          <group delimiter=". ">
            <names variable="container-author">
              <name and="text" delimiter="; " delimiter-precedes-last="never" delimiter-precedes-et-al="never">
                <name-part name="family" text-case="uppercase"/>
              </name>
              <label form="short" prefix=" (" suffix=")"/>
              <substitute>
                <names variable="editor compiler" delimiter="; "/>
              </substitute>
            </names>
            <text macro="container-title"/>
          </group>
        </group>
      </if>
    </choose>
  </macro>
  <!-- A part of a serial: the serial's title, then "Online." for a linked copy, then its numbering. -->
  <macro name="serial">
    <choose>
      <if variable="URL DOI" match="any">
        <group delimiter=". ">
          <text macro="container-title"/>
          <text term="online" text-case="capitalize-first"/>
          <text macro="numeration"/>
        </group>
      </if>
      <else>
        <group delimiter=", ">
          <text macro="container-title"/>
          <text macro="numeration"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- Always in Slovak (decision 18): "roč. 4 (2003), č. 11 – 12, s. 547 – 551"; newspapers give the date instead. -->
  <macro name="numeration">
    <choose>
      <if type="article-newspaper">
        <group delimiter=", ">
          <text macro="date-full"/>
          <text macro="pages"/>
        </group>
      </if>
      <else>
        <group delimiter=", ">
          <group delimiter=" ">
            <group delimiter=" ">
              <text value="roč."/>
              <text variable="volume"/>
            </group>
            <text macro="serial-year"/>
          </group>
          <group delimiter=" ">
            <label variable="issue" form="short"/>
            <text variable="issue"/>
          </group>
          <text macro="pages"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- Type and carrier without brackets: "[genre][; medium]", "online" when the medium is empty and there is a link.
       Web-native types print their genre alone ("Tweet."), or "Online." without one. -->
  <macro name="format">
    <choose>
      <if type="webpage post post-weblog" match="any">
        <choose>
          <if variable="genre">
            <text variable="genre" text-case="capitalize-first"/>
          </if>
          <else-if variable="URL DOI" match="any">
            <text term="online" text-case="capitalize-first"/>
          </else-if>
        </choose>
      </if>
      <else-if type="dataset software" match="any">
        <group delimiter="; ">
          <text macro="genre"/>
          <text macro="carrier"/>
        </group>
      </else-if>
      <else-if variable="genre">
        <group delimiter="; ">
          <text variable="genre" text-case="capitalize-first"/>
          <text macro="carrier"/>
        </group>
      </else-if>
      <else>
        <text macro="carrier-alone"/>
      </else>
    </choose>
  </macro>
  <macro name="genre">
    <choose>
      <if variable="genre">
        <text variable="genre" text-case="capitalize-first"/>
      </if>
      <else-if type="dataset">
        <text term="dataset" text-case="capitalize-first"/>
      </else-if>
      <else-if type="software">
        <text term="software" text-case="capitalize-first"/>
      </else-if>
    </choose>
  </macro>
  <macro name="carrier">
    <choose>
      <if variable="medium">
        <text variable="medium"/>
      </if>
      <else-if variable="URL DOI" match="any">
        <text term="online"/>
      </else-if>
    </choose>
  </macro>
  <!-- The carrier with no genre before it starts the element: "Online.", "PDF; CD-ROM." -->
  <macro name="carrier-alone">
    <choose>
      <if variable="medium">
        <text variable="medium" text-case="capitalize-first"/>
      </if>
      <else-if variable="URL DOI" match="any">
        <text term="online" text-case="capitalize-first"/>
      </else-if>
    </choose>
  </macro>
  <!-- Running time of audiobooks and recordings, after the format: "Audiokniha; MP3, trvanie 409 min." -->
  <macro name="duration">
    <choose>
      <if type="book song motion_picture broadcast" match="any">
        <text variable="dimensions" prefix="trvanie "/>
      </if>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="version">
    <group delimiter=" ">
      <text term="version" text-case="capitalize-first"/>
      <text variable="version"/>
    </group>
  </macro>
  <macro name="series">
    <group delimiter=", ">
      <text variable="collection-title"/>
      <text variable="collection-number"/>
    </group>
  </macro>
  <macro name="publisher">
    <choose>
      <if variable="publisher">
        <text variable="publisher"/>
      </if>
      <else-if type="book chapter paper-conference report thesis software dataset map" match="any">
        <text term="no-publisher" form="short" prefix="[" suffix="]"/>
      </else-if>
    </choose>
  </macro>
  <macro name="imprint">
    <group delimiter=", ">
      <text macro="publisher"/>
      <text macro="date-pub"/>
      <text macro="date-recording"/>
      <text macro="volume"/>
      <text macro="pages"/>
    </group>
  </macro>
  <!-- Films, recordings and broadcasts carry the date of the recording, as precise as entered, after the
       publisher in both styles: "Slovenské národné divadlo, 2022-03-19". A year-only date repeats the year in
       the author-date style; the data is kept (owner, 2026-10-21). -->
  <macro name="date-recording">
    <choose>
      <if type="motion_picture broadcast song" match="any">
        <text macro="date-full"/>
      </if>
    </choose>
  </macro>
  <macro name="volume">
    <choose>
      <if type="book chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=" ">
          <label variable="volume" form="short"/>
          <text variable="volume"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <!-- Artworks give their size before the date, maps after the publisher. -->
  <macro name="dimensions-before">
    <choose>
      <if type="graphic">
        <text variable="dimensions"/>
      </if>
    </choose>
  </macro>
  <macro name="dimensions-after">
    <choose>
      <if type="map">
        <text variable="dimensions"/>
      </if>
    </choose>
  </macro>
  <macro name="patent-dates">
    <group delimiter=". ">
      <group delimiter=" ">
        <text value="Dátum podania:"/>
        <date variable="submitted">
          <date-part name="year"/>
          <date-part name="month" form="numeric-leading-zeros" prefix="-"/>
          <date-part name="day" form="numeric-leading-zeros" prefix="-"/>
        </date>
      </group>
      <group delimiter=" ">
        <text value="Dátum udelenia:"/>
        <text macro="date-full"/>
      </group>
    </group>
  </macro>
  <macro name="patent-number">
    <group delimiter=" ">
      <text value="Patentové číslo"/>
      <text variable="number"/>
    </group>
  </macro>
  <!-- Where a presentation took place: "V: event, place". -->
  <macro name="event-place">
    <group delimiter=" ">
      <text term="at" text-case="capitalize-first" suffix=":"/>
      <group delimiter=", ">
        <text variable="event-title"/>
        <text variable="event-place"/>
      </group>
    </group>
  </macro>
  <!-- A DOI alone (no URL and no distributor beside it); else the URL, after the distributor if Archive is filled,
       or after the service for a forum or social-media post ("Facebook, URL"). -->
  <macro name="access">
    <choose>
      <if variable="DOI">
        <group delimiter=" ">
          <text term="available at" suffix=":"/>
          <text variable="DOI" prefix="https://doi.org/"/>
        </group>
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text term="available at" suffix=":"/>
          <choose>
            <if type="post">
              <group delimiter=", ">
                <text variable="container-title"/>
                <text variable="URL"/>
              </group>
            </if>
            <else>
              <group delimiter=": ">
                <choose>
                  <if type="graphic manuscript personal_communication" match="none">
                    <text variable="archive" suffix=" (distribútor)"/>
                  </if>
                </choose>
                <text variable="URL"/>
              </group>
            </else>
          </choose>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="accessed">
    <choose>
      <if variable="URL DOI" match="any">
        <group prefix="[" suffix="]" delimiter=" ">
          <text term="accessed"/>
          <date variable="accessed">
            <date-part name="year"/>
            <date-part name="month" form="numeric-leading-zeros" prefix="-"/>
            <date-part name="day" form="numeric-leading-zeros" prefix="-"/>
          </date>
        </group>
      </if>
    </choose>
  </macro>
  <!-- Archival and unique items, and anything with an Archive but no link: "V: archive, place. Signatúra: …",
       before the access element. -->
  <macro name="location">
    <choose>
      <if type="graphic manuscript personal_communication" match="any">
        <text macro="location-body"/>
      </if>
      <else-if variable="URL DOI" match="none">
        <text macro="location-body"/>
      </else-if>
    </choose>
  </macro>
  <!-- The shelfmark comes from Loc. in Archive, or else from Call Number, whose Slovak label in Zotero is
       „Signatúra" (owner, 2026-10-21). Only with an Archive: library-catalogue imports fill Call Number on
       ordinary books, which have no Archive. -->
  <macro name="location-body">
    <group delimiter=". ">
      <group delimiter=" ">
        <text term="at" text-case="capitalize-first" suffix=":"/>
        <group delimiter=", ">
          <text variable="archive"/>
          <text variable="archive-place"/>
        </group>
      </group>
      <choose>
        <if variable="archive archive_location" match="all">
          <text variable="archive_location" prefix="Signatúra: "/>
        </if>
        <else-if variable="archive">
          <text variable="call-number" prefix="Signatúra: "/>
        </else-if>
      </choose>
    </group>
  </macro>
  <macro name="locator">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <group delimiter=", ">
        <text variable="citation-number"/>
        <text macro="locator"/>
      </group>
    </layout>
  </citation>
  <!-- delimiter-precedes-last here as well as on cs:name: citeproc-js joins a final institution with its own
       token, which inherits only from this level ("A; B a CORPORATE NAME", not "; a"). -->
  <bibliography et-al-min="6" et-al-use-first="1" delimiter-precedes-last="never" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=". ">
        <text macro="creators"/>
        <choose>
          <!-- Parts of serials (spec, Part B, T4). -->
          <if type="article-journal article-magazine article-newspaper" match="any">
            <group delimiter=". ">
              <text macro="title"/>
              <text macro="serial"/>
              <text macro="access"/>
              <text macro="accessed"/>
            </group>
          </if>
          <!-- Web pages, blogs and posts: no publisher, the full date if any (T15, T16). -->
          <else-if type="webpage post post-weblog" match="any">
            <group delimiter=". ">
              <text macro="title"/>
              <text macro="website-title"/>
              <text macro="format"/>
              <text macro="secondary"/>
              <text macro="date-full"/>
              <text macro="access"/>
              <text macro="accessed"/>
            </group>
          </else-if>
          <!-- Letters, messages, interviews and presentations (T17). -->
          <else-if type="personal_communication interview speech" match="any">
            <group delimiter=". ">
              <text macro="date-archival"/>
              <text macro="title"/>
              <text macro="format"/>
              <text macro="secondary"/>
              <text macro="date-personal"/>
              <text macro="event-place"/>
              <text macro="location"/>
              <text macro="access"/>
              <text macro="accessed"/>
            </group>
          </else-if>
          <else-if type="patent">
            <group delimiter=". ">
              <text macro="title"/>
              <text macro="patent-dates"/>
              <text macro="patent-number"/>
              <text macro="access"/>
              <text macro="accessed"/>
            </group>
          </else-if>
          <!-- Standards: the number before the title, no publisher (ISO 8.11.4; L). -->
          <else-if type="standard">
            <group delimiter=". ">
              <group delimiter=", ">
                <text variable="number"/>
                <text macro="title"/>
              </group>
              <text macro="format"/>
              <text macro="edition"/>
              <text macro="access"/>
              <text macro="accessed"/>
            </group>
          </else-if>
          <!-- Monographs and their parts, and everything else (T1, T2 and the rest of Part B). -->
          <else>
            <group delimiter=". ">
              <text macro="title"/>
              <text macro="container"/>
              <group delimiter=", ">
                <text macro="format"/>
                <text macro="duration"/>
              </group>
              <text variable="scale"/>
              <text macro="edition"/>
              <text macro="version"/>
              <text macro="secondary"/>
              <text macro="series"/>
              <text macro="dimensions-before"/>
              <text macro="imprint"/>
              <text macro="dimensions-after"/>
              <text macro="location"/>
              <text macro="access"/>
              <text macro="accessed"/>
            </group>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
