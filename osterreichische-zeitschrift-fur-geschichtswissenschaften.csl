<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="never" page-range-format="expanded" default-locale="de-AT">
  <info>
    <title>Österreichische Zeitschrift für Geschichtswissenschaften (Deutsch - Österreich)</title>
    <title-short>OeZG Austrian Journal of Historical Studies</title-short>
    <id>http://www.zotero.org/styles/osterreichische-zeitschrift-fur-geschichtswissenschaften</id>
    <link href="http://www.zotero.org/styles/osterreichische-zeitschrift-fur-geschichtswissenschaften" rel="self"/>
    <link href="https://journals.univie.ac.at/index.php/oezg/oezgstylesheet" rel="documentation"/>
    <author>
      <name>Maximilian Dick</name>
      <uri>https://orcid.org/0000-0002-8198-3939</uri>
    </author>
    <category citation-format="note"/>
    <category field="history"/>
    <category field="humanities"/>
    <issn>1016-765X</issn>
    <eissn>2707-966X</eissn>
    <summary>Zitierstil nach dem Stylesheet der Österreichischen Zeitschrift für Geschichtswissenschaften (Stand: 2026). Vollbeleg in der ersten Fußnote, danach Kurztitel; „Ebd." bei unmittelbar aufeinanderfolgenden Verweisen.</summary>
    <updated>2026-09-24T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="de">
    <terms>
      <term name="editor" form="short">
        <single>Hg.</single>
        <multiple>Hg.</multiple>
      </term>
      <term name="ibid">ebd.</term>
      <term name="volume" form="short">
        <single>Bd.</single>
        <multiple>Bde.</multiple>
      </term>
      <term name="edition" form="short">Aufl.</term>
    </terms>
  </locale>
  <!-- Autor*innen (Vorname Nachname, Trennung durch Schrägstrich); ersatzweise Herausgeber*innen mit (Hg.) -->
  <macro name="contributors">
    <names variable="author">
      <name delimiter="/" delimiter-precedes-last="always"/>
      <substitute>
        <names variable="editor">
          <name delimiter="/" delimiter-precedes-last="always"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </substitute>
    </names>
  </macro>
  <macro name="contributors-short">
    <names variable="author">
      <name form="short" delimiter="/" delimiter-precedes-last="always"/>
      <substitute>
        <names variable="editor">
          <name form="short" delimiter="/" delimiter-precedes-last="always"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>
  <!-- Herausgeber*innen des Sammelbandes nach „in:" -->
  <macro name="container-contributors">
    <names variable="editor container-author">
      <name delimiter="/" delimiter-precedes-last="always"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <!-- Erscheinungsjahr, fehlend: [o.&#160;J.] -->
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text value="[o.&#160;J.]"/>
      </else>
    </choose>
  </macro>
  <!-- Volles Datum: 15.5.2016 (ohne führende Nullen) -->
  <macro name="full-date">
    <date variable="issued">
      <date-part name="day" form="numeric" suffix="."/>
      <date-part name="month" form="numeric" suffix="."/>
      <date-part name="year"/>
    </date>
  </macro>
  <!-- Verlagsort Jahr, fehlender Ort: [o.&#160;O.] -->
  <macro name="place-year">
    <group delimiter=" ">
      <choose>
        <if variable="publisher-place">
          <text variable="publisher-place"/>
        </if>
        <else>
          <text value="[o.&#160;O.]"/>
        </else>
      </choose>
      <text macro="year"/>
    </group>
  </macro>
  <!-- Ort Jahr ohne [o.&#160;O.]-Ersatz (für Hochschulschriften etc.) -->
  <macro name="place-year-soft">
    <group delimiter=" ">
      <text variable="publisher-place"/>
      <text macro="year"/>
    </group>
  </macro>
  <!-- Auflage: erst ab der 2. Aufl. eintragen (Feld bei Erstauflagen leer lassen) -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <!-- Bandangaben: „5 Bde." bzw. „Bd. 3" -->
  <macro name="volumes">
    <group delimiter=", ">
      <group delimiter=" ">
        <number variable="number-of-volumes"/>
        <text term="volume" form="short" plural="true"/>
      </group>
      <group delimiter=" ">
        <text term="volume" form="short"/>
        <number variable="volume"/>
      </group>
    </group>
  </macro>
  <!-- Zugriffsdatum: (13.7.2016) -->
  <macro name="accessed">
    <date variable="accessed" prefix="(" suffix=")">
      <date-part name="day" form="numeric" suffix="."/>
      <date-part name="month" form="numeric" suffix="."/>
      <date-part name="year"/>
    </date>
  </macro>
  <!-- DOI (als https://doi.org/…) bzw. URL mit Zugriffsdatum -->
  <macro name="online">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text variable="URL"/>
          <text macro="accessed"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="locator">
    <text variable="locator"/>
  </macro>
  <!-- Interviews: "Interview mit [Name] (geb. JJJJ). Interview geführt am [Datum] von
        [Name], Transkript, [Seite] (Aufbewahrungsort des Transkripts: [Ort])."
        Zotero-Typ "Interview": Befragte*r = Autor*in, Interviewer*in = Interviewer,
        Medium = "Transkript", Archiv = Aufbewahrungsort;
        Geburtsjahr optional über das Feld "Extra" als: original-date: 1936 -->
  <macro name="interview-medium">
    <choose>
      <if variable="medium">
        <text variable="medium"/>
      </if>
      <else>
        <text value="Transkript"/>
      </else>
    </choose>
  </macro>
  <macro name="interview">
    <group delimiter=", ">
      <group delimiter=". ">
        <group delimiter=" ">
          <names variable="author" prefix="Interview mit ">
            <name delimiter="/" delimiter-precedes-last="always"/>
          </names>
          <date variable="original-date" prefix="(geb. " suffix=")">
            <date-part name="year"/>
          </date>
        </group>
        <choose>
          <if variable="issued">
            <group delimiter=" ">
              <text value="Interview geführt am"/>
              <text macro="full-date"/>
              <names variable="interviewer" prefix="von ">
                <name delimiter="/" delimiter-precedes-last="always"/>
              </names>
            </group>
          </if>
          <else>
            <names variable="interviewer" prefix="Interview geführt von ">
              <name delimiter="/" delimiter-precedes-last="always"/>
            </names>
          </else>
        </choose>
      </group>
      <choose>
        <if variable="locator">
          <group delimiter=" ">
            <group delimiter=", ">
              <text macro="interview-medium"/>
              <text macro="locator"/>
            </group>
            <text variable="archive" prefix="(Aufbewahrungsort des Transkripts: " suffix=")"/>
          </group>
        </if>
        <else>
          <group delimiter=" ">
            <text macro="interview-medium"/>
            <text variable="archive" prefix="(Aufbewahrungsort des Transkripts: " suffix=")"/>
          </group>
        </else>
      </choose>
    </group>
  </macro>
  <!-- Quellenzitate: "Statní ústřední archiv (SÚA) Praha [Staatliches Zentralarchiv Prag], BR 52."
        Folgezitat: "SÚA, BR 52."
        Zotero-Typ "Manuskript" mit ausgefülltem Feld "Archiv"; Signatur in "Ort im Archiv";
        die im Folgezitat verwendete Abkürzung in das Feld "Kurztitel". -->
  <macro name="archival">
    <group delimiter=", ">
      <text macro="contributors"/>
      <text variable="title"/>
      <text variable="archive"/>
      <text variable="archive_location"/>
      <text macro="locator"/>
    </group>
  </macro>
  <!-- Vollbeleg -->
  <macro name="full-citation">
    <choose>
      <!-- Zeitschriftenaufsatz -->
      <if type="article-journal">
        <group delimiter=", ">
          <text macro="contributors"/>
          <text variable="title"/>
          <group delimiter=" " prefix="in: ">
            <text variable="container-title"/>
            <group delimiter="/">
              <text variable="volume"/>
              <text variable="issue"/>
            </group>
            <text macro="year" prefix="(" suffix=")"/>
          </group>
          <text variable="page"/>
          <text macro="locator"/>
          <text macro="online"/>
        </group>
      </if>
      <!-- Aufsatz im Sammelband -->
      <else-if type="chapter entry entry-encyclopedia entry-dictionary paper-conference">
        <group delimiter=", ">
          <text macro="contributors"/>
          <text variable="title"/>
          <group delimiter=", " prefix="in: ">
            <text macro="container-contributors"/>
            <text variable="container-title"/>
            <text macro="volumes"/>
            <text macro="edition"/>
            <text macro="place-year"/>
            <text variable="page"/>
            <text macro="locator"/>
          </group>
          <text macro="online"/>
        </group>
      </else-if>
      <!-- Interviews -->
      <else-if type="interview">
        <text macro="interview"/>
      </else-if>
      <!-- Archiv-/Quellenzitate (Manuskript mit ausgefülltem Archiv-Feld) -->
      <else-if type="manuscript" variable="archive" match="all">
        <text macro="archival"/>
      </else-if>
      <!-- Hochschulschriften und unveröffentlichte Manuskripte -->
      <else-if type="thesis manuscript report">
        <group delimiter=", ">
          <text macro="contributors"/>
          <text variable="title"/>
          <text variable="genre"/>
          <choose>
            <if variable="publisher-place">
              <group delimiter=", ">
                <text variable="publisher"/>
                <text macro="place-year-soft"/>
              </group>
            </if>
            <else>
              <group delimiter=" ">
                <text variable="publisher"/>
                <text macro="year"/>
              </group>
            </else>
          </choose>
          <text macro="locator"/>
          <text macro="online"/>
        </group>
      </else-if>
      <!-- Zeitungen und nichtwissenschaftliche Zeitschriften -->
      <else-if type="article-newspaper article-magazine">
        <group delimiter=", ">
          <group delimiter=", ">
            <text macro="contributors"/>
            <text variable="title"/>
          </group>
          <choose>
            <if variable="title author" match="any">
              <group delimiter=", " prefix="in: ">
                <text variable="container-title"/>
                <text macro="full-date"/>
              </group>
            </if>
            <else>
              <group delimiter=", ">
                <text variable="container-title"/>
                <text macro="full-date"/>
              </group>
            </else>
          </choose>
          <text variable="page"/>
          <text macro="locator"/>
          <text macro="online"/>
        </group>
      </else-if>
      <!-- Internetquellen -->
      <else-if type="webpage post-weblog post">
        <group delimiter=", ">
          <text macro="contributors"/>
          <text variable="title"/>
          <text variable="container-title" prefix="in: "/>
          <text macro="full-date"/>
          <text macro="locator"/>
          <group delimiter=" ">
            <text variable="URL"/>
            <text macro="accessed"/>
          </group>
        </group>
      </else-if>
      <!-- Monografien, Sammelbände und alles Übrige -->
      <else>
        <group delimiter=", ">
          <text macro="contributors"/>
          <text variable="title"/>
          <text macro="edition"/>
          <text macro="volumes"/>
          <text macro="place-year"/>
          <text macro="locator"/>
          <text macro="online"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation disambiguate-add-names="false" disambiguate-add-givenname="false">
    <layout suffix="." delimiter="; ">
      <choose>
        <!-- Ebd. nur bei unmittelbar aufeinanderfolgenden Verweisen -->
        <if position="ibid-with-locator">
          <group delimiter=", ">
            <text term="ibid" text-case="capitalize-first"/>
            <text macro="locator"/>
          </group>
        </if>
        <else-if position="ibid">
          <text term="ibid" text-case="capitalize-first"/>
        </else-if>
        <!-- Kurztitel: Familienname, Kurztitel, Jahr, Seite -->
        <!-- Kurzzitat Interview: "Interview mit Peter Weish, 2015, 14." -->
        <else-if position="subsequent" type="interview" match="all">
          <group delimiter=", ">
            <names variable="author" prefix="Interview mit ">
              <name delimiter="/" delimiter-precedes-last="always"/>
            </names>
            <text macro="year"/>
            <text macro="locator"/>
          </group>
        </else-if>
        <!-- Kurzzitat Archivalie: "SÚA, BR 52." -->
        <else-if position="subsequent" type="manuscript" variable="archive" match="all">
          <group delimiter=", ">
            <text variable="title" form="short"/>
            <text variable="archive_location"/>
            <text macro="locator"/>
          </group>
        </else-if>
        <else-if position="subsequent">
          <group delimiter=", ">
            <text macro="contributors-short"/>
            <text variable="title" form="short"/>
            <choose>
              <if type="book chapter entry entry-encyclopedia entry-dictionary" match="any">
                <group delimiter=" ">
                  <text term="volume" form="short"/>
                  <number variable="volume"/>
                </group>
              </if>
            </choose>
            <choose>
              <if type="article-newspaper article-magazine webpage post-weblog post" match="any">
                <text macro="full-date"/>
              </if>
              <else>
                <text macro="year"/>
              </else>
            </choose>
            <text macro="locator"/>
          </group>
        </else-if>
        <else>
          <text macro="full-citation"/>
        </else>
      </choose>
    </layout>
  </citation>
  <!-- Hinweis: Die OeZG arbeitet ausschließlich mit Fußnoten; das Literaturverzeichnis
        (Format identisch mit dem Vollbeleg) ist nur als Komfortfunktion enthalten. -->
  <bibliography>
    <sort>
      <key macro="contributors"/>
      <key macro="year"/>
    </sort>
    <layout suffix=".">
      <text macro="full-citation"/>
    </layout>
  </bibliography>
</style>
