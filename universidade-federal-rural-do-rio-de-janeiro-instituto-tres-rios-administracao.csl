<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" demote-non-dropping-particle="never" default-locale="pt-BR">
  <info>
    <title>Universidade Federal Rural do Rio de Janeiro - Instituto Três Rios - Administração (Português - Brasil)</title>
    <title-short>UFRRJ</title-short>
    <id>http://www.zotero.org/styles/universidade-federal-rural-do-rio-de-janeiro-instituto-tres-rios-administracao</id>
    <link href="http://www.zotero.org/styles/universidade-federal-rural-do-rio-de-janeiro-instituto-tres-rios-administracao" rel="self"/>
    <link href="http://www.zotero.org/styles/associacao-brasileira-de-normas-tecnicas" rel="template"/>
    <link href="https://institucional.ufrrj.br/biblioteca/2026/01/13/manual-para-trabalhos-finais-de-curso/" rel="documentation"/>
    <author>
      <name>Gabriel Rocha Matos</name>
      <email>gbrmt1@ufrrj.br</email>
    </author>
    <category citation-format="author-date"/>
    <summary>Estilo brasileiro autor-data baseado exclusivamente na ABNT NBR 6023:2025 e na ABNT NBR 10520:2023.</summary>
    <updated>2026-08-31T17:13:32+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="pt">
    <terms>
      <term name="in">In</term>
      <term name="no-place">s. l.</term>
      <term name="no-publisher">s. n.</term>
      <term name="volume" form="long">ano</term>
    </terms>
  </locale>
  <macro name="author-bibliography">
    <names variable="author" delimiter="; ">
      <name name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " delimiter-precedes-last="always">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " delimiter-precedes-last="always">
            <name-part name="family" text-case="uppercase"/>
            <name-part name="given"/>
          </name>
          <et-al font-style="italic"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <names variable="translator">
          <name name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " delimiter-precedes-last="always">
            <name-part name="family" text-case="uppercase"/>
            <name-part name="given"/>
          </name>
          <et-al font-style="italic"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="editor-bibliography">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " delimiter-precedes-last="always">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given"/>
      </name>
      <et-al font-style="italic"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="author-citation">
    <names variable="author">
      <name form="short" name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " delimiter-precedes-last="never">
        <name-part name="family" text-case="capitalize-first"/>
      </name>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor">
          <name form="short" name-as-sort-order="all" sort-separator=", " initialize="false" delimiter="; " delimiter-precedes-last="never">
            <name-part name="family" text-case="capitalize-first"/>
          </name>
          <et-al font-style="italic"/>
        </names>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" prefix="[" suffix="]"/>
      </else>
    </choose>
  </macro>
  <macro name="date-periodical">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" prefix="[" suffix="]"/>
      </else>
    </choose>
  </macro>
  <macro name="title-book">
    <text variable="title" font-weight="bold"/>
  </macro>
  <macro name="title-plain">
    <text variable="title"/>
  </macro>
  <macro name="container-title">
    <text variable="container-title" font-weight="bold"/>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" suffix="."/>
          <label variable="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="publisher">
    <choose>
      <if variable="publisher-place publisher" match="any">
        <group delimiter=": ">
          <choose>
            <if variable="publisher-place">
              <text variable="publisher-place"/>
            </if>
            <else>
              <text term="no-place" prefix="[" suffix="]"/>
            </else>
          </choose>
          <choose>
            <if variable="publisher">
              <text variable="publisher"/>
            </if>
            <else>
              <text term="no-publisher" prefix="[" suffix="]"/>
            </else>
          </choose>
        </group>
      </if>
      <else>
        <group delimiter=": " prefix="[" suffix="]">
          <text term="no-place"/>
          <text term="no-publisher"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="journal-details">
    <group delimiter=", ">
      <group delimiter=" ">
        <label variable="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <group delimiter=" ">
        <label variable="issue" form="short"/>
        <text variable="issue"/>
      </group>
      <group delimiter=" ">
        <label variable="page" form="short"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>
  <macro name="chapter-details">
    <group delimiter=", ">
      <group delimiter=" ">
        <label variable="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <group delimiter=" ">
        <label variable="page" form="short"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>
  <macro name="online">
    <group delimiter=". ">
      <text variable="DOI" prefix="DOI: http://dx.doi.org/"/>
      <choose>
        <if variable="URL">
          <group delimiter=": ">
            <text term="available at" text-case="capitalize-first"/>
            <text variable="URL"/>
          </group>
          <group delimiter=": ">
            <text term="accessed" text-case="capitalize-first"/>
            <date variable="accessed">
              <date-part name="day" suffix=" "/>
              <date-part name="month" form="short" suffix=" "/>
              <date-part name="year"/>
            </date>
          </group>
        </if>
      </choose>
    </group>
  </macro>
  <macro name="locator">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>
  <macro name="event">
    <group delimiter=", ">
      <text variable="event" text-case="uppercase"/>
      <text variable="event-place"/>
    </group>
  </macro>
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <sort>
      <key macro="author-citation"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-citation"/>
        <text macro="year"/>
        <text macro="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="false" et-al-min="4" et-al-use-first="1" entry-spacing="1" line-spacing="1">
    <sort>
      <key macro="author-bibliography"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="book" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-book"/>
            <text macro="edition"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="online"/>
          </group>
        </if>
        <else-if type="chapter" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <group delimiter=" ">
              <text term="in" text-case="capitalize-first" font-style="italic" suffix=":"/>
              <text macro="editor-bibliography"/>
              <text macro="container-title"/>
            </group>
            <text macro="edition"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="chapter-details"/>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="article-journal article-magazine" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <group delimiter=", ">
              <text macro="container-title"/>
              <text variable="publisher-place"/>
              <text macro="journal-details"/>
            </group>
            <text macro="date-periodical"/>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="article-newspaper" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <group delimiter=", ">
              <text macro="container-title"/>
              <text macro="journal-details"/>
            </group>
            <text macro="date-periodical"/>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="paper-conference" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <group delimiter=" ">
              <text term="in" text-case="capitalize-first" suffix=":"/>
              <text macro="event"/>
            </group>
            <text variable="container-title" font-weight="bold"/>
            <group delimiter=", ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
              <text macro="year"/>
            </group>
            <group delimiter=" ">
              <label variable="page" form="short"/>
              <text variable="page"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="thesis" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-book"/>
            <text macro="year"/>
            <group delimiter=" ">
              <text variable="genre"/>
              <group delimiter=", " prefix="– ">
                <text variable="publisher"/>
                <text variable="publisher-place"/>
                <text macro="year"/>
              </group>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="report" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-book"/>
            <text variable="genre"/>
            <group delimiter=", ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="webpage post post-weblog" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-book"/>
            <text macro="year"/>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="entry-dictionary entry-encyclopedia" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <text macro="container-title"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <else-if type="patent" match="any">
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-plain"/>
            <text variable="number"/>
            <group delimiter=", ">
              <text variable="publisher-place"/>
              <text macro="year"/>
            </group>
            <text macro="online"/>
          </group>
        </else-if>
        <else>
          <group delimiter=". ">
            <text macro="author-bibliography"/>
            <text macro="title-book"/>
            <text macro="container-title"/>
            <text macro="publisher"/>
            <text macro="year"/>
            <text macro="online"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
