<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-GB">
  <info>
    <title>Kaplan Harvard Referencing Style Guide (4th edition)</title>
    <id>http://www.zotero.org/styles/kaplan-harvard-referencing-style-4th-edition</id>
    <link href="http://www.zotero.org/styles/kaplan-harvard-referencing-style-4th-edition" rel="self"/>
    <link href="http://www.zotero.org/styles/style-manual-for-authors-editors-and-printers-6th-edition-snooks-co" rel="template"/>
    <link href="https://libguides.library.usyd.edu.au/c.php?g=508212&amp;p=3476130" rel="documentation"/>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <summary>Harvard author-date style customised to match the Kaplan Library Harvard Referencing Style Guide, version 4.0 (February 2023).</summary>
    <updated>2026-10-26T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="edition" form="short">edn</term>
      <term name="no date" form="short">n.d.</term>
    </terms>
  </locale>
  <!-- ===================== MACROS ===================== -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" and="symbol" sort-separator=", " initialize-with="" delimiter-precedes-last="never"/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="symbol" delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>
  <!-- Editor(s) as cited inside a chapter entry: "in A Mayne (ed.), Book title" -->
  <macro name="chapter-editor">
    <names variable="editor" prefix="in ">
      <name and="symbol" initialize-with="" delimiter-precedes-last="never"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="title">
    <choose>
      <if type="bill book graphic legal_case legislation motion_picture report standard pamphlet dataset software treaty broadcast post post-weblog song regulation webpage figure map" match="any">
        <text variable="title" font-style="italic"/>
      </if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="publisher">
    <text variable="publisher"/>
  </macro>
  <macro name="publisher-place">
    <text variable="publisher-place"/>
  </macro>
  <macro name="year-date">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="access">
    <choose>
      <if variable="URL">
        <group delimiter=" ">
          <group delimiter=" ">
            <text value="viewed"/>
            <date variable="accessed">
              <date-part name="day" suffix=" "/>
              <date-part name="month" suffix=" "/>
              <date-part name="year"/>
            </date>
          </group>
          <text variable="URL" prefix="&lt;" suffix="&gt;"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="page-pinpoint">
    <group>
      <label variable="page" form="short" suffix=" "/>
      <text variable="page"/>
    </group>
  </macro>
  <!-- groups legislation/case law/treaties together, then everything else, so the
       flat CSL bibliography clusters as closely as possible to Kaplan's separate
       "Legislation" / "Case law" headings (CSL cannot print real sub-headings) -->
  <macro name="type-rank">
    <choose>
      <if type="legislation bill regulation treaty" match="any">
        <text value="2"/>
      </if>
      <else-if type="legal_case">
        <text value="3"/>
      </else-if>
      <else>
        <text value="1"/>
      </else>
    </choose>
  </macro>
  <macro name="sort-name">
    <choose>
      <if type="legal_case legislation bill regulation treaty" match="any">
        <text variable="title"/>
      </if>
      <else>
        <text macro="author"/>
      </else>
    </choose>
  </macro>
  <!-- ===================== CITATION (in-text) ===================== -->
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="true" disambiguate-add-givenname="true">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <choose>
        <if type="legal_case">
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <date variable="issued" prefix="[" suffix="]">
              <date-part name="year"/>
            </date>
            <text variable="authority"/>
            <text variable="locator"/>
          </group>
        </if>
        <else-if type="legislation bill regulation" match="any">
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <date variable="issued">
              <date-part name="year"/>
            </date>
            <text variable="jurisdiction" prefix="(" suffix=")"/>
            <text variable="locator"/>
          </group>
        </else-if>
        <else-if type="treaty">
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <date variable="issued">
              <date-part name="year"/>
            </date>
            <text variable="locator"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <group delimiter=" ">
              <text macro="author-short"/>
              <text macro="year-date"/>
            </group>
            <group>
              <label variable="locator" form="short" suffix=" "/>
              <text variable="locator"/>
            </group>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <!-- ===================== BIBLIOGRAPHY / REFERENCE LIST ===================== -->
  <bibliography hanging-indent="false">
    <sort>
      <key macro="type-rank"/>
      <key macro="sort-name"/>
      <key variable="issued" sort="descending"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <choose>
        <!-- Case law -->
        <if type="legal_case">
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <date variable="issued" prefix="[" suffix="]">
              <date-part name="year"/>
            </date>
            <text variable="authority"/>
          </group>
        </if>
        <!-- Legislation, bills, regulations -->
        <else-if type="legislation bill regulation" match="any">
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <date variable="issued">
              <date-part name="year"/>
            </date>
            <text variable="jurisdiction" prefix="(" suffix=")"/>
          </group>
        </else-if>
        <!-- Conventions and treaties (also listed under "Legislation") -->
        <else-if type="treaty">
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <date variable="issued">
              <date-part name="year"/>
            </date>
          </group>
        </else-if>
        <!-- Chapter from a compiled book -->
        <else-if type="chapter">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <text macro="title" prefix=", "/>
          <text macro="chapter-editor" prefix=", "/>
          <text variable="container-title" font-style="italic" prefix=", "/>
          <text macro="edition" prefix=", "/>
          <text macro="publisher" prefix=", "/>
          <choose>
            <if variable="URL">
              <group prefix=", " delimiter=", ">
                <text macro="page-pinpoint"/>
                <text macro="access"/>
              </group>
            </if>
            <else>
              <text macro="publisher-place" prefix=", "/>
              <text macro="page-pinpoint" prefix=", "/>
            </else>
          </choose>
        </else-if>
        <!-- Conference paper -->
        <else-if type="paper-conference">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <text macro="title" prefix=", "/>
          <text variable="event" font-style="italic" prefix=", "/>
          <text macro="publisher" prefix=", "/>
          <text macro="publisher-place" prefix=", "/>
          <text macro="page-pinpoint" prefix=", "/>
          <text macro="access" prefix=", "/>
        </else-if>
        <!-- Journal articles -->
        <else-if type="article-journal">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <choose>
            <if variable="author editor" match="any">
              <text macro="title" prefix=", "/>
            </if>
          </choose>
          <text variable="container-title" font-style="italic" prefix=", "/>
          <text variable="volume" prefix=", vol. "/>
          <text variable="issue" prefix=", no. "/>
          <text macro="page-pinpoint" prefix=", "/>
          <text macro="access" prefix=", "/>
        </else-if>
        <!-- Newspaper and magazine articles -->
        <else-if type="article-newspaper article-magazine" match="any">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <choose>
            <if variable="author editor" match="any">
              <text macro="title" prefix=", "/>
            </if>
          </choose>
          <text variable="container-title" font-style="italic" text-case="title" prefix=", "/>
          <date variable="issued" prefix=", ">
            <date-part name="day"/>
            <date-part name="month" form="long" prefix=" "/>
          </date>
          <text macro="page-pinpoint" prefix=", "/>
          <text macro="access" prefix=", "/>
        </else-if>
        <!-- Kaplan course material -->
        <else-if type="document">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <choose>
            <if variable="author editor" match="any">
              <text macro="title" prefix=", "/>
            </if>
          </choose>
          <text variable="container-title" font-style="italic" prefix=", "/>
          <text macro="publisher" prefix=", "/>
          <date variable="issued" prefix=", ">
            <date-part name="day"/>
            <date-part name="month" form="long" prefix=" "/>
          </date>
        </else-if>
        <!-- Television and radio broadcasts -->
        <else-if type="broadcast">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <choose>
            <if variable="author editor" match="any">
              <text macro="title" prefix=", "/>
            </if>
          </choose>
          <text variable="medium" prefix=" [" suffix="]"/>
          <text macro="publisher" prefix=", "/>
          <text macro="publisher-place" prefix=", "/>
          <date variable="issued" prefix=", ">
            <date-part name="day"/>
            <date-part name="month" form="long" prefix=" "/>
          </date>
        </else-if>
        <!-- Online video streaming / film, DVD, video; online audio and podcasts -->
        <else-if type="motion_picture song" match="any">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <choose>
            <if variable="author editor" match="any">
              <text macro="title" prefix=", "/>
            </if>
          </choose>
          <text variable="medium" prefix=" [" suffix="]"/>
          <text macro="publisher" prefix=", "/>
          <choose>
            <if variable="URL">
              <text macro="access" prefix=", "/>
            </if>
            <else>
              <text macro="publisher-place" prefix=", "/>
            </else>
          </choose>
        </else-if>
        <!-- Print and eBooks -->
        <else-if type="book">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <choose>
            <if variable="author editor" match="any">
              <text macro="title" prefix=", "/>
            </if>
          </choose>
          <text macro="edition" prefix=", "/>
          <text macro="publisher" prefix=", "/>
          <choose>
            <if variable="URL">
              <text macro="access" prefix=", "/>
            </if>
            <else>
              <text macro="publisher-place" prefix=", "/>
            </else>
          </choose>
        </else-if>
        <!-- Company, industry and government reports; professional and industry standards -->
        <else-if type="report standard" match="any">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <choose>
            <if variable="author editor" match="any">
              <text macro="title" prefix=", "/>
            </if>
          </choose>
          <text variable="number" prefix=", "/>
          <text macro="publisher" prefix=", "/>
          <text macro="access" prefix=", "/>
        </else-if>
        <!-- Websites and webpages -->
        <else-if type="webpage">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <choose>
            <if variable="author editor" match="any">
              <text macro="title" prefix=", "/>
            </if>
          </choose>
          <text macro="publisher" prefix=", "/>
          <text macro="access" prefix=", "/>
        </else-if>
        <!-- Social media, blogs -->
        <else-if type="post post-weblog" match="any">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <choose>
            <if variable="author editor" match="any">
              <text macro="title" prefix=", "/>
            </if>
          </choose>
          <text macro="publisher" prefix=", "/>
          <date variable="issued" prefix=", ">
            <date-part name="day"/>
            <date-part name="month" form="long" prefix=" "/>
          </date>
          <text macro="access" prefix=", "/>
        </else-if>
        <!-- Images, tables, charts; data sources; software/game/application; brochures, posters, pamphlets -->
        <else-if type="graphic figure map dataset software pamphlet" match="any">
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <choose>
            <if variable="author editor" match="any">
              <text macro="title" prefix=", "/>
            </if>
          </choose>
          <text variable="medium" prefix=" [" suffix="]"/>
          <text variable="version" prefix=", version "/>
          <text macro="publisher" prefix=", "/>
          <choose>
            <if variable="URL">
              <text macro="access" prefix=", "/>
            </if>
            <else>
              <text macro="publisher-place" prefix=", "/>
            </else>
          </choose>
        </else-if>
        <!-- Fallback for any other source type -->
        <else>
          <text macro="author"/>
          <text macro="year-date" prefix=" "/>
          <choose>
            <if variable="author editor" match="any">
              <text macro="title" prefix=", "/>
            </if>
          </choose>
          <text macro="publisher" prefix=", "/>
          <text macro="access" prefix=", "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
