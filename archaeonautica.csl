<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Style CSL pour la revue Archaeonautica (système auteur-date)
  ============================================================================

  RENDU ATTENDU
    Citation dans le texte : (Pomey 2014, p. 36 ; Pomey, Boetto 2019)
                             (Dangréaux et al. 2012) (Pomey 2014, 2002, 1995)
    Bibliographie (le bloc des noms forme une ligne à part) :
      DANGRÉAUX B., FRANÇOIS S., GUIBAL F., WICHA S., GENTRIC G.
      2012 « L’épave de la Tour Fondue… », Cah. Archéol. Subaquat., 19, p. 5-36.
      POMEY P.
      1995 « Les épaves grecques et romaines… », CRAI, 139, 2, p. 459-484.
      2002 « Une nouvelle tradition… », dans Tropis VII…, Athènes, Hellenic…, p. 597-603.
      POMEY P., RIETH É.
      2005 L’archéologie navale, Paris, Errance.
      WICHA S.
      2005 Caractérisation…, thèse de doctorat…, Aix-en-Provence, Université de Provence.
    Quand un même auteur (ou un même groupe d'auteurs) a plusieurs entrées,
    son nom n'est donné qu'une fois (attribut subsequent-author-substitute).

  ORGANISATION DU FICHIER
    1. <locale>       : termes propres au style (« dans », « dir. », « [s.d.] »…)
    2. <macro>        : briques réutilisables, regroupées par fonction :
                          noms, titres, publication, dates, pages, accès
    3. <citation>     : forme de l'appel dans le texte
    4. <bibliography> : forme de l'entrée bibliographique

  SAISIE DANS ZOTERO (champs qui pilotent le rendu)
    - Particules : saisir Nom « Larminat », Prénom « Solenn de »
                   → LARMINAT S. de (classée à L).
    - Initiales  : le style réduit le prénom à sa première lettre (Christine → C.).
                   Pour Chr., Th., Ph., etc., saisir directement « Chr. » comme prénom.
                   Les prénoms composés sont gérés : Jean-Pierre → J.-P.
    - Revue      : le champ « Abrév. de revue » remplace le titre complet de la
                   revue s'il est rempli : IJNA, CRAI, Cah. Archéol. Subaquat.
    - Thèse, mémoire : « Type » = thèse de doctorat sous la direction de …,
                   « Lieu » = ville, « Université » = établissement.
    - Collaborateur : un nom saisi avec le rôle « Collaborateur » s'affiche
                   après les auteurs : POMEY P., avec une contribution de RIETH É.
    - Colloque   : type « Article de colloque » ; le titre des actes va dans
                   « Titre des actes » (container-title).

  LANGUES
    Français, anglais (américain), italien, espagnol. La langue se choisit dans
    Zotero (menu « Langue » des préférences du document). Seuls les termes
    changent (dans/in/en, dir./ed./a cura di, [s.l.]/n.p., guillemets…) ;
    la structure des entrées reste celle de la revue.

  POUR ADAPTER LE STYLE
    - Noms en capitales plutôt qu'en petites capitales : dans la macro
      « author-bibliography », remplacer font-variant="small-caps" par
      text-case="uppercase" sur les <name-part>.
    - Tabulation entre l'année et le titre (comme dans un manuscrit Word) :
      dans <bibliography>, remplacer delimiter=" " par delimiter="&#9;"
      sur le groupe qui suit le commentaire « Ligne 2 ».
    - Répéter le nom d'auteur à chaque entrée : supprimer les attributs
      subsequent-author-substitute de <bibliography>.
    - Seuil de « et al. » dans les citations : attributs de <citation> (3 et 1).
      La bibliographie donne toujours tous les auteurs.
    - Ordre des références groupées dans un appel : <sort> de <citation>.
    - Article en anglais, en italien ou en espagnol : point-virgule sans espace
      avant entre les références groupées (voir le commentaire de <citation>).
  ============================================================================
-->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="display-and-sort">
  <info>
    <title>Archaeonautica</title>
    <title-short>Archaeonautica</title-short>
    <id>http://www.zotero.org/styles/archaeonautica</id>
    <link href="http://www.zotero.org/styles/archaeonautica" rel="self"/>
    <link href="http://www.zotero.org/styles/invisu" rel="template"/>
    <link href="https://journals.openedition.org/archaeonautica/279" rel="documentation"/>
    <author>
      <name>Antonio Mendes da Silva</name>
      <email>antonio.mendes@cnrs.fr</email>
    </author>
    <category citation-format="author-date"/>
    <category field="humanities"/>
    <category field="history"/>
    <issn>0154-1854</issn>
    <eissn>2117-6973</eissn>
    <summary>Style conçu pour la revue Archaeonautica. L’archéologie maritime et navale de la préhistoire à l’époque contemporaine. Centre Camille Jullian, CNRS</summary>
    <updated>2026-11-05T20:30:00+01:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <!-- ======================================================================
       1. TERMES (style multilingue : français, anglais américain, italien,
          espagnol)
       Le style ne déclare pas de langue par défaut (pas de default-locale
       sur <style>) : la langue se choisit dans Zotero, dans le menu
       « Langue » des préférences du document (Word, LibreOffice) ou de
       « Créer une bibliographie ». Elle vaut pour toute la bibliographie.
       Chaque bloc ci-dessous ne remplace que les termes qui diffèrent des
       fichiers de langue standard de CSL ; tous les autres viennent de ces
       fichiers (guillemets, « et al. », « vol. », trait d'union des pages…).
       Pour ajouter une langue, copier un bloc et changer xml:lang.
       ====================================================================== -->
  <!-- Français : dans P. Pomey (dir.) ; [s.l.], [s.n.], [s.d.] ;
       avec une contribution de ; consulté en ligne le 12/03/2025 -->
  <locale xml:lang="fr">
    <terms>
      <term name="in">dans</term>
      <term name="no date" form="short">[s.d.]</term>
      <term name="no-place" form="short">[s.l.]</term>
      <term name="no-publisher" form="short">[s.n.]</term>
      <term name="accessed">consulté en ligne le</term>
      <term name="editor" form="short">dir.</term>
      <term name="contributor">avec une contribution de</term>
    </terms>
  </locale>
  <!-- Anglais (américain) : in P. Pomey (ed.) ; n.p., n.d. ;
       with a contribution by ; accessed 3/12/2025 -->
  <locale xml:lang="en">
    <terms>
      <term name="page" form="short">p.</term>
      <term name="contributor">with a contribution by</term>
    </terms>
  </locale>
  <!-- Italien : in P. Pomey (a cura di) ; [s.l.], [s.n.], [s.d.] ;
       con un contributo di ; consultato il 12/03/2025 -->
  <locale xml:lang="it">
    <terms>
      <term name="no date" form="short">[s.d.]</term>
      <term name="no-place" form="short">[s.l.]</term>
      <term name="no-publisher" form="short">[s.n.]</term>
      <term name="accessed">consultato il</term>
      <term name="editor" form="short">a cura di</term>
      <term name="page" form="short">p.</term>
      <term name="contributor">con un contributo di</term>
    </terms>
  </locale>
  <!-- Espagnol : en P. Pomey (ed.) ; [s.l.], [s.n.], [s.f.] ;
       con una contribución de ; consultado el 12/03/2025 -->
  <locale xml:lang="es">
    <terms>
      <term name="no date" form="short">[s.f.]</term>
      <term name="no-place" form="short">[s.l.]</term>
      <term name="no-publisher" form="short">[s.n.]</term>
      <term name="accessed">consultado el</term>
      <term name="page" form="short">p.</term>
      <term name="contributor">con una contribución de</term>
    </terms>
  </locale>

  <!-- ======================================================================
       2a. NOMS
       ====================================================================== -->

  <!-- Nom dans la citation : (Pomey 2014), (Pomey, Boetto 2019),
       (Dangréaux et al. 2012). Les seuils d'et al. sont fixés sur <citation>.
       Sans auteur : éditeurs scientifiques, puis titre abrégé. -->
  <macro name="author-citation">
    <names variable="author">
      <name form="short">
        <name-part name="family" font-variant="small-caps"/>
      </name>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <names variable="collection-editor"/>
        <text variable="title" form="short" font-variant="small-caps"/>
      </substitute>
    </names>
  </macro>

  <!-- Bloc des noms en tête d'entrée : tous les auteurs, nom puis initiales,
       séparés par des virgules, sans « et » :
         DANGRÉAUX B., FRANÇOIS S., GUIBAL F., WICHA S., GENTRIC G.
       Sans auteur : éditeurs scientifiques suivis de (dir.), sinon titre abrégé.
       Sert aussi de première clé de tri (cf. <bibliography>). -->
  <macro name="author-bibliography">
    <choose>
      <!-- Auteurs, suivis des collaborateurs éventuels (rôle « Collaborateur ») :
             POMEY P., avec une contribution de RIETH É.
           Les deux variables sont dans le même élément <names> pour que le
           regroupement par auteur distingue « POMEY P. » de
           « POMEY P., avec une contribution de RIETH É. ».
           Le terme « author » étant vide, seul le terme « contributor » s'affiche. -->
      <if variable="author">
        <names variable="author contributor" delimiter=", ">
          <label form="long" suffix=" "/>
          <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", ">
            <name-part name="family" font-variant="small-caps"/>
          </name>
        </names>
      </if>
      <!-- Sans auteur : POMEY P., RIETH É. (dir.)
           Limite : Zotero compare les noms sans tenir compte du rôle. Si un
           ouvrage dirigé suit un ouvrage écrit par les mêmes personnes, seul
           « (dir.) » s'affiche en ligne 1. -->
      <else-if variable="editor collection-editor" match="any">
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=" " initialize-with=". " delimiter=", ">
            <name-part name="family" font-variant="small-caps"/>
          </name>
          <label form="short" prefix=" (" suffix=")"/>
          <substitute>
            <names variable="collection-editor"/>
          </substitute>
        </names>
      </else-if>
      <!-- Ni auteur ni éditeur : titre abrégé (champ « Titre abrégé »), le titre
           complet restant en ligne 2. Placé hors de <substitute> pour que le
           titre ne soit pas supprimé du reste de l'entrée. -->
      <else>
        <text variable="title" form="short" font-variant="small-caps"/>
      </else>
    </choose>
  </macro>

  <!-- Éditeurs scientifiques d'un volume, en ordre naturel :
         dans P. Pomey et É. Rieth (dir.), … -->
  <macro name="editor">
    <names variable="editor">
      <name and="text" initialize-with=". " delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" font-variant="small-caps"/>
      </name>
      <label form="short" prefix="&#160;(" suffix=")"/>
    </names>
  </macro>

  <!-- Traducteur : traduit par Éric Rieth -->
  <macro name="translator">
    <names variable="translator">
      <label form="verb" suffix=" "/>
      <name and="text" delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" font-variant="small-caps"/>
      </name>
    </names>
  </macro>

  <macro name="interviewer">
    <names variable="interviewer">
      <label form="verb" suffix=" "/>
      <name and="text" delimiter=", ">
        <name-part name="family" font-variant="small-caps"/>
      </name>
    </names>
  </macro>

  <!-- ======================================================================
       2b. TITRES
       Titres d'articles, de chapitres, de communications et de pages web
       entre guillemets français (« … »), en romain, comme le préconise le CMOS ;
       titres de livres, de thèses, de revues et de volumes en italique.
       ====================================================================== -->
  <macro name="title">
    <choose>
      <if type="article-journal article-magazine article-newspaper chapter paper-conference entry-dictionary entry-encyclopedia post post-weblog webpage" match="any">
        <text variable="title" text-case="capitalize-first" quotes="true"/>
      </if>
      <else>
        <text variable="title" text-case="capitalize-first" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- Revue, volume, numéro : IJNA, 48, 1
       L'abréviation de la revue remplace le titre complet si elle existe. -->
  <macro name="journal">
    <group delimiter=", ">
      <choose>
        <if variable="container-title-short">
          <text variable="container-title-short" font-style="italic"/>
        </if>
        <else>
          <text variable="container-title" font-style="italic"/>
        </else>
      </choose>
      <text variable="volume"/>
      <text variable="issue"/>
    </group>
  </macro>

  <!-- Volume hôte d'un chapitre ou d'une communication :
         dans G. Volpe (dir.), Archeologia subacquea…, II -->
  <macro name="container-book">
    <group delimiter=" ">
      <text term="in"/>
      <group delimiter=", ">
        <text macro="editor"/>
        <text variable="container-title" text-case="capitalize-first" font-style="italic"/>
        <text macro="volume"/>
      </group>
    </group>
  </macro>

  <!-- Tome d'un ouvrage en plusieurs volumes : vol. 2 (ou II tel que saisi) ;
       à défaut, nombre de volumes : 2 vol. -->
  <macro name="volume">
    <choose>
      <if is-numeric="volume">
        <group delimiter="&#160;">
          <text term="volume" form="short"/>
          <text variable="volume"/>
        </group>
      </if>
      <else-if variable="volume">
        <text variable="volume"/>
      </else-if>
      <else>
        <group delimiter="&#160;">
          <text variable="number-of-volumes"/>
          <text term="volume" form="short" plural="true"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- Partie descriptive de l'entrée, selon le type de document.
       Chaque élément est séparé du suivant par une virgule. -->
  <macro name="description">
    <choose>
      <!-- Article : « Titre », Revue, volume, numéro, p. 5-36 -->
      <if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <text macro="translator"/>
          <text macro="journal"/>
          <text macro="page-bib"/>
        </group>
      </if>
      <!-- Chapitre, communication, notice :
           « Titre », dans É. Éditeur (dir.), Volume, Lieu, Éditeur (Collection), p. 425-446 -->
      <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <text macro="translator"/>
          <text macro="container-book"/>
          <text macro="edition"/>
          <text macro="publication"/>
          <text macro="page-bib"/>
        </group>
      </else-if>
      <!-- Thèse, mémoire :
           Titre, thèse de doctorat sous la direction de …, Aix-en-Provence, Université de Provence -->
      <else-if type="thesis" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <text variable="genre"/>
          <text macro="publication"/>
          <text macro="volume"/>
          <text macro="page-bib"/>
        </group>
      </else-if>
      <!-- Communication orale : Titre, communication présentée à Colloque, Lieu -->
      <else-if type="speech" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <text macro="event"/>
          <text variable="publisher-place"/>
        </group>
      </else-if>
      <!-- Page web, billet : « Titre », Site (l'URL suit sur une ligne à part) -->
      <else-if type="webpage post post-weblog" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <text variable="genre"/>
          <text variable="container-title" font-style="italic"/>
        </group>
      </else-if>
      <!-- Image, entretien, communication personnelle, film -->
      <else-if type="graphic personal_communication interview motion_picture broadcast" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <text macro="interviewer"/>
          <text variable="container-title" font-style="italic"/>
          <text variable="medium"/>
          <text variable="genre"/>
          <text variable="dimensions"/>
          <text variable="publisher"/>
        </group>
      </else-if>
      <!-- Manuscrit, carte : Titre, type, échelle, Lieu -->
      <else-if type="manuscript map" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <text variable="genre"/>
          <text variable="scale"/>
          <text macro="edition"/>
          <text macro="publication"/>
          <text macro="page-bib"/>
        </group>
      </else-if>
      <!-- Livre, rapport et tout autre type :
           Titre, vol. 2, 2e éd., Paris, Errance (Collection, 12) -->
      <else>
        <group delimiter=", ">
          <text macro="title"/>
          <text macro="volume"/>
          <text macro="translator"/>
          <text macro="edition"/>
          <text variable="genre"/>
          <text macro="publication"/>
          <text macro="page-bib"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- ======================================================================
       2c. PUBLICATION (édition, colloque, lieu, éditeur, collection)
       ====================================================================== -->

  <!-- Édition : 2e éd. -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <!-- Colloque (champ « Intitulé de la conférence ») pour une communication orale :
       communication présentée à Journées… -->
  <macro name="event">
    <group delimiter=" ">
      <text variable="genre"/>
      <text term="presented at"/>
      <text variable="event-title"/>
    </group>
  </macro>

  <!-- Lieu, éditeur et collection : Paris, Errance (Collection, 12)
       Lieu ou éditeur absent : [s.l.], [s.n.] (termes no-place, no-publisher). -->
  <macro name="publication">
    <group delimiter=" ">
      <group delimiter=", ">
        <choose>
          <if variable="publisher-place">
            <text variable="publisher-place"/>
          </if>
          <else>
            <text term="no-place" form="short"/>
          </else>
        </choose>
        <choose>
          <if variable="publisher">
            <text variable="publisher"/>
          </if>
          <else>
            <text term="no-publisher" form="short"/>
          </else>
        </choose>
      </group>
      <text macro="collection"/>
    </group>
  </macro>

  <!-- Collection entre parenthèses : (Notizie degli Scavi di Antichità, 30) -->
  <macro name="collection">
    <group delimiter=", " prefix="(" suffix=")">
      <text variable="collection-title"/>
      <text variable="collection-number"/>
    </group>
  </macro>

  <!-- ======================================================================
       2d. DATES
       ====================================================================== -->

  <!-- Année en début de la 2e ligne : 2019, 2019a, [s.d.] -->
  <macro name="year-date">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <!-- ======================================================================
       2e. PAGES
       ====================================================================== -->

  <!-- Pages d'un article ou d'un chapitre : p. 5-36
       Nombre de pages d'une thèse, d'un manuscrit, d'une carte : 250 p.
       Rien pour les livres. -->
  <macro name="page-bib">
    <choose>
      <if type="article-journal article-magazine article-newspaper chapter paper-conference entry-dictionary entry-encyclopedia report" match="any">
        <group delimiter="&#160;">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </if>
      <else-if type="thesis manuscript map" match="any">
        <group delimiter="&#160;">
          <text variable="number-of-pages"/>
          <choose>
            <if is-numeric="number-of-pages">
              <text term="page" form="short"/>
            </if>
          </choose>
        </group>
      </else-if>
    </choose>
  </macro>

  <!-- ======================================================================
       2f. ARCHIVES ET ACCÈS EN LIGNE
       ====================================================================== -->

  <!-- Fonds d'archives : Archives nationales, F/21/1234 -->
  <macro name="archive">
    <group delimiter=", ">
      <text variable="archive"/>
      <text variable="archive_location"/>
      <text variable="call-number"/>
    </group>
  </macro>

  <!-- URL et date de consultation, sur une ligne à part :
       https://… (consulté en ligne le 12/03/2025).
       La date seule (sans URL) n'est pas affichée. -->
  <macro name="accessed">
    <choose>
      <if variable="URL">
        <group delimiter=" ">
          <text variable="URL"/>
          <group delimiter=" " prefix="(" suffix=").">
            <text term="accessed"/>
            <date variable="accessed" form="numeric"/>
          </group>
        </group>
      </if>
    </choose>
  </macro>

  <!-- ======================================================================
       3. CITATION DANS LE TEXTE
       (Pomey 2014, p. 36) — (Pomey 2014, 2002, 1995) — (Pomey, Boetto 2019 ; Long 2004)
       ====================================================================== -->
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year" cite-group-delimiter=", " year-suffix-delimiter=", " name-delimiter=", " delimiter-precedes-last="never">
    <sort>
      <!-- Ordre des références groupées : de la plus récente à la plus ancienne.
           Pour un ordre alphabétique, remplacer les trois clés par :
           <key macro="author-citation"/> <key variable="issued"/> -->
      <key variable="issued" sort="descending"/>
      <key macro="author-citation"/>
      <key macro="title"/>
    </sort>
    <!-- Séparateur des références groupées : espace insécable + point-virgule,
         selon la typographie française. CSL ne permet pas de le faire varier
         selon la langue choisie : pour un article en anglais, en italien ou
         en espagnol, remplacer delimiter="&#160;; " par delimiter="; ". -->
    <layout prefix="(" suffix=")" delimiter="&#160;; ">
      <group delimiter=", ">
        <group delimiter=" ">
          <text macro="author-citation"/>
          <text macro="year-date"/>
        </group>
        <group delimiter="&#160;">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <!-- ======================================================================
       4. BIBLIOGRAPHIE
       Ligne 1 : noms (omis si identiques à ceux de l'entrée précédente)
       Ligne 2 : année puis description
       Ligne 3 : URL éventuelle
       ====================================================================== -->
  <bibliography subsequent-author-substitute="" subsequent-author-substitute-rule="complete-all">
    <sort>
      <!-- liste complète des auteurs, puis année croissante, puis titre :
           POMEY P. 1995, 2002, 2014 < POMEY P., BOETTO G. < POMEY P., POVEDA P. -->
      <key macro="author-bibliography"/>
      <key variable="issued"/>
      <key macro="title"/>
    </sort>
    <layout>
      <!-- Ligne 1 -->
      <group display="block">
        <text macro="author-bibliography"/>
      </group>
      <!-- Ligne 2 -->
      <group delimiter=" " suffix=".">
        <text macro="year-date"/>
        <group delimiter=", ">
          <text macro="description"/>
          <text macro="archive"/>
        </group>
      </group>
      <!-- Ligne 3 -->
      <group display="block">
        <text macro="accessed"/>
      </group>
    </layout>
  </bibliography>
</style>
