<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <!-- This style was edited with the Visual CSL Editor (https://editor.citationstyles.org/codeEditor/) -->
  <info>
    <title>Cleaner Environmental Systems</title>
    <title-short>Clean. Environ. Syst.</title-short>
    <id>http://www.zotero.org/styles/cleaner-environmental-systems</id>
    <link href="http://www.zotero.org/styles/cleaner-environmental-systems" rel="self"/>
    <link href="http://www.zotero.org/styles/elsevier-vancouver" rel="template"/>
    <link href="https://www.journals.elsevier.com/cleaner-environmental-systems" rel="documentation"/>
    <author>
      <name>Louis Freboeuf</name>
    </author>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <category field="science"/>
    <summary>Reference style for Cleaner Environmental Systems journal. Numbered references in order of appearance, with journal names abbreviated according to LTWA.</summary>
    <updated>2026-07-29T13:14:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
    <issn>2666-7894</issn>
  </info>
  <macro name="author">
    <names variable="author">
      <name initialize-with="." delimiter=", " delimiter-precedes-last="always" sort-separator=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name initialize-with="." delimiter=", " delimiter-precedes-last="always" sort-separator=", "/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>
  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
    </choose>
  </macro>
  <macro name="url-access">
    <choose>
      <if variable="URL">
        <text variable="URL"/>
        <group prefix=" (" suffix=")" delimiter=" ">
          <text term="accessed"/>
          <date variable="accessed" form="text"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="pages">
    <text variable="page"/>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="] "/>
      <choose>
        <if type="article-journal">
          <group>
            <text macro="author" suffix=", "/>
            <text variable="title" suffix=", "/>
            <text variable="container-title" form="short" text-case="title" suffix=" "/>
            <text variable="volume" suffix=" "/>
            <group prefix="(" suffix=") ">
              <text macro="year"/>
            </group>
            <choose>
              <if variable="page">
                <text variable="page"/>
              </if>
              <else-if variable="article-number">
                <text variable="article-number"/>
              </else-if>
            </choose>
            <text macro="doi" prefix=". "/>
          </group>
        </if>
        <!-- Book -->
        <else-if type="book">
          <group suffix=".">
            <text macro="author" suffix=", "/>
            <text variable="title" suffix=", "/>
            <text macro="edition" suffix=", "/>
            <text macro="publisher" suffix=", "/>
            <text macro="year"/>
            <choose>
              <if variable="DOI">
                <text value=". " suffix=""/>
                <text macro="doi"/>
              </if>
            </choose>
          </group>
        </else-if>
        <else-if type="chapter">
          <group>
            <text macro="author" suffix=", "/>
            <text variable="title" suffix=", "/>
            <group delimiter=": ">
              <text term="in" text-case="sentence"/>
              <text macro="editor" suffix=", "/>
            </group>
            <text variable="container-title" suffix=", "/>
            <text macro="publisher" suffix=", "/>
            <text macro="year" suffix=", "/>
            <group delimiter=" ">
              <text value="pp" suffix=" "/>
              <text variable="page" suffix=". "/>
            </group>
            <text macro="doi"/>
          </group>
        </else-if>
        <else-if type="standard">
          <group>
	    <text variable="publisher" suffix=" "/>
            <text variable="number" suffix=": "/>     
	    <text variable="title" suffix=", "/>
            <text variable="publisher-place" suffix=", "/>
            <text macro="year" suffix=""/>
          </group>
        </else-if>
        <else-if type="dataset">
          <group>
            <text macro="author" suffix=", "/>
            <text variable="title" suffix=" "/>
            <text value="[dataset]" suffix=", "/>
            <text variable="publisher" suffix=", "/>
            <text variable="version" prefix="v" suffix=", "/>
            <text macro="year" suffix=". "/>
            <text macro="doi"/>
          </group>
        </else-if>
        <else-if type="software">
          <group>
            <text macro="author" suffix=", "/>
            <text variable="title" suffix=" "/>
            <text value="[software]" suffix=", "/>
            <text variable="publisher" suffix=", "/>
            <date variable="issued" form="text" suffix=". "/>
            <text macro="doi"/>
          </group>
        </else-if>
        <else-if type="report">
          <group>
          <text macro="author" suffix=", "/>
          <text variable="title" suffix=", "/>
          <text variable="publisher" suffix=", "/>
          <text variable="publisher-place" suffix=", "/>
          <text macro="year" suffix=". "/>
          <choose>
            <if variable="DOI">
              <text variable="DOI" prefix="https://doi.org/"/>
            </if>
            <else>
              <text macro="url-access"/>
            </else>
          </choose>
        </group>
        </else-if>
        <else-if type="thesis">
          <group>
            <text macro="author" suffix=", "/>
            <text variable="title" suffix=", "/>
            <text variable="genre" suffix=", "/>
            <text variable="publisher" suffix=", "/>
            <text variable="publisher-place" suffix=", "/>
            <text macro="year" suffix=". "/>
            <text macro="doi"/>
          </group>
        </else-if>
        <else-if type="webpage">
          <group>
            <text macro="author" suffix=", "/>
            <text variable="title" suffix=". "/>
            <text variable="URL" suffix=", "/>
            <date variable="issued" form="text" suffix=" "/>
            <group prefix="(" suffix=")" delimiter=" ">
              <text term="accessed"/>
              <date variable="accessed" form="text"/>
            </group>
          </group>
        </else-if>
        <else-if type="manuscript">
          <group>
            <text macro="author" suffix=", "/>
            <text variable="title" suffix=" "/>
            <text value="[preprint]" suffix=", "/>
            <text variable="publisher" suffix=", "/>
            <text macro="year" suffix=". "/>
            <text macro="doi"/>
          </group>
        </else-if>
        <else>
          <group>
            <text macro="author" suffix=", "/>
            <text variable="title" suffix=", "/>
            <choose>
              <if variable="container-title">
                <text variable="container-title" form="short" text-case="title" suffix=", "/>
              </if>
            </choose>
            <text macro="publisher" suffix=", "/>
            <text macro="year" suffix=". "/>
            <text macro="doi"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
