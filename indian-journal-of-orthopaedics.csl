<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Indian Journal of Orthopaedics</title>
    <title-short>IJO</title-short>
    <id>http://www.zotero.org/styles/indian-journal-of-orthopaedics</id>
    <link href="http://www.zotero.org/styles/indian-journal-of-orthopaedics" rel="self"/>
    <link href="https://link.springer.com/journal/43465/submission-guidelines#Instructions%20for%20Authors_References" rel="documentation"/>
    <author>
      <name>Srinivas B S Kambhampati</name>
      <email>kbssrinivas@yahoo.com</email>
    </author>
    <contributor>
      <name>Patrick O'Brien</name>
    </contributor>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <issn>0019-5413</issn>
    <eissn>1998-3727</eissn>
    <summary>Numeric NLM/Index Medicus style for manuscripts submitted to the Indian Journal of Orthopaedics.</summary>
    <updated>2026-10-20T00:00:00+05:30</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name initialize-with="" name-as-sort-order="all" sort-separator=" " delimiter=", " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>
  <macro name="editor">
    <names variable="editor">
      <name initialize-with="" name-as-sort-order="all" sort-separator=" " delimiter=", " delimiter-precedes-last="never"/>
      <label form="long" prefix=", "/>
    </names>
  </macro>
  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="issued-date">
    <date variable="issued">
      <date-part name="year" suffix=" "/>
      <date-part name="month" form="short" suffix=" "/>
      <date-part name="day"/>
    </date>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="accessed">
    <date variable="accessed" prefix="[cited " suffix="]">
      <date-part name="year" suffix=" "/>
      <date-part name="month" form="short" suffix=" "/>
      <date-part name="day"/>
    </date>
  </macro>
  <macro name="identifier">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi: "/>
      </if>
      <else-if variable="URL">
        <group delimiter=". ">
          <text macro="accessed"/>
          <text variable="URL" prefix="Available from: "/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="journal-details">
    <group delimiter=";">
      <group delimiter=" ">
        <text variable="container-title" form="short"/>
        <text macro="issued-year"/>
      </group>
      <group delimiter=":">
        <text variable="volume"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <text macro="author" suffix=". "/>
      <choose>
        <if type="article-journal article-magazine review review-book" match="any">
          <text variable="title" suffix=". "/>
          <text macro="journal-details"/>
        </if>
        <else-if type="article-newspaper">
          <text variable="title" suffix=". "/>
          <text variable="container-title" form="short" suffix=". "/>
          <text macro="issued-date"/>
          <text variable="section" prefix=";"/>
          <text variable="page" prefix=":"/>
        </else-if>
        <else-if type="book graphic motion_picture musical_score pamphlet song" match="any">
          <group delimiter=", ">
            <text variable="title"/>
            <text macro="edition"/>
            <text variable="volume" prefix="Vol. "/>
            <text variable="publisher-place"/>
            <text variable="publisher"/>
            <text macro="issued-year"/>
          </group>
          <text variable="page" prefix="; "/>
        </else-if>
        <else-if type="chapter entry entry-dictionary entry-encyclopedia paper-conference" match="any">
          <text variable="title" suffix=". "/>
          <group prefix="In " delimiter=", ">
            <text macro="editor"/>
            <text variable="container-title"/>
            <text macro="edition"/>
            <text variable="volume" prefix="Vol. "/>
            <text variable="publisher-place"/>
            <text variable="publisher"/>
            <text macro="issued-year"/>
          </group>
          <text variable="page" prefix=";"/>
        </else-if>
        <else-if type="report thesis manuscript speech" match="any">
          <text variable="title"/>
          <text variable="genre" prefix=" [" suffix="]"/>
          <text macro="publisher" prefix=". "/>
          <text macro="issued-year" prefix="; "/>
          <text variable="number" prefix=". Report No.: "/>
        </else-if>
        <else-if type="dataset">
          <text variable="title" suffix=" [dataset]. "/>
          <text variable="publisher" suffix="; "/>
          <text macro="issued-year"/>
          <text variable="version" prefix=". Version "/>
        </else-if>
        <else-if type="patent">
          <text variable="title" suffix=". "/>
          <text variable="jurisdiction" suffix=" patent "/>
          <text variable="number" suffix=". "/>
          <text macro="issued-date"/>
        </else-if>
        <else-if type="webpage post post-weblog" match="any">
          <text variable="title" suffix=" [Internet]. "/>
          <text variable="container-title" suffix=". "/>
          <text macro="issued-year"/>
        </else-if>
        <else-if type="bill legal_case legislation regulation treaty" match="any">
          <text variable="title" suffix=". "/>
          <text variable="container-title"/>
          <text variable="volume" prefix=" "/>
          <text variable="number" prefix="(" suffix=")"/>
          <text variable="page" prefix=":"/>
          <text macro="issued-year" prefix="; "/>
        </else-if>
        <else>
          <text variable="title"/>
          <text variable="container-title" prefix=". "/>
          <text macro="issued-year" prefix=". "/>
        </else>
      </choose>
      <text macro="identifier" prefix=". "/>
    </layout>
  </bibliography>
</style>
