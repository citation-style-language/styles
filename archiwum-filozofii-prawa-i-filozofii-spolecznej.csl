<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="note" default-locale="pl-PL" demote-non-dropping-particle="sort-only">
  <info>
    <title>Archiwum Filozofii Prawa i Filozofii Społecznej</title>
    <title-short>AFPiFS</title-short>
    <id>http://www.zotero.org/styles/archiwum-filozofii-prawa-i-filozofii-spolecznej</id>
    <link href="http://www.zotero.org/styles/archiwum-filozofii-prawa-i-filozofii-spolecznej" rel="self"/>
    <link href="https://archiwum.ivr.org.pl/wytyczne-dla-autorow/" rel="documentation"/>
    <author><name>Archiwum Filozofii Prawa i Filozofii Społecznej</name></author>
    <category citation-format="note"/>
    <category field="law"/>
    <summary>Footnote and bibliography style for AFPiFS based on the journal's current author guidelines.</summary>
    <updated>2026-08-20T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="pl-PL">
    <terms>
      <term name="page" form="short">s.</term>
      <term name="page-range-delimiter">–</term>
      <term name="editor" form="short">red.</term>
      <term name="editor" form="short" plural="true">red.</term>
      <term name="translator" form="short">tłum.</term>
      <term name="accessed">dostęp</term>
    </terms>
  </locale>
  <macro name="author-note">
    <names variable="author">
      <name initialize-with=". " delimiter=", " and="text"/>
      <substitute><names variable="editor"><name initialize-with=". " delimiter=", "/></names><text variable="title"/></substitute>
    </names>
  </macro>
  <macro name="author-bib">
    <names variable="author">
      <name initialize-with=". " name-as-sort-order="all" sort-separator=" " delimiter=", " and="text"/>
      <substitute><names variable="editor"><name initialize-with=". " name-as-sort-order="all" sort-separator=" " delimiter=", "/></names><text variable="title"/></substitute>
    </names>
  </macro>
  <macro name="editors">
    <names variable="editor">
      <label form="short" suffix=" "/><name initialize-with=". " delimiter=", "/>
    </names>
  </macro>
  <macro name="issued-year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>
  <macro name="issued-date">
    <date variable="issued" delimiter=".">
      <date-part name="day" form="numeric-leading-zeros"/>
      <date-part name="month" form="numeric-leading-zeros"/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="accessed-date">
    <date variable="accessed" delimiter=".">
      <date-part name="day" form="numeric-leading-zeros"/>
      <date-part name="month" form="numeric-leading-zeros"/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="pages">
    <group delimiter=" "><label variable="page" form="short"/><text variable="page"/></group>
  </macro>
  <macro name="book-body">
    <group delimiter=", ">
      <text variable="title" font-style="italic"/>
      <text variable="edition" prefix="wyd. "/>
      <text variable="publisher"/>
      <group delimiter=" "><text variable="publisher-place"/><text macro="issued-year"/></group>
    </group>
  </macro>
  <macro name="container-book">
    <group delimiter=", ">
      <text variable="container-title" font-style="italic"/>
      <text macro="editors"/>
      <text variable="edition" prefix="wyd. "/>
      <text variable="publisher"/>
      <group delimiter=" "><text variable="publisher-place"/><text macro="issued-year"/></group>
    </group>
  </macro>
  <macro name="journal-body">
    <group delimiter=", ">
      <group delimiter=" "><text variable="container-title" quotes="true"/><text macro="issued-year"/></group>
      <text variable="volume" prefix="t. "/>
      <text variable="issue" prefix="nr "/>
      <text macro="pages"/>
    </group>
  </macro>
  <macro name="web-body">
    <group delimiter=", ">
      <text variable="container-title"/>
      <text macro="issued-date"/>
      <group delimiter=" "><text variable="URL"/><group prefix="(" suffix=")" delimiter=": "><text term="accessed"/><text macro="accessed-date"/></group></group>
    </group>
  </macro>
  <macro name="full-entry-note">
    <group delimiter=", ">
      <text macro="author-note"/>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <text variable="title"/>
          <text macro="journal-body"/>
        </if>
        <else-if type="chapter paper-conference entry-encyclopedia" match="any">
          <group delimiter=" [w:] "><text variable="title"/><text macro="container-book"/></group>
          <text macro="pages"/>
        </else-if>
        <else-if type="webpage post-weblog" match="any">
          <text variable="title"/>
          <text macro="web-body"/>
        </else-if>
        <else>
          <text macro="book-body"/>
          <text macro="pages"/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="full-entry-bib">
    <group delimiter=", ">
      <text macro="author-bib"/>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <text variable="title"/>
          <text macro="journal-body"/>
        </if>
        <else-if type="chapter paper-conference entry-encyclopedia" match="any">
          <group delimiter=" [w:] "><text variable="title"/><text macro="container-book"/></group>
          <text macro="pages"/>
        </else-if>
        <else-if type="webpage post-weblog" match="any">
          <text variable="title"/>
          <text macro="web-body"/>
        </else-if>
        <else>
          <text macro="book-body"/>
          <text macro="pages"/>
        </else>
      </choose>
    </group>
  </macro>
  <citation et-al-min="4" et-al-use-first="1">
    <layout suffix=".">
      <choose>
        <if position="subsequent">
          <group delimiter=", "><text macro="author-note"/><text variable="title" form="short"/><text macro="pages"/></group>
        </if>
        <else><text macro="full-entry-note"/></else>
      </choose>
    </layout>
  </citation>
  <bibliography hanging-indent="false" et-al-min="7" et-al-use-first="6">
    <sort><key macro="author-bib"/><key variable="title"/></sort>
    <layout suffix="."><text macro="full-entry-bib"/></layout>
  </bibliography>
</style>
