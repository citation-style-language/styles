<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" page-range-format="expanded" default-locale="pl-PL">
  <info>
    <title>Wikipedia &#8211; szablon Cytuj (polski)</title>
    <title-short>plwiki Cytuj</title-short>
    <id>http://www.zotero.org/styles/wikipedia-szablon-cytuj</id>
    <link href="http://www.zotero.org/styles/wikipedia-szablon-cytuj" rel="self"/>
    <link href="https://pl.wikipedia.org/wiki/Szablon:Cytuj" rel="documentation"/>
    <author>
      <name>Maciek Szostek (Piastu)</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Wstawia szablon {{Cytuj}} polskojęzycznej Wikipedii, owinięty w znaczniki ref.</summary>
    <updated>2026-11-26T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- Autorzy w zapisie katalogowym: "Nazwisko, Imię; Nazwisko, Imię;".
       Końcowy średnik każe parserowi {{Cytuj}} traktować przecinek jako
       separator nazwiska i imion (ważne przy nazwiskach wielowyrazowych). -->
  <macro name="autor">
    <choose>
      <if type="chapter paper-conference" match="any">
        <names variable="container-author" prefix=" | autor = " suffix=";">
          <name name-as-sort-order="all" sort-separator=", " delimiter="; "/>
        </names>
      </if>
      <else-if type="entry entry-dictionary entry-encyclopedia" match="any">
        <choose>
          <if variable="URL" match="none">
            <names variable="container-author" prefix=" | autor = " suffix=";">
              <name name-as-sort-order="all" sort-separator=", " delimiter="; "/>
            </names>
          </if>
          <else>
            <names variable="author" prefix=" | autor = " suffix=";">
              <name name-as-sort-order="all" sort-separator=", " delimiter="; "/>
            </names>
          </else>
        </choose>
      </else-if>
      <else>
        <names variable="author" prefix=" | autor = " suffix=";">
          <name name-as-sort-order="all" sort-separator=", " delimiter="; "/>
        </names>
      </else>
    </choose>
  </macro>
  <!-- Autor rozdziału: rozdziały, referaty i hasła encyklopedii drukowanych -->
  <macro name="autor-r">
    <choose>
      <if type="chapter paper-conference" match="any">
        <names variable="author" prefix=" | autor r = " suffix=";">
          <name name-as-sort-order="all" sort-separator=", " delimiter="; "/>
        </names>
      </if>
      <else-if type="entry entry-dictionary entry-encyclopedia" match="any">
        <choose>
          <if variable="URL" match="none">
            <names variable="author" prefix=" | autor r = " suffix=";">
              <name name-as-sort-order="all" sort-separator=", " delimiter="; "/>
            </names>
          </if>
        </choose>
      </else-if>
    </choose>
  </macro>
  <macro name="redaktor">
    <names variable="editor" prefix=" | redaktor = " suffix=";">
      <name name-as-sort-order="all" sort-separator=", " delimiter="; "/>
    </names>
  </macro>
  <macro name="inni">
    <names variable="translator" prefix=" | inni = ">
      <name delimiter="; "/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="rozdzial">
    <choose>
      <if type="chapter paper-conference" match="any">
        <text variable="title" prefix=" | rozdział = "/>
      </if>
      <else-if type="entry entry-dictionary entry-encyclopedia" match="any">
        <choose>
          <if variable="URL" match="none">
            <text variable="title" prefix=" | rozdział = "/>
          </if>
        </choose>
      </else-if>
    </choose>
  </macro>
  <macro name="tytul">
    <choose>
      <if type="chapter paper-conference" match="any">
        <text variable="container-title" prefix=" | tytuł = "/>
      </if>
      <else-if type="entry entry-dictionary entry-encyclopedia" match="any">
        <choose>
          <if variable="URL" match="none">
            <text variable="container-title" prefix=" | tytuł = "/>
          </if>
          <else>
            <text variable="title" prefix=" | tytuł = "/>
          </else>
        </choose>
      </else-if>
      <else>
        <text variable="title" prefix=" | tytuł = "/>
      </else>
    </choose>
  </macro>
  <macro name="czasopismo">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <text variable="container-title" prefix=" | czasopismo = "/>
      </if>
    </choose>
  </macro>
  <!-- Hasło encyklopedii online: nazwa encyklopedii idzie do "praca" -->
  <macro name="praca">
    <choose>
      <if type="entry entry-dictionary entry-encyclopedia" match="any">
        <choose>
          <if variable="URL">
            <text variable="container-title" prefix=" | praca = "/>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="opublikowany">
    <choose>
      <if type="webpage post post-weblog" match="any">
        <text variable="container-title" prefix=" | opublikowany = "/>
      </if>
      <else-if type="entry entry-dictionary entry-encyclopedia" match="any">
        <choose>
          <if variable="URL">
            <text variable="publisher" prefix=" | opublikowany = "/>
          </if>
        </choose>
      </else-if>
    </choose>
  </macro>
  <!-- "wydawca" i "miejsce" tylko dla źródeł nie-webowych (unika komunikatu "pub. albo wyd.") -->
  <macro name="wydawca">
    <choose>
      <if type="webpage post post-weblog" match="any"/>
      <else-if type="entry entry-dictionary entry-encyclopedia" match="any">
        <choose>
          <if variable="URL" match="none">
            <text variable="publisher-place" prefix=" | miejsce = "/>
            <text variable="publisher" prefix=" | wydawca = "/>
          </if>
        </choose>
      </else-if>
      <else>
        <text variable="publisher-place" prefix=" | miejsce = "/>
        <text variable="publisher" prefix=" | wydawca = "/>
      </else>
    </choose>
  </macro>
  <macro name="opis">
    <choose>
      <if type="thesis report" match="any">
        <text variable="genre" prefix=" | opis = "/>
      </if>
    </choose>
  </macro>
  <macro name="data">
    <date variable="issued" prefix=" | data = ">
      <date-part name="year"/>
      <date-part name="month" form="numeric-leading-zeros" prefix="-"/>
      <date-part name="day" form="numeric-leading-zeros" prefix="-"/>
    </date>
  </macro>
  <macro name="data-dostepu">
    <date variable="accessed" prefix=" | data dostępu = ">
      <date-part name="year"/>
      <date-part name="month" form="numeric-leading-zeros" prefix="-"/>
      <date-part name="day" form="numeric-leading-zeros" prefix="-"/>
    </date>
  </macro>
  <!-- W przypisie z lokalizatorem (np. "s. 15" w oknie cytowania) bierzemy lokalizator,
       w przeciwnym razie zakres stron pozycji -->
  <macro name="strony">
    <choose>
      <if variable="locator">
        <choose>
          <if locator="page">
            <text variable="locator" prefix=" | s = "/>
          </if>
          <else>
            <group prefix=" | s = " delimiter=" ">
              <label variable="locator" form="short"/>
              <text variable="locator"/>
            </group>
          </else>
        </choose>
      </if>
      <else>
        <text variable="page" prefix=" | s = "/>
      </else>
    </choose>
  </macro>
  <macro name="issn">
    <choose>
      <if variable="DOI" match="none">
        <text variable="ISSN" prefix=" | issn = "/>
      </if>
    </choose>
  </macro>
  <macro name="cytuj">
    <group prefix="&lt;ref&gt;{{Cytuj" suffix=" }}&lt;/ref&gt;">
      <text macro="autor-r"/>
      <text macro="rozdzial"/>
      <text macro="autor"/>
      <text macro="redaktor"/>
      <text macro="tytul"/>
      <text macro="czasopismo"/>
      <text macro="praca"/>
      <text macro="opublikowany"/>
      <text variable="edition" prefix=" | wydanie = "/>
      <text variable="volume" prefix=" | wolumin = "/>
      <text variable="issue" prefix=" | numer = "/>
      <text macro="inni"/>
      <text macro="opis"/>
      <text variable="collection-title" prefix=" | seria = "/>
      <text macro="wydawca"/>
      <text macro="data"/>
      <text macro="strony"/>
      <text variable="ISBN" prefix=" | isbn = "/>
      <text macro="issn"/>
      <text variable="DOI" prefix=" | doi = "/>
      <text variable="PMID" prefix=" | pmid = "/>
      <text variable="PMCID" prefix=" | pmc = "/>
      <text variable="URL" prefix=" | url = "/>
      <text macro="data-dostepu"/>
      <text variable="language" prefix=" | język = "/>
    </group>
  </macro>
  <citation>
    <layout>
      <text macro="cytuj"/>
    </layout>
  </citation>
  <bibliography>
    <sort>
      <key variable="author"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <text macro="cytuj"/>
    </layout>
  </bibliography>
</style>
