<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" page-range-format="expanded" default-locale="de-DE">
  <info>
    <title>Neue Politische Literatur (Deutsch)</title>
    <title-short>NPL</title-short>
    <id>http://www.zotero.org/styles/neue-politische-literatur</id>
    <link href="http://www.zotero.org/styles/neue-politische-literatur" rel="self"/>
    <link href="http://www.zotero.org/styles/technische-universitat-dresden-kunstgeschichte-note" rel="template"/>
    <link href="https://neue-politische-literatur.de/en/information-for-authors" rel="documentation"/>
    <link href="https://neue-politische-literatur.de/images/informationen_fur_unsere_autor_innen_20251212.pdf" rel="documentation"/>
    <author>
      <name>Sebastian Karcher</name>
    </author>
    <category citation-format="note"/>
    <category field="political_science"/>
    <category field="history"/>
    <eissn>2197-6082</eissn>
    <summary>Fußnotenstil der Neuen Politischen Literatur: Vollbeleg bei der ersten Nennung, danach Kurzbeleg mit Verweis auf die Anmerkung.</summary>
    <updated>2026-08-25T01:52:17+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="de">
    <terms>
      <!-- NPL prints journal issues as "H." (Heft) and edited-by as "hrsg. v."; op-cit carries the back-reference to the note with the full citation, "wie Anm. 4". -->
      <term name="issue" form="short">H.</term>
      <term name="op-cit">wie Anm.</term>
            <term name="accessed">Zugriff</term>
      <term name="editor" form="verb-short">hrsg. v.</term>
      <term name="editortranslator" form="verb-short">hrsg. u. übers. v.</term>
      <term name="translator" form="verb-short">übers. v.</term>
      <term name="no date" form="short">o.&#160;J.</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name delimiter="/" name-as-sort-order="all" sort-separator=", "/>
      <et-al/>
      <substitute>
        <text macro="editors"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" delimiter="/"/>
      <et-al/>
      <substitute>
        <names variable="editor">
          <name form="short" delimiter="/"/>
          <et-al/>
        </names>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>
  <macro name="editors">
    <names variable="editor">
      <name delimiter="/" name-as-sort-order="all" sort-separator=", "/>
      <et-al/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="editor-secondary">
    <!-- "hrsg. v. Hubertus Buchstein/Rainer Kühn": only next to a named author, and only where the editor is not already carrying the container. -->
    <choose>
      <if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="none">
        <choose>
          <if variable="author" match="all">
            <names variable="editor translator" delimiter=", ">
              <label form="verb-short" suffix=" "/>
              <name delimiter="/"/>
              <et-al/>
            </names>
          </if>
          <else>
            <!-- The editor already leads the entry; only the translator is left to name. -->
            <names variable="translator">
              <label form="verb-short" suffix=" "/>
              <name delimiter="/"/>
              <et-al/>
            </names>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="title">
    <choose>
      <if variable="collection-title volume" match="all" type="book">
        <!-- Mehrbändige Werke: "Reihentitel. Bd. 1: Titel des Bandes" -->
        <group delimiter=": ">
          <group delimiter=". ">
            <text variable="collection-title"/>
            <group delimiter=" ">
              <text term="volume" form="short"/>
              <number variable="volume"/>
            </group>
          </group>
          <text variable="title" text-case="title"/>
        </group>
      </if>
      <else>
        <text variable="title" text-case="title"/>
      </else>
    </choose>
  </macro>
  <macro name="title-short">
    <text variable="title" form="short" text-case="title"/>
  </macro>
  <macro name="container">
    <choose>
      <if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=": ">
          <text term="in" suffix=":"/>
          <text macro="editors"/>
          <text variable="container-title"/>
        </group>
      </if>
      <else-if type="article-journal article-magazine review review-book" match="any">
        <group delimiter=", ">
          <group delimiter=" ">
            <text term="in" suffix=": "/>
            <text variable="container-title"/>
            <text variable="volume"/>
            <text macro="issued-year" prefix="(" suffix=")"/>
          </group>
          <group delimiter=" ">
            <text term="issue" form="short"/>
            <text variable="issue"/>
          </group>
        </group>
      </else-if>
      <else-if type="article-newspaper post-weblog webpage" match="any">
        <group delimiter=" ">
          <text term="in" suffix=": "/>
          <text variable="container-title"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="issue-number">
    <!-- Wochenzeitungen: "Nr. 28". The issue term is bound to "H." for journals here, so the newspaper sense uses the number term, which de-DE already spells "Nr.". -->
    <choose>
      <if type="article-newspaper" match="any">
        <group delimiter=" ">
          <text term="number" form="short"/>
          <text variable="issue"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="issued-date">
    <choose>
      <if type="article-newspaper post-weblog" match="any">
        <date variable="issued" form="text"/>
      </if>
    </choose>
  </macro>
  <macro name="issued-year">
    <group>
      <choose>
        <if is-numeric="edition">
          <number variable="edition" vertical-align="sup"/>
        </if>
      </choose>
      <choose>
        <if variable="issued">
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </if>
        <else>
          <text term="no date" form="short"/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition" match="none">
        <text variable="edition"/>
      </if>
    </choose>
  </macro>
  <macro name="genre">
    <!-- Hochschulschriften und Berichte: "Dissertation", "Working Paper" u. Ä. -->
    <choose>
      <if type="thesis report manuscript speech" match="any">
        <text variable="genre"/>
      </if>
    </choose>
  </macro>
  <macro name="number-of-pages">
    <group delimiter=" ">
      <number variable="number-of-pages"/>
      <label variable="number-of-pages" form="short"/>
    </group>
  </macro>
  <macro name="publisher">
    <choose>
      <if type="article-journal article-magazine article-newspaper post-weblog review review-book" match="none">
        <group delimiter=", ">
          <text variable="publisher"/>
          <group delimiter=" ">
            <text variable="publisher-place"/>
            <text macro="issued-year"/>
          </group>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="locator">
    <!-- Where a page range is already printed the exact page follows as "hier S. 42". CSL has no term for this "here"; the label itself is the "page" term. -->
    <group delimiter=" ">
      <choose>
        <if variable="page">
          <text value="hier"/>
        </if>
      </choose>
      <text macro="locator-short"/>
    </group>
  </macro>
  <macro name="locator-short">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>
  <macro name="access">
    <group delimiter=" ">
      <choose>
        <if variable="DOI">
          <text variable="DOI" prefix="https://doi.org/"/>
        </if>
        <else-if variable="URL">
          <text variable="URL"/>
        </else-if>
      </choose>
      <choose>
        <if variable="DOI URL" match="any">
          <group delimiter=": " prefix="[" suffix="]">
          <text term="accessed" text-case="capitalize-first"/>
          <date variable="accessed" form="numeric"/>
          </group>
        </if>
      </choose>
    </group>
  </macro>
  <macro name="reference">
    <group delimiter=", ">
      <group delimiter=": ">
        <text macro="author"/>
        <text macro="title"/>
      </group>
      <text macro="genre"/>
      <text macro="container"/>
      <text macro="issue-number"/>
      <text macro="issued-date"/>
      <text macro="edition"/>
      <text macro="editor-secondary"/>
    </group>
  </macro>
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-names="true">
    <layout delimiter="; " suffix=".">
      <choose>
        <if position="ibid-with-locator">
          <group delimiter=", ">
            <text term="ibid"/>
            <text macro="locator-short"/>
          </group>
        </if>
        <else-if position="ibid">
          <text term="ibid"/>
        </else-if>
        <else-if position="subsequent">
          <group delimiter=", ">
            <group delimiter=" ">
              <group delimiter=": ">
                <text macro="author-short"/>
                <text macro="title-short"/>
              </group>
              <group delimiter=" " prefix="(" suffix=")">
                <text term="op-cit"/>
                <text variable="first-reference-note-number"/>
              </group>
            </group>
            <text macro="locator-short"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <text macro="reference"/>
            <text macro="publisher"/>
            <text macro="pages"/>
            <text macro="locator"/>
            <text macro="access"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography et-al-min="4" et-al-use-first="1" entry-spacing="0">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
      <key macro="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=", ">
        <text macro="reference"/>
        <text macro="number-of-pages"/>
        <text macro="publisher"/>
        <text macro="pages"/>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
