<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" initialize-with=". " page-range-format="expanded" demote-non-dropping-particle="never" default-locale="en-GB">
  <info>
    <title>EU Interinstitutional Style (notes)</title>
    <id>http://www.zotero.org/styles/eu-interinstitutional-style-notes</id>
    <link href="http://www.zotero.org/styles/eu-interinstitutional-style-notes" rel="self"/>
    <link href="http://www.zotero.org/styles/eu-interinstitutional-style" rel="template"/>
    <link href="https://style-guide.europa.eu/en/home" rel="documentation"/>
    <author>
      <name>Luis Machado</name>
      <email>luis.oliveira-machado@ec.europa.eu</email>
    </author>
    <contributor>
      <name>Patrick O'Brien</name>
    </contributor>
    <category citation-format="note"/>
    <category field="generic-base"/>
    <summary>European Union Interinstitutional style in notes format (1st full note), Eng (Revision 07b)</summary>
    <updated>2026-08-07T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- specific terms of the ISG or with variations not found in the CSL lexicon -->
  <locale xml:lang="en">
    <terms>
      <term name="translator" form="short">
        <single>trans.</single>
        <multiple>trans</multiple>
      </term>
      <term name="collection-editor" form="short">
        <single>ser. ed</single>
        <multiple>ser. eds</multiple>
      </term>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds</multiple>
      </term>
      <term name="webpage">website</term>
      <term name="available at">created</term>
    </terms>
  </locale>
  <!-- rules for creator names and their variations in subsequent notes (no author for legislation or regulation (EU OJ specific format) types as it is on the title) -->
  <macro name="author-subsequent">
    <choose>
      <if type="legislation regulation" match="any">
        <text variable="title" form="short"/>
      </if>
      <else>
        <names variable="host">
          <name form="short" and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" initialize-with=". "/>
          <et-al/>
          <substitute>
            <names variable="author"/>
            <names variable="editor director performer"/>
            <names variable="translator recipient"/>
            <names variable="collection-editor"/>
            <names variable="contributor"/>
            <text macro="anon-subsequent"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <!-- rules for unknown creator in subsequent notes -->
  <macro name="anon-subsequent">
    <choose>
      <if type="book motion_picture musical_score" match="any">
        <text variable="title" form="short" font-style="italic"/>
      </if>
      <else>
        <text variable="title" form="short" strip-periods="false" quotes="true"/>
      </else>
    </choose>
  </macro>
  <!-- rules for title in subsequent notes (for other than legislation or regulation, since their titles are already defined in the authors' place) -->
  <macro name="title-subsequent">
    <choose>
      <if type="book motion_picture musical_score" match="any">
        <text variable="title" form="short" font-style="italic"/>
      </if>
      <else-if type="legislation regulation" match="none">
        <text variable="title" form="short" quotes="true"/>
      </else-if>
    </choose>
  </macro>
  <!-- rules for page numbering or other locator in notes -->
  <macro name="citation-locater">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>
  <!-- rules for creator names and their variations -->
  <macro name="author">
    <choose>
      <if type="legislation regulation" match="any">
        <text variable="title" suffix=","/>
      </if>
      <else>
        <names variable="host">
          <name and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" initialize-with=". "/>
          <label form="short" text-case="lowercase" prefix=" (" suffix=")"/>
          <et-al/>
          <substitute>
            <names variable="author"/>
            <names variable="container-author"/>
            <names variable="editor director performer"/>
            <names variable="translator recipient"/>
            <names variable="collection-editor"/>
            <names variable="contributor"/>
            <text macro="anon"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <!-- rules for unknown creator -->
  <macro name="anon">
    <group>
      <choose>
        <if type="book motion_picture musical_score" match="any">
          <text variable="title" font-style="italic" suffix=","/>
        </if>
        <else>
          <text variable="title" quotes="true" suffix=","/>
        </else>
      </choose>
    </group>
  </macro>
  <!-- rules for web-post creator’s alias (via the tag ‘annote:’ in Zotero 'Extra' field) -->
  <macro name="author-alias">
    <choose>
      <if type="post post-weblog" match="any">
        <text variable="annote"/>
      </if>
    </choose>
  </macro>
  <!-- rules for title (as isn’t possible to set different rules for secondary titles, no capitalization rule has been set) -->
  <macro name="title">
    <choose>
      <if type="book motion_picture musical_score" match="any">
        <text variable="title" strip-periods="false" quotes="false" font-style="italic"/>
      </if>
      <else-if type="legislation regulation" match="none">
        <text variable="title" quotes="true"/>
      </else-if>
    </choose>
  </macro>
  <!-- rules for type (genre) -->
  <macro name="type">
    <choose>
      <if type="report" match="none">
        <choose>
          <if match="any" variable="genre">
            <text variable="genre"/>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- rules for version number -->
  <macro name="version">
    <group delimiter=" ">
      <label text-case="capitalize-first" variable="version"/>
      <text variable="version"/>
    </group>
  </macro>
  <!-- rules for internal reference number (via the tag 'supplement-number': in Zotero 'Extra' field) to the web page item type, following the ISG example -->
  <macro name="extra-IDnum-webpage">
    <choose>
      <if type="webpage" match="all" variable="supplement-number">
        <text variable="supplement-number"/>
      </if>
    </choose>
  </macro>
  <!-- rules for the term ‘in’ for container-titles -->
  <macro name="in">
    <choose>
      <if type="paper-conference chapter" match="any">
        <choose>
          <if variable="container-title" match="any">
            <text term="in" text-case="lowercase"/>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- rules for editor names -->
  <macro name="editor">
    <names variable="container-author">
      <name delimiter-precedes-et-al="never" delimiter-precedes-last="never" initialize-with=". "/>
      <label form="short" text-case="lowercase" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="collection-editor"/>
      </substitute>
    </names>
  </macro>
  <!-- rules for container-titles (of the larger work that contains the cited part) -->
  <macro name="container-title">
    <choose>
      <if type="webpage" match="any">
        <group delimiter=" ">
          <text variable="container-title" strip-periods="false"/>
          <text term="webpage"/>
        </group>
      </if>
      <else-if type="legislation regulation post post-weblog" match="any">
        <text variable="container-title"/>
      </else-if>
      <else-if type="paper-conference" match="any">
        <choose>
          <if match="none" variable="container-title">
            <group delimiter=", ">
              <group delimiter=" ">
                <text term="presented at"/>
                <text variable="event-title"/>
              </group>
              <text macro="event-date"/>
            </group>
          </if>
          <else>
            <text variable="container-title" font-style="italic"/>
          </else>
        </choose>
      </else-if>
      <else>
        <text variable="container-title" strip-periods="false" font-style="italic"/>
      </else>
    </choose>
  </macro>
  <!-- rules for conference dates and similar events  -->
  <macro name="event-date">
    <date delimiter=" " variable="event-date">
      <date-part name="day"/>
      <date-part name="month"/>
      <date-part name="year"/>
    </date>
  </macro>
  <!-- rules for translator names -->
  <macro name="translator">
    <names variable="translator" delimiter=", ">
      <name delimiter-precedes-et-al="never" delimiter-precedes-last="never" initialize-with=". "/>
      <label form="short" text-case="lowercase" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <!-- rules for volume and issue numbers, and date of journal, magazine or newspaper articles -->
  <macro name="locators-article">
    <choose>
      <if match="none" variable="collection-title">
        <choose>
          <if type="article-journal article-magazine" match="any">
            <group delimiter=", ">
              <group delimiter=" ">
                <label variable="volume" form="short" text-case="capitalize-first"/>
                <text variable="volume" strip-periods="false"/>
              </group>
              <choose>
                <if match="none" is-numeric="issue">
                  <text variable="issue"/>
                </if>
                <else>
                  <group delimiter=" ">
                    <label variable="issue" plural="never" text-case="capitalize-first"/>
                    <text variable="issue"/>
                  </group>
                </else>
              </choose>
              <date delimiter=" " variable="issued">
                <date-part name="month"/>
                <date-part name="year"/>
              </date>
            </group>
          </if>
          <else-if type="article-newspaper">
            <date variable="issued" delimiter=" ">
              <date-part name="day"/>
              <date-part name="month"/>
              <date-part name="year"/>
            </date>
          </else-if>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- rules for edition number -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <label variable="edition" strip-periods="true"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <!-- rules for collection titles of monograph series, in journal/magazine/newspaper articles it will be interpreted as referencing a full issue -->
  <macro name="series_title">
    <choose>
      <if match="any" variable="collection-title">
        <choose>
          <if type="book chapter" match="any">
            <group delimiter=", ">
              <text variable="collection-title"/>
              <group delimiter=" ">
                <label variable="collection-number" form="short" text-case="capitalize-first" strip-periods="true"/>
                <text variable="collection-number"/>
              </group>
            </group>
          </if>
          <else-if type="article-journal article-magazine article-newspaper" match="any">
            <group delimiter=", ">
              <text variable="collection-title" font-style="italic"/>
              <group delimiter=" ">
                <label text-case="capitalize-first" strip-periods="true" variable="number" form="short"/>
                <text variable="issue"/>
              </group>
              <date delimiter=" " variable="issued">
                <date-part name="month"/>
                <date-part name="year"/>
              </date>
            </group>
          </else-if>
          <else-if type="paper-conference" match="any">
            <group delimiter=", ">
              <text variable="collection-title"/>
              <group delimiter=" ">
                <label variable="number" text-case="capitalize-first" strip-periods="true" form="short"/>
                <text variable="volume"/>
              </group>
            </group>
          </else-if>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- rules for reports (ISG grey literature) -->
  <macro name="report">
    <group delimiter=", ">
      <choose>
        <if type="report" match="all">
          <choose>
            <if match="none" is-numeric="number">
              <group delimiter=", ">
                <text variable="genre"/>
                <text variable="number"/>
              </group>
            </if>
            <else>
              <group delimiter=" ">
                <text variable="genre"/>
                <choose>
                  <if match="any" is-numeric="number">
                    <group delimiter=" ">
                      <label variable="number" plural="never" text-case="capitalize-first" strip-periods="true" form="short"/>
                      <text variable="number"/>
                    </group>
                  </if>
                  <else>
                    <text variable="number"/>
                  </else>
                </choose>
              </group>
            </else>
          </choose>
          <date delimiter=" " variable="issued">
            <date-part name="day"/>
            <date-part name="month"/>
            <date-part name="year"/>
          </date>
        </if>
      </choose>
    </group>
  </macro>
  <!-- rules for preprints (scholar papers in a version prior to the peer-review process) -->
  <macro name="preprint">
    <choose>
      <if type="article" match="any">
        <group delimiter=" ">
          <choose>
            <if match="none" variable="genre">
              <text term="preprint" prefix="[" suffix="],"/>
            </if>
            <else>
              <text variable="genre"/>
            </else>
          </choose>
          <choose>
            <if match="any" is-numeric="number">
              <group delimiter=" ">
                <label variable="number" form="short" text-case="capitalize-first"/>
                <text variable="number"/>
              </group>
            </if>
            <else>
              <text variable="number"/>
            </else>
          </choose>
        </group>
      </if>
    </choose>
  </macro>
  <!-- rules for publisher name and place -->
  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place" form="short"/>
    </group>
  </macro>
  <!-- rules for publication date, year or also day/month in specific item types (legislation, regulation (extra type for EU OJ format), webpage, web-post, and dataset) -->
  <macro name="date">
    <choose>
      <if type="webpage post-weblog dataset post legislation" match="any">
        <date delimiter=" " variable="issued">
          <date-part name="day"/>
          <date-part name="month"/>
          <date-part name="year"/>
        </date>
      </if>
      <else-if type="regulation" match="any">
        <date variable="issued">
          <date-part form="numeric" name="day" suffix="."/>
          <date-part form="numeric" name="month" suffix="."/>
          <date-part form="long" name="year"/>
        </date>
      </else-if>
      <else-if match="any" variable="issued">
        <choose>
          <if type="article-journal article-magazine article-newspaper report" variable="event-date" match="none">
            <date date-parts="year" form="text" variable="issued">
              <date-part name="year"/>
            </date>
          </if>
        </choose>
      </else-if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <!-- rules for creation date of datasets -->
  <macro name="creation-dataset">
    <choose>
      <if type="dataset" match="all" variable="original-date">
        <group delimiter=" " prefix="(" suffix=")">
          <text term="available at" text-case="lowercase"/>
          <date form="text" variable="original-date">
            <date-part name="day"/>
            <date-part name="month"/>
            <date-part name="year"/>
          </date>
        </group>
      </if>
    </choose>
  </macro>
  <!-- rules for creator names of the original post of a reposted web-post -->
  <macro name="original-author_webPost">
    <choose>
      <if type="post post-weblog" match="any">
        <choose>
          <if match="any" variable="original-author">
            <names variable="original-author" delimiter=", ">
              <name delimiter-precedes-et-al="never" delimiter-precedes-last="never" initialize-with=". "/>
              <label form="short" text-case="lowercase" prefix=" (" suffix=")"/>
            </names>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- rules for page numbering -->
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <!-- rules for including an internal reference number (using 'supplement-number' tag in extra field) in item types other than web pages -->
  <macro name="extra-IDnum">
    <choose>
      <if type="webpage" match="none">
        <text variable="supplement-number"/>
      </if>
    </choose>
  </macro>
  <!-- rules for access date and link (DOI, ELI (for EU OJ format), or URL) -->
  <macro name="access">
    <group delimiter=", ">
      <choose>
        <if type="dataset" variable="DOI" match="all"/>
        <else-if type="dataset" variable="URL" match="all"/>
      </choose>
    </group>
    <choose>
      <if type="dataset" match="any">
        <choose>
          <if match="any" variable="DOI">
            <group delimiter=", ">
              <group delimiter=" ">
                <text term="accessed"/>
                <date delimiter=" " variable="accessed">
                  <date-part name="day"/>
                  <date-part name="month"/>
                  <date-part name="year"/>
                </date>
              </group>
              <text variable="DOI" prefix="https://doi.org/"/>
            </group>
          </if>
          <else-if type="regulation" match="any">
            <text variable="URL" prefix="ELI: "/>
          </else-if>
          <else>
            <group delimiter=", ">
              <group delimiter=" ">
                <text term="accessed"/>
                <date delimiter=" " variable="accessed">
                  <date-part name="day"/>
                  <date-part name="month"/>
                  <date-part name="year"/>
                </date>
              </group>
              <text variable="URL"/>
            </group>
          </else>
        </choose>
      </if>
      <else>
        <choose>
          <if match="any" variable="DOI">
            <text variable="DOI" prefix="https://doi.org/"/>
          </if>
          <else-if match="any" variable="URL">
            <group delimiter=", ">
              <choose>
                <if type="webpage post-weblog post" match="any">
                  <group delimiter=" ">
                    <text term="accessed"/>
                    <date variable="accessed" delimiter=" ">
                      <date-part name="day"/>
                      <date-part name="month"/>
                      <date-part name="year"/>
                    </date>
                  </group>
                </if>
              </choose>
              <text variable="URL"/>
            </group>
          </else-if>
        </choose>
      </else>
    </choose>
  </macro>
  <!-- ordering rules for items in notes: subsequent and 1st -->
  <citation delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="6" et-al-use-first="5" et-al-subsequent-min="2" et-al-subsequent-use-first="1" name-as-sort-order="all">
    <layout delimiter="; " suffix=".">
      <choose>
        <if match="any" position="subsequent">
          <group delimiter=", ">
            <text macro="author-subsequent"/>
            <text macro="title-subsequent"/>
            <text macro="citation-locater"/>
          </group>
        </if>
        <else>
          <group>
            <choose>
              <if type="regulation" match="all">
                <text variable="title" suffix=" "/>
                <group delimiter=", " prefix="(" suffix=")">
                  <text macro="container-title"/>
                  <text macro="date"/>
                  <text macro="pages"/>
                  <text macro="access"/>
                </group>
              </if>
              <else>
                <group delimiter=", ">
                  <group delimiter=" ">
                    <text macro="author"/>
                    <text macro="author-alias" prefix="(" suffix=")"/>
                  </group>
                  <text macro="title"/>
                  <text macro="type"/>
                  <text macro="version"/>
                  <text macro="extra-IDnum-webpage"/>
                  <group delimiter=": ">
                    <text macro="in"/>
                    <group delimiter=", ">
                      <text macro="editor"/>
                      <text macro="container-title"/>
                    </group>
                  </group>
                  <text macro="translator"/>
                  <text macro="locators-article"/>
                  <text macro="edition"/>
                  <text macro="series_title"/>
                  <text macro="report"/>
                  <text macro="preprint"/>
                  <text macro="publisher"/>
                  <group delimiter=" ">
                    <text macro="date"/>
                    <text macro="creation-dataset"/>
                  </group>
                  <text macro="original-author_webPost"/>
                  <text macro="pages"/>
                  <text macro="extra-IDnum"/>
                  <text macro="access"/>
                  <text macro="citation-locater"/>
                </group>
              </else>
            </choose>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <!-- sorting rules and placing order of reference elements in reference list -->
  <bibliography delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="6" et-al-use-first="5" name-as-sort-order="all">
    <sort>
      <key macro="author"/>
      <key macro="date"/>
      <key macro="title"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="regulation" match="all">
          <text variable="title" suffix=" "/>
          <group delimiter=", " prefix="(" suffix=")">
            <text macro="container-title"/>
            <text macro="date"/>
            <text macro="pages"/>
            <text macro="access"/>
          </group>
        </if>
        <else>
          <group delimiter=", ">
            <group delimiter=" ">
              <text macro="author"/>
              <text macro="author-alias" prefix="(" suffix=")"/>
            </group>
            <text macro="title"/>
            <text macro="type"/>
            <text macro="version"/>
            <text macro="extra-IDnum-webpage"/>
            <group delimiter=": ">
              <text macro="in"/>
              <group delimiter=", ">
                <text macro="editor"/>
                <text macro="container-title"/>
              </group>
            </group>
            <text macro="translator"/>
            <text macro="locators-article"/>
            <text macro="edition"/>
            <text macro="series_title"/>
            <text macro="report"/>
            <text macro="preprint"/>
            <text macro="publisher"/>
            <group delimiter=" ">
              <text macro="date"/>
              <text macro="creation-dataset"/>
            </group>
            <text macro="original-author_webPost"/>
            <text macro="pages"/>
            <text macro="extra-IDnum"/>
            <text macro="access"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
