<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" 
  version="1.0" page-range-format="expanded" 
  delimiter-precedes-last="never" et-al-min="4" 
  et-al-use-first="1" demote-non-dropping-particle="sort-only"
  default-locale="en-GB">

  <!-- ================================================
       Bibliotheca Hertziana - Max Planck Institute 
       for Art History
       Polyglot: German, English, Italian
       Optimized for Ex Libris Alma/Primo
       ================================================ -->

  <info>
    <title>Bibliotheca Hertziana - Max Planck Institute for Art History (Primo/Alma)</title>
    <title-short>BHR-Primo</title-short>
    <id>http://www.zotero.org/styles/bhr-primo</id>
    <link href="http://www.zotero.org/styles/bhr-primo" rel="self"/>
    <link href="http://www.zotero.org/styles/bibliotheca-hertziana-max-planck-institute-for-art-history" rel="template"/>
    <link href="https://www.biblhertz.it/3170244/rjbh_editorial_guidelines_en.pdf" rel="documentation"/>
    <author>
      <name>Bibliotheca Hertziana</name>
    </author>
    <category citation-format="note"/>
    <category field="humanities"/>
    <updated>2026-06-25T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">
      This work is licensed under a Creative Commons 
      Attribution-ShareAlike 3.0 License
    </rights>
  </info>

  <!-- ================================================
       LOCALES
       ================================================ -->

  <locale xml:lang="en">
    <terms>
      <term name="open-quote">&#8220;</term>
      <term name="close-quote">&#8221;</term>
      <term name="open-inner-quote">&#8216;</term>
      <term name="close-inner-quote">&#8217;</term>
      <term name="editor">
        <single>ed.</single>
        <multiple>ed.</multiple>
      </term>
      <term name="collection-editor">
        <single>ed.</single>
        <multiple>ed.</multiple>
      </term>
      <term name="page">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
      <term name="page-range-delimiter">&#8211;</term>
      <term name="anonymous">Anon.</term>
      <term name="accessed">accessed</term>
    </terms>
  </locale>

  <locale xml:lang="de">
    <terms>
      <term name="open-quote">&#8222;</term>
      <term name="close-quote">&#8220;</term>
      <term name="open-inner-quote">&#8218;</term>
      <term name="close-inner-quote">&#8216;</term>
      <term name="editor">
        <single>hg. v.</single>
        <multiple>hg. v.</multiple>
      </term>
      <term name="collection-editor">
        <single>hg. v.</single>
        <multiple>hg. v.</multiple>
      </term>
      <term name="page">
        <single>S.</single>
        <multiple>S.</multiple>
      </term>
      <term name="page-range-delimiter">&#8211;</term>
      <term name="anonymous">o. A.</term>
      <term name="accessed">abgerufen am</term>
      <term name="no date" form="short">o. J.</term>
    </terms>
  </locale>

  <locale xml:lang="it">
    <terms>
      <term name="open-quote">&#8220;</term>
      <term name="close-quote">&#8221;</term>
      <term name="open-inner-quote">&#8216;</term>
      <term name="close-inner-quote">&#8217;</term>
      <term name="editor">
        <single>a cura di</single>
        <multiple>a cura di</multiple>
      </term>
      <term name="collection-editor">
        <single>a cura di</single>
        <multiple>a cura di</multiple>
      </term>
      <term name="page">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
      <term name="page-range-delimiter">&#8211;</term>
      <term name="anonymous">s.a.</term>
      <term name="accessed">accesso</term>
      <term name="no date" form="short">s.d.</term>
    </terms>
  </locale>

  <!-- ================================================
       MACROS
       ================================================ -->

  <!-- AUTHOR -->
  <macro name="author">
    <choose>
      <if variable="author">
        <names variable="author" suffix=",">
          <name and="text" 
                initialize="false" 
                initialize-with="."
                delimiter=", ">
            <name-part name="given" 
                       text-case="capitalize-first"/>
            <name-part name="family" 
                       text-case="capitalize-first"/>
          </name>
        </names>
      </if>
      <else-if variable="editor collection-editor" 
               match="any"/>
      <else>
        <text term="anonymous" prefix="[" suffix="],"/>
      </else>
    </choose>
  </macro>

  <!-- EDITOR -->
  <!-- Produces: ed. First Last, / hg. v. First Last, -->
  <!-- Oxford comma for 3+ names per editorial guidelines -->
  <macro name="editor">
    <choose>
      <if variable="editor">
        <names variable="editor" suffix=", ">
          <label form="long" 
                 text-case="lowercase" 
                 suffix=" "/>
          <name and="text" 
                delimiter=", "
                delimiter-precedes-last="always"/>
        </names>
      </if>
      <else-if variable="collection-editor">
        <names variable="collection-editor" suffix=", ">
          <label form="long" 
                 text-case="lowercase" 
                 suffix=" "/>
          <name and="text" 
                delimiter=", "
                delimiter-precedes-last="always"/>
        </names>
      </else-if>
    </choose>
  </macro>

  <!-- VOLUMES -->
  <!-- Produces: 2 vols., / 2 Bde., -->
  <macro name="volumes">
    <choose>
      <if variable="number-of-volumes">
        <group delimiter=" " suffix=",">
          <text variable="number-of-volumes"/>
          <label variable="number-of-volumes" 
                 form="short" plural="always"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- EDITION -->
  <!-- Produces: 2nd ed. -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else-if variable="edition">
        <text variable="edition"/>
      </else-if>
    </choose>
  </macro>

  <!-- ORIGINAL DATE -->
  <!-- Produces: 1st ed. 1977, -->
  <!-- Note: year ranges (1977-1978) must be entered 
       manually in the source data -->
  <macro name="original-date">
    <choose>
      <if variable="original-date">
        <group suffix=", " delimiter=" ">
          <choose>
            <if is-numeric="edition">
              <group delimiter=" ">
                <number variable="edition" form="ordinal"/>
                <text term="edition" form="short"/>
              </group>
            </if>
          </choose>
          <date variable="original-date">
            <date-part name="year"/>
          </date>
        </group>
      </if>
    </choose>
  </macro>

  <!-- TITLE -->
  <!-- Books/theses/manuscripts: italic -->
  <!-- Articles/chapters: quoted -->
  <macro name="title">
    <choose>
      <if type="book" match="any">
        <text variable="title" 
              font-style="italic" 
              suffix=", "/>
      </if>
      <else-if type="thesis manuscript" match="any">
        <text variable="title" 
              font-style="italic" 
              suffix=", "/>
      </else-if>
      <else>
        <text variable="title" 
              quotes="true" 
              suffix=", "/>
      </else>
    </choose>
  </macro>

  <!-- PLACE + YEAR -->
  <!-- Produces: Rome 2008 -->
  <macro name="place-year">
    <group delimiter=" ">
      <text variable="publisher-place"/>
      <date variable="issued" date-parts="year" form="text"/>
    </group>
  </macro>

  <!-- SERIES -->
  <!-- Produces: (Studi della Bibliotheca Hertziana 4) -->
  <macro name="series">
    <choose>
      <if variable="collection-title">
        <group prefix="(" suffix=")" delimiter=" ">
          <text variable="collection-title"/>
          <text variable="collection-number"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- PAGES -->
  <!-- Produces: pp. 9-13 -->
  <macro name="pages">
    <choose>
      <if variable="page">
        <group delimiter=" ">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- VOLUME-REF -->
  <!-- Produces: vol. 2 -->
  <macro name="volume-ref">
    <choose>
      <if variable="volume">
        <group delimiter=" ">
          <label variable="volume" form="short"/>
          <text variable="volume"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- CONFERENCE INFO -->
  <!-- Produces: (conference proceedings, Florence 2000) -->
  <!-- Optional: only rendered if data available in Alma -->
  <macro name="conference-info">
    <choose>
      <if variable="genre event-place event-date" match="any">
        <group prefix="(" suffix=")" delimiter=", ">
          <text variable="genre"/>
          <group delimiter=" ">
            <text variable="event-place"/>
            <date variable="event-date">
              <date-part name="year"/>
            </date>
          </group>
        </group>
      </if>
    </choose>
  </macro>

  <!-- REVIEW OF -->
  <!-- Produces: review of "Title", -->
  <macro name="review-of">
    <choose>
      <if variable="reviewed-title">
        <group suffix=",">
          <text value="review of" suffix=" "/>
          <text variable="reviewed-title" quotes="true"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- ACCESS / URL / DOI -->
  <!-- Produces: URL: http://... (accessed 04.12.2024). -->
  <macro name="access">
    <choose>
      <if variable="DOI">
        <group>
          <text variable="DOI" 
                prefix="URL: https://doi.org/"/>
          <choose>
            <if variable="accessed">
              <group prefix=" (" suffix=")">
                <text term="accessed" suffix=" "/>
                <date variable="accessed">
                  <date-part name="day" form="numeric-leading-zeros" suffix="."/>
                  <date-part name="month" 
                             form="numeric-leading-zeros" 
                             suffix="."/>
                  <date-part name="year"/>
                </date>
              </group>
            </if>
          </choose>
        </group>
      </if>
      <else-if variable="URL">
        <group>
          <text variable="URL" prefix="URL: "/>
          <choose>
            <if variable="accessed">
              <group prefix=" (" suffix=")">
                <text term="accessed" suffix=" "/>
                <date variable="accessed">
                  <date-part name="day" form="numeric-leading-zeros" suffix="."/>
                  <date-part name="month" 
                             form="numeric-leading-zeros" 
                             suffix="."/>
                  <date-part name="year"/>
                </date>
              </group>
            </if>
          </choose>
        </group>
      </else-if>
    </choose>
  </macro>

  <!-- CONTRIBUTORS SHORT (for citation key) -->
  <!-- Produces: Vasari / Smith et al. -->
  <macro name="contributors-short">
    <choose>
      <if variable="author">
        <names variable="author">
          <name form="short" 
                delimiter=" / " 
                delimiter-precedes-et-al="never"
                delimiter-precedes-last="never"
                et-al-min="4" 
                et-al-use-first="1"/>
          <substitute>
            <text variable="title-short" 
                  font-style="italic"/>
          </substitute>
        </names>
      </if>
      <else-if variable="editor">
        <names variable="editor">
          <name form="short" 
                delimiter=" / "
                delimiter-precedes-et-al="never"
                delimiter-precedes-last="never"
                et-al-min="4" 
                et-al-use-first="1"/>
        </names>
      </else-if>
      <else>
        <text variable="title-short" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- DATE REFERENCE (for citation key) -->
  <!-- Produces: (1550) 1986 / 2008 -->
  <macro name="date-reference">
    <choose>
      <if variable="issued">
        <choose>
          <if variable="original-date">
            <date variable="original-date" 
                  prefix="(" suffix=") ">
              <date-part name="year"/>
            </date>
          </if>
        </choose>
        <date variable="issued" 
              date-parts="year" 
              form="text"/>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>

  <!-- POINT LOCATORS (for footnote citation) -->
  <macro name="point-locators">
    <group>
      <choose>
        <if locator="page" match="none">
          <label variable="locator" 
                 form="short" 
                 suffix=" "/>
        </if>
      </choose>
      <text variable="locator"/>
    </group>
  </macro>

  <!-- ================================================
       CITATION (footnote)
       Produces: Vasari 1986: 45
       ================================================ -->

  <citation disambiguate-add-year-suffix="true" 
            disambiguate-add-names="true" 
            disambiguate-add-givenname="true">
    <sort>
      <key variable="issued" sort="ascending"/>
      <key macro="author"/>
    </sort>
    <layout delimiter="; ">
      <group delimiter=": ">
        <group delimiter=" ">
          <text macro="contributors-short"/>
          <text macro="date-reference"/>
        </group>
        <text macro="point-locators"/>
      </group>
    </layout>
  </citation>

  <!-- ================================================
       BIBLIOGRAPHY
       ================================================ -->

  <bibliography et-al-min="12" et-al-use-first="6">
    <sort>
      <key macro="contributors-short"/>
      <key macro="date-reference"/>
    </sort>
    <layout suffix=" ">

      <!-- Citation key block -->
      <!-- Produces: Vasari 1986 -->
      <group delimiter=" " suffix=" ">
        <text macro="contributors-short"/>
        <text macro="date-reference"/>
      </group>

      <!-- Main entry -->
      <group delimiter=" ">
        <text macro="author"/>
        <text macro="review-of"/>
        <text macro="title"/>

        <choose>

          <!-- ============ BOOK ============ -->
          <!-- First name Last name, Title,  -->
          <!-- [ed. Name,] [X vols.,]        -->
          <!-- [1st ed. YEAR,] Place Year    -->
          <!-- [(Series Number).]            -->
          <if type="book" match="any">
            <group delimiter=" ">
              <text macro="editor"/>
              <text macro="volumes"/>
              <text macro="original-date"/>
              <group delimiter=", " suffix=".">
                <group delimiter=" ">
                  <choose>
                    <if variable="volume">
                      <group delimiter=", ">
                        <text variable="publisher-place"/>
                        <text macro="volume-ref"/>
                        <date variable="issued" 
                              date-parts="year" 
                              form="text"/>
                      </group>
                    </if>
                    <else>
                      <group delimiter=" ">
                        <text variable="publisher-place"/>
                        <date variable="issued" 
                              date-parts="year" 
                              form="text"/>
                      </group>
                    </else>
                  </choose>
                  <text macro="series"/>
                </group>
                <text macro="access"/>
              </group>
            </group>
          </if>

          <!-- ============ ARTICLE-JOURNAL / REVIEW ============ -->
          <!-- First name Last name, ["review of" "Title",]     -->
          <!-- Journal, vol [, issue] (year), pp. x-x.          -->
          <else-if type="article-journal review review-book" 
                   match="any">
            <group delimiter=" ">
              <text variable="container-title" 
                    font-style="italic" 
                    suffix=","/>
              <group delimiter=", " suffix=".">
                <group suffix=")">
                  <text variable="volume"/>
                  <text variable="issue" prefix=", "/>
                  <date variable="issued" 
                        date-parts="year" 
                        form="text" 
                        prefix=" ("/>
                </group>
                <text macro="pages"/>
                <text macro="access"/>
              </group>
            </group>
          </else-if>

          <!-- ============ CHAPTER ============ -->
          <!-- First name Last name, "Title",   -->
          <!-- in Container Title               -->
          <!-- [(conf. proceedings, Place Year)]-->
          <!-- ed. Name, [X vols.,]             -->
          <!-- Place Year [(Series)],           -->
          <!-- pp. x-x.                         -->
          <else-if type="chapter" match="any">
            <group delimiter=" ">
              <group>
                <text term="in" 
                      text-case="lowercase" 
                      suffix=" "/>
                <text variable="container-title" 
                      font-style="italic"/>
                <text macro="conference-info" 
                      prefix=" "/>
                <text value=","/>
              </group>
              <text macro="editor"/>
              <text macro="volumes"/>
              <group delimiter=", " suffix=".">
                <group delimiter=" ">
                  <choose>
                    <if variable="volume">
                      <group delimiter=", ">
                        <text variable="publisher-place"/>
                        <text macro="volume-ref"/>
                        <date variable="issued" 
                              date-parts="year" 
                              form="text"/>
                      </group>
                    </if>
                    <else>
                      <group delimiter=" ">
                        <text variable="publisher-place"/>
                        <date variable="issued" 
                              date-parts="year" 
                              form="text"/>
                      </group>
                    </else>
                  </choose>
                  <text macro="series"/>
                </group>
                <text macro="pages"/>
                <text macro="access"/>
              </group>
            </group>
          </else-if>

          <!-- ============ ENTRY-DICTIONARY /        -->
          <!-- ENTRY-ENCYCLOPEDIA ============        -->
          <!-- First name Last name, "Title",        -->
          <!-- in Container/Title-short, vol. X,     -->
          <!-- Place Year, pp. x-x / col. x-x.      -->
          <else-if type="entry-dictionary entry-encyclopedia" 
                   match="any">
            <group delimiter=" ">
              <group>
                <text term="in" 
                      text-case="lowercase" 
                      suffix=" "/>
                <choose>
                  <if variable="title-short">
                    <text variable="title-short" 
                          font-style="italic" 
                          suffix=","/>
                  </if>
                  <else>
                    <text variable="container-title" 
                          font-style="italic" 
                          suffix=","/>
                  </else>
                </choose>
              </group>
              <text macro="editor"/>
              <group suffix=",">
                <text macro="volume-ref"/>
              </group>
              <group delimiter=", " suffix=".">
                <group delimiter=" ">
                  <text variable="publisher-place"/>
                  <date variable="issued" 
                        date-parts="year" 
                        form="text"/>
                </group>
                <text macro="pages"/>
                <text macro="access"/>
              </group>
            </group>
          </else-if>

          <!-- ============ THESIS ============      -->
          <!-- First name Last name, Title,         -->
          <!-- [type] thesis, University, Year.     -->
          <else-if type="thesis" match="any">
            <group delimiter=", " suffix=".">
              <text variable="genre" 
                    suffix=" thesis"/>
              <text variable="publisher"/>
              <date variable="issued" 
                    date-parts="year" 
                    form="text"/>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- ============ WEBPAGE ============ -->
          <!-- First name Last name, Title.     -->
          <!-- URL: ... (accessed dd.mm.yyyy).  -->
          <else-if type="webpage post post-weblog" 
                   match="any">
            <group delimiter=", " suffix=".">
              <date variable="issued" 
                    date-parts="year" 
                    form="text"/>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- ============ MANUSCRIPT ============ -->
          <else-if type="manuscript" match="any">
            <group delimiter=", " suffix=".">
              <text variable="publisher"/>
              <text term="manuscript" 
                    text-case="capitalize-first"/>
              <date variable="issued" 
                    date-parts="year" 
                    form="text"/>
              <text macro="access"/>
            </group>
          </else-if>

          <!-- ============ FALLBACK ============ -->
          <else>
            <group delimiter=", " suffix=".">
              <group delimiter=" ">
                <text variable="publisher-place"/>
                <date variable="issued" 
                      date-parts="year" 
                      form="text"/>
              </group>
              <text macro="access"/>
            </group>
          </else>

        </choose>
      </group>
    </layout>
  </bibliography>

</style>
