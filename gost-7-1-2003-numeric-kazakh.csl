<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" page-range-format="expanded">
  <info>
    <title>GOST 7.1-2003 (numeric, Қазақша)</title>
    <title-short>МЕМСТ 7.1-2003 ГОСТ Kazakh Kazakhstan Қазақстан</title-short>
    <id>http://www.zotero.org/styles/gost-7-1-2003-numeric-kazakh</id>
    <link href="http://www.zotero.org/styles/gost-7-1-2003-numeric-kazakh" rel="self"/>
    <link href="http://www.zotero.org/styles/gost-r-7-0-5-2008-numeric" rel="template"/>
    <link href="https://docs.cntd.ru/document/1200034383" rel="documentation"/>
    <author>
      <name>Shaidozm</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Numeric style for Kazakh-language reference lists following the interstate standard GOST 7.1-2003 (МЕМСТ 7.1-2003), the bibliographic description standard used by universities and journals in Kazakhstan. In-text: [1, 25 б.]; the reference list is ordered by first citation. There is no kk-KZ locale file yet, so no default-locale is set and all Kazakh terms are defined in the style; the output is Kazakh whatever locale is selected. Known CSL limitation: works with four or more authors still start with the first author. ГОСТ 7.1-2003 бойынша қазақ тіліндегі нөмірлі стиль.</summary>
    <updated>2026-10-27T01:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- Kazakh terms. There is no locales-kk-KZ.xml in the CSL locales repository, so all terms used by the style are defined here, without xml:lang, so they apply whatever locale the processor falls back to. -->
  <locale>
    <terms>
      <!-- Heading: first author only, without "et al." (GOST 7.1-2003, 4.1.3) -->
      <term name="and others"/>
      <!-- Statement of responsibility: 5 or more authors -> first three + [т.б.] (GOST 7.1-2003, 5.2.5.2) -->
      <term name="et-al"> [т.б.]</term>
      <term name="online">электрондық ресурс</term>
      <term name="accessed">қаралған күні</term>
      <term name="ordinal">-</term>
      <term name="edition" form="short">бас.</term>
      <term name="editor" form="verb-short">ред.</term>
      <term name="translator" form="verb-short">ауд.</term>
      <term name="compiler" form="verb-short">құраст.</term>
      <term name="editorial-director" form="verb-short">жауапты ред.</term>
      <term name="patent" form="short">пат.</term>
      <term name="volume" form="short">т.</term>
      <term name="issue" form="short">№</term>
      <term name="number" form="short">№</term>
      <term name="page" form="short">б.</term>
      <term name="number-of-pages" form="short">б.</term>
      <term name="chapter" form="short">тар.</term>
      <term name="part" form="short">бөл.</term>
      <term name="section" form="short">бөл.</term>
      <term name="figure" form="short">сур.</term>
      <term name="table" form="short">кесте</term>
      <term name="paragraph" form="short">п.</term>
      <term name="line" form="short">жол</term>
      <term name="note" form="short">ескер.</term>
      <term name="folio" form="short">пар.</term>
      <term name="book" form="short">кіт.</term>
      <term name="column" form="short">бағ.</term>
      <term name="verse" form="short">тарм.</term>
      <term name="sub-verbo" form="short">қар.</term>
      <term name="appendix" form="short">қос.</term>
      <term name="article-locator" form="short">бап</term>
      <term name="month-01">қаңтар</term>
      <term name="month-02">ақпан</term>
      <term name="month-03">наурыз</term>
      <term name="month-04">сәуір</term>
      <term name="month-05">мамыр</term>
      <term name="month-06">маусым</term>
      <term name="month-07">шілде</term>
      <term name="month-08">тамыз</term>
      <term name="month-09">қыркүйек</term>
      <term name="month-10">қазан</term>
      <term name="month-11">қараша</term>
      <term name="month-12">желтоқсан</term>
    </terms>
  </locale>
  <!-- Heading: first author, family name first (Ахметов А. Б.) -->
  <macro name="heading">
    <names variable="author" suffix=".">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=". " et-al-min="2" et-al-use-first="1"/>
      <et-al term="and others"/>
    </names>
  </macro>
  <!-- Statement of responsibility: / А. Б. Ахметов, С. Т. Серікова ; ред. Д. Е. Нұрланов ; ауд. ... -->
  <macro name="responsibility">
    <group delimiter=" ; ">
      <names variable="author">
        <name initialize-with=". " delimiter=", " delimiter-precedes-et-al="never" et-al-min="5" et-al-use-first="3"/>
        <et-al term="et-al"/>
      </names>
      <names variable="editorial-director">
        <label form="verb-short" suffix=" "/>
        <name initialize-with=". " delimiter=", " delimiter-precedes-et-al="never" et-al-min="5" et-al-use-first="3"/>
        <et-al term="et-al"/>
      </names>
      <choose>
        <if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="none">
          <names variable="editor">
            <label form="verb-short" suffix=" "/>
            <name initialize-with=". " delimiter=", " delimiter-precedes-et-al="never" et-al-min="5" et-al-use-first="3"/>
            <et-al term="et-al"/>
          </names>
        </if>
      </choose>
      <names variable="compiler">
        <label form="verb-short" suffix=" "/>
        <name initialize-with=". " delimiter=", " delimiter-precedes-et-al="never" et-al-min="5" et-al-use-first="3"/>
        <et-al term="et-al"/>
      </names>
      <names variable="translator">
        <label form="verb-short" suffix=" "/>
        <name initialize-with=". " delimiter=", " delimiter-precedes-et-al="never" et-al-min="5" et-al-use-first="3"/>
        <et-al term="et-al"/>
      </names>
    </group>
  </macro>
  <macro name="container-responsibility">
    <group delimiter=" ; ">
      <names variable="container-author">
        <name initialize-with=". " delimiter=", " delimiter-precedes-et-al="never" et-al-min="5" et-al-use-first="3"/>
        <et-al term="et-al"/>
      </names>
      <names variable="editor">
        <label form="verb-short" suffix=" "/>
        <name initialize-with=". " delimiter=", " delimiter-precedes-et-al="never" et-al-min="5" et-al-use-first="3"/>
        <et-al term="et-al"/>
      </names>
    </group>
  </macro>
  <!-- Title proper and other title information (: оқулық, : дис. ...) -->
  <macro name="title">
    <group delimiter=" : ">
      <group delimiter=" ">
        <text variable="title"/>
        <choose>
          <if type="webpage post post-weblog" match="any">
            <text term="online" text-case="capitalize-first" prefix="[" suffix="]"/>
          </if>
        </choose>
      </group>
      <choose>
        <if type="patent">
          <group delimiter=" ">
            <text term="patent" form="short"/>
            <group delimiter=" ">
              <text term="number" form="short"/>
              <text variable="number"/>
            </group>
          </group>
        </if>
        <else-if type="report">
          <group delimiter=" ">
            <text variable="genre"/>
            <group delimiter=" ">
              <text term="number" form="short"/>
              <text variable="number"/>
            </group>
          </group>
        </else-if>
        <else>
          <text variable="genre"/>
        </else>
      </choose>
    </group>
  </macro>
  <!-- Standards and legal acts start with their number: ҚР СТ 1.5-2019. Атауы -->
  <macro name="title-block">
    <group delimiter=" / ">
      <group delimiter=". ">
        <choose>
          <if type="standard legislation regulation" match="any">
            <text variable="number"/>
          </if>
        </choose>
        <text macro="title"/>
      </group>
      <text macro="responsibility"/>
    </group>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group>
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <!-- Newspapers: year, then day and month (&#8211; 2021. &#8211; 12 қаңтар) -->
  <macro name="day-month">
    <date variable="issued" delimiter=" ">
      <date-part name="day"/>
      <date-part name="month"/>
    </date>
  </macro>
  <!-- Publication area: Алматы : Қазақ университеті, 2020 -->
  <macro name="publication">
    <group delimiter=", ">
      <choose>
        <if type="thesis">
          <text variable="publisher-place"/>
        </if>
        <else>
          <group delimiter=" : ">
            <text variable="publisher-place"/>
            <text variable="publisher"/>
          </group>
        </else>
      </choose>
      <text macro="year"/>
    </group>
  </macro>
  <macro name="number-of-pages">
    <group delimiter=" ">
      <text variable="number-of-pages"/>
      <label variable="number-of-pages" form="short" plural="never"/>
    </group>
  </macro>
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short" text-case="capitalize-first" plural="never"/>
      <text variable="page"/>
    </group>
  </macro>
  <!-- Volume of a multivolume work (&#8211; Т. 3) -->
  <macro name="volume">
    <group delimiter=" ">
      <label variable="volume" form="short" text-case="capitalize-first" plural="never"/>
      <text variable="volume"/>
    </group>
  </macro>
  <!-- Series area: &#8211; (Серия атауы ; 5) -->
  <macro name="collection">
    <group delimiter=" ; " prefix="(" suffix=")">
      <text variable="collection-title"/>
      <text variable="collection-number"/>
    </group>
  </macro>
  <macro name="volume-issue">
    <group delimiter=", ">
      <text macro="volume"/>
      <group delimiter=" ">
        <text term="issue" form="short"/>
        <text variable="issue"/>
      </group>
    </group>
  </macro>
  <macro name="accessed">
    <group delimiter=": ">
      <text term="accessed"/>
      <date variable="accessed">
        <date-part name="day" form="numeric-leading-zeros" suffix="."/>
        <date-part name="month" form="numeric-leading-zeros" suffix="."/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>
  <!-- Electronic address: DOI if present, otherwise URL (қаралған күні: 01.02.2024) -->
  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: "/>
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text variable="URL" prefix="URL: "/>
          <text macro="accessed" prefix="(" suffix=")"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="body">
    <choose>
      <!-- Newspaper article: ... // Газет. &#8211; 2021. &#8211; 12 қаңтар. &#8211; Б. 5. -->
      <if type="article-newspaper">
        <group delimiter=". &#8211; ">
          <group delimiter=" // ">
            <text macro="title-block"/>
            <text variable="container-title"/>
          </group>
          <text macro="year"/>
          <text macro="day-month"/>
          <text macro="volume-issue"/>
          <text macro="pages"/>
          <text macro="access"/>
        </group>
      </if>
      <!-- Journal article: Ахметов А. Б. Атауы / А. Б. Ахметов // Журнал. &#8211; 2021. &#8211; Т. 3, № 2. &#8211; Б. 45&#8211;52. -->
      <else-if type="article-journal article-magazine" match="any">
        <group delimiter=". &#8211; ">
          <group delimiter=" // ">
            <text macro="title-block"/>
            <text variable="container-title"/>
          </group>
          <text macro="year"/>
          <text macro="volume-issue"/>
          <text macro="pages"/>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Part of a book: ... // Кітап атауы / ред. ... &#8211; Алматы : Баспа, 2020. &#8211; Б. 10&#8211;20. -->
      <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
        <group delimiter=". &#8211; ">
          <group delimiter=" // ">
            <text macro="title-block"/>
            <group delimiter=" / ">
              <group delimiter=" : ">
                <text variable="container-title"/>
                <text variable="event-title"/>
              </group>
              <text macro="container-responsibility"/>
            </group>
          </group>
          <text macro="edition"/>
          <text macro="publication"/>
          <group delimiter=", ">
            <text macro="volume"/>
            <text macro="pages"/>
          </group>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Web page: Атауы [Электрондық ресурс]. &#8211; URL: ... (қаралған күні: ...) -->
      <else-if type="webpage post post-weblog" match="any">
        <group delimiter=". &#8211; ">
          <group delimiter=" // ">
            <text macro="title-block"/>
            <text variable="container-title"/>
          </group>
          <text macro="year"/>
          <text macro="access"/>
        </group>
      </else-if>
      <!-- Book, thesis, report, standard, etc.: ... &#8211; Алматы : Баспа, 2005. &#8211; Т. 3. &#8211; 540 б. &#8211; (Серия ; 5). -->
      <else>
        <group delimiter=". &#8211; ">
          <text macro="title-block"/>
          <text macro="edition"/>
          <text macro="publication"/>
          <text macro="volume"/>
          <text macro="number-of-pages"/>
          <text macro="collection"/>
          <text macro="access"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter="; ">
      <group delimiter=", ">
        <text variable="citation-number"/>
        <group delimiter=" ">
          <text variable="locator"/>
          <label variable="locator" form="short" plural="never"/>
        </group>
      </group>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" suffix="."/>
      <group delimiter=" ">
        <text macro="heading"/>
        <text macro="body"/>
      </group>
    </layout>
  </bibliography>
</style>
