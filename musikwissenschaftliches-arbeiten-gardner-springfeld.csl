<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="display-and-sort" and="text" delimiter-precedes-last="never" default-locale="de-DE">
  <info>
    <title>Musikwissenschaftliches Arbeiten - Gardner/Springfeld (Deutsch)</title>
    <title-short>Gardner/Springfeld</title-short>
    <id>http://www.zotero.org/styles/musikwissenschaftliches-arbeiten-gardner-springfeld</id>
    <link href="http://www.zotero.org/styles/musikwissenschaftliches-arbeiten-gardner-springfeld" rel="self"/>
    <link href="https://d-nb.info/105407223X" rel="documentation"/>
    <link href="https://github.com/digimuwi/MWA_csl/blob/main/docs/regeln.md" rel="documentation"/>
    <author>
      <name>Julius Hauth</name>
    </author>
    <author>
      <name>Thomas Hua</name>
    </author>
    <author>
      <name>Niels Pfeffer</name>
    </author>
    <category citation-format="note"/>
    <category field="humanities"/>
    <summary>Notes and bibliography following Matthew Gardner and Sara Springfeld, Musikwissenschaftliches Arbeiten. Eine Einführung, Kassel 2014 (Bärenreiter Studienbücher Musik, 19), pp. 262&#8211;284.</summary>
    <updated>2026-11-14T12:00:00+01:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="de">
    <date form="numeric">
      <date-part name="day" suffix="."/>
      <date-part name="month" form="numeric" suffix="."/>
      <date-part name="year"/>
    </date>
    <terms>
      <term name="accessed">abgerufen am</term>
      <term name="open-quote">»</term>
      <term name="close-quote">«</term>
      <term name="open-inner-quote">›</term>
      <term name="close-inner-quote">‹</term>
    </terms>
  </locale>
  <!-- author, author-bibliography, author-short and author-sort share the same type logic -->
  <macro name="author">
    <choose>
      <if type="song">
        <names variable="composer"/>
      </if>
      <else-if type="chapter entry-dictionary entry-encyclopedia paper-conference" match="any">
        <names variable="author"/>
      </else-if>
      <else>
        <names variable="author">
          <substitute>
            <names variable="editor">
              <name/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="author-bibliography">
    <choose>
      <if type="song">
        <names variable="composer">
          <name name-as-sort-order="all" delimiter="; "/>
        </names>
      </if>
      <else-if type="chapter entry-dictionary entry-encyclopedia paper-conference" match="any">
        <names variable="author">
          <name name-as-sort-order="all" delimiter="; "/>
        </names>
      </else-if>
      <else>
        <names variable="author">
          <name name-as-sort-order="all" delimiter="; "/>
          <substitute>
            <names variable="editor">
              <name name-as-sort-order="all" delimiter="; "/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="author-short">
    <choose>
      <if type="song">
        <names variable="composer">
          <name form="short"/>
        </names>
      </if>
      <else-if type="chapter entry-dictionary entry-encyclopedia paper-conference" match="any">
        <names variable="author">
          <name form="short"/>
        </names>
      </else-if>
      <else>
        <names variable="author">
          <name form="short"/>
          <substitute>
            <names variable="editor">
              <name form="short"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="author-sort">
    <choose>
      <if type="song">
        <names variable="composer">
          <substitute>
            <text variable="title"/>
          </substitute>
        </names>
      </if>
      <else-if type="chapter entry-dictionary entry-encyclopedia paper-conference" match="any">
        <names variable="author">
          <substitute>
            <text variable="title"/>
          </substitute>
        </names>
      </else-if>
      <else>
        <names variable="author">
          <substitute>
            <names variable="editor"/>
            <text variable="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="title">
    <choose>
      <if type="song" variable="container-title" match="all">
        <group delimiter=", ">
          <text variable="title" quotes="true" text-case="title"/>
          <group delimiter=": ">
            <text term="on"/>
            <text variable="container-title" font-style="italic" text-case="title"/>
          </group>
        </group>
      </if>
      <else-if type="book graphic manuscript song thesis" match="any">
        <text variable="title" font-style="italic" text-case="title"/>
      </else-if>
      <else-if type="entry-dictionary entry-encyclopedia" match="any">
        <text variable="title" prefix="Art. " quotes="true" text-case="title"/>
      </else-if>
      <else>
        <text variable="title" quotes="true" text-case="title"/>
      </else>
    </choose>
  </macro>
  <!-- the short form drops "Art." (Gardner/Springfeld, p. 269 f.) -->
  <macro name="title-short">
    <choose>
      <if type="song" variable="container-title" match="all">
        <text variable="title" form="short" quotes="true" text-case="title"/>
      </if>
      <else-if type="book graphic manuscript song thesis" match="any">
        <text variable="title" form="short" font-style="italic" text-case="title"/>
      </else-if>
      <else>
        <text variable="title" form="short" quotes="true" text-case="title"/>
      </else>
    </choose>
  </macro>
  <macro name="container-title">
    <group delimiter=": ">
      <text term="in"/>
      <text variable="container-title" font-style="italic" text-case="title"/>
    </group>
  </macro>
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="publication">
    <choose>
      <if type="book chapter entry-dictionary entry-encyclopedia paper-conference" match="any">
        <group delimiter=", ">
          <text macro="container-title"/>
          <group delimiter=" ">
            <text variable="original-publisher-place"/>
            <date variable="original-date">
              <date-part name="year"/>
            </date>
          </group>
          <choose>
            <if is-numeric="edition" match="none">
              <text variable="edition"/>
            </if>
          </choose>
          <names variable="editor">
            <label form="verb-short" suffix=" "/>
            <name/>
          </names>
          <choose>
            <if is-numeric="volume">
              <group delimiter=" ">
                <label variable="volume" form="short"/>
                <text variable="volume"/>
              </group>
            </if>
            <else-if variable="volume">
              <text variable="volume"/>
            </else-if>
            <else-if variable="number-of-volumes">
              <group delimiter=" ">
                <text variable="number-of-volumes"/>
                <text term="volume" form="short" plural="true"/>
              </group>
            </else-if>
          </choose>
          <group delimiter=" ">
            <text variable="publisher-place"/>
            <group>
              <choose>
                <if is-numeric="edition">
                  <text variable="edition" vertical-align="sup"/>
                </if>
              </choose>
              <text macro="year"/>
            </group>
          </group>
          <text variable="medium"/>
        </group>
      </if>
      <else-if type="post-weblog webpage" match="any">
        <text variable="container-title" font-style="italic" text-case="title"/>
      </else-if>
      <else-if type="thesis">
        <group delimiter=", ">
          <group delimiter=" ">
            <text variable="genre"/>
            <text variable="publisher"/>
          </group>
          <text macro="year"/>
        </group>
      </else-if>
      <else-if type="article-journal">
        <group delimiter=" ">
          <group delimiter=": ">
            <text term="in"/>
            <text variable="container-title" form="short" font-style="italic" text-case="title"/>
          </group>
          <group delimiter="/">
            <text variable="volume"/>
            <text variable="issue"/>
          </group>
          <text macro="year" prefix="(" suffix=")"/>
        </group>
      </else-if>
      <else-if type="article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <choose>
            <if variable="title">
              <text macro="container-title"/>
            </if>
            <else>
              <text variable="container-title" font-style="italic" text-case="title"/>
            </else>
          </choose>
          <date variable="issued" form="numeric"/>
        </group>
      </else-if>
      <else-if type="manuscript">
        <group delimiter=", ">
          <text variable="genre"/>
          <names variable="contributor"/>
          <text macro="year"/>
          <text variable="call-number"/>
        </group>
      </else-if>
      <else-if type="song">
        <group delimiter=", ">
          <names variable="author"/>
          <text variable="publisher"/>
          <text macro="year"/>
          <text variable="medium"/>
        </group>
      </else-if>
      <else-if type="graphic">
        <group delimiter=", ">
          <text variable="medium"/>
          <group delimiter=" ">
            <text variable="event-place"/>
            <text macro="year"/>
          </group>
          <text variable="dimensions"/>
          <text variable="archive"/>
          <text variable="archive_location"/>
          <text variable="call-number"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="series">
    <choose>
      <if type="song" variable="collection-title volume" match="all">
        <group delimiter=", " prefix="(" suffix=")">
          <text variable="collection-title" text-case="title"/>
          <text variable="volume"/>
        </group>
      </if>
      <else-if variable="collection-title collection-number" match="all">
        <group delimiter=", " prefix="(" suffix=")">
          <text variable="collection-title" text-case="title"/>
          <text variable="collection-number"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="online-date">
    <choose>
      <if type="webpage">
        <date variable="issued" form="numeric" prefix="letzte Änderung "/>
      </if>
      <else-if type="post-weblog">
        <date variable="issued" form="numeric" prefix="gepostet am "/>
      </else-if>
    </choose>
  </macro>
  <macro name="accessed">
    <group delimiter=" ">
      <text term="accessed"/>
      <date variable="accessed" form="numeric"/>
    </group>
  </macro>
  <macro name="access">
    <choose>
      <if variable="DOI">
        <group delimiter=", ">
          <text variable="DOI" prefix="https://doi.org/"/>
          <text macro="accessed"/>
        </group>
      </if>
      <else-if variable="URL">
        <group delimiter=", ">
          <text variable="URL"/>
          <text macro="online-date"/>
          <text macro="accessed"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="pages">
    <choose>
      <if is-numeric="page">
        <group delimiter=" ">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </if>
      <else>
        <text variable="page"/>
      </else>
    </choose>
  </macro>
  <macro name="locator">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <number variable="locator"/>
    </group>
  </macro>
  <citation>
    <layout suffix="." delimiter="; ">
      <!-- the full form comes last, so processors without position tracking fall through to it -->
      <choose>
        <if position="ibid-with-locator">
          <group delimiter=", ">
            <text term="ibid"/>
            <text macro="locator"/>
          </group>
        </if>
        <else-if position="ibid">
          <text term="ibid"/>
        </else-if>
        <else-if position="subsequent">
          <group delimiter=", ">
            <text macro="author-short"/>
            <text macro="title-short"/>
            <choose>
              <if type="manuscript">
                <text variable="call-number"/>
              </if>
            </choose>
            <text macro="locator"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <text macro="author"/>
            <text macro="title"/>
            <group delimiter=" ">
              <text macro="publication"/>
              <text macro="series"/>
            </group>
            <text macro="access"/>
            <choose>
              <if variable="locator">
                <text macro="locator"/>
              </if>
              <else>
                <text macro="pages"/>
              </else>
            </choose>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography hanging-indent="true">
    <sort>
      <key macro="author-sort"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=", ">
        <text macro="author-bibliography"/>
        <text macro="title"/>
        <group delimiter=" ">
          <text macro="publication"/>
          <text macro="series"/>
        </group>
        <text macro="access"/>
        <text macro="pages"/>
      </group>
    </layout>
  </bibliography>
</style>
