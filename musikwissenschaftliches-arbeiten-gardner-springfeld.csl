<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="display-and-sort" default-locale="de-DE">
  <!-- CSL description -->
  <info>
    <title>Musikwissenschaftliches Arbeiten (Gardner/Springfeld) (Deutsch)</title>
    <title-short>Gardner/Springfeld</title-short>
    <id>http://www.zotero.org/styles/musikwissenschaftliches-arbeiten-gardner-springfeld</id>
    <link href="http://www.zotero.org/styles/musikwissenschaftliches-arbeiten-gardner-springfeld" rel="self"/>
    <link href="https://d-nb.info/105407223X" rel="documentation"/>
    <!-- implementation notes and Zotero input -->
    <link href="https://github.com/digimuwi/MWA_csl/blob/main/docs/regeln.md" rel="documentation"/>
    <author>
      <name>Julius Hauth</name>
    </author>
    <author>
      <name>Thomas Hua</name>
    </author>
    <author>
      <name>Niels Pfeffer</name>
    </author>
    <category citation-format="note"/>
    <category field="humanities"/>
    <summary>Notes and bibliography following Matthew Gardner and Sara Springfeld, Musikwissenschaftliches Arbeiten. Eine Einführung, Kassel 2014 (Bärenreiter Studienbücher Musik, 19), pp. 262&#8211;284.</summary>
    <updated>2026-10-24T11:30:00+02:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="de">
    <terms>
      <term name="open-quote">»</term>
      <term name="close-quote">«</term>
      <term name="open-inner-quote">›</term>
      <term name="close-inner-quote">‹</term>
    </terms>
  </locale>
  <!-- MACROS (type dependent) -->
  <macro name="title">
    <choose>
      <if type="book thesis manuscript graphic">
        <text variable="title" font-style="italic" text-case="title"/>
      </if>
      <else-if type="song">
        <choose>
          <if variable="event-place">
            <group delimiter=", ">
              <text quotes="true" variable="title"/>
              <group delimiter=": ">
                <text term="on"/>
                <text variable="event-place" font-style="italic"/>
              </group>
            </group>
          </if>
          <else>
            <text variable="title" font-style="italic" text-case="title"/>
          </else>
        </choose>
      </else-if>
      <else-if type="entry-dictionary entry-encyclopedia">
        <text prefix="Art. " quotes="true" variable="title" text-case="title"/>
      </else-if>
      <else>
        <text quotes="true" variable="title" text-case="title"/>
      </else>
    </choose>
  </macro>
  <macro name="author">
    <!-- ALWAYS KEEP IN MIND THAT "author", "author-bibliography" and "author-short" should be in sync!-->
    <choose>
      <if type="song">
        <names variable="composer">
          <name delimiter=", " and="text" delimiter-precedes-last="never"/>
        </names>
      </if>
      <else>
        <choose>
          <if variable="author">
            <names variable="author">
              <name delimiter=", " and="text" delimiter-precedes-last="never"/>
            </names>
          </if>
          <!-- [1] When including "editor" in the author section, they must be excluded in the "editor" macro -->
          <else-if type="chapter entry-dictionary entry-encyclopedia paper-conference" match="none">
            <names variable="editor">
              <name delimiter=", " and="text" delimiter-precedes-last="never"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
          </else-if>
        </choose>
      </else>
    </choose>
  </macro>
  <macro name="author-bibliography">
    <!-- ALWAYS KEEP IN MIND THAT "author", "author-bibliography" and "author-short" should be in sync!-->
    <choose>
      <if type="song">
        <names variable="composer">
          <name delimiter="; " and="text" delimiter-precedes-last="never" name-as-sort-order="all"/>
        </names>
      </if>
      <else>
        <choose>
          <if variable="author">
            <names variable="author">
              <name delimiter="; " and="text" delimiter-precedes-last="never" name-as-sort-order="all"/>
            </names>
          </if>
          <!-- [1] When including "editor" in the author section, they must be excluded in the "editor" macro -->
          <else-if type="chapter entry-dictionary entry-encyclopedia paper-conference" match="none">
            <names variable="editor">
              <name delimiter="; " and="text" delimiter-precedes-last="never" name-as-sort-order="all"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
          </else-if>
        </choose>
      </else>
    </choose>
  </macro>
  <macro name="author-short">
    <!-- ALWAYS KEEP IN MIND THAT "author", "author-bibliography" and "author-short" should be in sync!-->
    <choose>
      <if type="song">
        <names variable="composer">
          <name delimiter=", " and="text" delimiter-precedes-last="never" form="short"/>
        </names>
      </if>
      <else>
        <choose>
          <if variable="author">
            <names variable="author">
              <name delimiter=", " and="text" delimiter-precedes-last="never" form="short"/>
            </names>
          </if>
          <!-- [1] When including "editor" in the author section, they must be excluded in the "editor" macro -->
          <else-if type="chapter entry-dictionary entry-encyclopedia paper-conference" match="none">
            <names variable="editor">
              <name delimiter=", " and="text" delimiter-precedes-last="never" form="short"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
          </else-if>
        </choose>
      </else>
    </choose>
  </macro>
  <macro name="sort-author">
    <!-- Mirrors "author-bibliography"; works without author (or editor) are sorted by their title -->
    <choose>
      <if type="song">
        <names variable="composer">
          <substitute>
            <text variable="title"/>
          </substitute>
        </names>
      </if>
      <else-if type="chapter entry-dictionary entry-encyclopedia paper-conference">
        <names variable="author">
          <substitute>
            <text variable="title"/>
          </substitute>
        </names>
      </else-if>
      <else>
        <names variable="author">
          <substitute>
            <names variable="editor"/>
            <text variable="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="editor">
    <!-- [1] This exclusion is needed, since in some cases we want the editors in front -->
    <choose>
      <if variable="author" type="chapter entry-dictionary entry-encyclopedia paper-conference" match="any">
        <names variable="editor">
          <label form="verb-short" suffix=" "/>
          <name delimiter=", " and="text" delimiter-precedes-last="never"/>
        </names>
      </if>
    </choose>
  </macro>
  <macro name="copyist">
    <names variable="translator">
      <name delimiter=", " and="text" delimiter-precedes-last="never"/>
    </names>
  </macro>
  <macro name="book-journal-title">
    <group delimiter=": ">
      <text term="in"/>
      <text variable="container-title" font-style="italic" text-case="title"/>
    </group>
  </macro>
  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="page-count">
    <choose>
      <if is-numeric="page">
        <group delimiter=" ">
          <text term="page" form="short"/>
          <text variable="page"/>
        </group>
      </if>
      <else>
        <text variable="page"/>
      </else>
    </choose>
  </macro>
  <macro name="serie">
    <choose>
      <if type="song">
        <choose>
          <if variable="collection-title volume">
            <group prefix="(" suffix=")" delimiter=", ">
              <text variable="collection-title" text-case="title"/>
              <text variable="volume"/>
            </group>
          </if>
        </choose>
      </if>
      <else>
        <choose>
          <if variable="collection-title collection-number">
            <group prefix="(" suffix=")" delimiter=", ">
              <text variable="collection-title" text-case="title"/>
              <text variable="collection-number"/>
            </group>
          </if>
        </choose>
      </else>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if type="chapter book entry-dictionary entry-encyclopedia paper-conference">
        <group delimiter=", ">
          <text macro="book-journal-title"/>
          <!-- reprints: place and year of the original edition -->
          <group delimiter=" ">
            <text variable="original-publisher-place"/>
            <date variable="original-date">
              <date-part name="year"/>
            </date>
          </group>
          <!-- non-numeric edition, e.g. "zweite und verbesserte Auflage" -->
          <choose>
            <if is-numeric="edition"/>
            <else>
              <text variable="edition"/>
            </else>
          </choose>
          <text macro="editor"/>
          <choose>
            <if variable="volume">
              <choose>
                <if is-numeric="volume">
                  <group delimiter=" ">
                    <label variable="volume" form="short"/>
                    <text variable="volume"/>
                  </group>
                </if>
                <else>
                  <text variable="volume"/>
                </else>
              </choose>
            </if>
            <else-if variable="number-of-volumes">
              <group delimiter=" ">
                <text variable="number-of-volumes"/>
                <text term="volume" form="short" plural="true"/>
              </group>
            </else-if>
          </choose>
          <group delimiter=" ">
            <text variable="publisher-place"/>
            <group>
              <choose>
                <if is-numeric="edition">
                  <text variable="edition" vertical-align="sup"/>
                </if>
              </choose>
              <text macro="issued-year"/>
            </group>
          </group>
          <text variable="note"/>
        </group>
      </if>
      <else-if type="webpage post-weblog">
        <text variable="container-title" font-style="italic" text-case="title"/>
      </else-if>
      <else-if type="thesis">
        <group delimiter=", ">
          <group delimiter=" ">
            <text variable="genre"/>
            <text variable="publisher"/>
          </group>
          <text macro="issued-year"/>
        </group>
      </else-if>
      <else-if type="article-journal">
        <group delimiter=" ">
          <group delimiter=": ">
            <text term="in"/>
            <text variable="container-title" form="short" font-style="italic" text-case="title"/>
          </group>
          <group delimiter="/">
            <text variable="volume"/>
            <text variable="issue"/>
          </group>
          <text macro="issued-year" prefix="(" suffix=")"/>
        </group>
      </else-if>
      <else-if type="article-newspaper article-magazine">
        <group delimiter=", ">
          <choose>
            <if variable="title">
              <text macro="book-journal-title"/>
            </if>
            <else>
              <text variable="container-title" font-style="italic" text-case="title"/>
            </else>
          </choose>
          <date variable="issued">
            <date-part name="day" suffix="."/>
            <date-part name="month" form="numeric" suffix="."/>
            <date-part name="year"/>
          </date>
        </group>
      </else-if>
      <else-if type="manuscript">
        <group delimiter=", ">
          <text variable="genre"/>
          <text macro="copyist"/>
          <text macro="issued-year"/>
          <text variable="call-number"/>
        </group>
      </else-if>
      <else-if type="song">
        <group delimiter=", ">
          <names variable="author">
            <name delimiter=", " and="text" delimiter-precedes-last="never"/>
          </names>
          <text variable="publisher"/>
          <text macro="issued-year"/>
          <text variable="medium"/>
        </group>
      </else-if>
      <else-if type="graphic">
        <group delimiter=", ">
          <text variable="medium"/>
          <group delimiter=" ">
            <text variable="language"/>
            <text macro="issued-year"/>
          </group>
          <text variable="dimensions"/>
          <text variable="archive"/>
          <text variable="archive_location"/>
          <text variable="source"/>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="access-date">
    <date variable="accessed" prefix="abgerufen am ">
      <date-part name="day" suffix="."/>
      <date-part name="month" form="numeric" suffix="."/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="access">
    <group delimiter=" ">
      <group delimiter=", ">
        <choose>
          <if variable="DOI">
            <text variable="DOI" prefix="https://doi.org/"/>
            <text macro="access-date"/>
          </if>
          <else-if variable="URL">
            <text variable="URL"/>
            <choose>
              <if type="webpage post-weblog">
                <group delimiter=" ">
                  <choose>
                    <if type="webpage">
                      <text value="letzte Änderung"/>
                    </if>
                    <else-if type="post-weblog">
                      <text value="gepostet am"/>
                    </else-if>
                  </choose>
                  <date variable="issued">
                    <date-part name="day" suffix="."/>
                    <date-part name="month" form="numeric" suffix="."/>
                    <date-part name="year"/>
                  </date>
                </group>
              </if>
            </choose>
            <text macro="access-date"/>
          </else-if>
        </choose>
      </group>
    </group>
  </macro>
  <macro name="short-title">
    <!-- ALWAYS KEEP IN MIND THAT "title" and "short-title" should be in sync!-->
    <!-- form="short" falls back to the full title; Gardner/Springfeld drop "Art." here (p. 269 f.) -->
    <choose>
      <if type="book thesis manuscript graphic">
        <text variable="title" form="short" font-style="italic" text-case="title"/>
      </if>
      <else-if type="song">
        <choose>
          <if variable="event-place">
            <text quotes="true" variable="title" form="short" text-case="title"/>
          </if>
          <else>
            <text variable="title" form="short" font-style="italic" text-case="title"/>
          </else>
        </choose>
      </else-if>
      <else>
        <text quotes="true" variable="title" form="short" text-case="title"/>
      </else>
    </choose>
  </macro>
  <macro name="locator-page">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <number variable="locator"/>
    </group>
  </macro>
  <!-- FOOTNOTE (type agnostic definition) -->
  <citation>
    <layout suffix="." delimiter="; ">
      <group delimiter=" ">
        <group delimiter=", ">
          <choose>
            <if position="first">
              <text macro="author"/>
              <text macro="title"/>
              <group delimiter=" ">
                <text macro="edition"/>
                <text macro="serie"/>
              </group>
              <text macro="access"/>
              <choose>
                <if variable="locator">
                  <text macro="locator-page"/>
                </if>
                <else>
                  <text macro="page-count"/>
                </else>
              </choose>
            </if>
            <else-if position="ibid-with-locator">
              <text term="ibid"/>
              <text macro="locator-page"/>
            </else-if>
            <else-if position="ibid">
              <text term="ibid"/>
            </else-if>
            <else-if position="subsequent">
              <text macro="author-short"/>
              <text macro="short-title"/>
              <choose>
                <if type="manuscript">
                  <text variable="call-number"/>
                </if>
              </choose>
              <text macro="locator-page"/>
            </else-if>
          </choose>
        </group>
      </group>
    </layout>
  </citation>
  <!-- BIBLIOGRAPHY (type agnostic definition)-->
  <bibliography hanging-indent="true">
    <sort>
      <key macro="sort-author"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=" ">
        <group delimiter=", ">
          <text macro="author-bibliography"/>
          <text macro="title"/>
          <group delimiter=" ">
            <text macro="edition"/>
            <text macro="serie"/>
          </group>
          <text macro="access"/>
          <text macro="page-count"/>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
