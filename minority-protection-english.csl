<?xml version='1.0' encoding='UTF-8'?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" default-locale="en-GB" page-range-format="expanded">
  <info>
    <title>Minority Protection (English)</title>
    <title-short>Minority Protection EN</title-short>
    <id>http://www.zotero.org/styles/minority-protection-english</id>
    <link href="http://www.zotero.org/styles/minority-protection-english" rel="self"/>
    <link href="http://www.zotero.org/styles/international-organization" rel="template"/>
    <link href="https://portal.kre.hu/images/kiadvanyok/folyoirat/kisebbseg/Journal_Template_Minority_Protection.docx" rel="documentation"/>
    <author>
      <name>Attila Dabis</name>
    </author>
    <category citation-format="note"/>
    <category field="political_science"/>
    <category field="law"/>
    <category field="social_science"/>
    <issn>2676-8992</issn>
    <eissn>2939-5410</eissn>
    <summary>English-language citation style for the academic journal Minority Protection.</summary>
    <updated>2026-10-13T18:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en-GB">
    <terms>
      <term name="ibid">Ibid</term>
      <term name="op-cit">op. cit.</term>
      <term name="available at">Available at</term>
      <term name="accessed">accessed</term>
      <!-- Journal rule: ranges with a single hyphen, never an en dash. -->
      <term name="page-range-delimiter">-</term>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds.</multiple>
      </term>
      <term name="paragraph" form="short">
        <single>para.</single>
        <multiple>paras.</multiple>
      </term>
    </terms>
  </locale>
  <macro name="author-short">
    <names variable="author">
      <name form="short" delimiter=" - " et-al-min="3" et-al-use-first="1"/>
      <substitute>
        <names variable="editor">
          <name form="short" delimiter=" - " et-al-min="3" et-al-use-first="1"/>
        </names>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize="false" delimiter=" - " delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " initialize="false" delimiter=" - " delimiter-precedes-last="never"/>
        </names>
        <text variable="publisher"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-sort">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize="false"/>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="issued-full">
    <date variable="issued">
      <date-part name="day" suffix=" "/>
      <date-part name="month" form="long" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="accessed-full">
    <date variable="accessed">
      <date-part name="day" suffix=" "/>
      <date-part name="month" form="long" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="issued-document">
    <date variable="issued">
      <date-part name="day" form="numeric-leading-zeros" suffix=" "/>
      <date-part name="month" form="long" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="online-document-access">
    <choose>
      <if variable="URL">
        <text variable="URL" prefix="Available at: "/>
        <choose>
          <if variable="accessed">
            <text macro="accessed-full" prefix=", accessed: "/>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="locator">
    <text variable="locator"/>
  </macro>
  <macro name="ordinary-citation">
    <choose>
      <if position="ibid-with-locator">
        <group delimiter=", ">
          <text term="ibid" font-style="italic"/>
          <text macro="locator"/>
        </group>
      </if>
      <else-if position="ibid">
        <text term="ibid" font-style="italic"/>
      </else-if>
      <else-if position="subsequent">
        <group delimiter=" ">
          <text macro="author-short"/>
          <text macro="year"/>
        </group>
        <text term="op-cit" font-style="italic" prefix=", "/>
        <text macro="locator" prefix=" "/>
      </else-if>
      <else>
        <group delimiter=" ">
          <text macro="author-short"/>
          <text macro="year"/>
        </group>
        <text macro="locator" prefix=", "/>
      </else>
    </choose>
  </macro>
  <macro name="legal-locator">
    <choose>
      <if type="legal_case" locator="paragraph" match="all">
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </if>
      <else>
        <text variable="locator"/>
      </else>
    </choose>
  </macro>
  <macro name="legal-citation">
    <choose>
      <if position="ibid-with-locator">
        <group delimiter=", ">
          <text term="ibid" font-style="italic"/>
          <text macro="legal-locator"/>
        </group>
      </if>
      <else-if position="ibid">
        <text term="ibid" font-style="italic"/>
      </else-if>
      <else-if position="subsequent">
        <choose>
          <if type="legal_case">
            <!-- Court decisions: full case name in every note (no short form). -->
            <text variable="title"/>
            <text macro="year" prefix=" "/>
          </if>
          <else>
            <text variable="title" form="short"/>
          </else>
        </choose>
        <text macro="legal-locator" prefix=", "/>
      </else-if>
      <else>
        <text variable="title"/>
        <choose>
          <if type="legal_case">
            <text macro="year" prefix=" "/>
          </if>
        </choose>
        <text macro="legal-locator" prefix=", "/>
      </else>
    </choose>
  </macro>
  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
    </choose>
  </macro>
  <macro name="online-access">
    <choose>
      <if variable="URL">
        <text value=" [online]. Available at: "/>
        <text variable="URL"/>
        <choose>
          <if variable="accessed">
            <text value=", accessed: "/>
            <text macro="accessed-full"/>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="editors-en">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=", " initialize="false" delimiter=" - " delimiter-precedes-last="never"/>
      <label form="short" prefix=" (" suffix="):"/>
    </names>
  </macro>
  <macro name="bibliography-entry">
    <choose>
      <if type="book">
        <choose>
          <if variable="author">
            <text macro="author-bib" suffix=": "/>
          </if>
          <else-if variable="editor">
            <text macro="editors-en" suffix=" "/>
          </else-if>
          <else>
            <text macro="author-bib" suffix=": "/>
          </else>
        </choose>
        <text variable="title" font-style="italic" suffix=". "/>
        <group delimiter=": " suffix=". ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
        <text macro="year"/>
        <text macro="doi" prefix=". "/>
      </if>
      <else-if type="chapter paper-conference" match="any">
        <text macro="author-bib" suffix=": "/>
        <text variable="title" suffix=". In: "/>
        <text macro="editors-en" suffix=" "/>
        <text variable="container-title" font-style="italic" suffix=". "/>
        <group delimiter=": " suffix=". ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
        <text macro="year"/>
        <text variable="page" prefix=", "/>
        <text macro="doi" prefix=". "/>
      </else-if>
      <else-if type="article-journal">
        <text macro="author-bib" suffix=": "/>
        <text variable="title" suffix=". In: "/>
        <group font-style="italic">
          <text variable="container-title"/>
          <text variable="volume" prefix=" "/>
          <text variable="issue" prefix="(" suffix=")"/>
        </group>
        <text value=". "/>
        <text macro="year"/>
        <text variable="page" prefix=", "/>
        <text macro="doi" prefix=". "/>
      </else-if>
      <!-- Institutional statements and press releases are entered as webpage. -->
      <else-if type="webpage">
        <text macro="author-bib" suffix=": "/>
        <group delimiter=". ">
          <text variable="title" font-style="italic"/>
          <group delimiter=", ">
            <text variable="container-title" font-style="italic"/>
            <text macro="issued-document"/>
          </group>
          <text macro="online-document-access"/>
        </group>
      </else-if>
      <else-if type="article-newspaper article-magazine post-weblog post" match="any">
        <text macro="author-bib" suffix=": "/>
        <text variable="title" suffix=". "/>
        <text variable="container-title" font-style="italic"/>
        <choose>
          <if variable="issued">
            <text value=", "/>
            <text macro="issued-full"/>
          </if>
        </choose>
        <text macro="online-access"/>
      </else-if>
      <!-- Court decisions: case name. Court, date, case number. No decision type, no reporter.
           URL and access date only when no case number is recorded. -->
      <else-if type="legal_case">
        <text variable="title" suffix=". "/>
        <group delimiter=", ">
          <text variable="authority" font-style="italic"/>
          <text macro="issued-full"/>
          <text variable="number"/>
        </group>
        <choose>
          <if variable="number" match="none">
            <text macro="online-access"/>
          </if>
        </choose>
      </else-if>
      <!-- Enacted legislation and regulations are cited without online access data. -->
      <else-if type="legislation regulation" match="any">
        <text variable="title"/>
        <text variable="number" prefix=" "/>
      </else-if>
      <else-if type="bill">
        <text variable="title"/>
        <text variable="number" prefix=" "/>
        <text macro="online-access"/>
      </else-if>
      <!-- International normative instruments: short author-year notes, no URL. -->
      <else-if type="treaty">
        <text macro="author-bib" suffix=": "/>
        <text variable="title" font-style="italic"/>
        <text variable="number" prefix=", "/>
        <text macro="issued-document" prefix=", "/>
      </else-if>
      <else-if type="manuscript article" match="any">
        <text macro="author-bib" suffix=": "/>
        <text variable="title" suffix=". "/>
        <choose>
          <if variable="archive">
            <text variable="archive" font-style="italic" prefix="In: " suffix=". "/>
          </if>
          <else-if variable="container-title">
            <text variable="container-title" font-style="italic" suffix=". "/>
          </else-if>
          <else-if variable="publisher">
            <text variable="publisher" font-style="italic" prefix="In: " suffix=". "/>
          </else-if>
        </choose>
        <text macro="year"/>
        <text macro="doi" prefix=". "/>
        <text macro="online-access"/>
      </else-if>
      <else-if type="report">
        <text macro="author-bib" suffix=": "/>
        <group delimiter=", " suffix=". ">
          <text variable="title" font-style="italic"/>
          <text variable="number"/>
        </group>
        <group delimiter=": " suffix=". ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
        <text macro="issued-document"/>
        <text macro="doi" prefix=". "/>
        <text macro="online-document-access" prefix=". "/>
      </else-if>
      <else>
        <text macro="author-bib" suffix=": "/>
        <text variable="title"/>
        <choose>
          <if variable="container-title">
            <text variable="container-title" font-style="italic" prefix=". "/>
          </if>
        </choose>
        <text macro="year" prefix=". "/>
        <text macro="doi" prefix=". "/>
        <text macro="online-access"/>
      </else>
    </choose>
  </macro>
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <layout suffix="." delimiter="; ">
      <choose>
        <if type="legal_case legislation bill regulation" match="any">
          <text macro="legal-citation"/>
        </if>
        <else>
          <text macro="ordinary-citation"/>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography hanging-indent="true" entry-spacing="0">
    <sort>
      <key macro="author-sort"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <text macro="bibliography-entry"/>
    </layout>
  </bibliography>
</style>
