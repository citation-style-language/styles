<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" default-locale="de-DE" page-range-format="expanded">
  <info>
    <title>Mohr Siebeck - Rechtswissenschaft (Deutsch)</title>
    <title-short>Mohr Siebeck Recht</title-short>
    <id>http://www.zotero.org/styles/mohr-siebeck-rechtswissenschaft</id>
    <link href="http://www.zotero.org/styles/mohr-siebeck-rechtswissenschaft" rel="self"/>
    <link href="https://mohrsiebeck.com/assets/d9bdb19f-d8b7-4a3f-8ffa-3b42a0dacaa5" rel="documentation"/>
    <author>
      <name>QuellenPilot</name>
      <uri>https://quellenpilot.de</uri>
    </author>
    <category citation-format="note"/>
    <category field="law"/>
    <summary>Zitierweise für rechtswissenschaftliche Beiträge nach den Richtlinien für Beiträge in Sammelwerken des Verlags Mohr Siebeck (Stand Januar 2022): Fußnoten mit kursiven Verfassernamen, Kommentare mit Bearbeiter und Randnummer, Rechtsprechung mit Gericht, Datum, Aktenzeichen und Fundstelle, Folgezitate mit Verweis auf die Fußnote.</summary>
    <updated>2026-11-01T12:00:00+01:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="de">
    <terms>
      <term name="opus" form="short">
        <single>Rn.</single>
        <multiple>Rn.</multiple>
      </term>
      <term name="chapter" form="short">
        <single>Kap.</single>
        <multiple>Kap.</multiple>
      </term>
      <term name="edition" form="short">Aufl.</term>
      <term name="editor" form="short">
        <single>Hrsg.</single>
        <multiple>Hrsg.</multiple>
      </term>
    </terms>
  </locale>
  <!-- Namen -->
  <macro name="autor-fn">
    <names variable="author" font-style="italic">
      <name form="short" delimiter="/" initialize-with=". "/>
      <substitute>
        <names variable="editor">
          <name form="short" delimiter="/" initialize-with=". "/>
        </names>
        <text variable="title-short"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="autor-verz">
    <names variable="author" font-style="italic">
      <name name-as-sort-order="all" sort-separator=", " delimiter="/"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " delimiter="/"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="hrsg-fn">
    <names variable="editor">
      <name form="short" delimiter="/"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="hrsg-verz">
    <names variable="editor">
      <name delimiter="/"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="werk-hrsg-verz">
    <names variable="editor" font-style="italic">
      <name name-as-sort-order="all" sort-separator=", " delimiter="/"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <!-- Jahr, Auflage, Fundstellen -->
  <macro name="jahr">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="auflage">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <label variable="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="ort-jahr">
    <group delimiter=" ">
      <text variable="publisher-place"/>
      <text macro="jahr"/>
    </group>
  </macro>
  <macro name="zs-jahrgang">
    <choose>
      <if variable="volume">
        <group delimiter=" ">
          <text variable="volume"/>
          <date variable="issued" prefix="(" suffix=")">
            <date-part name="year"/>
          </date>
        </group>
      </if>
      <else>
        <text macro="jahr"/>
      </else>
    </choose>
  </macro>
  <macro name="zs-kuerzel">
    <group delimiter=" ">
      <text variable="container-title" form="short"/>
      <text macro="zs-jahrgang"/>
    </group>
  </macro>
  <macro name="fundstelle-fn">
    <group delimiter=", ">
      <text macro="zs-kuerzel"/>
      <text variable="page-first"/>
    </group>
  </macro>
  <macro name="fundstelle-verz">
    <group delimiter=", ">
      <text macro="zs-kuerzel"/>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="pinpoint">
    <choose>
      <if locator="page">
        <text variable="locator"/>
      </if>
      <else>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="pinpoint-klammer">
    <group prefix="(" suffix=")">
      <text macro="pinpoint"/>
    </group>
  </macro>
  <macro name="url-zugriff">
    <group delimiter=" ">
      <text variable="URL"/>
      <date variable="accessed" prefix="(abgerufen am " suffix=")" delimiter=".">
        <date-part name="day" form="numeric-leading-zeros"/>
        <date-part name="month" form="numeric-leading-zeros"/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>
  <!-- Rechtsprechung -->
  <macro name="gericht-datum-az">
    <group delimiter=" – ">
      <group delimiter=" ">
        <choose>
          <if variable="genre">
            <group delimiter=", ">
              <text variable="authority"/>
              <text variable="genre"/>
            </group>
          </if>
          <else>
            <text variable="authority"/>
          </else>
        </choose>
        <choose>
          <if variable="issued">
            <group delimiter=" ">
              <text value="v."/>
              <date variable="issued" delimiter=".">
                <date-part name="day" form="numeric"/>
                <date-part name="month" form="numeric"/>
                <date-part name="year"/>
              </date>
            </group>
          </if>
        </choose>
      </group>
      <group delimiter=" ">
        <text variable="number"/>
        <text variable="title" prefix="(" suffix=")"/>
      </group>
    </group>
  </macro>
  <macro name="rspr-fundstelle">
    <group delimiter=" ">
      <group delimiter=" ">
        <text variable="container-title" form="short"/>
        <group delimiter=", ">
          <text variable="volume"/>
          <text variable="page-first"/>
        </group>
      </group>
      <text macro="pinpoint-klammer"/>
    </group>
  </macro>
  <macro name="sortierung">
    <choose>
      <if type="entry-encyclopedia">
        <choose>
          <if variable="editor">
            <names variable="editor"/>
          </if>
          <else>
            <text variable="container-title"/>
          </else>
        </choose>
      </if>
      <else>
        <names variable="author">
          <substitute>
            <names variable="editor"/>
            <text variable="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="folgezitat">
    <group delimiter=", ">
      <group delimiter=" ">
        <group delimiter=", ">
          <text macro="autor-fn"/>
          <text variable="title-short"/>
        </group>
        <text variable="first-reference-note-number" prefix="(Fn. " suffix=")"/>
      </group>
      <text macro="pinpoint"/>
    </group>
  </macro>
  <citation disambiguate-add-givenname="true" givenname-disambiguation-rule="by-cite">
    <layout suffix="." delimiter="; ">
      <choose>
        <if type="legal_case">
          <group delimiter=", ">
            <text macro="gericht-datum-az"/>
            <text macro="rspr-fundstelle"/>
          </group>
        </if>
        <else-if type="article-journal">
          <group delimiter=", ">
            <text macro="autor-fn"/>
            <group delimiter=" ">
              <text macro="fundstelle-fn"/>
              <text macro="pinpoint-klammer"/>
            </group>
          </group>
        </else-if>
        <else-if position="subsequent">
          <text macro="folgezitat"/>
        </else-if>
        <else-if type="entry-encyclopedia">
          <group delimiter=", ">
            <text macro="autor-fn"/>
            <group delimiter=" ">
              <text value="in:"/>
              <choose>
                <if variable="container-title-short">
                  <text variable="container-title" form="short"/>
                </if>
                <else>
                  <text variable="container-title"/>
                </else>
              </choose>
            </group>
            <text macro="pinpoint"/>
          </group>
        </else-if>
        <else-if type="chapter paper-conference" match="any">
          <group delimiter=", ">
            <group delimiter=", ">
              <text macro="autor-fn"/>
              <group delimiter=" ">
                <text value="in:"/>
                <text macro="hrsg-fn"/>
              </group>
            </group>
            <text variable="container-title"/>
            <text macro="jahr"/>
            <choose>
              <if variable="locator">
                <text macro="pinpoint"/>
              </if>
              <else>
                <text variable="page-first" suffix=" ff."/>
              </else>
            </choose>
          </group>
        </else-if>
        <else-if type="article-newspaper article-magazine" match="any">
          <group delimiter=", ">
            <text macro="autor-fn"/>
            <text variable="container-title"/>
            <date variable="issued" delimiter=".">
              <date-part name="day" form="numeric-leading-zeros"/>
              <date-part name="month" form="numeric-leading-zeros"/>
              <date-part name="year"/>
            </date>
            <text macro="pinpoint"/>
            <text macro="url-zugriff"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <text macro="autor-fn"/>
            <text variable="title"/>
            <text macro="jahr"/>
            <text macro="pinpoint"/>
            <text macro="url-zugriff"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography hanging-indent="true" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="sortierung"/>
      <key variable="issued" sort="ascending"/>
    </sort>
    <layout>
      <choose>
        <if type="legal_case legislation bill" match="none">
          <choose>
            <if type="article-journal">
              <group delimiter=", ">
                <text macro="autor-verz"/>
                <text variable="title"/>
                <text macro="fundstelle-verz"/>
              </group>
            </if>
            <else-if type="entry-encyclopedia">
              <group delimiter=", ">
                <text macro="werk-hrsg-verz"/>
                <text variable="container-title"/>
                <choose>
                  <if variable="volume">
                    <group delimiter=" ">
                      <text term="volume" form="short"/>
                      <text variable="volume"/>
                    </group>
                  </if>
                </choose>
                <text macro="auflage"/>
                <text macro="ort-jahr"/>
              </group>
            </else-if>
            <else-if type="chapter paper-conference" match="any">
              <group delimiter=", ">
                <text macro="autor-verz"/>
                <text variable="title"/>
                <group delimiter=" ">
                  <text value="in:"/>
                  <text macro="hrsg-verz"/>
                </group>
                <text variable="container-title"/>
                <text macro="auflage"/>
                <text macro="ort-jahr"/>
                <text variable="page"/>
              </group>
            </else-if>
            <else>
              <group delimiter=", ">
                <text macro="autor-verz"/>
                <text variable="title"/>
                <text macro="auflage"/>
                <text macro="ort-jahr"/>
                <text macro="url-zugriff"/>
              </group>
            </else>
          </choose>
        </if>
      </choose>
    </layout>
  </bibliography>
</style>
