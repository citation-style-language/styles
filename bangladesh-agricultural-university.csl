<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" default-locale="en-GB">
  <info>
    <title>Bangladesh Agricultural University (PhD Dissertation)</title>
    <title-short>BAU PhD Dissertation</title-short>
    <id>http://www.zotero.org/styles/bangladesh-agricultural-university</id>
    <link href="http://www.zotero.org/styles/bangladesh-agricultural-university" rel="self"/>
    <link href="https://gist.github.com/ashfaq-sadat/39fc643b639c997bc29574f91fbfb7b4" rel="documentation"/>
    <author>
      <name>Md. Ashfaq Sadat</name>
      <!-- Department of Fisheries Management, Faculty of Fisheries, Bangladesh Agricultural University -->
    </author>
    <category citation-format="author-date"/>
    <category field="biology"/>
    <category field="science"/>
    <summary>Reference list format for PhD dissertations at Bangladesh Agricultural University (BAU), Mymensingh, as approved by BAU's Committee for Advanced Studies and Research (CASR) in its Emergency Meeting of 19 July 2012, and applied university-wide across all departments and faculties. Prepared by Md. Ashfaq Sadat, Department of Fisheries Management, Faculty of Fisheries, Bangladesh Agricultural University.</summary>
    <updated>2026-09-21T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="editor" form="short">
        <single>Editor</single>
        <multiple>Editors</multiple>
      </term>
      <term name="and">and</term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>

  <!-- ============ MACROS ============ -->

  <!-- Author list: Family Initials, Family Initials (no "and", no comma before initials, initials with no periods).
       If no author is present (e.g. an edited book with no separate author), the editor(s) are
       substituted and "(Editors)" is appended. -->
  <macro name="responsibility">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " delimiter=", " delimiter-precedes-last="never" initialize-with="" initialize="true"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=" " delimiter=", " delimiter-precedes-last="never" initialize-with="" initialize="true"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <!-- "Family Initials, Family Initials Year:" shared opening for every entry -->
  <macro name="author-year">
    <group delimiter=" ">
      <text macro="responsibility"/>
      <text macro="year"/>
    </group>
  </macro>

  <!-- Editors quoted inside an "In: ..." clause for a book chapter: Given Family order, joined with "and",
       initials with no periods, followed by "(Editors)" -->
  <macro name="container-editors">
    <names variable="editor" prefix="In: " suffix=" (Editors)">
      <name and="text" delimiter=", " delimiter-precedes-last="never" initialize-with="" initialize="true"/>
    </names>
  </macro>

  <macro name="publisher-place">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>

  <macro name="collection">
    <group delimiter=" ">
      <text variable="collection-title"/>
      <text variable="collection-number"/>
    </group>
  </macro>

  <!-- Book / edited book: Title (italic). Collection number. Publisher, Place. pp. NNN. -->
  <macro name="book-content">
    <group delimiter=". ">
      <text variable="title" font-style="italic"/>
      <text macro="collection"/>
      <text macro="publisher-place"/>
    </group>
    <text variable="number-of-pages" prefix=". pp. "/>
    <text value="."/>
  </macro>

  <!-- Chapter in an edited book: title (plain). In: Editors (Editors), Book title (italic). Publisher, Place. pp. NNN-NNN. -->
  <macro name="chapter-content">
    <group delimiter=". ">
      <text variable="title"/>
      <group delimiter=", ">
        <text macro="container-editors"/>
        <text variable="container-title" font-style="italic"/>
      </group>
      <text macro="publisher-place"/>
    </group>
    <text variable="page" prefix=". pp. "/>
    <text value="."/>
  </macro>

  <!-- Journal article: title (plain). Journal (italic) volume pages. -->
  <macro name="article-content">
    <group delimiter=". ">
      <text variable="title"/>
      <group delimiter=" ">
        <text variable="container-title" font-style="italic"/>
        <text variable="volume"/>
        <text variable="page"/>
      </group>
    </group>
    <text value="."/>
  </macro>

  <!-- Thesis: title (plain), Genre, Department/Publisher, Place. -->
  <macro name="thesis-content">
    <group delimiter=", ">
      <text variable="title"/>
      <text variable="genre"/>
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
    <text value="."/>
  </macro>

  <!-- Corporate report / yearbook: Title (plain) Publisher, Place. -->
  <macro name="report-content">
    <group delimiter=" ">
      <text variable="title"/>
      <text macro="publisher-place"/>
    </group>
    <text value="."/>
  </macro>

  <!-- CD-ROM / dataset or computer software: Title (italic) [medium]. Publisher, Place. -->
  <macro name="medium-content">
    <group delimiter=" ">
      <text variable="title" font-style="italic"/>
      <text variable="medium" prefix="[" suffix="]"/>
    </group>
    <text value=". "/>
    <text macro="publisher-place"/>
    <text value="."/>
  </macro>

  <!-- ============ CITATION (in-text) ============ -->
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <names variable="author">
          <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" initialize-with=""/>
          <et-al font-style="italic"/>
          <substitute>
            <names variable="editor">
              <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" initialize-with=""/>
              <et-al font-style="italic"/>
            </names>
          </substitute>
        </names>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </group>
    </layout>
  </citation>

  <!-- ============ BIBLIOGRAPHY ============ -->
  <bibliography>
    <sort>
      <key macro="responsibility"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <text macro="author-year" suffix=":"/>
      <text value=" "/>
      <choose>
        <if type="chapter">
          <text macro="chapter-content"/>
        </if>
        <else-if type="article-journal">
          <text macro="article-content"/>
        </else-if>
        <else-if type="thesis">
          <text macro="thesis-content"/>
        </else-if>
        <else-if type="report">
          <text macro="report-content"/>
        </else-if>
        <else-if type="dataset" match="any">
          <text macro="medium-content"/>
        </else-if>
        <else-if type="software">
          <text macro="medium-content"/>
        </else-if>
        <else>
          <text macro="book-content"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
